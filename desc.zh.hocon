emqx_bridge_kinesis.desc_config.label = "Amazon Kinesis 动作配置"
emqx_bridge_kinesis.desc_name.desc = "动作的名称"
emqx_bridge_kinesis.desc_name.label = "动作名称"
emqx_bridge_kinesis.desc_type.desc = "动作的类型"
emqx_bridge_kinesis.desc_type.label = "动作类型"
emqx_bridge_kinesis.endpoint.desc = "Amazon Kinesis 终端节点的 URL。"
emqx_bridge_kinesis.endpoint.label = "Amazon Kinesis 终端节点"
emqx_bridge_kinesis.kinesis_action.desc = "Kinesis 动作的配置。"
