emqx_bridge_greptimedb.write_syntax.desc = "GreptimeDB gRPC 协议写入数据点的配置。写入语法是一种文本格式，提供了数据点的测量、标签集、字段集和时间戳，并支持占位符，与 InfluxDB 行协议相同。\n参见 [InfluxDB 2.3 行协议](https://docs.influxdata.com/influxdb/v2.3/reference/syntax/line-protocol/) 和\n[GreptimeDB 1.8 行协议](https://docs.influxdata.com/influxdb/v1.8/write_protocols/line_protocol_tutorial/) <br/>\n简而言之:<br/>\n```\n<measurement>[,<tag_key>=<tag_value>[,<tag_key>=<tag_value>]] <field_key>=<field_value>[,<field_key>=<field_value>] [<timestamp>]\n```\n请注意，整数值的占位符必须用后缀 `i` 注释。例如 `${payload.int_value}i`。"
emqx_bridge_greptimedb.write_syntax.label = "写入语法"
emqx_bridge_greptimedb_connector.connector_ts_column.desc = "如果定义了，指定一个自定义时间戳列名，该列将在查询时出现。"
emqx_bridge_greptimedb_connector.connector_ts_column.label = "自定义时间戳列名"
emqx_bridge_greptimedb_connector.dbname.desc = "GreptimeDB 数据库"
emqx_bridge_greptimedb_connector.dbname.label = "数据库"
emqx_bridge_greptimedb_connector.greptimedb.desc = "GreptimeDB 的行协议。支持 GreptimeDB v1.8 以及之前的版本。"
emqx_bridge_greptimedb_connector.greptimedb.label = "HTTP API 协议"
emqx_bridge_greptimedb_connector.password.desc = "GreptimeDB 密码。"
emqx_bridge_greptimedb_connector.password.label = "密码"
emqx_bridge_greptimedb_connector.precision.desc = "GreptimeDB 的时间精度。"
emqx_bridge_greptimedb_connector.precision.label = "时间精度"
emqx_bridge_greptimedb_connector.protocol.desc = "GreptimeDB 的协议。gRPC API。"
emqx_bridge_greptimedb_connector.protocol.label = "协议"
emqx_bridge_greptimedb_connector.server.desc = "要连接的 IPv4 或 IPv6 地址或主机名。<br/>\n主机条目的格式如下：主机名[:端口]。<br/>\n如果未指定 [:端口]，则使用 GreptimeDB 的默认端口 8086。"
