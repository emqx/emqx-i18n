emqx_mq_schema.data_retention_period.desc = "消息队列中数据保留的时间段。"
emqx_mq_schema.data_retention_period.label = "数据保留期"
emqx_mq_schema.dispatch_strategy.desc = "用于将消息从消息队列分发到队列订阅者的策略。"
emqx_mq_schema.dispatch_strategy.label = "分发策略"
emqx_mq_schema.enable.desc = "是否启用消息队列。如果设置为 `auto`，消息队列默认禁用，仅在已有消息队列时启用。"
emqx_mq_schema.enable.label = "启用"
emqx_mq_schema.find_queue_retry_interval.desc = "订阅者在订阅队列主题时未找到队列时重试查找队列的间隔时间。"
emqx_mq_schema.find_queue_retry_interval.label = "查找队列重试间隔"
