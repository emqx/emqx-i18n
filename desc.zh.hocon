emqx_bridge_redis.command_template.desc = "用于导出消息的 Redis 命令模板。每个列表元素代表一个命令名称或其参数。\n例如，要将有效负载推送到 Redis 列表中的键 msgs，元素应该如下所示：\nrpush，msgs，${payload}。"
emqx_bridge_redis.command_template.label = "Redis 命令模版"
