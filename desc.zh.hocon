emqx_cluster_link_schema.clientid.label = "基础客户端 ID"
emqx_cluster_link_schema.enable.desc = "启用或停用集群连接。默认情况下启用连接，停用允许停止连接而无需删除其配置。连接必须在两个集群上启用才能正常工作。停用连接也应在两个集群上进行，以释放所有相关资源。"
emqx_cluster_link_schema.enable.label = "启用"
emqx_cluster_link_schema.link.desc = "集群连接配置"
emqx_cluster_link_schema.link.label = "集群连接"
emqx_cluster_link_schema.link_name.desc = "连接（远程）集群名称。必须与远程集群中配置的 `cluster.name` 值完全相同。不得与本地的 cluster.name 相同。所有配置的集群连接名称必须唯一。"
emqx_cluster_link_schema.link_name.label = "连接的集群名称"
emqx_cluster_link_schema.links.desc = "已连接的 EMQX 集群列表。"
emqx_cluster_link_schema.links.label = "连接的集群"
emqx_cluster_link_schema.max_inflight.desc = "MQTT 协议的最大待处理（已发送但未确认）消息数。"
emqx_cluster_link_schema.max_inflight.label = "最大待处理消息"
emqx_cluster_link_schema.password.desc = "用于连接到远程 EMQX 集群的 MQTT 密码（可选）。<br/>\n如需从文件加载密码而不是内联写入，请使用 <code>file://&lt;path-to-file&gt;</code> 形式；文件内容（去除末尾空白）将作为密码使用。集群模式下，该文件必须存在于所有 EMQX 节点。"
emqx_cluster_link_schema.password.label = "密码"
emqx_cluster_link_schema.pool_size.desc = "将向连接的 EMQX 消息服务器发布消息的 MQTT 客户端池的大小。"
emqx_cluster_link_schema.pool_size.label = "连接池大小"
emqx_cluster_link_schema.retry_interval.desc = "在未收到 ACK 的情况下，MQTT 桥接器重试发送 QoS1/QoS2 消息的延迟。"
emqx_cluster_link_schema.retry_interval.label = "重试间隔"
emqx_cluster_link_schema.server.desc = "远程 EMQX 消息服务器的 MQTT 主机和端口。"
emqx_cluster_link_schema.server.label = "MQTT 服务器"
emqx_cluster_link_schema.ssl.desc = "用于连接到远程 EMQX 集群的 SSL 配置。"
emqx_cluster_link_schema.ssl.label = "SSL 选项"
emqx_cluster_link_schema.tcp_opts.desc = "用于出站集群链路 MQTT 连接的 TCP socket 选项。\n所有字段均为可选；未设置的字段将保留 OS / `gen_tcp` 默认值。"
emqx_cluster_link_schema.tcp_opts.label = "TCP 选项"
emqx_cluster_link_schema.topics.desc = "将由连接的远程 EMQX 消息服务器转发到本地消息服务器的 MQTT 主题。只有当本地 EMQX 有匹配的订阅者时，消息才会被转发。\n支持通配符。将一侧的主题列表设置为空可以建立单向连接：具有空主题的一侧不会接收远程消息，但可以根据连接另一侧配置的主题将相关消息转发给其连接的对端。"
emqx_cluster_link_schema.topics.label = "主题"
emqx_cluster_link_schema.username.desc = "用于连接到远程 EMQX 集群的 MQTT 用户名（可选）。"
emqx_cluster_link_schema.username.label = "用户名"
emqx_coap_api.client_bad_response.desc = "客户端返回了无效的 CoAP 回复"
emqx_coap_api.client_bad_response.label = "客户端响应无效"
emqx_coap_api.client_not_found.desc = "未找到客户端错误"
emqx_coap_api.client_not_found.label = "未找到客户端"
emqx_coap_api.client_not_response_timeout.desc = "等待客户端响应超时"
emqx_coap_api.client_not_response_timeout.label = "客户端未响应超时"
emqx_coap_api.content_type.desc = "Payload 类型"
emqx_coap_api.message_id.desc = "消息 ID"
emqx_coap_api.method.desc = "请求 Method 类型"
emqx_coap_api.missing_required_parameter.desc = "缺少必需参数"
emqx_coap_api.payload.desc = "Payload 内容"
emqx_coap_api.response_code.desc = "应答码"
emqx_coap_api.send_coap_request.desc = "发送 CoAP 消息到指定客户端"
emqx_coap_api.send_coap_request.label = "发送 CoAP 请求"
emqx_coap_api.timeout.desc = "请求超时"
emqx_coap_api.token.desc = "消息 Token, 可以为空"
emqx_coap_schema.coap.desc = "CoAP 网关设置。\n使用此网关将 CoAP 设备连接到 EMQX MQTT 消息系统。\n协议参考：RFC 7252 和 CoAP Pub/Sub 草案：\nhttps://core-wg.github.io/coap-pubsub/draft-ietf-core-pubsub.html"
emqx_coap_schema.coap_blockwise.desc = "大负载传输设置。\n分块传输将一个大负载拆分为更小的 CoAP 块。\n除非遇到负载大小或丢包问题，否则使用默认值即可。"
emqx_coap_schema.coap_blockwise_enable.desc = "启用大负载的分块传输。\n除非所有负载都很小且固定，否则保持启用。"
emqx_coap_schema.coap_blockwise_exchange_lifetime.desc = "临时分块状态的保留时长。\n过短可能导致慢速传输中断；过长会占用更多内存。"
emqx_coap_schema.coap_blockwise_max_block_size.desc = "每个 CoAP 块的大小（字节）。\n较大的值：更少的数据包，但丢包时重传代价更高。\n较小的值：更多的数据包，但丢包影响更小。"
emqx_coap_schema.coap_blockwise_max_body_size.desc = "重组后的最终负载最大大小。\n超过此大小的消息将被拒绝以保护内存。"
emqx_coap_schema.coap_connection_required.desc = "客户端是否必须维护连接上下文。\n  - false（默认）：无状态请求/响应。\n  - true：必须创建、认证并保持客户端会话。\n仅在设备流程依赖连接状态时启用。"
emqx_coap_schema.coap_heartbeat.desc = "已连接客户端的最小心跳间隔。\n仅在 <code>connection_required = true</code> 时使用。\n如果心跳间隔大于此值，会话可能被视为离线。"
emqx_coap_schema.coap_notify_type.desc = "转发已观察主题消息时使用的 CoAP 消息类型。<br/>\n  - non：发送 NON（更快，无需 ACK）<br/>\n  - con：发送 CON（可靠，需要 ACK）<br/>\n  - qos：根据 MQTT QoS 自动映射（QoS 0 -> NON，QoS 1/2 -> CON）"
emqx_coap_schema.coap_publish_qos.desc = "CoAP 发布请求未提供 <code>qos</code> 时的默认 MQTT QoS。<br/>\n  - qos0 | qos1 | qos2：使用固定 QoS<br/>\n  - coap：根据消息类型推导（NON -> qos0，CON -> qos1）"
emqx_coap_schema.coap_subscribe_qos.desc = "CoAP 订阅请求未提供 <code>qos</code> 时的默认 MQTT QoS。<br/>\n  - qos0 | qos1 | qos2：使用固定 QoS<br/>\n  - coap：根据消息类型推导（NON -> qos0，CON -> qos1）"
emqx_conf_schema.audit_file_handler_path.desc = "审计日志文件的名称。"
emqx_conf_schema.audit_file_handler_path.label = "审计日志文件名"
emqx_conf_schema.audit_handler_level.desc = "审计日志处理进程处理的日志级别。<br/>\n- 处理时间超过 3 秒的请求将被记录为 <code>warning</code> 级别日志。<br/>\n- HTTP 状态码在 200-300 之间的 GET 请求记录为<code>debug</code>日志。<br/>\n- HTTP 状态码在 200-300 之间的非 GET 请求记录为<code>info</code>日志。<br/>\n- HTTP 状态码在 300-400 之间的请求记录为<code>warning</code>日志。<br/>\n- HTTP 状态码在 400-500 之间的请求记录为<code>error</code>日志。<br/>\n- 默认为 info 级别。"
emqx_conf_schema.audit_handler_level.label = "日志级别"
emqx_conf_schema.audit_log_cache_size.desc = "将最新的 N 条日志记录存储在数据库中，以便 `/audit` HTTP API 过滤和检索日志数据。\n清理冗余日志记录的间隔保持在 10~20 秒之间。"
emqx_conf_schema.audit_log_cache_size.label = "缓存大小"
emqx_conf_schema.audit_log_ignore_high_frequency_request.desc = "忽略高频请求以避免淹没审计日志，例如发布/订阅踢出 http API 请求将被忽略。"
emqx_conf_schema.audit_log_ignore_high_frequency_request.label = "忽略高频请求"
emqx_conf_schema.authorization.desc = "授权（ACL）。EMQX 支持完整的客户端访问控制（ACL）。"
emqx_conf_schema.authorization.label = "授权"
emqx_conf_schema.cluster_autoclean.desc = "指定多久之后从集群中删除离线节点。"
emqx_conf_schema.cluster_autoclean.label = "自动删除离线节点时间"
emqx_conf_schema.cluster_autoheal.desc = "集群脑裂自动恢复机制开关。"
emqx_conf_schema.cluster_autoheal.label = "节点脑裂自动修复机制"
emqx_conf_schema.cluster_call_cleanup_interval.desc = "清理过期事务的时间间隔"
emqx_conf_schema.cluster_call_cleanup_interval.label = "清理间隔"
emqx_conf_schema.cluster_call_max_history.desc = "集群间调用最多保留的历史记录数。只用于排错时查看。"
emqx_conf_schema.cluster_call_max_history.label = "最大历史记录"
emqx_conf_schema.cluster_call_retry_interval.desc = "当集群间调用出错时，多长时间重试一次。"
emqx_conf_schema.cluster_call_retry_interval.label = "重试时间间隔"
emqx_conf_schema.cluster_discovery_strategy.desc = "集群节点发现方式。可选值为:\n- manual: 使用 <code>emqx ctl cluster</code> 命令管理集群。<br/>\n- static: 配置静态节点。配置几个固定的节点，新节点通过连接固定节点中的某一个来加入集群。<br/>\n- dns: 使用 DNS A 记录的方式发现节点。<br/>\n- etcd: 使用 etcd 发现节点。<br/>\n- k8s: 使用 Kubernetes API 发现节点。"
emqx_conf_schema.cluster_discovery_strategy.label = "集群服务发现策略"
emqx_conf_schema.cluster_dns_name.desc = "指定 DNS A 记录的名字。emqx 会通过访问这个 DNS A 记录来获取 IP 地址列表。\n当<code>cluster.discovery_strategy</code> 为 <code>dns</code> 时有效。"
emqx_conf_schema.cluster_dns_name.label = "DNS 名称"
emqx_conf_schema.cluster_dns_record_type.desc = "DNS 记录类型。"
emqx_conf_schema.cluster_dns_record_type.label = "DNS 记录类型"
emqx_conf_schema.cluster_etcd_node_ttl.desc = "指定 etcd 中节点信息的过期时间。\n当 cluster.discovery_strategy 为 etcd 时，此配置项才有效。"
emqx_conf_schema.cluster_etcd_node_ttl.label = "Etcd 节点过期时间"
emqx_conf_schema.cluster_etcd_prefix.desc = "指定 etcd 路径的前缀。每个节点在 etcd 中都会创建一个路径:\nv2/keys/<prefix>/<cluster.name>/<node.name> <br/>\n当 cluster.discovery_strategy 为 etcd 时，此配置项才有效。"
emqx_conf_schema.cluster_etcd_prefix.label = "Etcd 路径前缀"
emqx_conf_schema.cluster_etcd_server.desc = "指定 etcd 服务的地址。如有多个服务使用逗号 , 分隔。\n当 cluster.discovery_strategy 为 etcd 时，此配置项才有效。"
emqx_conf_schema.cluster_etcd_server.label = "Etcd 服务器地址"
emqx_conf_schema.cluster_etcd_ssl.desc = "当使用 TLS 连接 etcd 时的配置选项。\n当 cluster.discovery_strategy 为 etcd 时，此配置项才有效。"
emqx_conf_schema.cluster_etcd_ssl.label = "Etcd SSL 选项"
emqx_conf_schema.cluster_k8s_address_type.desc = "当使用 k8s 方式集群时，address_type 用来从 Kubernetes 接口的应答里获取什么形式的 Host 列表。\n指定 <code>cluster.k8s.address_type</code> 为 <code>ip</code>，则将从 Kubernetes 接口中获取集群中其他节点\n的 IP 地址。"
emqx_conf_schema.cluster_k8s_address_type.label = "K8s 地址类型"
emqx_conf_schema.cluster_k8s_apiserver.desc = "指定 Kubernetes API Server。如有多个 Server 使用逗号 , 分隔。\n当 cluster.discovery_strategy 为 k8s 时，此配置项才有效。"
emqx_conf_schema.cluster_k8s_apiserver.label = "K8s 服务地址"
emqx_conf_schema.cluster_k8s_namespace.desc = "当使用 k8s 方式并且 cluster.k8s.address_type 指定为 dns 类型时，\n可设置 emqx 节点名的命名空间。与 cluster.k8s.suffix 一起使用用以拼接得到节点名列表。"
emqx_conf_schema.cluster_k8s_namespace.label = "K8s 命名空间"
emqx_conf_schema.cluster_k8s_service_name.desc = "指定 Kubernetes 中 EMQX 的服务名。\n当 cluster.discovery_strategy 为 k8s 时，此配置项才有效。"
emqx_conf_schema.cluster_k8s_service_name.label = "K8s 服务别名"
emqx_conf_schema.cluster_k8s_suffix.desc = "当使用 k8s 方式并且 cluster.k8s.address_type 指定为 dns 类型时，可设置 emqx 节点名的后缀。\n与 cluster.k8s.namespace 一起使用用以拼接得到节点名列表。"
emqx_conf_schema.cluster_k8s_suffix.label = "K8s 前缀"
emqx_conf_schema.cluster_name.desc = "EMQX 集群的友好名称。\n注意：集群名称只能包含 `a-z`、`A-Z`、`0-9`、`_`、`-` 中的字符，并且第一个字符必须是 `a-z` 或 `A-Z`，\n否则您将无法将其配置为集群连接的对等集群。"
emqx_conf_schema.cluster_name.label = "集群名称"
emqx_conf_schema.cluster_proto_dist.desc = "分布式 Erlang 集群协议类型。可选值为:<br/>\n- inet_tcp: 使用 IPv4 <br/>\n- inet_tls: 使用 TLS，需要配合 <code>etc/ssl_dist.conf</code> 一起使用。<br/>\n- inet6_tcp: IPv6 TCP <br/>\n- inet6_tls: IPv6 TLS， 与 <code>etc/ssl_dist.conf</code> 配合使用。"
emqx_conf_schema.cluster_proto_dist.label = "集群内部通信协议"
emqx_conf_schema.cluster_quic_lb_mode.desc = "QUIC stack 负载均衡模式\n- 0: 禁用 (默认)\n- 1: server_ip\n- 2: server_id_fixed\n- N：当 N > 2 时，使用 server_id_fixed 且 server_id 为 N\n- IfName：当 IfName 为字符串时，server_id 将设置为 IfName 接口上的第一个 IP 地址，仅支持 IPv4。"
emqx_conf_schema.cluster_quic_lb_mode.label = " QUIC stack 负载均衡模式 "
emqx_conf_schema.cluster_static_seeds.desc = "集群中的 EMQX 节点名称列表，\n指定固定的节点列表，多个节点间使用逗号 , 分隔。\n当 cluster.discovery_strategy 为 static 时，此配置项才有效。\n适合于节点数量较少且固定的集群。"
emqx_conf_schema.cluster_static_seeds.label = "集群静态节点"
emqx_conf_schema.common_handler_chars_limit.desc = "设置单个日志消息的最大长度。 如果超过此长度，则日志消息将被截断。最小可设置的长度为 100。\n注意：如果日志格式为 JSON，限制字符长度可能会导致截断不完整的 JSON 数据。"
emqx_conf_schema.common_handler_chars_limit.label = "单条日志长度限制"
emqx_conf_schema.common_handler_drop_mode_qlen.desc = "当缓冲的日志事件数大于此值时，新的日志事件将被丢弃。起到过载保护的功能。\n为了使过载保护算法正常工作必须要：<code> sync_mode_qlen =< drop_mode_qlen =< flush_qlen </code> 且 drop_mode_qlen > 1\n要禁用某些模式，请执行以下操作。\n- 如果 sync_mode_qlen 被设置为 0，所有的日志事件都被同步处理。也就是说，异步日志被禁用。\n- 如果 sync_mode_qlen 被设置为与 drop_mode_qlen 相同的值，同步模式被禁用。也就是说，处理程序总是以异步模式运行，除非调用 drop 或 flushing。\n- 如果 drop_mode_qlen 被设置为与 flush_qlen 相同的值，则 drop 模式被禁用，永远不会发生。"
emqx_conf_schema.common_handler_drop_mode_qlen.label = "进入丢弃模式的队列长度"
emqx_conf_schema.common_handler_enable.desc = "启用此日志处理进程。"
emqx_conf_schema.common_handler_enable.label = "启用日志处理进程"
emqx_conf_schema.common_handler_flush_qlen.desc = "如果缓冲日志事件的数量增长大于此阈值，则会发生冲刷（删除）操作。 日志处理进程会丢弃缓冲的日志消息。\n来缓解自身不会由于内存瀑涨而影响其它业务进程。日志内容会提醒有多少事件被删除。"
emqx_conf_schema.common_handler_flush_qlen.label = "冲刷阈值"
emqx_conf_schema.common_handler_formatter.desc = "选择日志格式类型。 <code>text</code> 用于纯文本，<code>json</code> 用于结构化日志记录。"
emqx_conf_schema.common_handler_formatter.label = "日志格式类型"
emqx_conf_schema.common_handler_level.desc = "当前日志处理进程的日志级别。\n默认为 warning 级别。"
emqx_conf_schema.common_handler_level.label = "日志级别"
emqx_conf_schema.common_handler_max_depth.desc = "Erlang 内部格式日志格式化和 Erlang 进程消息队列检查的最大深度。"
emqx_conf_schema.common_handler_max_depth.label = "最大深度"
emqx_conf_schema.common_handler_single_line.desc = "如果设置为 true，则单行打印日志。 否则，日志消息可能跨越多行。"
emqx_conf_schema.common_handler_single_line.label = "单行模式"
emqx_conf_schema.common_handler_supervisor_reports.desc = "Supervisor 报告的类型。默认为 error 类型。<br/>\n  - <code>error</code>：仅记录 Erlang 进程中的错误。\n  - <code>progress</code>：除了 error 信息外，还需要记录进程启动的详细信息。"
emqx_conf_schema.common_handler_supervisor_reports.label = "报告类型"
emqx_conf_schema.common_handler_sync_mode_qlen.desc = "只要缓冲的日志事件的数量低于这个值，所有的日志事件都会被异步处理。\n这意味着，日志落地速度不会影响正常的业务进程，因为它们不需要等待日志处理进程的响应。\n如果消息队列的增长超过了这个值，处理程序开始同步处理日志事件。也就是说，发送事件的客户进程必须等待响应。\n当处理程序将消息队列减少到低于 sync_mode_qlen 阈值的水平时，异步操作就会恢复。\n默认为 100 条信息，当等待的日志事件大于 100 条时，就开始同步处理日志。"
emqx_conf_schema.common_handler_sync_mode_qlen.label = "进入异步模式的队列长度"
emqx_conf_schema.common_handler_time_offset.desc = "日志中的时间戳使用的时间偏移量。\n可选值为：\n  - <code>system</code>: 本地系统使用的时区偏移量\n  - <code>utc</code>: 0 时区的偏移量\n  - <code>+-[hh]:[mm]</code>: 自定义偏移量，比如 \"-02:00\" 或者 \"+00:00\"\n默认值为本地系统的时区偏移量：<code>system</code>。"
emqx_conf_schema.common_handler_time_offset.label = "时间偏移量"
emqx_conf_schema.common_handler_timestamp_format.desc = "选择时间戳格式：\n- `auto`：自动选择最佳格式。`epoch` 给 JSON 日志 `rfc3339` 给自由文本格式。\n- `epoch`： 微秒精度的 Unix epoch 整形值。\n- `rfc3339`： 遵从 RFC3339 规范的字符串格式。"
emqx_conf_schema.common_handler_timestamp_format.label = "时间戳格式"
emqx_conf_schema.db_backend.desc = "配置后端数据库驱动，默认值为 <code>rlog</code> 它适用于大规模的集群。\n<code>mnesia</code> 是备选数据库，适合中小集群。"
emqx_conf_schema.db_backend.label = "内置数据库"
emqx_conf_schema.db_default_bootstrap_batch_size.desc = "在引导过程中，从核心节点向复制节点推送的内置数据库表记录的批量数量。\n引导是在当新的复制节点添加到集群中或现有的复制节点重新连接到核心节点时发生的。\n增加此值可能会大大缩短复制节点的启动时间，特别是在 EMQX 集群互连网络延迟较高且 EMQX 内置数据库保存大量数据（例如订阅量很高时）的情况下\n默认值为 500。"
emqx_conf_schema.db_default_bootstrap_batch_size.label = "默认引导批量大小"
emqx_conf_schema.db_default_shard_transport.desc = "定义用于推送事务日志的默认传输。<br/>\n这可以在 <code>db.shard_transports</code> 中基于每个分片被覆盖。\n<code>gen_rpc</code> 使用 <code>gen_rpc</code> 库，\n<code>distr</code> 使用 Erlang 发行版。"
emqx_conf_schema.db_default_shard_transport.label = "事务日志传输默认协议"
emqx_conf_schema.db_role.desc = "选择节点的角色。<br/>\n<code>core</code> 节点提供数据的持久性，并负责写入。建议将核心节点放置在不同的机架或不同的可用区。<br/>\n<code>replicant</code> 节点是临时工作节点。 从集群中删除它们，不影响数据库冗余<br/>\n建议复制节点多于核心节点。<br/>\n注意：该参数仅在设置<code>backend</code>时生效到 <code>rlog</code>。"
emqx_conf_schema.db_role.label = "数据库角色"
emqx_conf_schema.db_rpc_module.desc = "集群间推送事务日志到复制节点使用的协议。"
emqx_conf_schema.db_rpc_module.label = "RPC 协议"
emqx_conf_schema.db_shard_transports.desc = "允许为每个 shard 下的事务日志复制操作的传输方法进行调优。<br/>\n<code>gen_rpc</code> 使用 <code>gen_rpc</code> 库，\n<code>distr</code> 使用 Erlang 自带的 rpc 库。<br/>如果未指定，\n默认是使用 <code>db.default_shard_transport</code> 中设置的值。"
emqx_conf_schema.db_shard_transports.label = "事务日志传输协议"
emqx_conf_schema.db_tlog_push_mode.desc = "同步模式下，核心节点等待复制节点的确认信息，然后再发送下一条事务日志。"
emqx_conf_schema.db_tlog_push_mode.label = "Tlog 推送模式"
emqx_conf_schema.desc_audit_log_handler.desc = "将日志时间输出到文件的审计日志处理进程。"
emqx_conf_schema.desc_audit_log_handler.label = "审计日志处理进程"
emqx_conf_schema.desc_authorization.desc = "授权相关"
emqx_conf_schema.desc_authorization.label = "授权"
emqx_conf_schema.desc_cluster.desc = "EMQX 节点可以组成一个集群，以提高总容量。<br/> 这里指定了节点之间如何连接。"
emqx_conf_schema.desc_cluster.label = "集群"
emqx_conf_schema.desc_cluster_call.desc = "集群调用功能的选项。"
emqx_conf_schema.desc_cluster_call.label = "集群调用"
emqx_conf_schema.desc_cluster_dns.desc = "DNS SRV 记录服务发现。"
emqx_conf_schema.desc_cluster_dns.label = "DNS SRV 记录服务发现"
emqx_conf_schema.desc_cluster_etcd.desc = "使用 'etcd' 服务的服务发现。"
emqx_conf_schema.desc_cluster_etcd.label = "'etcd' 服务的服务发现"
emqx_conf_schema.desc_cluster_k8s.desc = "Kubernetes 服务发现。"
emqx_conf_schema.desc_cluster_k8s.label = "Kubernetes 服务发现"
emqx_conf_schema.desc_cluster_static.desc = "静态节点服务发现。新节点通过连接一个节点来加入集群。"
emqx_conf_schema.desc_cluster_static.label = "静态节点服务发现"
emqx_conf_schema.desc_console_handler.desc = "日志处理进程将日志事件打印到 EMQX 控制台。"
emqx_conf_schema.desc_console_handler.label = "控制台处理进程"
emqx_conf_schema.desc_db.desc = "内置数据库的配置。"
emqx_conf_schema.desc_db.label = "数据库"
emqx_conf_schema.desc_durable_timers.desc = "持久化定时器的配置。\n持久化定时器用于调度即使创建它们的节点关闭也应发生的动作。"
emqx_conf_schema.desc_durable_timers.label = "持久化定时器"
emqx_conf_schema.desc_log.desc = "EMQX 支持多个日志处理器，包括一个控制台处理器和多个文件处理器。\n默认情况下，EMQX 在 Docker 环境或控制台/前台模式下运行时会输出日志到控制台，\n否则会将日志输出到文件 `${EMQX_LOG_DIR}/emqx.log.N`。\n对于高级配置，您可以在此部分找到更多参数。"
emqx_conf_schema.desc_log.label = "日志"
emqx_conf_schema.desc_log_burst_limit.desc = "短时间内产生的大量日志事件可能会导致问题，例如：\n  - 日志文件变得非常大\n  - 日志文件轮换过快，有用信息被覆盖\n  - 对系统的整体性能影响\n\n日志突发限制功能可以暂时禁用日志记录以避免这些问题。"
emqx_conf_schema.desc_log_burst_limit.label = "日志突发限制"
emqx_conf_schema.desc_log_file_handler.desc = "日志处理进程将日志事件打印到文件。"
emqx_conf_schema.desc_log_file_handler.label = "文件日志处理进程"
emqx_conf_schema.desc_log_overload_kill.desc = "日志过载终止，具有过载保护功能。当日志处理进程使用过多内存，或者缓存的日志消息过多时该功能被激活。<br/>\n检测到过载时，日志处理进程将终止，并在冷却期后重新启动。"
emqx_conf_schema.desc_log_overload_kill.label = "日志过载保护"
emqx_conf_schema.desc_log_rotation.desc = "默认情况下，日志存储在 `./log` 目录（用于从 zip 文件安装）或 `/var/log/emqx`（用于二进制安装）。<br/>\n这部分配置，控制每个日志处理进程保留的文件数量。"
emqx_conf_schema.desc_log_rotation.label = "日志轮换"
emqx_conf_schema.desc_log_throttling.desc = "日志限流功能通过在配置的时间窗口内丢弃除第一个事件外的所有事件，来减少可能泛滥的日志事件数量。\n如果 `console` 或 `file` 日志级别设置为 debug，则自动禁用限流。"
emqx_conf_schema.desc_log_throttling.label = "日志限流"
emqx_conf_schema.desc_node.desc = "节点名称、Cookie、配置文件、数据目录和 Erlang 虚拟机（BEAM）启动参数。"
emqx_conf_schema.desc_node.label = "节点"
emqx_conf_schema.desc_rpc.desc = "EMQX 使用 <code>gen_rpc</code> 库来实现跨节点通信。<br/>\n大多数情况下，默认的配置应该可以工作，但如果你需要做一些性能优化或者实验，可以尝试调整这些参数。"
emqx_conf_schema.desc_rpc.label = "RPC"
emqx_conf_schema.dist_buffer_size.desc = "Erlang 分布式缓冲区的繁忙阈值，单位是 KB。"
emqx_conf_schema.dist_buffer_size.label = "Erlang 分布式缓冲区的繁忙阈值(KB)"
emqx_conf_schema.dist_connect_options.desc = "Erlang 分发端口的连接选项，用于性能调优。\n定义连接其他分布式 Erlang 节点时要使用的一组额外 socket 选项。\n参见 https://www.erlang.org/doc/apps/kernel/gen_tcp.html#connect/4"
emqx_conf_schema.dist_connect_options.label = "Erlang 分发端口连接选项"
emqx_conf_schema.dist_listen_options.desc = "Erlang 分发监听端口选项，用于性能调优。\n定义为分布式 Erlang 节点打开监听 socket 时要使用的一组额外 socket 选项。\n参见 https://www.erlang.org/doc/apps/kernel/gen_tcp.html#listen/2"
emqx_conf_schema.dist_listen_options.label = "Erlang 分发监听端口选项"
emqx_conf_schema.durable_timer_batch_size.desc = "指定用于读取 `timers` 持久存储的批处理大小。"
emqx_conf_schema.durable_timer_batch_size.label = "持久定时器批处理大小"
emqx_conf_schema.durable_timer_heartbeat_interval.desc = "节点心跳间隔指定节点在 `timers` 持久存储中记录其存在的频率。\n此设置应在集群中的所有节点上相同。"
emqx_conf_schema.durable_timer_heartbeat_interval.label = "心跳间隔"
emqx_conf_schema.durable_timer_missed_heartbeats.desc = "如果节点未能达到此数量的心跳，其对等节点将认为它已关闭。"
emqx_conf_schema.durable_timer_missed_heartbeats.label = "错过的心跳"
emqx_conf_schema.durable_timer_retry_interval.desc = "如果节点未能从持久存储中获取定时器，它将在此间隔后重试。"
emqx_conf_schema.durable_timer_retry_interval.label = "持久定时器重试间隔"
emqx_conf_schema.log_audit_handler.desc = "审计日志文件处理进程"
emqx_conf_schema.log_audit_handler.label = "审计日志处理进程"
emqx_conf_schema.log_burst_limit_enable.desc = "启用日志限流保护机制。"
emqx_conf_schema.log_burst_limit_enable.label = "日志限流保护"
emqx_conf_schema.log_burst_limit_max_count.desc = "在 `window_time` 间隔内处理的最大日志事件数。 达到限制后，将丢弃连续事件，直到 `window_time` 结束。"
emqx_conf_schema.log_burst_limit_max_count.label = "日志事件数"
emqx_conf_schema.log_burst_limit_window_time.desc = "参考 <code>max_count</code>。"
emqx_conf_schema.log_burst_limit_window_time.label = "窗口时间"
emqx_conf_schema.log_file_handler_file.desc = "日志文件路径及名字。"
emqx_conf_schema.log_file_handler_file.label = "日志文件名字"
emqx_conf_schema.log_file_handler_max_size.desc = "此参数控制日志文件轮换。 `infinity` 意味着日志文件将无限增长，否则日志文件将在达到 `max_size`（以字节为单位）时进行轮换。\n与 rotation count 配合使用。如果 counter 为 10，则是 10 个文件轮换。"
emqx_conf_schema.log_file_handler_max_size.label = "日志文件轮换大小"
emqx_conf_schema.log_file_handlers.desc = "输出到文件的日志处理进程列表"
emqx_conf_schema.log_file_handlers.label = "文件日志处理进程"
emqx_conf_schema.log_overload_kill_enable.desc = "日志处理进程过载时为保护自己节点其它的业务能正常，强制杀死日志处理进程。"
emqx_conf_schema.log_overload_kill_enable.label = "日志处理进程过载保护"
emqx_conf_schema.log_overload_kill_mem_size.desc = "日志处理进程允许使用的最大内存。"
emqx_conf_schema.log_overload_kill_mem_size.label = "日志处理进程允许使用的最大内存"
emqx_conf_schema.log_overload_kill_qlen.desc = "允许的最大队列长度。"
emqx_conf_schema.log_overload_kill_qlen.label = "最大队列长度"
emqx_conf_schema.log_overload_kill_restart_after.desc = "处理进程停止后，会在该延迟时间后自动重新启动。除非该值设置为 <code>infinity</code>，这会阻止任何后续的重启。"
emqx_conf_schema.log_overload_kill_restart_after.label = "处理进程重启延迟"
emqx_conf_schema.log_root.desc = "EMQX 支持两种主要的日志处理进程：file 和 console，另有一个专门设计用于始终将日志定向到文件的 audit 处理进程。\n系统的默认日志处理行为可以通过环境变量 `EMQX_DEFAULT_LOG_HANDLER` 配置，它接受以下设置：\n\n- file：将日志输出仅定向到文件。\n- console：将日志输出仅定向到控制台。\n\n值得注意的是，当通过 systemd 的 emqx.service 文件启动 EMQX 时，EMQX_DEFAULT_LOG_HANDLER 被设置为 file。\n在 systemd 启动之外的场景中，console 作为默认的日志处理进程。"
emqx_conf_schema.log_root.label = "日志"
emqx_conf_schema.log_rotation_count.desc = "轮换的最大日志文件数。"
emqx_conf_schema.log_rotation_count.label = "最大日志文件数"
emqx_conf_schema.log_rotation_enable.desc = "启用日志轮换功能。启动后生成日志文件后缀会加上对应的索引数字，比如：log/emqx.log.1。\n系统会默认生成<code>*.siz/*.idx</code>用于记录日志位置，请不要手动修改这两个文件。"
emqx_conf_schema.log_rotation_enable.label = "日志轮换"
emqx_conf_schema.log_throttling.desc = "日志限流配置。"
emqx_conf_schema.log_throttling.label = "日志限流"
emqx_conf_schema.log_throttling_time_window.desc = "此配置设置控制限流消息的日志记录行为，包括但不限于像 'authorization_permission_denied' 这样的消息。\n在每个定义的时间窗口内，只有一个限流消息的实例会被记录，以防止日志泛滥。\n在每个时间窗口结束时，将生成一个摘要日志，详细说明该期间内任何限流消息的发生。\n重要的是，此设置的最短有效时间窗口为 1 秒（1s）。\n如果指定的值低于 1s，则会自动调整为 1s。"
emqx_conf_schema.log_throttling_time_window.label = "日志限流时间窗口"
emqx_conf_schema.max_ets_tables.desc = "Erlang ETS 表的最大数量"
emqx_conf_schema.max_ets_tables.label = "Erlang 表的最大数量"
emqx_conf_schema.max_ports.desc = "转换为 Erlang VM 的 `+Q` 标志。\n指定此 Erlang 系统允许同时打开的最大端口数（文件、socket 等）。\n\n当设置为 `auto`（默认）时，EMQX 会根据可用逻辑 CPU 数自动调整限制，每个核心 65536 个端口，最多 8 核；超过 8 核的主机将回退到固定的 1048576 端口限制。\n\n注意：运行时选择的实际限制可能大于此处配置的数值。\n在大多数情况下，为了提高内部效率，VM 会将该值向上取整为下一个 2 的幂。\n\nEMQX 会自动将 Erlang 进程限制（`+P` 标志）设置为该值的 2 倍，因此用户只需配置 `max_ports`。2 倍比例可满足 TLS/QUIC 连接的需求，因为每个连接使用两个 Erlang 进程。\n对应的 `+P` 标志用于控制 Erlang 进程的最大数量。\n\n可以从控制台节点监控标签页中观察到有效值。"
emqx_conf_schema.max_ports.label = "Erlang 端口和进程限制"
emqx_conf_schema.node_applications.desc = "当新 EMQX 加入集群时，应重启的 Erlang 应用程序的列表。"
emqx_conf_schema.node_applications.label = "应用"
emqx_conf_schema.node_backtrace_depth.desc = "错误信息中打印的最大堆栈层数"
emqx_conf_schema.node_backtrace_depth.label = "最大堆栈导数"
emqx_conf_schema.node_broker_pool_size.desc = "emqx_broker 池中的工作进程数量。增加此值可能会因增强并行性而提高性能\n， 尤其在 EMQX 集群的互连网络延迟较高时。\n默认值为 Erlang 调度程序的数量（CPU 核心数）* 2。"
emqx_conf_schema.node_broker_pool_size.label = "节点 Broker 池大小"
emqx_conf_schema.node_channel_cleanup_batch_size.desc = "通道清理批处理的大小。 如果 EMQX 集群互连网络延迟较高，\n减小此值以及增加 node.generic_pool_size\n可能会在大量客户端突然断开连接时提高性能。\n默认值为 100000。"
emqx_conf_schema.node_channel_cleanup_batch_size.label = "节点通道清理批处理大小"
emqx_conf_schema.node_cookie.desc = "分布式 Erlang 集群使用的 cookie 值。集群间保持一致"
emqx_conf_schema.node_cookie.label = "节点 Cookie"
emqx_conf_schema.node_crash_dump_bytes.desc = "限制崩溃文件的大小，当崩溃时节点内存太大，\n如果为了保存现场，需要全部存到崩溃文件中，此处限制最多能保存多大的文件。\n如果超过此限制，崩溃转储将被截断。如果设置为 0，系统不会尝试写入崩溃转储文件。"
emqx_conf_schema.node_crash_dump_bytes.label = "崩溃文件最大大小"
emqx_conf_schema.node_crash_dump_file.desc = "设置 Erlang crash_dump 文件的存储路径和文件名。默认为 <code>log/erl_crash.YYYY.MM.DD.HH.MM.SS.dump</code>。\n时间戳是在 EMQX 启动时生成的。"
emqx_conf_schema.node_crash_dump_file.label = "节点崩溃时的 Dump 文件"
emqx_conf_schema.node_crash_dump_seconds.desc = "该配置给出了运行时系统允许花费的写入崩溃转储的秒数。当给定的秒数已经过去，运行时系统将被终止。<br/>\n- 如果设置为 0 秒，运行时会立即终止，不会尝试写入崩溃转储文件。<br/>\n- 如果设置为一个正数 S，节点会等待 S 秒来完成崩溃转储文件，然后用 SIGALRM 信号终止运行时系统。<br/>\n- 如果设置为一个负值导致运行时系统的终止等待无限期地直到崩溃转储文件已经完全写入。"
emqx_conf_schema.node_crash_dump_seconds.label = "保存崩溃文件最长时间"
emqx_conf_schema.node_data_dir.desc = "节点数据存放目录，可能会自动创建的子目录如下：<br/>\n- `mnesia/<node_name>`。EMQX 的内置数据库目录。例如，`mnesia/emqx@127.0.0.1`。<br/>\n如果节点要被重新命名（例如，`emqx@10.0.1.1`）。旧目录应该首先被删除。<br/>\n- `configs`。在启动时生成的配置，以及集群/本地覆盖的配置。<br/>\n- `patches`: 热补丁文件将被放在这里。<br/>\n- `trace`: 日志跟踪文件。<br/>\n\n**注意**: 一个数据 dir 不能被两个或更多的 EMQX 节点同时使用。"
emqx_conf_schema.node_data_dir.label = "节点数据目录"
emqx_conf_schema.node_dist_bind_address.desc = "指定用于 Erlang 分布式通信的 IP 地址。\n这应为 IP 地址（例如 IPv4 的 \"192.168.1.100\" 或 IPv6 的 \"::1\"）。\n设置后，Erlang 分布式通信将绑定到指定的 IP 地址。\n注意：如果使用 IPv6 地址，必须将 <code>cluster.proto_dist</code> 设置为 <code>inet6_tcp</code>。"
emqx_conf_schema.node_dist_bind_address.label = "分布式绑定地址"
emqx_conf_schema.node_dist_net_ticktime.desc = "系统调优参数，此配置将覆盖 vm.args 文件里的 -kernel net_ticktime 参数。当一个节点持续无响应多久之后，认为其已经宕机并断开连接。"
emqx_conf_schema.node_dist_net_ticktime.label = "节点间心跳间隔"
emqx_conf_schema.node_etc_dir.desc = "<code>etc</code> 存放目录"
emqx_conf_schema.node_etc_dir.label = "Etc 目录"
emqx_conf_schema.node_generic_pool_size.desc = "emqx_pool 中的工作进程数。增加此值可能会通过增强并行性提高性能，\n特别是当 EMQX 集群互连网络延迟较高时。\n默认值为 Erlang 调度器（CPU 核心数）的数量。"
emqx_conf_schema.node_generic_pool_size.label = "节点通用池大小"
emqx_conf_schema.node_global_gc_interval.desc = "全局垃圾回收的周期性执行间隔。设置为 <code>disabled</code> 可禁用此功能。<br/>仅当 EMQX 的内存使用持续增长且明显超过正常水平，并且手动触发垃圾回收确实能释放大量内存时，才建议使用此功能作为临时解决方案。"
emqx_conf_schema.node_global_gc_interval.label = "全局垃圾回收"
emqx_conf_schema.node_name.desc = "节点名。格式为 \\<name>@\\<host>。其中 <host> 可以是 IP 地址，也可以是 FQDN。\n详见 http://erlang.org/doc/reference_manual/distributed.html。"
emqx_conf_schema.node_name.label = "节点名"
emqx_conf_schema.node_tls_server_session_ticket_lifetime.desc = "服务器发送的会话票据的生命周期，以秒为单位。服务器不得使用超过 604800 秒（7 天）的值。默认值为 7200 秒（2 小时）。"
emqx_conf_schema.node_tls_server_session_ticket_lifetime.label = "TLS 服务器会话票据生命周期"
emqx_conf_schema.node_tls_server_session_tickets_amount.desc = "在成功握手或恢复后，服务器发送的会话票据数量。必须大于 0。默认值为 1。\n\nEMQX 仅支持无状态会话票据。配置较大的数量会增加资源使用，尤其是在监听器 SSL 选项中启用 <code>stateless_with_cert</code> 时，会增加网络带宽使用，因为每个票据都包含证书信息。"
emqx_conf_schema.node_tls_server_session_tickets_amount.label = "TLS 服务器会话票据数量"
emqx_conf_schema.node_tls_stateless_tickets_seed.desc = "用于生成 TLS 1.3 无状态会话票据的密钥种子。必须是长度不少于 16 字节的字符串。\n\n如果设置为空字符串（默认），无论监听器 SSL 选项中的 <code>session_tickets</code> 设置如何，都不会生成会话票据。\n\n重要提示：\n\n- 此配置无法在运行时更改。更改后需要重启节点以使配置生效。\n- 集群中的所有节点必须配置相同的密钥，以确保会话票据在集群中正常工作。\n- 该密钥应保持机密和安全，因为它用于加密会话票据。"
emqx_conf_schema.node_tls_stateless_tickets_seed.label = "TLS 无状态票据种子"
emqx_conf_schema.process_limit.desc = "覆盖 Erlang `+P`（最大进程数）标志。\n默认情况下，EMQX 会从 `max_ports`（2 倍）推导此值，适用于绝大多数工作负载。仅当该设置严格大于推导值时才会生效；较小的值会被忽略，以确保进程表不会小于端口表。"
emqx_conf_schema.process_limit.label = "Erlang 进程限制"
emqx_conf_schema.rpc_async_batch_size.desc = "异步模式下，发送的批量消息的最大数量。"
emqx_conf_schema.rpc_async_batch_size.label = "异步模式下的批量消息数量"
emqx_conf_schema.rpc_authentication_timeout.desc = "远程节点认证的超时时间。"
emqx_conf_schema.rpc_authentication_timeout.label = "RPC 认证超时时间"
emqx_conf_schema.rpc_cacertfile.desc = "验证 <code>rpc.certfile</code> 的 CA 证书文件的路径。<br/>\n注意：集群中所有节点的证书必须使用同一个 CA 签发。"
emqx_conf_schema.rpc_cacertfile.label = "RPC CA 证书文件"
emqx_conf_schema.rpc_call_receive_timeout.desc = "同步 RPC 的回复超时时间。"
emqx_conf_schema.rpc_call_receive_timeout.label = "RPC 调用接收超时时间"
emqx_conf_schema.rpc_certfile.desc = "TLS 证书文件的路径，用于验证集群节点的身份。\n只有当 <code>rpc.driver</code> 设置为 <code>ssl</code> 时，此配置才会生效。"
emqx_conf_schema.rpc_certfile.label = "RPC 证书文件"
emqx_conf_schema.rpc_client_num.desc = "设置该节点与每个远程节点之间发起的最大 RPC 通信通道数量。"
emqx_conf_schema.rpc_client_num.label = "RPC TCP 客户端数量"
emqx_conf_schema.rpc_connect_timeout.desc = "建立 RPC 连接的超时时间。"
emqx_conf_schema.rpc_connect_timeout.label = "RPC 连接超时时间"
emqx_conf_schema.rpc_driver.desc = "集群间通信使用的传输协议。"
emqx_conf_schema.rpc_driver.label = "RPC 驱动"
emqx_conf_schema.rpc_insecure_fallback.desc = "兼容旧的无鉴权模式"
emqx_conf_schema.rpc_insecure_fallback.label = "向后兼容旧的无鉴权模式"
emqx_conf_schema.rpc_ipv6_only.desc = "此设置仅在 <code>rpc.listen_address</code> 被分配了一个 IPv6 地址时有效。\n如果设置为 <code>true</code>，RPC 客户端将仅使用 IPv6 进行连接。\n否则，即使服务器位于 IPv6 上，客户端也可能选择 IPv4。"
emqx_conf_schema.rpc_ipv6_only.label = "仅使用 IPv6"
emqx_conf_schema.rpc_keyfile.desc = "<code>rpc.certfile</code> 的私钥文件的路径。<br/>\n注意：此文件内容是私钥，所以需要设置权限为 600。"
emqx_conf_schema.rpc_keyfile.label = "RPC 私钥文件"
emqx_conf_schema.rpc_listen_address.desc = "指示 RPC 服务器监听的 IP 地址。例如，使用 <code>\"0.0.0.0\"</code> 表示 IPv4 或 <code>\"::\"</code> 表示 IPv6。"
emqx_conf_schema.rpc_listen_address.label = "RPC 监听 IP 地址"
emqx_conf_schema.rpc_mode.desc = "在 <code>sync</code> 模式下，发送端等待接收端的 ack 信号。"
emqx_conf_schema.rpc_mode.label = "RPC 模式"
emqx_conf_schema.rpc_port_discovery.desc = "<code>manual</code>: 通过 <code>server_port</code> 来发现端口。\n<br/><code>stateless</code>: 使用无状态的方式来发现端口，使用如下算法。如果节点名称是 <code>\nemqxN@127.0.0.1</code>, N 是一个数字，那么监听端口就是 5370 + N。\n注意：当 port_discovery 设置为 manual 时，server_port 配置将不起作用。"
emqx_conf_schema.rpc_port_discovery.label = "RPC 端口发现策略"
emqx_conf_schema.rpc_send_timeout.desc = "发送 RPC 请求的超时时间。"
emqx_conf_schema.rpc_send_timeout.label = "RPC 发送超时时间"
emqx_conf_schema.rpc_server_port.desc = "RPC 本地服务使用的监听端口。<br/>\n请注意，此配置仅在 rpc.port_discovery 设置为手动时生效。"
emqx_conf_schema.rpc_server_port.label = "RPC 服务器端口"
emqx_conf_schema.rpc_socket_buffer.desc = "TCP 调节参数。用户模式套接字缓冲区大小。"
emqx_conf_schema.rpc_socket_buffer.label = "RPC 套接字缓冲区大小"
emqx_conf_schema.rpc_socket_keepalive_count.desc = "对应 TCP_KEEPCNT socket 选项。指定在放弃连接并终止连接之前发送的最大 TCP keepalive 探测次数，如果未从另一端收到响应，则终止连接。"
emqx_conf_schema.rpc_socket_keepalive_count.label = "RPC Socket Keepalive 次数"
emqx_conf_schema.rpc_socket_keepalive_idle.desc = "对应 TCP_KEEPIDLE socket 选项。指定在 TCP 开始发送 keepalive 探测包之前，连接需要保持空闲的时间（以秒为单位）。"
emqx_conf_schema.rpc_socket_keepalive_idle.label = "RPC Socket Keepalive 空闲时间"
emqx_conf_schema.rpc_socket_keepalive_interval.desc = "对应 TCP_KEEPINTVL socket 选项。指每次 keepalive 探测之间的时间间隔（以秒为单位）。"
emqx_conf_schema.rpc_socket_keepalive_interval.label = "RPC Socket Keepalive 间隔"
emqx_conf_schema.rpc_socket_recbuf.desc = "TCP 调节参数。TCP 接收缓冲区大小。"
emqx_conf_schema.rpc_socket_recbuf.label = "RPC 套接字接收缓冲区大小"
emqx_conf_schema.rpc_socket_sndbuf.desc = "TCP 调节参数。TCP 发送缓冲区大小。"
emqx_conf_schema.rpc_socket_sndbuf.label = "RPC 套接字发送缓冲区大小"
emqx_conf_schema.schedulers.desc = "转换为 Erlang VM 的 `+S` 标志，同时设置总调度器数和在线调度器数。\n\n当设置为 `auto`（默认）时，EMQX 使用实际可供 VM 使用的逻辑处理器数量（Linux 上为 `sched_getaffinity`），因此使用 `--cpuset-cpus` 或 k8s CPU 请求限制的容器不会生成无法并行运行的调度器 OS 线程。\n\n设置为正整数可覆盖自动检测值。\n当你希望为同一主机上的非 EMQX 工作预留 CPU 余量，或将调度器数量限制在可用 CPU 数以下时，该设置很有用。"
emqx_conf_schema.schedulers.label = "Erlang 调度器"
emqx_conf_schema_types.bytesize.desc = "表示字节数量的字符串，例如：<code>10B</code>、<code>640kb</code>、<code>4MB</code>、<code>1GB</code>。单位采用二进制标准，即 1MB 等于 1024KB。单位不区分大小写，例如 1kb 等于 1KB。"
emqx_conf_schema_types.duration.desc = "表示时间持续的字符串，例如：<code>10s</code>、<code>2.5m</code>、<code>1h30m</code>、<code>1W2D</code> 或 <code>2345ms</code>，其中 <code>ms</code> 是最小单位。每个配置项都有其自己的最小精度。设置值中超过精度的部分将被忽略。\n\n例如，如果一个类型为 <code>Duration(s)</code> 的配置项被设置为 <code>1200ms</code>，则最终有效值将是 <code>1s</code> 而不是 <code>1.2s</code>。\n\nDuration 等同于 Duration(ms)。单位部分不区分大小写。"
emqx_conf_schema_types.secret.desc = "包含一些敏感信息的字符串，例如密码。当密钥以 <code>file://</code> 开头时，字符串的其余部分将被解释为包含密钥本身的文件路径：文件的整个内容（除了任何尾随的空白字符）都被视为密钥值。注意：在集群中，所有 EMQX 节点在使用 <code>file://</code> 密钥之前应该具有相同的文件。"
emqx_conf_schema_types.template.desc = "用于`${.path.to.var}`样式值插值的字符串，其中开头的点是可选的。语法`${.}`表示取值整个对象（包含所有字段）。"
emqx_connector_aggregator_schema.container.desc = "设置包含聚合事件的上传文件格式的配置。"
emqx_connector_aggregator_schema.container.label = "聚合事件容器"
emqx_connector_aggregator_schema.container_csv.desc = "记录（事件）将被聚合并作为 CSV 文件上传。"
emqx_connector_aggregator_schema.container_csv.label = "CSV 容器"
emqx_connector_aggregator_schema.container_csv_column_order.desc = "事件字段将在生成的 CSV 文件中按此顺序排列为列。<br/>\n无论此设置如何，生成的 CSV 都将包含所有聚合事件的字段，但所有未在此明确提及的列将在此处列出的列之后按字典顺序排列。"
emqx_connector_aggregator_schema.container_csv_column_order.label = "CSV 列顺序"
emqx_connector_aggregator_schema.container_json_lines.desc = "记录（事件）将被聚合并且作为 [JSON Lines](https://jsonlines.org/) 文件上传。"
emqx_connector_aggregator_schema.container_json_lines.label = "JSON Lines 容器"
emqx_connector_aggregator_schema.container_parquet.desc = "使用 [Parquet](https://parquet.apache.org/docs/) 编码数据文件。"
emqx_connector_aggregator_schema.container_parquet.label = "Parquet 数据文件"
emqx_connector_aggregator_schema.container_parquet_max_row_group_bytes.desc = "行组刷新时的大小。行组刷新的实际触发使用缓冲数据大小的估计，因为实际输出可能与原始输入数据大小不同。"
emqx_connector_aggregator_schema.container_parquet_max_row_group_bytes.label = "Parquet 最大行组字节数"
emqx_connector_aggregator_schema.parquet_default_compression.desc = "用于压缩 Parquet 行组中的数据页的默认算法。"
emqx_connector_aggregator_schema.parquet_default_compression.label = "Parquet 默认压缩"
emqx_connector_aggregator_schema.parquet_schema.desc = "用于 Parquet 文件的 Schema，采用 Avro 格式。"
emqx_connector_aggregator_schema.parquet_schema.label = "Parquet Schema (Avro)"
emqx_connector_aggregator_schema.parquet_schema_avro_inline.desc = "内联定义的 Avro Schema。"
emqx_connector_aggregator_schema.parquet_schema_avro_inline.label = "内联"
emqx_connector_aggregator_schema.parquet_schema_avro_inline_def.desc = "JSON 格式的 Avro Schema 定义。"
emqx_connector_aggregator_schema.parquet_schema_avro_inline_def.label = "Schema 定义"
emqx_connector_aggregator_schema.parquet_schema_avro_inline_type.desc = "内联定义的 Avro Schema。"
emqx_connector_aggregator_schema.parquet_schema_avro_inline_type.label = "类型"
emqx_connector_aggregator_schema.parquet_schema_avro_ref.desc = "存储在 Schema Registry 中的 Avro Schema。"
emqx_connector_aggregator_schema.parquet_schema_avro_ref.label = "Schema Registry 引用"
emqx_connector_aggregator_schema.parquet_schema_avro_ref_name.desc = "存储在 Schema Registry 中的 Avro Schema 名称。"
emqx_connector_aggregator_schema.parquet_schema_avro_ref_name.label = "Schema 名称"
emqx_connector_aggregator_schema.parquet_schema_avro_ref_type.desc = "存储在 Schema Registry 中的 Avro Schema。"
emqx_connector_aggregator_schema.parquet_schema_avro_ref_type.label = "类型"
emqx_connector_api.cannot_delete_connector_with_active_rules.desc = "无法删除连接器，因为该连接器定义了活动规则。"
emqx_connector_api.cannot_delete_connector_with_active_rules.label = "无法删除具有活动规则的连接器"
emqx_connector_api.connector_already_exists.desc = "连接器已存在。"
emqx_connector_api.connector_already_exists.label = "连接器已存在"
emqx_connector_api.connector_not_found.desc = "未找到连接器。"
emqx_connector_api.connector_not_found.label = "未找到连接器"
emqx_connector_api.connector_not_found_or_invalid_operation.desc = "未找到连接器或无效操作。"
emqx_connector_api.connector_not_found_or_invalid_operation.label = "未找到连接器或无效操作"
emqx_connector_api.connector_or_node_not_found.desc = "未找到连接器或节点或无效操作。"
emqx_connector_api.connector_or_node_not_found.label = "未找到连接器或节点"
emqx_connector_api.connector_test_failed.desc = "连接器测试失败。"
emqx_connector_api.connector_test_failed.label = "连接器测试失败"
emqx_connector_api.desc_api1.desc = "列出所有创建的连接器。"
emqx_connector_api.desc_api1.label = "列出所有连接器"
emqx_connector_api.desc_api2.desc = "通过类型和名称创建一个新的连接器。"
emqx_connector_api.desc_api2.label = "创建连接器"
emqx_connector_api.desc_api3.desc = "通过 id 获取一个连接器。"
emqx_connector_api.desc_api3.label = "获取连接器"
emqx_connector_api.desc_api4.desc = "通过 id 更新一个连接器。"
emqx_connector_api.desc_api4.label = "更新连接器"
emqx_connector_api.desc_api5.desc = "通过 id 删除一个连接器。"
emqx_connector_api.desc_api5.label = "删除连接器"
emqx_connector_api.desc_api7.desc = "在集群的所有节点上启动连接器。"
emqx_connector_api.desc_api7.label = "集群连接器操作"
emqx_connector_api.desc_api8.desc = "在特定节点上启动连接器。"
emqx_connector_api.desc_api8.label = "节点连接器操作"
emqx_connector_api.desc_api9.desc = "测试创建一个新的连接器。"
emqx_connector_api.desc_api9.label = "测试连接器创建"
emqx_connector_api.desc_enable_connector.desc = "在集群的所有节点上启用或禁用连接器。"
emqx_connector_api.desc_enable_connector.label = "集群连接器启用"
emqx_connector_api.desc_param_path_enable.desc = "是否启用此连接器。"
emqx_connector_api.desc_param_path_enable.label = "启用连接器"
emqx_connector_api.desc_param_path_id.desc = "连接器 id。必须是 {type}:{name} 的格式。"
emqx_connector_api.desc_param_path_id.label = "连接器 ID"
emqx_connector_api.desc_param_path_node.desc = "节点名称，例如 'emqx@127.0.0.1'。"
emqx_connector_api.desc_param_path_node.label = "节点名称"
emqx_connector_api.desc_param_path_operation_cluster.desc = "集群可用操作：'start'。"
emqx_connector_api.desc_param_path_operation_cluster.label = "集群操作"
emqx_connector_api.desc_param_path_operation_on_node.desc = "节点可用操作：'start'。"
emqx_connector_api.desc_param_path_operation_on_node.label = "节点操作"
emqx_connector_api.not_implemented.desc = "未实现。"
emqx_connector_api.not_implemented.label = "未实现"
emqx_connector_api.problem_with_external_service.desc = "外部服务配置问题。"
emqx_connector_api.problem_with_external_service.label = "外部服务问题"
emqx_connector_api.problem_with_external_service_or_not_enabled.desc = "外部服务配置问题或连接器未启用。"
emqx_connector_api.problem_with_external_service_or_not_enabled.label = "外部服务问题或未启用"
emqx_connector_api.service_unavailable.desc = "服务不可用。"
emqx_connector_api.service_unavailable.label = "服务不可用"
emqx_connector_api.update_connector_failed.desc = "更新连接器失败。"
emqx_connector_api.update_connector_failed.label = "更新连接器失败"
emqx_connector_schema.config_enable.desc = "启用 (是) 或 停用 (否) 该连接器。"
emqx_connector_schema.config_enable.label = "启用或停用"
emqx_connector_schema.connector_actions.desc = "添加到该连接器的动作列表。"
emqx_connector_schema.connector_actions.label = "动作"
emqx_connector_schema.connector_field.desc = "由动作指定的连接器名称，用于选择外部资源。"
emqx_connector_schema.connector_field.label = "连接器"
emqx_connector_schema.desc_connectors.desc = "用于连接到外部系统的连接器。"
emqx_connector_schema.desc_connectors.label = "连接器"
emqx_connector_schema.desc_name.desc = "连接器的名称"
emqx_connector_schema.desc_name.label = "连接器名称"
emqx_connector_schema.desc_node_name.desc = "节点的名称"
emqx_connector_schema.desc_node_name.label = "节点名"
emqx_connector_schema.desc_node_status.desc = "节点的状态"
emqx_connector_schema.desc_node_status.label = "节点状态"
emqx_connector_schema.desc_status.desc = "连接器的状态<br/>\n- <code>正在连接</code>: 在进行任何健康检查之前的初始状态。<br/>\n- <code>已连接</code>: 当连接器通过健康检查时的状态。<br/>\n- <code>已断开</code>: 当连接器无法通过健康检查时的状态。<br/>\n- <code>不一致</code>: 集群节点之间的连接器状态不一致。"
emqx_connector_schema.desc_status.label = "连接器状态"
emqx_connector_schema.desc_status_reason.desc = "这是连接器连接失败时给出的原因。"
emqx_connector_schema.desc_status_reason.label = "失败原因"
emqx_connector_schema.desc_type.desc = "连接器的类型。"
emqx_connector_schema.desc_type.label = "连接器类型"
emqx_connector_schema.ehttpc_max_inactive.desc = "HTTP 驱动程序在没有任何活动的情况下等待重新连接的最长时间。"
emqx_connector_schema.ehttpc_max_inactive.label = "最大无活动时间"
emqx_connector_schema_lib.auto_reconnect.desc = "已弃用。自动重连数据库。"
emqx_connector_schema_lib.auto_reconnect.label = "已弃用。自动重连数据库"
emqx_connector_schema_lib.connect_timeout.desc = "连接数据库的超时时间。"
emqx_connector_schema_lib.connect_timeout.label = "连接超时"
emqx_connector_schema_lib.database_desc.desc = "数据库名字。"
emqx_connector_schema_lib.database_desc.label = "数据库名字"
emqx_connector_schema_lib.disable_prepared_statements.desc = "禁用在连接中使用预处理语句。\n一些端点（如 Transaction 模式下的 PGBouncer 或 Supabase）不支持诸如预处理语句之类的会话特性。对于此类连接，应启用此选项。"
emqx_connector_schema_lib.disable_prepared_statements.label = "禁用预处理语句"
emqx_connector_schema_lib.password.desc = "与桥接关联的密码，用于与外部数据库认证。<br/>\n如需从文件加载密码而不是内联写入，请使用 <code>file://&lt;path-to-file&gt;</code> 形式；文件内容（去除末尾空白）将作为密码使用。集群模式下，该文件必须存在于所有 EMQX 节点。"
emqx_connector_schema_lib.password.label = "密码"
emqx_connector_schema_lib.pool_size.desc = "桥接远端服务时使用的连接池大小。"
emqx_connector_schema_lib.pool_size.label = "连接池大小"
emqx_connector_schema_lib.prepare_statement.desc = "SQL 预处理语句列表。"
