emqx_bridge_quasardb_connector_schema.config_connector.label = "QuasarDB 连接器配置"
emqx_bridge_quasardb_connector_schema.connect_timeout.desc = "与服务器建立连接的超时时间。"
emqx_bridge_quasardb_connector_schema.connect_timeout.label = "连接超时"
emqx_bridge_quasardb_connector_schema.dsn.desc = "ODBC 数据源名称，通常定义在 `/etc/odbc.ini`。"
emqx_bridge_quasardb_connector_schema.dsn.label = "ODBC 数据源名称"
