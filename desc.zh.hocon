emqx_lwm2m_api.name.desc = "资源名称"
emqx_lwm2m_api.no_content.desc = "无内容"
emqx_lwm2m_api.no_content.label = "无内容"
emqx_lwm2m_api.observe_resource.desc = "Observe/Un-Observe 指定资源"
emqx_lwm2m_api.observe_resource.label = "观察资源"
emqx_lwm2m_api.operations.desc = "资源可用操作列表"
emqx_lwm2m_api.path.desc = "资源路径"
emqx_lwm2m_api.read_resource.desc = "发送读指令到某资源"
emqx_lwm2m_api.read_resource.label = "读取资源"
emqx_lwm2m_api.write_resource.desc = "发送写指令到某资源"
emqx_lwm2m_api.write_resource.label = "写入资源"
emqx_lwm2m_schema.lwm2m.desc = "LwM2M 网关设置（v1.0.1）。\n先使用默认值，再调整 lifetime 和主题映射。"
emqx_lwm2m_schema.lwm2m_auto_observe.desc = "从 REGISTER 对象列表自动创建 Observe 订阅。\n支持的值：<br/>\n  - false / \"off\"：禁用自动 observe<br/>\n  - true / \"on\"：observe REGISTER 对象列表中的所有路径<br/>\n  - \"/3/0,/3/0/1\" 或 [\"/3/0\", \"/3/0/1\"]：仅 observe 指定路径"
emqx_lwm2m_schema.lwm2m_blockwise.desc = "大负载传输设置。\n分块传输将一个大负载拆分为更小的 CoAP 块。\n除非遇到负载大小或丢包问题，否则使用默认值即可。"
emqx_lwm2m_schema.lwm2m_blockwise_enable.desc = "启用大负载的分块传输。\n除非所有负载都很小且固定，否则保持启用。"
emqx_lwm2m_schema.lwm2m_blockwise_exchange_lifetime.desc = "临时分块状态的保留时长。\n过短可能导致慢速传输中断；过长会占用更多内存。"
emqx_lwm2m_schema.lwm2m_blockwise_max_block_size.desc = "每个 CoAP 块的大小（字节）。\n较大的值：更少的数据包，但丢包时重传代价更高。\n较小的值：更多的数据包，但丢包影响更小。"
emqx_lwm2m_schema.lwm2m_blockwise_max_body_size.desc = "重组后的最终负载最大大小。\n超过此大小的消息将被拒绝以保护内存。"
emqx_lwm2m_schema.lwm2m_coap_max_block_size.desc = "自 6.1.0 起已弃用。请使用 `blockwise.max_block_size` 代替。"
emqx_lwm2m_schema.lwm2m_lifetime_max.desc = "网关接受的客户端 lifetime 上限。\n用于防止设备设置过长的保活间隔。"
emqx_lwm2m_schema.lwm2m_lifetime_min.desc = "网关接受的客户端 lifetime 下限。\n用于防止设备产生过于频繁的更新流量。"
emqx_lwm2m_schema.lwm2m_qmode_time_window.desc = "在 QMode 下，这是 UPDATE 之后的“链路仍有效”窗口。\n窗口内：直接发送消息。\n窗口外：将消息缓存在内存中，直到客户端可达。"
emqx_lwm2m_schema.lwm2m_translators.desc = "LwM2M 事件与 MQTT 命令之间的主题映射。"
emqx_lwm2m_schema.lwm2m_translators_command.desc = "发送下行命令到 LwM2M 客户端的 MQTT 主题。\n方向：MQTT -> LwM2M 设备。"
emqx_lwm2m_schema.lwm2m_translators_notify.desc = "发布来自 LwM2M 客户端的 NOTIFY 事件的 MQTT 主题。\n方向：LwM2M 设备 -> MQTT。"
emqx_lwm2m_schema.lwm2m_translators_register.desc = "发布 REGISTER 事件的 MQTT 主题。\n方向：LwM2M 设备 -> MQTT。"
emqx_lwm2m_schema.lwm2m_translators_response.desc = "发布命令响应/ACK 事件的 MQTT 主题。\n方向：LwM2M 设备 -> MQTT。"
emqx_lwm2m_schema.lwm2m_translators_update.desc = "发布 UPDATE 事件的 MQTT 主题。\n方向：LwM2M 设备 -> MQTT。"
emqx_lwm2m_schema.lwm2m_update_msg_publish_condition.desc = "何时发布 UPDATE 事件。<br/>\n  - always：发布每个 UPDATE 请求<br/>\n  - contains_object_list：仅当 UPDATE 包含 Object 列表时发布<br/>\n使用 <code>contains_object_list</code> 可以减少无意义的更新事件。"
emqx_lwm2m_schema.lwm2m_xml_dir.desc = "LwM2M 资源定义 XML 文件的目录。\n请设置为本地 XML 目录（必需）。"
emqx_lwm2m_schema.translator.desc = "一个主题映射项（主题 + QoS），对应一种事件类型。"
emqx_lwm2m_schema.translator_qos.desc = "发布此事件主题时使用的 QoS。"
emqx_lwm2m_schema.translator_topic.desc = "MQTT 主题名称/模板。"
