emqx_bridge_bigtable_action_schema.row_key.label = "行键"
emqx_bridge_bigtable_action_schema.set_cell_column_qualifier.desc = "包含变更列限定符的键名。请确保在规则 SQL 中显式写出（例如：`SELECT x as key_name, ...`）。"
