emqx_bridge_rabbitmq_connector_schema.port.desc = "RabbitMQ 服务器监听的端口号（默认为 5672）。"
emqx_bridge_rabbitmq_connector_schema.port.label = "端口"
emqx_bridge_rabbitmq_connector_schema.publish_confirmation_timeout.desc = "使用发布者确认时，等待 RabbitMQ 确认消息发布的超时时间。"
emqx_bridge_rabbitmq_connector_schema.publish_confirmation_timeout.label = "发布确认超时时间"
emqx_bridge_rabbitmq_connector_schema.routing_key.desc = "用于将消息路由到 RabbitMQ 交换机中正确队列的路由键。支持使用模版，（例如：`k-${payload.r}`）。"
