emqx_bridge_iotdb.desc_config_post.desc = "创建 IoTDB 配置。"
emqx_bridge_iotdb.desc_config_put.desc = "更新 IoTDB 配置。"
emqx_bridge_iotdb.desc_name.desc = "IoTDB 数据桥接名称。"
emqx_bridge_iotdb.desc_name.label = "桥接名称"
emqx_bridge_iotdb_connector.auth_basic.desc = "基本认证的参数。"
emqx_bridge_iotdb_connector.auth_basic.label = "基本认证参数"
emqx_bridge_iotdb_connector.config_auth_password.desc = "在 IoTDB/Thrift REST 接口中配置的密码。"
emqx_bridge_iotdb_connector.config_auth_password.label = "认证密码"
emqx_bridge_iotdb_connector.config_auth_username.desc = "在 IoTDB REST/Thrift 接口中配置的用户名。"
emqx_bridge_iotdb_connector.config_auth_username.label = "认证用户名"
emqx_bridge_iotdb_connector.config_authentication.desc = "认证配置"
emqx_bridge_iotdb_connector.config_authentication.label = "认证"
emqx_bridge_iotdb_connector.config_base_url.desc = "外部 IoTDB 服务的 REST 接口的基础 URL。"
emqx_bridge_iotdb_connector.config_base_url.label = "服务器地址"
emqx_bridge_iotdb_connector.config_database.desc = "要连接的 IoTDB 数据库名称。"
emqx_bridge_iotdb_connector.config_database.label = "数据库"
emqx_bridge_iotdb_connector.config_driver.desc = "IoTDB 连接器使用的驱动程序，可以是：\n- rest\n- thrift"
emqx_bridge_iotdb_connector.config_max_retries.desc = "当 HTTP 请求失败时的最大重试次数。"
emqx_bridge_iotdb_connector.config_max_retries.label = "HTTP 请求最大重试次数"
emqx_bridge_iotdb_connector.config_protocol_version.desc = "IoTDB Thrift 协议的版本。"
emqx_bridge_iotdb_connector.config_sql_dialect.desc = "IoTDB 支持两种时序数据模型（SQL 方言），\n均用于管理设备和测点。\n- Tree：以层级路径方式管理数据，一个路径对应设备的一个测点。\n- Table：以关系表方式管理数据，一个表对应一类设备。"
emqx_bridge_iotdb_connector.config_sql_dialect.label = "SQL 方言"
emqx_bridge_iotdb_connector.config_zoneId.desc = "IoTDB Thrift 会话的时区。"
emqx_bridge_iotdb_connector.connect_timeout.desc = "连接到 IoTDB Thrift 服务器的超时时间。"
emqx_bridge_iotdb_connector.desc_config.desc = "Apache IoTDB 连接器的配置。"
emqx_bridge_iotdb_connector.desc_config.label = "IoTDB 连接器配置"
emqx_bridge_iotdb_connector.pool_size.desc = "IoTDB Thrift 连接池的大小。"
emqx_bridge_iotdb_connector.recv_timeout.desc = "IoTDB Thrift 服务器响应的超时时间。"
emqx_bridge_iotdb_connector.server.desc = "IoTDB Thrift 服务器的地址（主机:端口）。"
emqx_bridge_kafka.allow_auto_topic_creation.desc = "设置为 true 以允许通过元数据获取请求自动创建 Kafka 主题。"
emqx_bridge_kafka.allow_auto_topic_creation.label = "允许自动创建主题"
emqx_bridge_kafka.auth_gssapi_kerberos.desc = "使用 GSSAPI/Kerberos 认证。"
emqx_bridge_kafka.auth_gssapi_kerberos.label = "GSSAPI/Kerberos"
emqx_bridge_kafka.auth_kerberos_keytab_file.desc = "SASL GSSAPI 认证方法的 Kerberos keytab 文件。注意：该文件需要上传到 EMQX 服务器中，且运行 EMQX 服务的系统账户需要有读取权限。"
emqx_bridge_kafka.auth_kerberos_keytab_file.label = "Kerberos keytab 文件"
emqx_bridge_kafka.auth_kerberos_principal.desc = "SASL GSSAPI 认证方法的 Kerberos 主体，例如 <code>kafka/node1.example.com@EXAMPLE.COM/code>，注意：这里使用的 realm 需要配置在 EMQX 服务器的 /etc/krb5.conf 中。"
emqx_bridge_kafka.auth_kerberos_principal.label = "Kerberos 主体"
emqx_bridge_kafka.auth_msk_iam_roles_anywhere_endpoint.desc = "AWS IAM Roles Anywhere 凭据进程提供其 API 的端点。"
emqx_bridge_kafka.auth_msk_iam_roles_anywhere_endpoint.label = "端点"
emqx_bridge_kafka.auth_msk_iam_roles_anywhere_region.desc = "MSK 集群运行所在的 AWS 区域。"
emqx_bridge_kafka.auth_msk_iam_roles_anywhere_region.label = "区域"
emqx_bridge_kafka.auth_msk_iam_roles_anywhere_type.desc = "MSK IAM Roles Anywhere"
emqx_bridge_kafka.auth_msk_iam_roles_anywhere_type.label = "MSK IAM Roles Anywhere"
emqx_bridge_kafka.auth_oauth_client_credentials.desc = "基于 OAuth 的认证（客户端凭证流程）。"
emqx_bridge_kafka.auth_oauth_client_credentials.label = "OAuth（客户端凭证）认证"
emqx_bridge_kafka.auth_sasl_mechanism.desc = "SASL 认证方法名称。"
emqx_bridge_kafka.auth_sasl_mechanism.label = "认证方法"
emqx_bridge_kafka.auth_sasl_password.desc = "SASL 认证的密码。"
emqx_bridge_kafka.auth_sasl_password.label = "密码"
emqx_bridge_kafka.auth_sasl_username.desc = "SASL 认证的用户名。"
emqx_bridge_kafka.auth_sasl_username.label = "用户名"
emqx_bridge_kafka.auth_username_password.desc = "基于用户名密码的认证。"
emqx_bridge_kafka.auth_username_password.label = "用户名密码认证"
emqx_bridge_kafka.authentication.desc = "认证配置。\n- <code>none</code>：无认证。\n- <code>msk_iam</code>：使用 [MSK IAM 认证](https://docs.aws.amazon.com/msk/latest/developerguide/security-iam.html)。注意：这仅在 EMQX 运行在 EC2 实例上时有效。\n- <code>basic auth</code>：简单的用户名和密码认证。\n- <code>kerberos</code>：使用 Kerberos GSSAPI 认证。"
emqx_bridge_kafka.authentication.label = "认证"
emqx_bridge_kafka.bootstrap_hosts.desc = "用逗号分隔的 <code>host[:port]</code> 主机列表。默认端口号为 9092。"
emqx_bridge_kafka.bootstrap_hosts.label = "主机列表"
emqx_bridge_kafka.buffer_memory_overload_protection.desc = "缓存模式是 <code>memory</code> 或 <code>hybrid</code> 时适用。当系统处于高内存压力时，从队列中丢弃旧的消息以减缓内存增长。注意，该配置仅在 Linux 系统中有效。"
emqx_bridge_kafka.buffer_memory_overload_protection.label = "内存过载保护"
emqx_bridge_kafka.buffer_mode.desc = "消息缓存模式。\n<code>memory</code>: 所有的消息都缓存在内存里。如果 EMQX 服务重启，缓存的消息会丢失。\n<code>disk</code>: 缓存到磁盘上。EMQX 重启后会继续发送重启前未发送完成的消息。\n<code>hybrid</code>: 先将消息缓存在内存中，当内存中的消息堆积超过一定限制（配置项 <code>segment_bytes</code> 描述了该限制）后，后续的消息会缓存到磁盘上。与 <code>memory</code> 模式一样，如果 EMQX 服务重启，缓存的消息会丢失。"
emqx_bridge_kafka.buffer_mode.label = "缓存模式"
emqx_bridge_kafka.buffer_per_partition_limit.desc = "为每个 Kafka 分区设置的最大缓存字节数。当超过这个上限之后，老的消息会被丢弃，为新的消息腾出空间。"
emqx_bridge_kafka.buffer_per_partition_limit.label = "Kafka 分区缓存上限"
emqx_bridge_kafka.buffer_segment_bytes.desc = "当缓存模式是 <code>disk</code> 或 <code>hybrid</code> 时适用。该配置用于指定缓存到磁盘上的文件的大小。"
emqx_bridge_kafka.buffer_segment_bytes.label = "缓存文件大小"
emqx_bridge_kafka.compression.desc = "压缩方法。"
emqx_bridge_kafka.compression.label = "压缩"
emqx_bridge_kafka.config_enable.desc = "启用（true）或停用该（false）Kafka 数据桥接。"
emqx_bridge_kafka.config_enable.label = "启用或停用"
emqx_bridge_kafka.connect_timeout.desc = "建立 TCP 连接时的最大等待时长（若启用认证，这个等待时长也包含完成认证所需时间）。"
emqx_bridge_kafka.connect_timeout.label = "连接超时"
emqx_bridge_kafka.consumer_kafka_opts.desc = "Kafka 消费者配置。"
emqx_bridge_kafka.consumer_kafka_opts.label = "Kafka 消费者"
emqx_bridge_kafka.consumer_kafka_topic.desc = "指定从哪个 Kafka 主题消费消息。"
emqx_bridge_kafka.consumer_kafka_topic.label = "Kafka 主题"
emqx_bridge_kafka.consumer_key_encoding_mode.desc = "通过 MQTT 转发之前，如何处理 Kafka 消息的 Key。<code>none</code> 使用 Kafka 消息中的 Key 原始值，不进行编码。注意：在这种情况下，Key 必须是一个有效的 UTF-8 字符串。\n<code>base64</code> 对收到的 Key 或值使用 base-64 编码。"
emqx_bridge_kafka.consumer_key_encoding_mode.label = "Key 编码模式"
emqx_bridge_kafka.consumer_max_batch_bytes.desc = "设置每次从 Kafka 拉取数据的字节数。\n消息由消费者批量拉取，如果第一个非空\n分区中的第一个记录批次大于此值，记录批次仍将被返回，以确保\n消费者能够继续进程。因此，这不是绝对的最大值。设置为 1 可实现最低延迟。"
emqx_bridge_kafka.consumer_max_batch_bytes.label = "拉取字节数"
emqx_bridge_kafka.consumer_max_rejoin_attempts.desc = "消费组成员允许重新加入小组的最大次数。如超过该配置次数后仍未能成功加入消费组，则会在等待一段时间后重试。"
emqx_bridge_kafka.consumer_max_rejoin_attempts.label = "最大的重新加入尝试"
emqx_bridge_kafka.consumer_mqtt_opts.desc = "本地 MQTT 消息转发。"
emqx_bridge_kafka.consumer_mqtt_opts.label = "MQTT 转发"
emqx_bridge_kafka.consumer_mqtt_payload.desc = "用于转换收到的 Kafka 消息的模板。默认情况下，它将使用 JSON 格式来序列化来自 Kafka 的所有字段。这些字段包括：<code>headers</code>：一个包含字符串键值对的 JSON 对象。\n<code>key</code>：Kafka 消息的键（使用选择的编码方式编码）。\n<code>offset</code>：消息的偏移量。\n<code>topic</code>：Kafka 主题。\n<code>ts</code>: 消息的时间戳。\n<code>ts_type</code>：消息的时间戳类型，值可能是： <code>create</code>， <code>append</code> 或 <code>undefined</code>。\n<code>value</code>: Kafka 消息值（使用选择的编码方式编码）。"
emqx_bridge_kafka.consumer_mqtt_payload.label = "MQTT 载荷模板"
emqx_bridge_kafka.consumer_mqtt_qos.desc = "转发 MQTT 消息时使用的 QoS。"
emqx_bridge_kafka.consumer_mqtt_qos.label = "QoS"
emqx_bridge_kafka.consumer_mqtt_topic.desc = "设置 Kafka 消息向哪个本地 MQTT 主题转发消息。"
emqx_bridge_kafka.consumer_mqtt_topic.label = "MQTT 主题"
emqx_bridge_kafka.consumer_offset_commit_interval_seconds.desc = "指定 Kafka 消费组偏移量提交的时间间隔。"
emqx_bridge_kafka.consumer_offset_commit_interval_seconds.label = "偏移提交间隔"
emqx_bridge_kafka.consumer_offset_reset_policy.desc = "如不存在偏移量历史记录或历史记录失效，消费者应使用哪个偏移量开始消费。"
emqx_bridge_kafka.consumer_offset_reset_policy.label = "偏移重置策略"
emqx_bridge_kafka.consumer_opts.desc = "本地 MQTT 转发 和 Kafka 消费者配置。"
emqx_bridge_kafka.consumer_opts.label = "MQTT 到 Kafka"
emqx_bridge_kafka.consumer_value_encoding_mode.desc = "通过 MQTT 转发之前，如何处理 Kafka 消息的 Value。<code>none</code> 使用 Kafka 消息中的 Value 原始值，不进行编码。  注意：在这种情况下，Value 必须是一个有效的 UTF-8 字符串。\n<code>base64</code> 对收到的 Value 使用 base-64 编码。"
emqx_bridge_kafka.consumer_value_encoding_mode.label = "Value 编码模式"
emqx_bridge_kafka.desc_config.desc = "一个 Kafka 生产者客户端的配置项"
emqx_bridge_kafka.desc_config.label = "Kafka 生产者客户端配置"
emqx_bridge_kafka.desc_name.desc = "桥接名字，可读描述"
emqx_bridge_kafka.desc_name.label = "桥接名字"
emqx_bridge_kafka.desc_type.desc = "桥接类型"
emqx_bridge_kafka.desc_type.label = "桥接类型"
emqx_bridge_kafka.kafka_consumer.desc = "Kafka 消费者配置。"
emqx_bridge_kafka.kafka_consumer.label = "Kafka 消费者"
emqx_bridge_kafka.kafka_header_value_encode_mode.desc = "Kafka 头部值编码模式<br/>\n - None: 仅将二进制值添加到 Kafka 头部；<br/>\n - JSON: 仅将 JSON 值添加到 Kafka 头部，并在发送前对其进行 JSON 字符串编码。"
emqx_bridge_kafka.kafka_header_value_encode_mode.label = "Kafka 头部值编码模式"
emqx_bridge_kafka.kafka_headers.desc = "请提供要用作 Kafka 头部的占位符<br/>\n例如：<code>${pub_props}</code><br/>\n请注意，占位符的值必须是对象形式的：<code>{\"foo\": \"bar\"}</code>\n或者是键值对的数组形式：<code>[{\"key\": \"foo\", \"value\": \"bar\"}]</code>。"
emqx_bridge_kafka.kafka_headers.label = "Kafka 头部"
emqx_bridge_kafka.kafka_message.desc = "用于生成 Kafka 消息的模版。"
emqx_bridge_kafka.kafka_message.label = "Kafka 消息模版"
emqx_bridge_kafka.kafka_message_key.desc = "生成 Kafka 消息 Key 的模版。如果模版生成后为空值，则会使用 Kafka 的 <code>NULL</code> ，而非空字符串。"
emqx_bridge_kafka.kafka_message_key.label = "消息的 Key"
emqx_bridge_kafka.kafka_message_timestamp.desc = "生成 Kafka 消息时间戳的模版。该时间必需是一个整型数值（可以是字符串格式）例如 <code>1661326462115</code> 或 <code>'1661326462115'</code>。当所需的输入字段不存在，或不是一个整型时，则会使用当前系统时间。"
emqx_bridge_kafka.kafka_message_timestamp.label = "消息的时间戳"
emqx_bridge_kafka.kafka_message_value.desc = "生成 Kafka 消息 Value 的模版。如果模版生成后为空值，则会使用 Kafka 的 <code>NULL</code>，而非空字符串。"
emqx_bridge_kafka.kafka_message_value.label = "消息的 Value"
emqx_bridge_kafka.kafka_producer.desc = "Kafka 生产者配置。"
emqx_bridge_kafka.kafka_producer.label = "Kafka 生产者"
emqx_bridge_kafka.kafka_producer_action.desc = "Kafka 生产者动作"
emqx_bridge_kafka.kafka_producer_action.label = "Kafka 生产者动作"
emqx_bridge_kafka.kafka_topic.desc = "Kafka 主题名称。支持使用模版（例如：`t-${payload.t}`）。"
emqx_bridge_kafka.kafka_topic.label = "Kafka 主题名称"
emqx_bridge_kafka.max_batch_bytes.desc = "最大消息批量字节数。大多数 Kafka 环境的默认最低值是 1 MB，EMQX 的默认值比 1 MB 更小是因为需要补偿 Kafka 消息编码所需要的额外字节（尤其是当每条消息都很小的情况下）。当单个消息的大小超过该限制时，它仍然会被发送，（相当于该批量中只有单个消息）。"
emqx_bridge_kafka.max_batch_bytes.label = "最大批量字节数"
emqx_bridge_kafka.max_inflight.desc = "设置 Kafka 生产者（每个分区一个）在收到 Kafka 的确认前最多发送多少个请求（批量）。调大这个值通常可以增加吞吐量，但是，当该值设置大于 1 时存在消息乱序的风险。"
emqx_bridge_kafka.max_inflight.label = "飞行窗口"
emqx_bridge_kafka.max_linger_bytes.desc = "每个分区生产者在发送数据前，为了收集批量消息进行缓冲，最多可以等待的消息字节数。"
emqx_bridge_kafka.max_linger_bytes.label = "最大等待字节数"
emqx_bridge_kafka.max_linger_time.desc = "每个分区生产者为了收集批量消息进行缓冲的最长等待时间。\n默认值为 0，表示不等待。 对于非内存缓冲模式，建议配置至少 5ms 以减少 IOPS（每秒输入输出操作次数）。"
emqx_bridge_kafka.max_linger_time.label = "最大等待时间"
emqx_bridge_kafka.metadata_request_timeout.desc = "刷新元数据时最大等待时长。"
emqx_bridge_kafka.metadata_request_timeout.label = "元数据请求超时"
emqx_bridge_kafka.min_metadata_refresh_interval.desc = "刷新 Kafka broker 和 Kafka 主题元数据段最短时间间隔。设置太小可能会增加 Kafka 压力。"
emqx_bridge_kafka.min_metadata_refresh_interval.label = "元数据刷新最小间隔"
emqx_bridge_kafka.mqtt_topic.desc = "MQTT 主题数据源由桥接指定，或留空由规则动作指定。"
emqx_bridge_kafka.mqtt_topic.label = "源 MQTT 主题"
emqx_bridge_kafka.oauth_client_credentials_client_id.desc = "用于从 OAuth 服务器请求令牌的客户端 ID。"
emqx_bridge_kafka.oauth_client_credentials_client_id.label = "OAuth 客户端 ID"
emqx_bridge_kafka.oauth_client_credentials_client_secret.desc = "用于从 OAuth 服务器请求令牌的客户端密钥。"
emqx_bridge_kafka.oauth_client_credentials_client_secret.label = "OAuth 客户端密钥"
emqx_bridge_kafka.oauth_client_credentials_endpoint_uri.desc = "生成访问令牌的 OAuth 令牌端点的 URI。"
emqx_bridge_kafka.oauth_client_credentials_endpoint_uri.label = "OAuth 令牌端点 URI"
emqx_bridge_kafka.oauth_client_credentials_extensions.desc = "如果需要，指定要传递到 SASL 握手的扩展。"
emqx_bridge_kafka.oauth_client_credentials_extensions.label = "SASL 扩展"
emqx_bridge_kafka.oauth_client_credentials_grant_type.desc = "OAuth 授权类型"
emqx_bridge_kafka.oauth_client_credentials_grant_type.label = "OAuth 授权类型"
emqx_bridge_kafka.oauth_client_credentials_mechanism.desc = "SASL 认证机制"
emqx_bridge_kafka.oauth_client_credentials_mechanism.label = "SASL 认证机制"
emqx_bridge_kafka.oauth_client_credentials_scope.desc = "如果需要，指定在请求 OAuth 访问令牌时提供的 `scope`。"
emqx_bridge_kafka.oauth_client_credentials_scope.label = "OAuth 请求范围"
emqx_bridge_kafka.partition_count_refresh_interval.desc = "配置 Kafka 刷新分区数量的时间间隔。\nEMQX 发现 Kafka 分区数量增加后，会开始按 <code>partition_strategy<code> 配置，把消息发送到新的分区中。"
emqx_bridge_kafka.partition_count_refresh_interval.label = "分区数量刷新间隔"
emqx_bridge_kafka.partition_strategy.desc = "设置消息发布时应该如何选择 Kafka 分区。\n\n<code>random</code>: 为每个消息随机选择一个分区。\n<code>key_dispatch</code>: Hash Kafka message key to a partition number"
emqx_bridge_kafka.partition_strategy.label = "分区选择策略"
emqx_bridge_kafka.partitions_limit.desc = "限制为给定主题生产数据的分区数量。\n特殊值 all_partitions 用于利用该主题的所有分区。\n将此设置为大于分区总数的值将不会产生任何效果。"
emqx_bridge_kafka.partitions_limit.label = "最大分区数"
emqx_bridge_kafka.producer_buffer.desc = "配置消息缓存的相关参数。\n\n当 EMQX 需要发送的消息超过 Kafka 处理能力，或者当 Kafka 临时下线时，EMQX 内部会将消息缓存起来。"
emqx_bridge_kafka.producer_buffer.label = "消息缓存"
emqx_bridge_kafka.producer_health_check_topic.desc = "专用于更精确的连接器健康检查的主题名称。"
emqx_bridge_kafka.producer_health_check_topic.label = "连接器健康检查主题"
emqx_bridge_kafka.producer_kafka_ext_header_key.desc = "Kafka 头部的键。支持格式为 ${var} 的占位符。"
emqx_bridge_kafka.producer_kafka_ext_header_key.label = "额外的 Kafka 头部键"
emqx_bridge_kafka.producer_kafka_ext_header_value.desc = "Kafka 头部的值。支持格式为 ${var} 的占位符。"
emqx_bridge_kafka.producer_kafka_ext_header_value.label = "值"
emqx_bridge_kafka.producer_kafka_ext_headers.desc = "请提供更多的 Kafka 头部键值对<br/>\n这里的键值对将与 <code>kafka_headers</code> 字段的值合并，然后发送到 Kafka。"
emqx_bridge_kafka.producer_kafka_ext_headers.label = "额外的 Kafka headers头部"
emqx_bridge_kafka.producer_kafka_opts.desc = "Kafka 生产者参数。"
emqx_bridge_kafka.producer_kafka_opts.label = "生产者参数"
emqx_bridge_kafka.query_mode.desc = "查询模式。可选 'sync/async'，默认 'async'。"
emqx_bridge_kafka.query_mode.label = "查询模式"
emqx_bridge_kafka.required_acks.desc = "设置 Kafka leader 在返回给 EMQX 确认之前需要等待多少个 follower 的确认。\n\n<code>all_isr</code>: 需要所有的在线复制者都确认。\n<code>leader_only</code>: 仅需要分区 leader 确认。\n<code>none</code>: 无需 Kafka 回复任何确认。"
emqx_bridge_kafka.required_acks.label = "Kafka 确认数量"
emqx_bridge_kafka.resource_opts.desc = "资源选项。"
emqx_bridge_kafka.resource_opts.label = "资源选项"
emqx_bridge_kafka.server_name_indication.desc = "TLS 握手的 Server Name Indication (SNI) 设置。<br/>\n- <code>auto</code>：客户端将使用 <code>\"servicebus.windows.net\"</code> 作为 SNI。<br/>\n- <code>disable</code>：如果您希望阻止客户端发送 SNI。<br/>\n- 其他字符串值将按原样发送。"
emqx_bridge_kafka.server_name_indication.label = "SNI"
emqx_bridge_kafka.socket_nodelay.desc = "设置‘true’让系统内核立即发送。否则当需要发送的内容很少时，可能会有一定延迟（默认 40 毫秒）。"
emqx_bridge_kafka.socket_nodelay.label = "是否关闭延迟发送"
emqx_bridge_kafka.socket_opts.desc = "更多 Socket 参数设置。"
emqx_bridge_kafka.socket_opts.label = "Socket 参数"
emqx_bridge_kafka.socket_receive_buffer.desc = "TCP socket 的收包缓存调优。默认值是针对高吞吐量的一个推荐值。"
emqx_bridge_kafka.socket_receive_buffer.label = "Socket 收包缓存大小"
emqx_bridge_kafka.socket_send_buffer.desc = "TCP socket 的发送缓存调优。默认值是针对高吞吐量的一个推荐值。"
emqx_bridge_kafka.socket_send_buffer.label = "Socket 发送缓存大小"
emqx_bridge_kafka.ssl_client_opts.desc = "Kafka 客户端的 TLS/SSL 选项"
emqx_bridge_kafka.ssl_client_opts.label = "TLS/SSL 选项"
emqx_bridge_kafka.sync_query_timeout.desc = "该参数定义同步查询的超时限制。仅当桥接查询模式配置为'sync'时才适用。"
emqx_bridge_kafka.sync_query_timeout.label = "同步查询超时"
emqx_bridge_kafka_consumer_schema.config_connector.desc = "Kafka 消费者客户端的配置。"
emqx_bridge_kafka_consumer_schema.config_connector.label = "Kafka 消费者客户端配置"
emqx_bridge_kafka_consumer_schema.consumer_source.desc = "Source 配置。"
emqx_bridge_kafka_consumer_schema.consumer_source.label = "Source"
emqx_bridge_kafka_consumer_schema.group_id.desc = "用于此 Source 的消费者组标识符。如果省略，将自动生成一个基于 Source 名称的标识符。"
emqx_bridge_kafka_consumer_schema.group_id.label = "自定义消费者组 ID"
emqx_bridge_kafka_consumer_schema.max_wait_time.desc = "等待 Kafka broker 发送拉取响应的最长时间。"
emqx_bridge_kafka_consumer_schema.max_wait_time.label = "最大等待时间"
emqx_bridge_kafka_consumer_schema.source_parameters.desc = "针对 Source 的详细配置。"
emqx_bridge_kafka_consumer_schema.source_parameters.label = "Source 详细配置"
emqx_bridge_kinesis.action_parameters.desc = "针对动作的详细配置。"
emqx_bridge_kinesis.action_parameters.label = "动作"
