emqx_rule_engine_api.api1_match_from.desc = "根据规则来源 Topic 过滤, 使用 MQTT Topic 匹配"
emqx_rule_engine_api.api1_qs_action.desc = "筛选包含任意给定动作 ID 的规则。当与 source ID 筛选一起使用时，规则必须包含匹配某些条件的 source 和动作。"
emqx_rule_engine_api.api1_qs_source.desc = "筛选包含任意给定 source ID 的规则。当与动作 ID 筛选一起使用时，规则必须包含匹配某些条件的 source 和动作。"
emqx_rule_engine_api.api1_resp.desc = "规则列表"
emqx_rule_engine_api.api1_resp.label = "列出所有规则"
emqx_rule_engine_api.api2.desc = "通过指定 ID 创建规则"
emqx_rule_engine_api.api2.label = "通过指定 ID 创建规则"
emqx_rule_engine_api.api3.desc = "列出所有能被规则使用的事件"
emqx_rule_engine_api.api3.label = "列出所有能被规则使用的事件"
emqx_rule_engine_api.api4.desc = "通过 ID 查询规则"
emqx_rule_engine_api.api4.label = "查询规则"
emqx_rule_engine_api.api4_1.desc = "通过给定的 Id 获得规则的指标数据"
emqx_rule_engine_api.api4_1.label = "获得指标数据"
emqx_rule_engine_api.api5.desc = "通过 ID 更新集群里所有节点上的规则"
emqx_rule_engine_api.api5.label = "更新集群规则"
emqx_rule_engine_api.api6.desc = "通过 ID 删除集群里所有节点上的规则"
emqx_rule_engine_api.api6.label = "基于给定 ID 新建一条规则"
emqx_rule_engine_api.api7.desc = "重置规则计数"
emqx_rule_engine_api.api7.label = "重置规则计数"
emqx_rule_engine_api.api8.desc = "测试一个规则"
emqx_rule_engine_api.api8.label = "测试规则"
emqx_rule_engine_api.api9.desc = "获取规则引擎配置。"
emqx_rule_engine_api.api9.label = "获取配置"
emqx_rule_engine_api.delete_rule_successfully.desc = "规则删除成功。"
emqx_rule_engine_api.delete_rule_successfully.label = "规则删除成功"
emqx_rule_engine_api.invalid_parameters.desc = "无效的参数。"
emqx_rule_engine_api.invalid_parameters.label = "无效的参数"
emqx_rule_engine_api.invalid_request.desc = "无效的请求。"
emqx_rule_engine_api.invalid_request.label = "无效的请求"
emqx_rule_engine_api.reset_success.desc = "重置成功。"
emqx_rule_engine_api.reset_success.label = "重置成功"
emqx_rule_engine_api.rule_applied.desc = "规则已应用。"
emqx_rule_engine_api.rule_applied.label = "规则已应用"
emqx_rule_engine_api.rule_could_not_be_found.desc = "未找到规则。"
emqx_rule_engine_api.rule_could_not_be_found.label = "未找到规则"
emqx_rule_engine_api.rule_not_found.desc = "未找到规则。"
emqx_rule_engine_api.rule_not_found.label = "未找到规则"
emqx_rule_engine_api.rule_test_pass.desc = "规则测试通过。"
emqx_rule_engine_api.rule_test_pass.label = "规则测试通过"
emqx_rule_engine_api.sql_not_match.desc = "SQL 不匹配。"
emqx_rule_engine_api.sql_not_match.label = "SQL 不匹配"
emqx_rule_engine_schema.console_function.desc = "将输出打印到控制台"
emqx_rule_engine_schema.console_function.label = "控制台函数"
emqx_rule_engine_schema.desc_builtin_action_console.desc = "配置打印到控制台"
emqx_rule_engine_schema.desc_builtin_action_console.label = "配置打印到控制台"
emqx_rule_engine_schema.desc_builtin_action_republish.desc = "配置重新发布。"
emqx_rule_engine_schema.desc_builtin_action_republish.label = "配置重新发布"
emqx_rule_engine_schema.desc_republish_args.desc = "内置 'republish' 动作的参数。\n可以在参数中使用变量。\n变量是规则中选择的字段。 例如规则 SQL 定义如下：\n<code>\n    SELECT clientid, qos, payload FROM \"t/1\"\n</code>\n然后有 3 个变量可用：<code>clientid</code>、<code>qos</code> 和 <code>payload</code>。 如果我们将参数设置为：\n<code>\n    {\n        topic = \"t/${clientid}\"\n        qos = \"${qos}\"\n        payload = \"msg: ${payload}\"\n    }\n</code>\n当收到一条消息 payload = `hello`, qos = 1, clientid = `Steve` 时，将重新发布一条新的 MQTT 消息到主题 `t/Steve`\n消息内容为 payload = `msg: hello`, and `qos = 1"
emqx_rule_engine_schema.desc_republish_args.label = "重新发布参数"
emqx_rule_engine_schema.desc_rule_engine.desc = "配置 EMQX 规则引擎。"
emqx_rule_engine_schema.desc_rule_engine.label = "配置规则引擎"
emqx_rule_engine_schema.desc_rules.desc = "配置规则"
emqx_rule_engine_schema.desc_rules.label = "配置规则"
emqx_rule_engine_schema.desc_user_provided_function.desc = "配置用户函数"
emqx_rule_engine_schema.desc_user_provided_function.label = "配置用户函数"
emqx_rule_engine_schema.limit_selects_in_namespace.desc = "启用后，规则仅会在与规则自身同一命名空间的客户端发布消息时触发。"
emqx_rule_engine_schema.limit_selects_in_namespace.label = "限制命名空间内的 Select"
emqx_rule_engine_schema.republish_args_direct_dispatch.desc = "启用直接分发到订阅者，而无需启动新的消息发布事件。\n当设置为 `true` 时，可以防止同一动作递归处理消息，适用于输出消息不需要进一步处理的情况。\n\n然而，启用此功能有几个限制：\n\n- 此动作的输出消息不会被保留。\n- 它不会触发基于此动作的输出主题运行的其他规则。\n- 它不会激活选择 `$events/message_publish` 的规则。\n- 它不会触发使用 `'message.publish'` 钩子的插件。\n- 不会收集此动作输出消息的主题指标。\n- 不会应用消息 schema 验证（EMQX Enterprise 的功能）。\n- 不会应用消息转换过程（EMQX Enterprise 的功能）。"
emqx_rule_engine_schema.republish_args_direct_dispatch.label = "Direct Dispatch"
emqx_rule_engine_schema.republish_args_mqtt_properties.desc = "从消息中应该获取哪个变量作为消息的 MQTT 发布属性。\n可以使用像<code>${.payload.content_type}</code>这样的占位符。"
emqx_rule_engine_schema.republish_args_mqtt_properties.label = "MQTT 属性"
emqx_rule_engine_schema.republish_args_payload.desc = "要重新发布的消息的有效负载。允许使用带有变量的模板，请参阅“republish_args”的描述。\n默认为 ${payload}。 如果从所选结果中未找到变量 ${payload}，则使用字符串 \"undefined\"。"
emqx_rule_engine_schema.republish_args_payload.label = "消息负载"
emqx_rule_engine_schema.republish_args_qos.desc = "要重新发布的消息的 qos。允许使用带有变量的模板，请参阅“republish_args”的描述。\n默认为 ${qos}。 如果从规则的选择结果中没有找到变量 ${qos}，则使用 0。"
emqx_rule_engine_schema.republish_args_qos.label = "消息 QoS 等级"
emqx_rule_engine_schema.republish_args_retain.desc = "要重新发布的消息的“保留”标志。允许使用带有变量的模板，请参阅“republish_args”的描述。\n默认为 ${retain}。 如果从所选结果中未找到变量 ${retain}，则使用 false。"
emqx_rule_engine_schema.republish_args_retain.label = "保留消息标志"
emqx_rule_engine_schema.republish_args_topic.desc = "重新发布消息的目标主题。\n允许使用带有变量的模板，请参阅“republish_args”的描述。"
emqx_rule_engine_schema.republish_args_topic.label = "目标主题"
emqx_rule_engine_schema.republish_args_user_properties.desc = "指定使用哪个变量来填充 MQTT 消息的 User-Property 列表。这个变量的值必须是一个 map 类型。\n可以设置成 <code>${pub_props.'User-Property'}</code> 或者\n使用 <code>SELECT *,pub_props.'User-Property' as user_properties</code> 来把源 MQTT 消息\n的 User-Property 列表用于填充。\n也可以使用 <code>map_put</code> 函数来添加新的 User-Property，\n<code>map_put('my-prop-name', 'my-prop-value', user_properties) as user_properties</code>\n注意：MQTT 协议允许一个消息中出现多次同一个 property 名，但是 EMQX 的规则引擎不允许。"
emqx_rule_engine_schema.republish_args_user_properties.label = "用户属性"
emqx_rule_engine_schema.republish_function.desc = "将消息重新发布为新的 MQTT 消息"
emqx_rule_engine_schema.republish_function.label = "重新发布函数"
emqx_rule_engine_schema.republish_mqtt_properties_prop.desc = "在消息重发布时可设置的 MQTT 属性。"
emqx_rule_engine_schema.rule_engine_ignore_sys_message.desc = "当设置为“true”（默认）时，规则引擎将忽略发布到 $SYS 主题的消息。"
emqx_rule_engine_schema.rule_engine_ignore_sys_message.label = "忽略系统消息"
emqx_rule_engine_schema.rule_engine_jq_function_default_timeout.desc = "规则引擎内建函数 `jq` 默认时间限制"
emqx_rule_engine_schema.rule_engine_jq_function_default_timeout.label = "规则引擎 jq 函数时间限制"
emqx_rule_engine_schema.rule_engine_jq_implementation_module.desc = "jq 规则引擎功能的实现模块。可用的两个选项是 jq_nif 和 jq_port。jq_nif 使用 Erlang NIF 库访问 jq 库，而 jq_port 使用基于 Erlang Port 的实现。jq_nif 方式（默认选项）是这两个选项中最快的实现，但 jq_port 方式更安全，因为这种情况下 jq 程序不会在 Erlang VM 进程中执行。"
emqx_rule_engine_schema.rule_engine_jq_implementation_module.label = "JQ 实现模块"
emqx_rule_engine_schema.rule_engine_rules.desc = "规则"
emqx_rule_engine_schema.rule_engine_rules.label = "规则"
emqx_rule_engine_schema.rules_actions.desc = "规则的动作列表。\n动作可以是指向 EMQX 数据桥接的引用，也可以是一个指向函数的对象。\n我们支持一些内置函数，如“republish”和“console”，我们还支持用户提供的函数，它的格式为：“{module}:{function}”。\n列表中的动作按顺序执行。这意味着如果其中一个动作执行缓慢，则以下所有动作都不会被执行直到它返回。\n如果其中一个动作崩溃，在它之后的所有动作仍然会被按照原始顺序执行。\n如果运行动作时出现任何错误，则会出现错误消息，并且相应的计数器会增加。"
emqx_rule_engine_schema.rules_actions.label = "动作列表"
emqx_rule_engine_schema.rules_description.desc = "规则的描述"
emqx_rule_engine_schema.rules_description.label = "规则描述"
emqx_rule_engine_schema.rules_enable.desc = "启用或禁用规则引擎"
emqx_rule_engine_schema.rules_enable.label = "启用或禁用规则引擎"
emqx_rule_engine_schema.rules_metadata.desc = "规则的元数据，不要手动修改"
emqx_rule_engine_schema.rules_metadata.label = "规则的元数据"
emqx_rule_engine_schema.rules_name.desc = "规则名字"
emqx_rule_engine_schema.rules_name.label = "规则名字"
emqx_rule_engine_schema.rules_sql.desc = "用于处理消息的 SQL 。\n示例：<code>SELECT * FROM \"test/topic\" WHERE payload.x = 1</code>"
emqx_rule_engine_schema.rules_sql.label = "规则 SQL"
emqx_rule_engine_schema.ssrf.desc = "针对通过规则引擎连接器、桥接和动作配置的出站目标地址的 SSRF 防护。<br/>\n启用后，先拒绝与 `deny_hosts` 精确匹配的目标，再在解析出的目标 IP 上先检查 `allow_cidrs`，随后检查 `deny_cidrs`。<br/>\n这仅是配置验证阶段的防护层：无法防止验证通过后发生的恶意 DNS 变更。<br/>\n请结合防火墙、`iptables` 或 `nftables` 等网络层出站控制使用。"
emqx_rule_engine_schema.ssrf.label = "SSRF 防护"
emqx_rule_engine_schema.ssrf_allow_cidrs.desc = "在检查拒绝列表之前显式允许的 CIDR 范围列表。<br/>\n用于在不全局关闭 SSRF 防护的情况下，允许受信任的内部目标。<br/>\n默认为空。"
emqx_rule_engine_schema.ssrf_allow_cidrs.label = "允许的 CIDR 范围"
emqx_rule_engine_schema.ssrf_deny_cidrs.desc = "被视为私有或不安全的出站目标 CIDR 范围列表。<br/>\n默认覆盖回环、链路本地（含云 IMDS）、RFC1918、ULA、未指定地址和组播范围，以及已知的云元数据 IP（阿里云 100.100.100.200 和 AWS 69.254.169.253）。<br/>\n如确有需要，请使用 `allow_cidrs` 添加显式例外。"
emqx_rule_engine_schema.ssrf_deny_cidrs.label = "拒绝的 CIDR 范围"
emqx_rule_engine_schema.ssrf_deny_hosts.desc = "按精确匹配（不区分大小写）拒绝的主机名列表。<br/>\n默认覆盖云元数据主机名：metadata.tencentyun.com、metadata.google.internal、metadata.azure.internal。"
emqx_rule_engine_schema.ssrf_deny_hosts.label = "拒绝的主机名"
emqx_rule_engine_schema.ssrf_enable.desc = "为出站连接器/桥接/动作目标应用 `rule_engine.ssrf` 下的 SSRF 策略。<br/>\n仅在配置更新时检查——运行时 DNS 重新解析不会被阻止。<br/>\n对于验证后的 DNS 变更，请使用网络层出站控制作为执行层。"
emqx_rule_engine_schema.ssrf_enable.label = "启用 SSRF 防护"
emqx_rule_engine_schema.user_provided_function_args.desc = "用户提供的参数将作为函数 module:function/3 的第三个参数，\n请检查源文件：<code>apps/emqx_rule_engine/src/emqx_rule_actions.erl</code> 中的示例函数 <code>console</code> 和<code>republish</code> 。"
emqx_rule_engine_schema.user_provided_function_args.label = "用户提供函数的参数"
emqx_rule_engine_schema.user_provided_function_function.desc = "用户提供的函数。 格式应为：'{module}:{function}'。\n其中 {module} 是 Erlang 回调模块， {function} 是 Erlang 函数。\n要编写自己的函数，请检查源文件：<code>apps/emqx_rule_engine/src/emqx_rule_actions.erl</code> 中的示例函数 <code>console</code> 和<code>republish</code> 。"
emqx_rule_engine_schema.user_provided_function_function.label = "用户提供的函数"
emqx_s3_schema.access_key_id.desc = "S3 桶的访问密钥 ID。"
emqx_s3_schema.acl.desc = "上传对象使用的 ACL。"
emqx_s3_schema.bucket.desc = "S3 桶的名称。"
emqx_s3_schema.bucket.label = "存储桶"
emqx_s3_schema.bucket_access_method.desc = "通过 HTTP API 访问存储桶的 HTTP 请求方法。"
emqx_s3_schema.bucket_access_method.label = "存储桶访问方法"
emqx_s3_schema.host.desc = "S3 端点的主机。"
emqx_s3_schema.ipv6_probe.desc = "是否探测 IPv6 支持。"
emqx_s3_schema.key.desc = "S3 对象的键。"
emqx_s3_schema.key.label = "对象键"
emqx_s3_schema.max_part_size.desc = "多部分上传的最大部分大小。<br/>\nS3 上传器不会尝试上传超过此大小的部分。"
emqx_s3_schema.min_part_size.desc = "多部分上传的最小部分大小。<br/>\n上传的数据将在内存中累积，直到达到此大小。"
emqx_s3_schema.port.desc = "S3 端点的端口。"
emqx_s3_schema.secret_access_key.desc = "S3 桶的 Secret Access Key。<br/>\n如需从文件加载密钥而不是内联写入，请使用 <code>file://&lt;path-to-file&gt;</code> 形式；文件内容（去除末尾空白）将作为密钥使用。集群模式下，该文件必须存在于所有 EMQX 节点。"
emqx_s3_schema.transport_options.desc = "S3 客户端使用的 HTTP 传输层选项。"
emqx_s3_schema.upload_headers.desc = "包含在 S3 对象上传请求中的 HTTP 请求头，用于指定 S3 对象的内容类型、内容编码以及其他属性。"
emqx_s3_schema.upload_headers.label = "S3 对象 HTTP 请求头"
emqx_s3_schema.url_expire_time.desc = "S3 对象的签名 URL 有效时间（秒）。"
emqx_schema.alarm_actions.desc = "告警激活时触发的动作。<br/>目前，支持以下操作：<code>log</code> 和 <code>publish</code>.\n<code>log</code> 将告警写入日志 (控制台或者文件).\n<code>publish</code> 将告警作为 MQTT 消息发布到系统主题:\n<code>$SYS/brokers/emqx@xx.xx.xx.x/alarms/activate</code> and\n<code>$SYS/brokers/emqx@xx.xx.xx.x/alarms/deactivate</code>"
emqx_schema.alarm_actions.label = "告警动作"
emqx_schema.alarm_size_limit.desc = "最多可以存储的历史告警数量。\n\n当达到最大数量时，将删除最旧的历史告警以存储新的历史告警。"
emqx_schema.alarm_size_limit.label = "告警总数限制"
emqx_schema.alarm_validity_period.desc = "历史告警的有效期。从历史告警激活的时间开始计算，而不是取消的时间。\n\n如果告警存在的时间超过了有效期，该告警将被删除。"
emqx_schema.alarm_validity_period.label = "告警有效期"
emqx_schema.authz_include_mountpoint.desc = "启用后，目标主题和主题过滤器在与 ACL 规则或授权后端匹配之前，会被主题挂载点前缀。"
emqx_schema.authz_include_mountpoint.label = "授权的挂载前缀"
emqx_schema.banned_bootstrap_file.desc = "引导文件是一个 CSV 文件，用于在初始化单节点或集群时批量加载被禁止的数据，换句话说，只有在数据库中没有数据时才执行导入操作。\n\n此文件的分隔符是 `,`。\n\n此文件的第一行必须是标题行。所有有效的标题如下所示：\n- as :: 必填\n- who :: 必填\n- by  :: 可选\n- reason :: 可选\n- at :: 可选\n- until :: 可选\n\n有关每个字段的详细信息，请参阅文档。\n\n此文件其余行中的每一行必须包含与标题行相同数量的列，\n如果列可以省略，则其值将为 `undefined`。"
emqx_schema.base_listener_acceptors.desc = "监听器接收池的大小。"
emqx_schema.base_listener_acceptors.label = "接收器数量"
emqx_schema.base_listener_bind.desc = "监听套接字的 IP 地址和端口。"
emqx_schema.base_listener_bind.label = "IP 地址和端口"
emqx_schema.base_listener_enable_authn.desc = "配置 <code>true</code> （默认值）启用客户端进行身份认证，通过检查认配置的认认证器链来决定是否允许接入。\n配置 <code>false</code> 时，将不对客户端做任何认证，任何客户端，不论是不是携带用户名等认证信息，都可以接入。\n配置 <code>quick_deny_anonymous</code> 时，行为跟 <code>true</code> 类似，但是会对匿名\n客户直接拒绝，不做使用任何认证器对客户端进行身份检查。"
emqx_schema.base_listener_enable_authn.label = "启用身份认证"
emqx_schema.base_listener_limiter.desc = "速率限制类型"
emqx_schema.base_listener_limiter.label = "速率限制类型"
emqx_schema.base_listener_max_connections.desc = "监听器允许的最大并发连接数。"
emqx_schema.base_listener_max_connections.label = "最大并发连接数"
emqx_schema.base_listener_mountpoint.desc = "在客户端的 SUBSCRIBE 和 UNSUBSCRIBE 请求、`PUBLISH` 消息以及遗嘱消息（如果在 `CONNECT` 数据包中提供）中，为主题添加静态或模板化的前缀（例如，`n1/` 或 `${username}/`）。\n- 从发布到相应订阅的消息的主题中移除此前缀。\n\n支持的占位符有：\n- `${username}`\n- `${clientid}`\n- `${zone}`\n- `${client_attrs.NAME}`\n\n例如，使用 `mountpoint=\"${username}/\"` 配置时，使用 `u1` 作为用户名的客户端将具有：\n- 客户端 `SUBSCRIBE sensors/#` 在服务器内部为 `u1/sensors/#`。\n- 服务器发布 `PUBLISH u1/sensors/data` -> 发送给客户端的主题为 `sensors/data`。\n\n前缀挂载/卸载适用于：\n- `CONNECT` 中的遗嘱消息\n- `PUBLISH`\n- `SUBSCRIBE`\n- `UNSUBSCRIBE`\n\n注意：挂载操作发生在**授权/ACL 检查之后**。"
emqx_schema.base_listener_mountpoint.label = "挂载点"
emqx_schema.base_listener_zone.desc = "监听器所属的配置 zone。\n连接到此监听器的客户端将继承在此 zone 名称下创建的 zone 设置。\n\n一个 zone 可以覆盖以下根名称下的配置：\n- `mqtt`\n- `force_shutdown`\n- `force_gc`\n- `flapping_detect`\n- `durable_sessions`"
emqx_schema.base_listener_zone.label = "Zone"
emqx_schema.broker.desc = "Broker 相关配置项。"
emqx_schema.broker_enable_session_registry.desc = "是否启用 Session Registry"
emqx_schema.broker_perf_async_fanout_shard_dispatch.desc = "启用后，高扩展主题中位于订阅者分片的订阅者将通过代理池异步并发分发。"
emqx_schema.broker_perf_route_lock_type.desc = "通配符主题订阅/取消订阅性能调优。\n建议仅当通配符主题较多时才更改此参数。\n\n注：当从 `global` 锁更改或更改为 `gloabal` 锁时，它要求集群中的所有节点在更改之前停止。\n  - `key`：为 mnesia 事务涉及到的每个 key 上锁，建议单节点时使用。\n  - `tab`：为 mnesia 事务涉及到的表上锁，建议在集群中使用。\n  - `global`：所以更新操作都被全局的锁保护，仅建议在超大规模集群中使用。"
emqx_schema.broker_perf_trie_compaction.desc = "是否开启主题表压缩存储。\n启用它会显着提高通配符主题订阅率，如果通配符主题具有唯一前缀，例如：'sensor/{{id}}/+/'，其中每个订阅者的 ID 是唯一的。\n如果消息主要发布到具有大量级别的主题，则主题匹配性能（发布时）可能会降低。\n\n注意：这是一个集群范围的配置。 它要求在更改之前停止所有节点。"
emqx_schema.broker_routing_batch_sync_enable_on.desc = "启用一个专门的进程池，能够批量地将订阅信息与全局路由表同步。\n特别适用于减少可能由于网络延迟导致的跨节点通信的减慢，还可能在其他场景下减轻代理池的负载，从而最大限度地减少了过载的风险。\n选定的值决定哪些节点在集群中将启用此功能。\n- <code>all</code>: 在每个节点上无条件启用，\n- <code>replicant</code>: 仅在复制节点上启用（例如那些<code>node.role = replicant</code>的节点），\n- <code>core</code>: 仅在核心节点上启用，\n- <code>none</code>: 完全禁用此功能。"
emqx_schema.broker_routing_storage_schema.desc = "路由存储模式。\n设置为 <code>v1</code> 以保留默认设置。\n<code>v2</code> 在版本 5.2 中引入。它允许通过两个单独的表进行路由，一个用于主题过滤，一个用于常规主题订阅。这个模式会同时提高订阅和路由性能，但会略微增加每个订阅的内存消耗。\n注意：模式 <code>v2</code> 仍然处于实验阶段。\n注意：更改此选项后，需要进行完整的非滚动集群重启才能生效。"
emqx_schema.broker_session_history_retain.desc = "保留会话注册历史记录的持续时间。将此值设置为大于 0s 的值会增加内存使用并影响性能。\n这个保留的历史记录可以用来监控过去配置的持续时间内注册了多少会话。\n注意：如果 enable_session_registry 设置为 false，则此配置无效。<br/>\n注意：如果客户端使用随机客户端 ID，则不建议启用此功能，至少不是长时间保留。<br/>\n注意：在集群中，集群内节点中的最低（但大于 0s）值将生效。"
emqx_schema.broker_session_locking_strategy.desc = "Session 在集群中的锁策略。\n  - `loca`：仅锁本节点的 Session；\n  - `one`：任选一个其它节点加锁；\n  - `quorum`：选择集群中半数以上的节点加锁；\n  - `all`：选择所有节点加锁。"
emqx_schema.broker_shared_dispatch_ack_enabled.desc = "该配置项已废弃。\n启用/禁用 QoS 1 和 QoS 2 消息的共享派发确认。\n该配置最初设计用于避免将消息派发给客户端离线状态下的会话中去。\n但新版本中，已做增强：在一个会话结束时，会话中的消息会重新派发到组内的其他会话中 -- 使这个老配置失去存在的意义。"
emqx_schema.ciphers_schema_common.desc = "此配置保存由逗号分隔的 TLS 密码套件名称，或作为字符串数组。例如\n<code>\"TLS_AES_256_GCM_SHA384,TLS_AES_128_GCM_SHA256\"</code>或\n<code>[\"TLS_AES_256_GCM_SHA384\",\"TLS_AES_128_GCM_SHA256\"]</code>。\n<br/>\n密码（及其顺序）定义了客户端和服务器通过网络连接加密信息的方式。\n选择一个好的密码套件对于应用程序的数据安全性、机密性和性能至关重要。\n\n名称应为 OpenSSL 字符串格式（而不是 RFC 格式）。\nEMQX 配置文档提供的所有默认值和示例都是 OpenSSL 格式<br/>\n注意：某些密码套件仅与特定的 TLS <code>版本</code>兼容（'tlsv1.1'、'tlsv1.2'或'tlsv1.3'）。\n不兼容的密码套件将被自动删除。\n\n例如，如果只有 <code>versions</code> 仅配置为 <code>tlsv1.3</code>。为其他版本配置密码套件将无效。\n\n<br/>\n注：PSK 的 Ciphers 不支持 tlsv1.3<br/>\n如果打算使用 PSK 密码套件, <code>tlsv1.3</code> 应在<code>ssl.versions</code>中禁用。\n\n<br/>\nPSK 密码套件：\n<code>\"RSA-PSK-AES256-GCM-SHA384,RSA-PSK-AES256-CBC-SHA384,\nRSA-PSK-AES128-GCM-SHA256,RSA-PSK-AES128-CBC-SHA256,\nRSA-PSK-AES256-CBC-SHA,RSA-PSK-AES128-CBC-SHA,\nRSA-PSK-DES-CBC3-SHA,RSA-PSK-RC4-SHA\"</code>"
emqx_schema.ciphers_schema_common.label = ""
emqx_schema.ciphers_schema_quic.desc = "此配置保存由逗号分隔的 TLS 密码套件名称，或作为字符串数组。例如\n<code>\"TLS_AES_256_GCM_SHA384,TLS_AES_128_GCM_SHA256\"</code>或\n<code>[\"TLS_AES_256_GCM_SHA384\",\"TLS_AES_128_GCM_SHA256\"]</code>。\n<br/>\n密码（及其顺序）定义了客户端和服务器通过网络连接加密信息的方式。\n选择一个好的密码套件对于应用程序的数据安全性、机密性和性能至关重要。\n\n名称应为 OpenSSL 字符串格式（而不是 RFC 格式）。\nEMQX 配置文档提供的所有默认值和示例都是 OpenSSL 格式。<br/>\n注意：某些密码套件仅与特定的 TLS <code>版本</code>兼容（'tlsv1.1'、'tlsv1.2'或'tlsv1.3'）。\n不兼容的密码套件将被自动删除。\n\n例如，如果只有 <code>versions</code> 仅配置为 <code>tlsv1.3</code>。为其他版本配置密码套件将无效。\n\n<br/>\n注：PSK 的 Ciphers 不支持 tlsv1.3。<br/>\n如果打算使用 PSK 密码套件，<code>tlsv1.3</code> 应在 <code>ssl.versions</code> 中禁用。\n\n<br/>\nPSK 密码套件：\n<code>\"RSA-PSK-AES256-GCM-SHA384,RSA-PSK-AES256-CBC-SHA384,\nRSA-PSK-AES128-GCM-SHA256,RSA-PSK-AES128-CBC-SHA256,\nRSA-PSK-AES256-CBC-SHA,RSA-PSK-AES128-CBC-SHA,\nRSA-PSK-DES-CBC3-SHA,RSA-PSK-RC4-SHA\"</code><br/>\n\n注：QUIC 监听器只支持 tlsv1.3 的 ciphers。"
emqx_schema.ciphers_schema_quic.label = ""
emqx_schema.client_attrs_init.desc = "指定如何初始化客户端属性。每个属性可被初始化为 `client_attrs.{NAME}` ，其中 `{NAME}` 是在配置字段 `set_as_attr` 中指定的属性名称。初始化的客户端属性将以指定的名称存储在 `client_attrs` 属性中，并使用指定的名称，可以作为变量来渲染挂载点、身份认证和授权请求的模板。例如，当 `set_as_attr = alias` 时，使用 `${client_attrs.alias}` 来渲染 HTTP POST 请求体，或者为主题命名空间渲染监听器配置 `moutpoint = devices/${client_attrs.alias}/`。"
emqx_schema.client_attrs_init.label = "客户端属性初始化"
emqx_schema.client_attrs_init_expression.desc = "单行表达式，用于解析一组预定义的字符串函数（类似规则引擎 SQL 语句中的函数）。\n表达式可以是带有嵌套调用的函数调用，或直接变量引用。\n目前，它不提供用户定义的变量绑定（如 `var a=1`）或用户定义的函数。\n例如，提取以点分隔的客户端 ID 的前缀：`nth(1, tokens(clientid, '.'))`。\n\n预绑定的变量包括：\n- `clientid`：MQTT 客户端 ID。\n- `username`：MQTT 客户端的用户名。\n- `user_property.{NAME}`：CONNECT 包中的用户属性。\n- `zone`：监听器的配置区域。\n- `listener`：客户端连接的监听器 ID（如 `tcp:default`）。\n对于 TLS 客户端，直接连接或通过启用代理协议（v2）负载均衡器连接时，\n还可以使用一些额外的变量：\n- `cn`：客户端的 TLS 证书公共名称。\n- `cert_common_name`：`cn` 的别名。\n- `dn`：客户端的 TLS 证书区分名称（主体）。\n- `cert_subject`：`dn` 的别名。\n对于直接连接的 TLS 客户端，可使用客户端证书中的主题备用名称：\n- `cert_san.dns`：客户端证书中的 DNS 名称。\n- `cert_san.ip`：客户端证书中的 IP 地址。\n- `cert_san.email`：客户端证书中的邮箱地址。\n- `cert_san.uri`：客户端证书中的 URI。\n- `peersni`：客户端发送的 TLS 服务器名称指示。\n\n您可以在 EMQX 文档中阅读更多关于变量表达式的信息。"
emqx_schema.client_attrs_init_expression.label = "客户端属性提取正则表达式"
emqx_schema.client_attrs_init_set_as_attr.desc = "从客户端数据中提取的客户端属性的名称。\n提取的属性将以此名称存储在 `client_attrs` 属性中。"
emqx_schema.client_attrs_init_set_as_attr.label = "命名提取的属性"
emqx_schema.client_ssl_opts_schema_enable.desc = "启用 TLS。"
emqx_schema.client_ssl_opts_schema_enable.label = "启用 TLS"
emqx_schema.client_ssl_opts_schema_middlebox_comp_mode.desc = "配置 TLS-1.3 连接的中间盒兼容模式。\n\n大量中间盒在协商 TLS-1.3 连接时表现不佳。通过将 TLS-1.3 握手调整为类似于 TLS-1.2 握手的方式，可以增加通过这些中间盒建立连接的机会。"
emqx_schema.client_ssl_opts_schema_middlebox_comp_mode.label = "中间盒兼容模式"
emqx_schema.client_ssl_opts_schema_server_name_indication.desc = "指定要在 TLS 服务器名称指示扩展中使用的主机名。<br/>\n例如，当连接到 \"server.example.net\" 时，接受连接并执行 TLS 握手的真正服务器可能与 TLS 客户端最初连接到的主机不同，\n例如，当连接到 IP 地址时，或者当主机具有多个可解析的 DNS 记录时<br/>\n如果未指定，它将默认为使用的主机名字符串\n建立连接，除非使用 IP 地址<br/>\n然后，主机名也用于对等机的主机名验证证书<br/>\n特殊值 <code>disable</code> 阻止发送服务器名称指示扩展，并禁用主机名验证检查。"
emqx_schema.client_ssl_opts_schema_server_name_indication.label = "服务器名称指示"
emqx_schema.client_tcp_opts.desc = "用于出站 MQTT 客户端连接的 TCP socket 选项。\n所有字段均为可选；未设置的字段将保留操作系统或 `gen_tcp` 默认值。"
emqx_schema.client_tcp_opts.label = "客户端 TCP 选项"
emqx_schema.clientid_override.desc = "使用 Variform 表达式覆盖客户端 ID。\n例如：`concat(client_attrs.tns, '-', clientid)` 添加命名空间作为前缀。\n这允许不同命名空间的客户端使用相同的客户端 ID 连接而不冲突。\n有关表达式语法，请参阅 EMQX 文档。"
emqx_schema.clientid_override.label = "客户端 ID 覆盖表达式"
emqx_schema.common_ssl_opts_schema_cacertfile.desc = "受信任的 PEM 格式 CA  证书捆绑文件<br/>\n此文件中的证书用于验证 TLS 对等方的证书。\n如果要信任新 CA，请将新证书附加到文件中。\n无需重启 EMQX 即可加载更新的文件，因为系统会定期检查文件是否已更新（并重新加载）<br/>\n注意：从文件中失效（删除）证书不会影响已建立的连接。"
emqx_schema.common_ssl_opts_schema_cacertfile.label = "CA 证书文件"
emqx_schema.common_ssl_opts_schema_certfile.desc = "PEM 格式证书链文件<br/>\n此文件中的证书应与证书颁发链的顺序相反。也就是说，主机的证书应该放在文件的开头，\n然后是直接颁发者 CA 证书，依此类推，一直到根 CA 证书。\n根 CA 证书是可选的，如果想要添加，应加到文件到最末端。"
emqx_schema.common_ssl_opts_schema_certfile.label = "证书文件"
emqx_schema.common_ssl_opts_schema_depth.desc = "在有效的证书路径中，可以跟随对等证书的非自颁发中间证书的最大数量。\n因此，如果深度为 0，则对等方必须由受信任的根 CA 直接签名；<br/>\n如果是 1，路径可以是 PEER、中间 CA、ROOT-CA；<br/>\n如果是 2，则路径可以是 PEER、中间 CA1、中间 CA2、ROOT-CA。"
emqx_schema.common_ssl_opts_schema_depth.label = "CA 证书深度"
emqx_schema.common_ssl_opts_schema_hibernate_after.desc = "指定 SSL 进程在空闲后休眠的时间，从而减少其内存占用。\n\n当有新消息到达时，休眠的进程将被唤醒。\n过于频繁地休眠和唤醒可能会导致 CPU 使用率增加，因为这两个操作都会对进程进行垃圾回收。"
emqx_schema.common_ssl_opts_schema_hibernate_after.label = "休眠时间为"
emqx_schema.common_ssl_opts_schema_keyfile.desc = "PEM 格式的私钥文件。"
emqx_schema.common_ssl_opts_schema_keyfile.label = "私钥文件"
emqx_schema.common_ssl_opts_schema_log_level.desc = "SSL 握手的日志级别。默认值是 'notice'，可以设置为 'debug' 用来调查 SSL 握手的问题。"
emqx_schema.common_ssl_opts_schema_log_level.label = "SSL 日志级别"
emqx_schema.common_ssl_opts_schema_managed_certs.desc = "EMQX 管理的证书文件捆绑包的引用。\n\n如果使用此选项，`cacertfile`、`certfile`、`keyfile` 和 `password` 将被忽略。"
emqx_schema.common_ssl_opts_schema_managed_certs.label = "托管证书"
emqx_schema.common_ssl_opts_schema_partial_chain.desc = "启用或禁用使用 partial_chain 的对等验证。\n在 x509 路径验证过程中，本地验证对等证书时，它会构建一个从对等证书开始到信任锚结束的证书链。\n默认情况下，如果设置为 `false`，信任锚是根 CA，证书链必须完整。\n但是，如果设置为 `true` 或 `cacert_from_cacertfile`，则 `cacertfile` 中的最后一个证书将用作信任锚证书（中间 CA）。这在路径验证中创建了一个部分链。\n或者，如果配置为 `two_cacerts_from_cacertfile`，则 `cacertfile` 中的最后两个证书之一将用作信任锚证书，形成部分链。此选项特别适用于中间 CA 证书轮换。\n但是，请注意，这会产生一些额外的开销，因此应仅用于证书轮换目的。"
emqx_schema.common_ssl_opts_schema_partial_chain.label = "部分链"
emqx_schema.common_ssl_opts_schema_password.desc = "包含用户密码的字符串。仅在私钥文件受密码保护时使用。<br/>\n如需从文件加载密码而不是内联写入，请使用 <code>file://&lt;path-to-file&gt;</code> 形式。文件内容（去除末尾空白）将作为密码使用。集群模式下，该文件必须存在于所有 EMQX 节点。"
emqx_schema.common_ssl_opts_schema_password.label = "秘钥文件密码"
emqx_schema.common_ssl_opts_schema_reuse_sessions.desc = "启用 TLS 会话重用。"
emqx_schema.common_ssl_opts_schema_reuse_sessions.label = "TLS 会话重用"
emqx_schema.common_ssl_opts_schema_secure_renegotiate.desc = "SSL 参数重新协商是一种允许客户端和服务器动态重新协商 SSL 连接参数的功能。\nRFC 5746 定义了一种更安全的方法。通过启用安全的重新协商，您就失去了对不安全的重新协商的支持，从而容易受到 MitM 攻击。"
emqx_schema.common_ssl_opts_schema_secure_renegotiate.label = "SSL 重新协商"
emqx_schema.common_ssl_opts_schema_verify.desc = "启用或禁用对等验证。"
emqx_schema.common_ssl_opts_schema_verify.label = "对等验证"
emqx_schema.common_ssl_opts_schema_versions.desc = "支持所有 TLS/DTLS 版本<br/>\n注：PSK 的 Ciphers 无法在 <code>tlsv1.3</code> 中使用，如果打算使用 PSK 密码套件，请确保这里配置为 <code>[\"tlsv1.2\",\"tlsv1.1\"]</code>。"
emqx_schema.common_ssl_opts_schema_versions.label = "SSL 版本"
emqx_schema.common_ssl_opts_verify_peer_ext_key_usage.desc = "验证对等证书中的扩展密钥用法\n为了额外的对等证书验证，这里定义的值必须出现在对等证书的 '扩展密钥用法' 中，\n如 [rfc5280](https://www.rfc-editor.org/rfc/rfc5280#section-4.2.1.12) 中定义。\n\n允许的值有\n- `clientAuth`\n- `serverAuth`\n- `codeSigning`\n- `emailProtection`\n- `timeStamping`\n- `ocspSigning`\n- 原始 OID，例如：\"OID:1.3.6.1.5.5.7.3.2\" 表示 `id-pk 2`，相当于 `clientAuth`\n\n也支持用逗号分隔的字符串来验证多个密钥用法。\n\n例如，`\"serverAuth,OID:1.3.6.1.5.5.7.3.2\"`"
emqx_schema.common_ssl_opts_verify_peer_ext_key_usage.label = "验证证书中的 KeyUsage"
emqx_schema.config_backup_interval.desc = "备份 `cluster.hocon` 配置文件的时间间隔。即使在该时间间隔内进行了多次配置更新，也只会创建一次备份，包含当前的最新配置。"
emqx_schema.config_backup_interval.label = "配置备份间隔"
emqx_schema.conn_congestion_enable_alarm.desc = "启用或者禁用连接阻塞告警功能。"
emqx_schema.conn_congestion_enable_alarm.label = "启用/禁用阻塞告警"
emqx_schema.conn_congestion_min_alarm_sustain_duration.desc = "清除告警前的最短时间。<br/>只有当队列中没有挂起的数据，并且连接至少被堵塞了 <code>min_alarm_sustain_duration</code> 毫秒时，<br/>报警才会被清除。这是为了避免太频繁地清除和再次发出告警。"
emqx_schema.conn_congestion_min_alarm_sustain_duration.label = "告警维持时间"
emqx_schema.crl_cache_capacity.desc = "缓存中可容纳的 CRL URL 的最大数量。 如果缓存的大小已满，并且必须获取一个新的 URL，那么它将驱逐缓存中插入的最老的 URL。"
emqx_schema.crl_cache_capacity.label = "CRL 缓存大小"
emqx_schema.crl_cache_failure_threshold.desc = "失败阈值"
emqx_schema.crl_cache_failure_threshold.label = "指定当某个 URL 持续刷新失败达到设定时间后，系统将其从缓存中移除。"
emqx_schema.crl_cache_refresh_http_timeout.desc = "获取 CRLs 时 HTTP 请求的超时。 该配置对所有启用 CRL 检查的监听器监听器有效。"
emqx_schema.crl_cache_refresh_http_timeout.label = "CRL 缓存刷新 HTTP 超时"
emqx_schema.crl_cache_refresh_interval.desc = "从服务器刷新 CRL 的周期。 该配置对所有 URL 和监听器有效。"
emqx_schema.crl_cache_refresh_interval.label = "CRL 缓存刷新间隔"
emqx_schema.description.desc = "描述性文本。"
emqx_schema.description.label = "描述"
emqx_schema.ds_shared_sub_checkpoint_interval.desc = "共享订阅领导者定期将主题重放的进度提交到数据库。\n此参数指定此类提交之间的最小间隔。"
emqx_schema.ds_shared_sub_checkpoint_interval.label = "检查点间隔"
emqx_schema.ds_shared_sub_realloc_interval.desc = "共享订阅领导者在此期间积累对组的更改（例如订阅者加入或离开组）\n然后在订阅者之间重新分配工作。\n\n这样做是为了避免在多个订阅者短时间内加入或离开组时进行不必要的工作。"
emqx_schema.ds_shared_sub_realloc_interval.label = "重新分配间隔"
emqx_schema.ds_shared_sub_revocation_timeout.desc = "给共享订阅者完成最后一批消息处理的最大时间。\n\n共享订阅组的重新平衡可能涉及从一个订阅者那里获取工作并将其转移给另一个订阅者。\n在此期间，允许第一个订阅者完成被撤销任务的剩余工作。\n\n如果订阅者未能及时回复，则会被踢出组，其所有工作将被重新分配。"
emqx_schema.ds_shared_sub_revocation_timeout.label = "撤销超时"
emqx_schema.durable_sessions.desc = "会话持久化功能的相关设置。"
emqx_schema.durable_sessions.label = "会话持久化"
emqx_schema.durable_sessions_enable.desc = "使用持久存储来持久化客户端会话。\n如果启用，会话和相应的消息将被持久存储，并在服务器停机时保留。\n\n::: warning\n发送到持久会话的消息会被存储在磁盘上。\n这不可避免地限制了系统的总体吞吐量。\n:::"
emqx_schema.durable_sessions_enable.label = "启用会话持久化"
emqx_schema.durable_shared_subs.desc = "与持久会话的共享订阅相关的配置。"
emqx_schema.durable_shared_subs.label = "持久共享订阅"
emqx_schema.durable_storage.desc = "与 EMQX 持久存储相关的配置。\n\nEMQX 使用持久存储来卸载各种数据到磁盘，如 MQTT 消息。"
emqx_schema.durable_storage.label = "持久存储"
emqx_schema.duration.desc = "时间间隔是一个包含数字和时间单位的字符串：\n  - `ms` 表示毫秒\n  - `s` 表示秒\n  - `m` 表示分钟\n  - `h` 表示小时\n或其组合：`1h5m0s`"
emqx_schema.duration.label = "持续时间"
emqx_schema.fields_authorization_deny_action.desc = "授权检查拒绝操作时的操作。"
emqx_schema.fields_authorization_deny_action.label = "授权检查拒绝操作时的操作"
emqx_schema.fields_authorization_no_match.desc = "如果用户或客户端不匹配 ACL 规则，或者从可配置授权源(比如内置数据库、HTTP API 或 PostgreSQL 等。)内未找\n到此类用户或客户端时，模式的认访问控制操作。\n在“授权”中查找更多详细信息。"
emqx_schema.fields_authorization_no_match.label = "未匹时的默认授权动作"
emqx_schema.fields_authz_cache_excludes.desc = "排除主题列表，列表内的主题将不会生成授权缓存。"
emqx_schema.fields_authz_cache_excludes.label = "排除主题列表"
emqx_schema.fields_cache_enable.desc = "启用或禁用授权缓存。"
emqx_schema.fields_cache_enable.label = "启用或禁用授权缓存"
emqx_schema.fields_cache_max_size.desc = "缓存项的最大数量。"
emqx_schema.fields_cache_max_size.label = "缓存项的最大数量"
emqx_schema.fields_cache_ttl.desc = "缓存数据的生存时间。"
emqx_schema.fields_cache_ttl.label = "缓存数据的生存时间。"
emqx_schema.fields_client_tcp_opts_buffer.desc = "Erlang VM 为出站 MQTT 连接使用的用户态缓冲区大小。"
emqx_schema.fields_client_tcp_opts_buffer.label = "用户态缓冲区"
emqx_schema.fields_client_tcp_opts_delay_send.desc = "启用后，`gen_tcp` 可能会短暂排队小写入，将其合并为更大的 TCP 段。\n可提升发送大量小消息的发布端吞吐量，但会增加少量延迟。\n默认值：`false`。"
emqx_schema.fields_client_tcp_opts_delay_send.label = "延迟发送"
emqx_schema.fields_client_tcp_opts_keepalive.desc = "为出站 MQTT 连接启用 TCP `SO_KEEPALIVE` socket 选项。\n这是 OS 级 TCP 保活探测，独立于 MQTT 层的 keepalive。"
emqx_schema.fields_client_tcp_opts_keepalive.label = "TCP SO_KEEPALIVE"
emqx_schema.fields_client_tcp_opts_nodelay.desc = "出站 TCP 连接的 `TCP_NODELAY` 标志。\n设置为 `true` 时，数据将立即发送，不论大小。"
emqx_schema.fields_client_tcp_opts_nodelay.label = "禁用延迟"
emqx_schema.fields_client_tcp_opts_recbuf.desc = "出站 MQTT 连接的 TCP 接收缓冲区（OS 内核）大小。"
emqx_schema.fields_client_tcp_opts_recbuf.label = "TCP 接收缓冲区"
emqx_schema.fields_client_tcp_opts_sndbuf.desc = "出站 MQTT 连接的 TCP 发送缓冲区（OS 内核）大小。"
emqx_schema.fields_client_tcp_opts_sndbuf.label = "TCP 发送缓冲区"
emqx_schema.fields_deflate_opts_client_context_takeover.desc = "接管意味着在客户端消息之间保留压缩状态。"
emqx_schema.fields_deflate_opts_client_context_takeover.label = "客户端上下文接管"
emqx_schema.fields_deflate_opts_client_max_window_bits.desc = "指定客户端压缩上下文的大小。"
emqx_schema.fields_deflate_opts_client_max_window_bits.label = "压缩窗口大小"
emqx_schema.fields_deflate_opts_level.desc = "压缩级别"
emqx_schema.fields_deflate_opts_level.label = "压缩级别"
emqx_schema.fields_deflate_opts_mem_level.desc = "指定压缩状态的大小<br/>\n较低的值会减少每个连接的内存使用。"
emqx_schema.fields_deflate_opts_mem_level.label = "压缩状态大小"
emqx_schema.fields_deflate_opts_server_context_takeover.desc = "接管意味着在服务器消息之间保留压缩状态。"
emqx_schema.fields_deflate_opts_server_context_takeover.label = "服务上下文接管"
emqx_schema.fields_deflate_opts_server_max_window_bits.desc = "指定服务器压缩上下文的大小。"
emqx_schema.fields_deflate_opts_server_max_window_bits.label = "服务器压缩窗口大小"
emqx_schema.fields_deflate_opts_strategy.desc = "指定压缩策略。"
emqx_schema.fields_deflate_opts_strategy.label = "指定压缩策略"
emqx_schema.fields_listener_enabled.desc = "启停监听器。"
emqx_schema.fields_listener_enabled.label = "启停监听器"
emqx_schema.fields_listeners_quic.desc = "QUIC 监听器。"
emqx_schema.fields_listeners_quic.label = "QUIC 监听器"
emqx_schema.fields_listeners_ssl.desc = "SSL 监听器。"
emqx_schema.fields_listeners_ssl.label = "SSL 监听器"
emqx_schema.fields_listeners_tcp.desc = "TCP 监听器。"
emqx_schema.fields_listeners_tcp.label = "TCP 监听器"
emqx_schema.fields_listeners_ws.desc = "HTTP websocket 监听器。"
emqx_schema.fields_listeners_ws.label = "HTTP websocket 监听器"
emqx_schema.fields_listeners_wss.desc = "HTTPS websocket 监听器。"
emqx_schema.fields_listeners_wss.label = "HTTPS websocket 监听器"
emqx_schema.fields_mqtt_opts_parse_unit.desc = "此设置指定 MQTT 解析时的数据处理粒度，决定从字节流中提取和解析 MQTT 帧的方式：\n\n- `chunk`：按传输层数据包级别处理帧。此方式使用原始字节块作为解析单位，需要应用逻辑自行组装和解析 MQTT 帧。每个数据块的大小不确定，受传输速率、socket 缓冲区大小及其他内核设置影响。\n- `frame`：按完整的 MQTT 消息处理帧。此方式确保应用逻辑仅接收完整的 MQTT 帧进行处理。在大多数情况下，它比 `chunk` 选项具有更好的性能。\n\n请注意，`parse_unit` 的选择会影响 `active_n` 设置的解释方式：它决定了传递到连接进程的是原始字节块的数量还是完整的 MQTT 消息数量。"
emqx_schema.fields_mqtt_opts_parse_unit.label = "MQTT 消息解析单位"
emqx_schema.fields_mqtt_opts_tcp_backend.desc = "指示侦听器应使用哪个 TCP 后端。\n\n- `gen_tcp`：自 EMQX 5.0 版本以来使用的标准后端。\n\n- `socket`：实验性后端，旨在改善消息延迟和计算资源使用。\n    请注意，使用此后端时，某些 `tcp_options` 设置将无效，例如：`high_watermark` 和 `send_timeout_close`。\n    \n更改后端需要重新启动侦听器，这将终止其所有活动连接。"
emqx_schema.fields_mqtt_opts_tcp_backend.label = "TCP 后端"
emqx_schema.fields_mqtt_quic_listener_certfile.desc = "证书文件。在 5.1 中会被废弃，使用 .ssl_options.certfile 代替。"
emqx_schema.fields_mqtt_quic_listener_certfile.label = "证书文件"
emqx_schema.fields_mqtt_quic_listener_conn_flow_control_window.desc = "连接的流控窗口。默认：16777216"
emqx_schema.fields_mqtt_quic_listener_conn_flow_control_window.label = "流控窗口"
emqx_schema.fields_mqtt_quic_listener_datagram_receive_enabled.desc = "宣传对 QUIC Datagram 扩展的支持。为将来保留。默认为 0（FALSE）"
emqx_schema.fields_mqtt_quic_listener_datagram_receive_enabled.label = "启用 Datagram 接收"
emqx_schema.fields_mqtt_quic_listener_disconnect_timeout_ms.desc = "在判定路径无效和断开连接之前，要等待多长时间的 ACK。默认：16000"
emqx_schema.fields_mqtt_quic_listener_disconnect_timeout_ms.label = "断开连接超时 毫秒"
emqx_schema.fields_mqtt_quic_listener_handshake_idle_timeout.desc = "一个握手在被丢弃之前可以空闲多长时间。"
emqx_schema.fields_mqtt_quic_listener_handshake_idle_timeout.label = "握手空闲超时时间"
emqx_schema.fields_mqtt_quic_listener_handshake_idle_timeout_ms.desc = "一个握手在被丢弃之前可以空闲多长时间"
emqx_schema.fields_mqtt_quic_listener_handshake_idle_timeout_ms.label = "握手空闲超时 毫秒"
emqx_schema.fields_mqtt_quic_listener_idle_timeout.desc = "一个连接在被关闭之前可以空闲多长时间。0 表示禁用。"
emqx_schema.fields_mqtt_quic_listener_idle_timeout.label = "空闲超时时间"
emqx_schema.fields_mqtt_quic_listener_idle_timeout_ms.desc = "一个连接在被优雅地关闭之前可以空闲多长时间。0 表示禁用超时"
emqx_schema.fields_mqtt_quic_listener_idle_timeout_ms.label = "空闲超时 毫秒"
emqx_schema.fields_mqtt_quic_listener_initial_rtt_ms.desc = "初始 RTT 估计"
emqx_schema.fields_mqtt_quic_listener_initial_rtt_ms.label = "Initial RTT 毫秒"
emqx_schema.fields_mqtt_quic_listener_initial_window_packets.desc = "一个连接的初始拥堵窗口的大小（以包为单位）。默认值：10"
emqx_schema.fields_mqtt_quic_listener_initial_window_packets.label = "初始窗口数据包"
emqx_schema.fields_mqtt_quic_listener_keep_alive_interval.desc = "发送 PING 帧的频率，以保活连接. 设为 0 表示禁用。"
emqx_schema.fields_mqtt_quic_listener_keep_alive_interval.label = "Keep Alive 间隔"
emqx_schema.fields_mqtt_quic_listener_keep_alive_interval_ms.desc = "多长时间发送一次 PING 帧以保活连接。"
emqx_schema.fields_mqtt_quic_listener_keep_alive_interval_ms.label = "Keep Alive 间隔毫秒"
emqx_schema.fields_mqtt_quic_listener_keyfile.desc = "私钥文件。在 5.1 中会被废弃，使用 .ssl_options.keyfile 代替。"
emqx_schema.fields_mqtt_quic_listener_keyfile.label = "私钥文件"
emqx_schema.fields_mqtt_quic_listener_load_balancing_mode.desc = "0: 禁用, 1: SERVER_ID_IP, 2: SERVER_ID_FIXED. 默认: 0"
emqx_schema.fields_mqtt_quic_listener_load_balancing_mode.label = "负载平衡模式"
emqx_schema.fields_mqtt_quic_listener_max_ack_delay_ms.desc = "在收到数据后要等待多长时间才能发送一个 ACK。默认值：25"
emqx_schema.fields_mqtt_quic_listener_max_ack_delay_ms.label = "最大应答延迟 毫秒"
emqx_schema.fields_mqtt_quic_listener_max_binding_stateless_operations.desc = "在任何时候可以在一个绑定上排队的无状态操作的最大数量。默认值：100"
emqx_schema.fields_mqtt_quic_listener_max_binding_stateless_operations.label = "最大绑定无状态操作"
emqx_schema.fields_mqtt_quic_listener_max_bytes_per_key.desc = "在启动密钥更新之前，用单个 1-RTT 加密密钥加密的最大字节数。默认值：274877906944"
emqx_schema.fields_mqtt_quic_listener_max_bytes_per_key.label = "每个密钥的最大字节数"
emqx_schema.fields_mqtt_quic_listener_max_operations_per_drain.desc = "每个连接操作的最大耗费操作数。默认：16"
emqx_schema.fields_mqtt_quic_listener_max_operations_per_drain.label = "每次操作最大操作数"
emqx_schema.fields_mqtt_quic_listener_max_stateless_operations.desc = "无状态操作的最大数量，在任何时候都可以在一个工作者上排队。默认值：16"
emqx_schema.fields_mqtt_quic_listener_max_stateless_operations.label = "最大无状态操作数"
emqx_schema.fields_mqtt_quic_listener_maximum_mtu.desc = "一个连接所支持的最大 MTU。这将是最大的探测值。默认值：1500"
emqx_schema.fields_mqtt_quic_listener_maximum_mtu.label = "最大 MTU"
emqx_schema.fields_mqtt_quic_listener_migration_enabled.desc = "开启客户端地址迁移功能。需要一个支持的负载平衡器，或者没有负载平衡器。默认值：1（已启用）"
emqx_schema.fields_mqtt_quic_listener_migration_enabled.label = "启用地址迁移"
emqx_schema.fields_mqtt_quic_listener_minimum_mtu.desc = "一个连接所支持的最小 MTU。这将被作为起始 MTU 使用。默认值：1248"
emqx_schema.fields_mqtt_quic_listener_minimum_mtu.label = "最小 MTU"
emqx_schema.fields_mqtt_quic_listener_mtu_discovery_missing_probe_count.desc = "在任何时候都可以在一个绑定上排队的无状态操作的最大数量。默认值：3"
emqx_schema.fields_mqtt_quic_listener_mtu_discovery_missing_probe_count.label = "MTU 发现丢失的探针数量"
emqx_schema.fields_mqtt_quic_listener_mtu_discovery_search_complete_timeout_us.desc = "如果没有达到 max ，在重新尝试 MTU 探测之前要等待的时间，单位是微秒。默认值：600000000"
emqx_schema.fields_mqtt_quic_listener_mtu_discovery_search_complete_timeout_us.label = "MTU 发现搜索完成超时（微秒）"
emqx_schema.fields_mqtt_quic_listener_pacing_enabled.desc = "有节奏的发送，以避免路径上的缓冲区过度填充。默认值：1（已启用）"
emqx_schema.fields_mqtt_quic_listener_pacing_enabled.label = "启用节奏发送"
emqx_schema.fields_mqtt_quic_listener_peer_bidi_stream_count.desc = "允许对端打开的双向流的数量"
emqx_schema.fields_mqtt_quic_listener_peer_bidi_stream_count.label = "对端双向流的数量"
emqx_schema.fields_mqtt_quic_listener_peer_unidi_stream_count.desc = "允许对端打开的单向流的数量"
emqx_schema.fields_mqtt_quic_listener_peer_unidi_stream_count.label = "对端单向流的数量"
emqx_schema.fields_mqtt_quic_listener_retry_memory_limit.desc = "在使用无状态重试之前，可用于握手连接的可用内存的百分比。计算为`N/65535`。默认值：65"
emqx_schema.fields_mqtt_quic_listener_retry_memory_limit.label = "重试内存限制"
emqx_schema.fields_mqtt_quic_listener_send_buffering_enabled.desc = "缓冲发送数据，而不是保留应用缓冲区，直到发送数据被确认。默认值：1（启用）"
emqx_schema.fields_mqtt_quic_listener_send_buffering_enabled.label = "启用发送缓冲功能"
emqx_schema.fields_mqtt_quic_listener_send_idle_timeout_ms.desc = "在闲置一定时间后重置拥堵控制。默认值：1000"
emqx_schema.fields_mqtt_quic_listener_send_idle_timeout_ms.label = "发送空闲超时毫秒"
emqx_schema.fields_mqtt_quic_listener_server_resumption_level.desc = "连接恢复 和/或 0-RTT 服务器支持。默认值：0（无恢复功能）"
emqx_schema.fields_mqtt_quic_listener_server_resumption_level.label = "服务端连接恢复支持"
emqx_schema.fields_mqtt_quic_listener_ssl_options.desc = "QUIC 传输层的 TLS 选项"
emqx_schema.fields_mqtt_quic_listener_ssl_options.label = "TLS 选项"
emqx_schema.fields_mqtt_quic_listener_sslkeylogfile.desc = "指定本地文件系统中文件的路径，监听器将在该文件中写入每个连接的 TLS 会话密钥，从而实现流量解密。此设置无法在运行时更改。"
emqx_schema.fields_mqtt_quic_listener_sslkeylogfile.label = "SSLKEYLOGFILE"
emqx_schema.fields_mqtt_quic_listener_stateless_operation_expiration_ms.desc = "同一个对端的操作之间的时间限制，单位是毫秒。 默认：100"
emqx_schema.fields_mqtt_quic_listener_stateless_operation_expiration_ms.label = "无状态操作过期 毫秒"
emqx_schema.fields_mqtt_quic_listener_stream_recv_buffer_default.desc = "流的初始缓冲区大小。默认：4096"
emqx_schema.fields_mqtt_quic_listener_stream_recv_buffer_default.label = "流媒体接收缓冲区默认值"
emqx_schema.fields_mqtt_quic_listener_stream_recv_window_default.desc = "初始流接收窗口大小。 默认值：32678"
emqx_schema.fields_mqtt_quic_listener_stream_recv_window_default.label = "流接收窗口默认"
emqx_schema.fields_mqtt_quic_listener_tls_server_max_send_buffer.desc = "缓冲多少 TLS 数据。 默认值：8192"
emqx_schema.fields_mqtt_quic_listener_tls_server_max_send_buffer.label = "TLS 服务器最大发送缓冲区"
emqx_schema.fields_rate_limit_conn_bytes_in.desc = "限制 MQTT 连接接收数据包的速率。 速率以每秒的数据包字节数计算。"
emqx_schema.fields_rate_limit_conn_bytes_in.label = "数据包速率"
emqx_schema.fields_rate_limit_conn_messages_in.desc = "外部 MQTT 连接的消息限制。"
emqx_schema.fields_rate_limit_conn_messages_in.label = "外部 MQTT 连接的消息限制"
emqx_schema.fields_rate_limit_max_conn_rate.desc = "每秒最大连接数。"
emqx_schema.fields_rate_limit_max_conn_rate.label = "每秒最大连接数"
emqx_schema.fields_tcp_opts_active_n.desc = "为此套接字指定{active，N}选项<br/>\nSee: https://erlang.org/doc/man/inet.html#setopts-2"
emqx_schema.fields_tcp_opts_active_n.label = "active_n"
emqx_schema.fields_tcp_opts_backlog.desc = "TCP backlog 定义了挂起连接队列可以增长到的最大长度。"
emqx_schema.fields_tcp_opts_backlog.label = "TCP 连接队列长度"
emqx_schema.fields_tcp_opts_buffer.desc = "驱动程序使用的用户空间缓冲区的大小。"
emqx_schema.fields_tcp_opts_buffer.label = "TCP 用户态缓冲区"
emqx_schema.fields_tcp_opts_high_watermark.desc = "当 VM 套接字实现内部排队的数据量达到此限制时，套接字将设置为忙碌状态。"
emqx_schema.fields_tcp_opts_high_watermark.label = "TCP 高水位线"
emqx_schema.fields_tcp_opts_keepalive.desc = "为通过 TCP 或 SSL 建立的 MQTT 连接启用 TCP keepalive。\n使用三个逗号分隔的数字（单位：秒）进行配置： 'Idle,Interval,Probes'\n - Idle: 在服务器开始发送 keepalive 探测包之前，连接需要处于空闲状态的秒数（Linux 默认为 7200 秒）。\n - Interval: 每次发送 TCP keepalive 探测包之间的间隔时间（Linux 默认 75 秒）。\n - Probes: 在未收到响应的情况下，最多发送多少次探测包后放弃并关闭连接（Linux 默认 9 次）。\n例如 \"240,30,5\" 表示：在连接空闲 240 秒后发送 TCP keepalive 探测，每隔 30 秒发送一次，直到收到响应，如果连续丢失 5 个响应，连接应该被关闭。\n默认值为：'none'，设置为 'none' 时将使用操作系统的默认 keepalive 设置（仍然启用，并非禁用）。"
emqx_schema.fields_tcp_opts_keepalive.label = "TCP keepalive 选项"
emqx_schema.fields_tcp_opts_nodelay.desc = "连接的 `TCP_NODELAY` 标志。\n当设置为 `true` 时，无论数据大小，都会立即发送数据。"
emqx_schema.fields_tcp_opts_nodelay.label = "无延迟"
emqx_schema.fields_tcp_opts_nolinger.desc = "启用时，`SO_LINGER` 标志设置为 `(onoff=1, linger=0)`，这意味着 TCP socket 将立即关闭，发送 TCP-RST 包，丢弃任何未发送的数据，并跳过正常关闭步骤，包括 CLOSE_WAIT、FIN_WAIT 和 TIME_WAIT。"
emqx_schema.fields_tcp_opts_nolinger.label = "无延迟关闭"
emqx_schema.fields_tcp_opts_recbuf.desc = "连接的 TCP 接收缓冲区（OS 内核）。"
emqx_schema.fields_tcp_opts_recbuf.label = "TCP 接收缓冲区"
emqx_schema.fields_tcp_opts_reuseaddr.desc = "连接的 SO_REUSEADDR 标识。"
emqx_schema.fields_tcp_opts_reuseaddr.label = "SO_REUSEADDR"
emqx_schema.fields_tcp_opts_send_timeout.desc = "连接的 TCP 发送超时。"
emqx_schema.fields_tcp_opts_send_timeout.label = "TCP 发送超时"
emqx_schema.fields_tcp_opts_send_timeout_close.desc = "如果发送超时，则关闭连接。"
emqx_schema.fields_tcp_opts_send_timeout_close.label = "TCP 发送超时关闭连接"
emqx_schema.fields_tcp_opts_sndbuf.desc = "连接的 TCP 发送缓冲区（OS 内核）。"
emqx_schema.fields_tcp_opts_sndbuf.label = "TCP 发送缓冲区"
emqx_schema.fields_trace_max_file_size.desc = "指定每个跟踪文件可以达到的最大大小。\n一旦跟踪文件达到此大小，即使跟踪仍然处于活动状态，也不会记录其他事件。"
emqx_schema.fields_trace_max_file_size.label = "最大跟踪文件大小"
emqx_schema.fields_trace_max_traces.desc = "指定允许同时存在的跟踪数量，无论其状态如何。"
emqx_schema.fields_trace_max_traces.label = "最大跟踪数"
emqx_schema.fields_trace_payload_encode.desc = "确定跟踪文件中有效负载格式的格式。<br/>\n`text`：基于文本的协议或纯文本协议。\n建议在有效负载为 JSON 编码时使用<br/>\n`hex`：二进制十六进制编码。当有效负载是自定义二进制协议时，建议使用此选项<br/>\n`hidden`：有效负载被模糊化为 `******`"
emqx_schema.fields_trace_payload_encode.label = "有效负载编码"
emqx_schema.fields_ws_opts_allow_origin_absence.desc = "如果设置为 <code>false</code> 并且 <code>check_origin_enable</code> 为 <code>true</code>，服务器将拒绝没有 <code>origin</code> HTTP 头的请求。"
emqx_schema.fields_ws_opts_allow_origin_absence.label = "允许 origin 缺失"
emqx_schema.fields_ws_opts_check_origin_enable.desc = "如果<code>true</code>，<code>origin</code>HTTP 头将根据<code>check_origins</code>参数中配置的允许来源列表进行验证。"
emqx_schema.fields_ws_opts_check_origin_enable.label = "检查 origin"
emqx_schema.fields_ws_opts_check_origins.desc = "允许的 origins 列表"
emqx_schema.fields_ws_opts_check_origins.label = "允许的 origins"
emqx_schema.fields_ws_opts_compress.desc = "如果 <code>true</code>，则使用 <code>zlib</code> 压缩 WebSocket 消息<br/>\n<code>deflate_opts</code> 下的配置项属于压缩相关参数配置。"
emqx_schema.fields_ws_opts_compress.label = "Ws 压缩"
emqx_schema.fields_ws_opts_fail_if_no_subprotocol.desc = "如果<code>true</code>，当客户端未携带<code>Sec WebSocket Protocol</code>字段时，服务器将返回一个错误。\n<br/>注意：微信小程序需要禁用此验证。"
emqx_schema.fields_ws_opts_fail_if_no_subprotocol.label = "无 subprotocol 则失败"
emqx_schema.fields_ws_opts_idle_timeout.desc = "关闭在此间隔内未发送 MQTT CONNECT 消息的客户端的传输层连接。"
emqx_schema.fields_ws_opts_idle_timeout.label = "WS 空闲时间"
emqx_schema.fields_ws_opts_max_frame_size.desc = "单个 MQTT 数据包的最大长度。"
emqx_schema.fields_ws_opts_max_frame_size.label = "最大数据包长度"
emqx_schema.fields_ws_opts_mqtt_path.desc = "WebSocket 的 MQTT 协议路径。因此，EMQX Broker 的 WebSocket 地址为：\n<code>ws://{ip}:{port}/mqtt</code>"
emqx_schema.fields_ws_opts_mqtt_path.label = "WS MQTT 路径"
emqx_schema.fields_ws_opts_mqtt_piggyback.desc = "WebSocket 消息是否允许包含多个 MQTT 数据包。"
emqx_schema.fields_ws_opts_mqtt_piggyback.label = "MQTT Piggyback"
emqx_schema.fields_ws_opts_proxy_address_header.desc = "HTTP 头，用于传递有关客户端 IP 地址的信息。\n当 EMQX 集群部署在负载平衡器后面时，这一点非常重要。"
emqx_schema.fields_ws_opts_proxy_address_header.label = "客户端地址头"
emqx_schema.fields_ws_opts_proxy_port_header.desc = "HTTP 头，用于传递有关客户端端口的信息。当 EMQX 集群部署在负载平衡器后面时，这一点非常重要。"
emqx_schema.fields_ws_opts_proxy_port_header.label = "客户端端口头"
emqx_schema.fields_ws_opts_supported_subprotocols.desc = "逗号分隔的 subprotocols 支持列表。"
emqx_schema.fields_ws_opts_supported_subprotocols.label = "Subprotocols 支持列表"
emqx_schema.fields_ws_opts_validate_utf8.desc = "设置为 <code>false</code> 可以禁用 WebSocket 帧 UTF-8 验证以提高性能。"
emqx_schema.fields_ws_opts_validate_utf8.label = "启用/禁用 WebSocket 帧 utf8 验证"
emqx_schema.flapping_detect_ban_time.desc = "抖动的客户端将会被禁止登录多长时间。"
emqx_schema.flapping_detect_ban_time.label = "禁止登录时长"
emqx_schema.flapping_detect_enable.desc = "启用抖动检测功能。"
emqx_schema.flapping_detect_enable.label = "启用抖动检测"
emqx_schema.flapping_detect_max_count.desc = "MQTT 客户端在“窗口”时间内允许的最大断开次数"
emqx_schema.flapping_detect_max_count.label = "最大断开次数"
emqx_schema.flapping_detect_window_time.desc = "抖动检测的时间窗口。"
emqx_schema.flapping_detect_window_time.label = "时间窗口"
emqx_schema.force_gc_bytes.desc = "在进程处理过多少个字节之后，对此进程执行垃圾回收。"
emqx_schema.force_gc_bytes.label = "垃圾回收字节数"
emqx_schema.force_gc_count.desc = "在进程收到多少消息之后，对此进程执行垃圾回收。"
emqx_schema.force_gc_count.label = "垃圾回收消息数"
emqx_schema.force_gc_enable.desc = "启用强制垃圾回收。"
emqx_schema.force_gc_enable.label = "启用强制垃圾回收"
emqx_schema.force_shutdown_enable.desc = "启用 `force_shutdown` 功能。"
emqx_schema.force_shutdown_enable.label = "启用 `force_shutdown` 功能"
emqx_schema.force_shutdown_max_heap_size.desc = "Heap 的总大小。"
emqx_schema.force_shutdown_max_heap_size.label = "Heap 的总大小"
emqx_schema.force_shutdown_max_mailbox_size.desc = "每个在线客户端在 EMQX 服务器中都是独立的一个进程。该配置可以设为单个进程的邮箱消息队列设置最大长度，当超过该上限时，客户端会被强制下线。"
emqx_schema.force_shutdown_max_mailbox_size.label = "进程邮箱消息数上限"
emqx_schema.listeners_root_doc.desc = "监听器配置按传输类型进行定义。\n每种传输类型都包含一个将监听器名称与其配置关联的映射。\n默认情况下，每种传输类型都包含一个名为 `default` 的监听器，该监听器不会在配置文件中显式声明。\n若要移除 `default` 监听器，可显式设置其配置为：`listeners.ws.default = marked_for_deletion`。\n\n另外，若希望禁用某个监听器但保留其配置内容，可将隐藏字段 `enable` 设置为 `false`，例如：`listeners.tcp.my_listener.enable = false`。"
emqx_schema.listeners_root_doc.label = "配置 MQTT 监听器"
emqx_schema.managed_certs_bundle_name.desc = "托管证书文件捆绑包的名称。"
emqx_schema.managed_certs_bundle_name.label = "托管证书捆绑包名称"
emqx_schema.managed_certs_ns.desc = "证书文件捆绑包所在的命名空间。省略此字段以定位全局命名空间。"
emqx_schema.managed_certs_ns.label = "托管证书命名空间"
emqx_schema.managed_certs_server.desc = "EMQX 管理的一个或多个证书文件捆绑包的引用。\n\n当使用引用数组时，监听器根据客户端请求的 SNI 动态选择证书。每个托管证书引用都有一个可选的 SNI 字段，用于表示该引用的 SNI。如果客户端请求的 SNI 在配置中没有匹配项，则数组中的第一个引用将用作默认证书捆绑包。\n\n如果使用此选项，`cacertfile`、`certfile`、`keyfile` 和 `password` 将被忽略。"
emqx_schema.managed_certs_server.label = "托管证书"
emqx_schema.managed_certs_server_sni.desc = "如果设置了此项，则在基于客户端发送的 SNI 进行动态证书选择时使用。"
emqx_schema.managed_certs_server_sni.label = "服务器名称指示"
emqx_schema.mqtt.desc = "全局的 MQTT 配置项。\nmqtt 下所有的配置作为全局的默认值存在，它可以被 <code>zone</code> 中的配置覆盖"
emqx_schema.mqtt_await_rel_timeout.desc = "客户端发布 QoS 2 消息时，服务器等待 `PUBREL` 的最长时延。超过该时长后服务器会放弃等待，该 PACKET ID 会被释放，从而允许后续新的 PUBLISH 消息使用。如果超时后收到 PUBREL，服务器将会产生一条告警日志。注意，向订阅客户端转发消息的动作发生在进入等待之前。"
emqx_schema.mqtt_await_rel_timeout.label = "PUBREL 最大等待时间"
emqx_schema.mqtt_exclusive_subscription.desc = "是否启用对 MQTT 排它订阅的支持。"
emqx_schema.mqtt_exclusive_subscription.label = "排它订阅"
emqx_schema.mqtt_idle_timeout.desc = "设置连接被断开或进入休眠状态前的等待时间，空闲超时后，\n  - 如暂未收到客户端的 CONNECT 报文，连接将断开；\n  - 如已收到客户端的 CONNECT 报文，连接将进入休眠模式以节省系统资源。\n\n注意：请合理设置该参数值，如等待时间设置过长，可能造成系统资源的浪费。"
emqx_schema.mqtt_idle_timeout.label = "空闲超时"
emqx_schema.mqtt_ignore_loop_deliver.desc = "设置由 MQTT v3.1.1/v3.1.0 客户端发布的消息是否将转发给其本身；类似 MQTT 5.0 协议中的 <code>No Local</code> 选项。"
emqx_schema.mqtt_ignore_loop_deliver.label = "忽略循环投递"
emqx_schema.mqtt_keepalive_check_interval.desc = "检查传入 MQTT 数据包的频率，决定服务器检查新 MQTT 数据包的频率。\n如果在没有客户端发送任何数据包的情况下经过了一定时间，这段时间将累加起来。\n一旦累积时间超过 `keepalive-interval * keepalive-multiplier`，连接将被终止。\n默认设置为 30 秒，最小值为 1 秒，最大值为 `keepalive-interval / 2`。"
emqx_schema.mqtt_keepalive_check_interval.label = "Keep Alive 检查间隔"
emqx_schema.mqtt_keepalive_multiplier.desc = "Keep-Alive 超时 = Keep-Alive 间隔 × Keep-Alive 倍数。默认值 1.5 遵循 MQTT 5.0 规范。此倍数可调整，为系统管理员提供根据特定需求进行定制的灵活性。例如，如果客户端的 10 秒 Keep-Alive 间隔的 PINGREQ 因为额外的 10 秒延迟，将倍数更改为 2 可以让 EMQX 容忍此延迟。"
emqx_schema.mqtt_keepalive_multiplier.label = "Keep Alive 倍数"
emqx_schema.mqtt_limiter.desc = "MQTT 相关的限流器配置。"
emqx_schema.mqtt_listener_access_rules.desc = "此监听器的访问控制规则。"
emqx_schema.mqtt_listener_access_rules.label = "访问控制规则"
emqx_schema.mqtt_listener_proxy_protocol.desc = "如果 EMQX 集群部署在 HAProxy 或 Nginx 之后，请启用代理协议 V1/2 <br/>\n详情见: https://www.haproxy.com/blog/haproxy/proxy-protocol/"
emqx_schema.mqtt_listener_proxy_protocol.label = "Proxy protocol"
emqx_schema.mqtt_listener_proxy_protocol_timeout.desc = "代理协议超时。如果在超时时间内未收到代理协议数据包，EMQX 将关闭 TCP 连接。"
emqx_schema.mqtt_listener_proxy_protocol_timeout.label = "Proxy protocol 超时时间"
emqx_schema.mqtt_max_awaiting_rel.desc = "每个发布者的会话中，都存在一个队列来处理客户端发送的 QoS 2 消息。该队列会存储 QoS 2 消息的报文 ID 直到收到客户端的 PUBREL 或超时，达到队列长度的限制后，新的 QoS 2 消息发布会被拒绝，并返回 `147(0x93)` 错误。"
emqx_schema.mqtt_max_awaiting_rel.label = "PUBREL 等待队列长度"
emqx_schema.mqtt_max_clientid_len.desc = "允许的最大 MQTT Client ID 长度。"
emqx_schema.mqtt_max_clientid_len.label = "最大 Client ID 长度"
emqx_schema.mqtt_max_inflight.desc = "允许在完成应答前同时投递的 QoS 1 和 QoS 2 消息的最大数量。"
emqx_schema.mqtt_max_inflight.label = "最大飞行窗口"
emqx_schema.mqtt_max_mqueue_len.desc = "消息队列最大长度。持久客户端断开连接或飞行窗口已满时排队的消息长度。"
emqx_schema.mqtt_max_mqueue_len.label = "最大消息队列长度"
emqx_schema.mqtt_max_packet_size.desc = "允许的最大 MQTT 报文大小。"
emqx_schema.mqtt_max_packet_size.label = "最大报文大小"
emqx_schema.mqtt_max_qos_allowed.desc = "允许的最大 QoS 等级。"
emqx_schema.mqtt_max_qos_allowed.label = "最大 QoS"
emqx_schema.mqtt_max_session_expiry_interval.desc = "限制 MQTT 5.0 客户端通过 `Session-Expiry-Interval` CONNECT 属性请求的最大会话过期间隔。若客户端请求更长值，服务器会静默将其限制到该上限（并按 MQTT 5.0 规范 3.2.2.3.2 在 CONNACK 的 `Session-Expiry-Interval` 属性中回传该限制值）。对 MQTT 3.1.1 / 3.1 客户端无影响，它们的会话过期完全由 `session_expiry_interval` 服务器端控制。默认值：`infinity`（不限制）。"
emqx_schema.mqtt_max_session_expiry_interval.label = "最大会话过期间隔"
emqx_schema.mqtt_max_subscriptions.desc = "允许每个客户端建立的最大订阅数量。"
emqx_schema.mqtt_max_subscriptions.label = "最大订阅数量"
emqx_schema.mqtt_max_topic_alias.desc = "允许的最大主题别名数，0 表示不支持主题别名。"
emqx_schema.mqtt_max_topic_alias.label = "最大主题别名"
emqx_schema.mqtt_max_topic_levels.desc = "允许的最大主题层级。"
emqx_schema.mqtt_max_topic_levels.label = "最大主题层级"
emqx_schema.mqtt_message_expiry_interval.desc = "MQTT 消息的过期间隔。对于 MQTT 5.0 客户端，此配置仅在消息中未设置 Message-Expiry-Interval 属性时生效；否则，将使用 Message-Expiry-Interval 属性的值。对于 5.0 之前的 MQTT 版本，此配置将始终生效。请注意，将 message_expiry_interval 设置为大于 session_expiry_interval 是没有意义的，因为会话过期时所有消息将被清除。"
emqx_schema.mqtt_message_expiry_interval.label = "消息过期间隔"
emqx_schema.mqtt_mqueue_default_priority.desc = "默认的主题优先级，不在 <code>主题优先级</code>（<code>mqueue_priorities</code>） 中的主题将会使用该优先级。"
emqx_schema.mqtt_mqueue_default_priority.label = "默认主题优先级"
emqx_schema.mqtt_mqueue_priorities.desc = "主题优先级。取值范围 [1-255]\n默认优先级表为空，即所有的主题优先级相同。\n\n注：优先主题名称中不支持使用逗号和等号。\n注：不在此列表中的主题，被视为最高/最低优先级，这取决于<code>mqtt.mqueue_default_priority</code> 的配置。\n\n示例：\n配置 <code>\"topic/1\" > \"topic/2\"</code>:\n<code>mqueue_priorities: {\"topic/1\": 10, \"topic/2\": 8}</code>"
emqx_schema.mqtt_mqueue_priorities.label = "主题优先级"
emqx_schema.mqtt_mqueue_store_qos0.desc = "指定在连接断开但会话保持期间，是否需要在消息队列中存储 QoS 0 消息。"
emqx_schema.mqtt_mqueue_store_qos0.label = "存储 QoS 0 消息"
emqx_schema.mqtt_peer_cert_as_clientid.desc = "使用对端证书中的 CN、DN 字段或整个证书内容来作为客户端 ID。仅适用于 TLS 连接；\n目前支持：\n- <code>cn</code>: 取证书的 CN 字段\n- <code>dn</code>: 取证书的 DN 字段\n- <code>crt</code>: 取 <code>DER</code> 或 <code>PEM</code> 证书的内容\n- <code>pem</code>: 将 <code>DER</code> 证书内容转换为 <code>PEM</code> 格式作为客户端 ID\n- <code>md5</code>: 取 <code>DER</code> 或 <code>PEM</code> 证书内容的 MD5 值"
emqx_schema.mqtt_peer_cert_as_clientid.label = "对端证书作为客户端 ID"
emqx_schema.mqtt_peer_cert_as_username.desc = "使用对端证书中的 CN、DN 字段或整个证书内容来作为用户名；仅适用于 TLS 连接。\n目前支持：\n- <code>cn</code>: 取证书的 CN 字段\n- <code>dn</code>: 取证书的 DN 字段\n- <code>crt</code>: 取 <code>DER</code> 或 <code>PEM</code> 的证书内容\n- <code>pem</code>: 将 <code>DER</code> 证书转换为 <code>PEM</code> 格式作为用户名\n- <code>md5</code>: 取 <code>DER</code> 或 <code>PEM</code> 证书内容的 MD5 值"
emqx_schema.mqtt_peer_cert_as_username.label = "对端证书作为用户名"
emqx_schema.mqtt_response_information.desc = "UTF-8 字符串，用于创建响应主题，例如，如果设置为 <code>reqrsp/</code>，发布者/订阅者将使用主题前缀 <code>reqrsp/</code> 进行通信。\n要禁用此功能，请在下方的文本框中留空。仅适用于 MQTT 5.0 客户端。"
emqx_schema.mqtt_response_information.label = "响应信息"
emqx_schema.mqtt_retain_available.desc = "是否启用对 MQTT 保留消息的支持。"
emqx_schema.mqtt_retain_available.label = "保留消息可用"
emqx_schema.mqtt_retry_interval.desc = "QoS 1/2 消息的重新投递间隔。"
emqx_schema.mqtt_retry_interval.label = "重试间隔"
emqx_schema.mqtt_server_keepalive.desc = "EMQX 要求的保活时间，如设为 disabled，则将使用客户端指定的保持连接时间；仅适用于 MQTT 5.0 客户端。"
emqx_schema.mqtt_server_keepalive.label = "服务端保活时间"
emqx_schema.mqtt_session_expiry_interval.desc = "指定会话将在连接断开后多久过期，仅适用于非 MQTT 5.0 的连接。"
emqx_schema.mqtt_session_expiry_interval.label = "会话过期间隔"
emqx_schema.mqtt_shared_subscription.desc = "是否启用对 MQTT 共享订阅的支持。"
emqx_schema.mqtt_shared_subscription.label = "共享订阅可用"
emqx_schema.mqtt_shared_subscription_initial_sticky_pick.desc = "当 shared_subscription_strategy 为 `sticky` 时，初始订阅者选择的策略。\n - `random`: 随机选择订阅者；\n - `local`: 随机选择当前节点上的订阅者，如果当前节点上没有订阅者，则在集群中随机选择；\n - `hash_clientid`: 根据发布者的客户端 ID 进行哈希，选择订阅者；\n - `hash_topic`: 根据发布的主题进行哈希，选择订阅者。"
emqx_schema.mqtt_shared_subscription_strategy.desc = "共享订阅的分发策略。\nEMQX 将 **分发状态**（如随机种子、轮询位置和粘性订阅者选择）作为 **发布客户端连接状态** 的一部分进行维护。\n如果发布客户端断开连接并重新连接，则此状态会丢失，必须重新初始化。\n\n- `random`：随机选择一个订阅者进行分发；\n- `round_robin`：共享订阅组中的客户端将依次消费消息，每个发布者独立记录循环进度，因此来自**不同发布者**的两个相邻消息可能会被订阅组中的同一客户端消费；\n- `round_robin_per_group`：共享订阅组中的客户端将依次消费消息，每个节点独立记录循环进度，因此来自**不同节点**的两个相邻消息可能会被订阅组中的同一客户端消费；\n- `local`：随机选择当前节点上的一个订阅者，如果当前节点没有订阅者，则在集群内随机选择；\n- `sticky`：持续将消息分发给最初选择的订阅者，直到他们的会话结束。初始选择基于 `mqtt_shared_subscription_initial_sticky_pick`；\n- `hash_clientid`：哈希发布者的客户端 ID 以选择订阅者；\n- `hash_topic`：哈希发布主题以选择订阅者。"
emqx_schema.mqtt_strict_mode.desc = "是否以严格模式解析 MQTT 消息。\n严格模式下，客户端 ID、主题名等中的无效 UTF-8 字符串、保留位以及其他格式错误的报文结构会导致客户端断开连接。\n自 6.3 版本起默认值为 `true`——若需兼容不符合规范的客户端，请设置为 `false` 以恢复旧的宽松行为。"
emqx_schema.mqtt_strict_mode.label = "严格模式"
emqx_schema.mqtt_subscription_max_qos_rules.desc = "最大订阅 QoS 允许规则。用于限制客户端在 `SUBSCRIBE` 数据包中请求的 QoS 级别。优先于 `max_qos_allowed` 选项，该选项在没有规则适用时充当默认值。\n\n例如，此规则列表可用于强制对主题过滤器 `#` 和与 `notification/+/#` 主题过滤器匹配的任何主题过滤器（例如 `notification/foo/bar/#`）强制使用 QoS 0：\n```\n[ { topic = { equals = \"#\" }, qos = 0 }\n  { topic = { matches = \"notification/+/#\" }, qos = 0 }\n]\n```"
emqx_schema.mqtt_subscription_max_qos_rules.label = "最大订阅 QoS 规则"
emqx_schema.mqtt_subscription_message_filter.desc = "是否启用对在主题过滤器中以 `?` 附加的 EMQX 订阅消息过滤器的支持。"
emqx_schema.mqtt_subscription_message_filter.label = "订阅消息过滤器"
emqx_schema.mqtt_upgrade_qos.desc = "投递消息时，是否根据订阅主题时的 QoS 等级来强制提升派发的消息的 QoS 等级。"
emqx_schema.mqtt_upgrade_qos.label = "升级 QoS"
emqx_schema.mqtt_use_username_as_clientid.desc = "是否使用用户名作为客户端 ID。\n此设置的作用时间晚于 <code>对端证书作为用户名</code> 和 <code>对端证书作为客户端 ID</code>。"
emqx_schema.mqtt_use_username_as_clientid.label = "用户名作为客户端 ID"
emqx_schema.mqtt_wildcard_subscription.desc = "是否启用对 MQTT 通配符订阅的支持。"
emqx_schema.mqtt_wildcard_subscription.label = "通配符订阅可用"
emqx_schema.namespace_as_mountpoint.desc = "使用客户端的命名空间作为主题挂载点。如果监听器已经配置了 `mountpoint`，则忽略此设置。\n启用后，EMQX 通过以下方式隔离主题：\n  - 在 PUBLISH、SUBSCRIBE、UNSUBSCRIBE 和 Will 消息中将命名空间作为前缀添加到主题。\n  - 从发送给客户端的消息中去除此前缀。\n示例（命名空间 `n1`）：\n  - 客户端订阅 `sensors/#` -> Broker 注册 `n1/sensors/#`。\n  - Broker 路由 `n1/sensors/data` -> 客户端接收 `sensors/data`。"
emqx_schema.namespace_as_mountpoint.label = "使用命名空间作为主题挂载点"
emqx_schema.overload_protection_backoff_delay.desc = "高负载时，一些不重要的任务可能会延迟执行，在这里设置允许延迟的时间。"
emqx_schema.overload_protection_backoff_delay.label = "延迟时间"
emqx_schema.overload_protection_backoff_gc.desc = "高负载时，跳过强制 GC。"
emqx_schema.overload_protection_backoff_gc.label = "跳过 GC"
emqx_schema.overload_protection_backoff_hibernation.desc = "高负载时，跳过进程休眠。"
emqx_schema.overload_protection_backoff_hibernation.label = "跳过休眠"
emqx_schema.overload_protection_backoff_new_conn.desc = "高负载时，拒绝新进来的客户端连接。"
emqx_schema.overload_protection_backoff_new_conn.label = "关闭新连接"
emqx_schema.overload_protection_enable.desc = "是否对系统过载做出反应。"
emqx_schema.overload_protection_enable.label = "是否对系统过载做出反应"
emqx_schema.resource_tags.desc = "连接器的标签"
emqx_schema.resource_tags.label = "标签"
emqx_schema.server_ssl_opts_schema_client_renegotiation.desc = "在支持客户机发起的重新协商的协议中，这种操作的资源成本对于服务器来说高于客户机。\n这可能会成为拒绝服务攻击的载体。\nSSL 应用程序已经采取措施来反击此类尝试，但通过将此选项设置为 false，可以严格禁用客户端发起的重新协商。\n默认值为 true。请注意，由于基础密码套件可以加密的消息数量有限，禁用重新协商可能会导致长期连接变得不可用。"
emqx_schema.server_ssl_opts_schema_client_renegotiation.label = "SSL 客户端冲协商"
emqx_schema.server_ssl_opts_schema_dhfile.desc = "如果协商使用 Diffie-Hellman 密钥交换的密码套件，则服务器将使用包含 PEM 编码的 Diffie-Hellman 参数的文件的路径。如果未指定，则使用默认参数。<br/>\n注意：TLS 1.3 不支持<code>dhfile</code>选项。"
emqx_schema.server_ssl_opts_schema_dhfile.label = "SSL dhfile"
emqx_schema.server_ssl_opts_schema_enable_crl_check.desc = "是否为该监听器启用 CRL 检查。"
emqx_schema.server_ssl_opts_schema_enable_crl_check.label = "启用 CRL 检查"
emqx_schema.server_ssl_opts_schema_enable_ocsp_stapling.desc = "是否为监听器启用 OCSP Stapling 功能。 如果设置为 true，需要定义 OCSP Responder 的 URL 和证书签发者的 PEM 文件路径。"
emqx_schema.server_ssl_opts_schema_enable_ocsp_stapling.label = "启用 OCSP Stapling"
emqx_schema.server_ssl_opts_schema_fail_if_no_peer_cert.desc = "TLS/DTLS 服务器与 {verify，verify_peer} 一起使用。\n如果设置为 true，则如果客户端没有要发送的证书，即发送空证书，服务器将失败。\n如果设置为 false，则仅当客户端发送无效证书（空证书被视为有效证书）时才会失败。"
emqx_schema.server_ssl_opts_schema_fail_if_no_peer_cert.label = "没有证书则 SSL 失败"
emqx_schema.server_ssl_opts_schema_gc_after_handshake.desc = "内存使用调优。如果启用，将在 TLS/SSL 握手完成后立即执行垃圾回收。TLS/SSL 握手建立后立即进行 GC。"
emqx_schema.server_ssl_opts_schema_gc_after_handshake.label = "握手后执行 GC"
emqx_schema.server_ssl_opts_schema_handshake_timeout.desc = "握手完成所允许的最长时间"
emqx_schema.server_ssl_opts_schema_handshake_timeout.label = "握手超时时间"
emqx_schema.server_ssl_opts_schema_honor_cipher_order.desc = "一个重要的安全设置，它强制根据服务器指定的顺序而不是客户机指定的顺序设置密码，从而强制服务器管理员执行（通常配置得更正确）安全顺序。"
emqx_schema.server_ssl_opts_schema_honor_cipher_order.label = "SSL honor cipher order"
emqx_schema.server_ssl_opts_schema_ocsp_issuer_pem.desc = "服务器证书的 OCSP 签发者的 PEM 编码证书。"
emqx_schema.server_ssl_opts_schema_ocsp_issuer_pem.label = "OCSP 签发者证书"
emqx_schema.server_ssl_opts_schema_ocsp_refresh_http_timeout.desc = "检查 OCSP 响应时，HTTP 请求的超时。"
emqx_schema.server_ssl_opts_schema_ocsp_refresh_http_timeout.label = "OCSP 刷新 HTTP 超时"
emqx_schema.server_ssl_opts_schema_ocsp_refresh_interval.desc = "为服务器刷新 OCSP 响应的周期。"
emqx_schema.server_ssl_opts_schema_ocsp_refresh_interval.label = "OCSP 刷新间隔"
emqx_schema.server_ssl_opts_schema_ocsp_responder_url.desc = "用于检查服务器证书的 OCSP Responder 的 URL。"
emqx_schema.server_ssl_opts_schema_ocsp_responder_url.label = "OCSP Responder 的 URL"
emqx_schema.server_ssl_opts_schema_session_tickets.desc = "启用使用无状态会话票据的 TLS 1.3 会话恢复。\n\n可能的值：\n\n- `disabled`：禁用会话票据（默认）。\n- `stateless`：启用无状态会话票据。服务器发送加密票据，客户端可以使用这些票据恢复会话，而无需在服务器上存储会话状态。\n- `stateless_with_cert`：启用包含证书信息的无状态会话票据。这允许即使服务器证书更改也能恢复会话，但会增加网络带宽使用，因为每个票据都包含证书数据。\n\n注意：EMQX 仅支持无状态会话票据，不支持客户端早期数据（0-RTT）。\n完全握手后发送的票据数量由配置 `node.tls_server_session_tickets_amount` 控制。\n种子密钥在 `node.tls_stateless_tickets_seed` 中配置。"
emqx_schema.server_ssl_opts_schema_session_tickets.label = "TLS 1.3 会话票据"
emqx_schema.server_ssl_opts_schema_user_lookup_fun.desc = "EMQX 内部回调，用于查找预共享密钥（PSK）身份。<br/>\n当 TLS 版本配置（或协商）为 1.3 时无效。"
emqx_schema.server_ssl_opts_schema_user_lookup_fun.label = "SSL PSK 用户查找功能"
emqx_schema.session_ds_batch_size.desc = "此值影响持久会话的流量控制。\n持久会话以批次查询持久消息存储。\n此值指定批次的大小。\n\n注意：较大的批次通常提高系统的吞吐量和整体性能，但会增加每个客户端的 RAM 使用量。"
emqx_schema.session_ds_batch_size.label = "批次大小"
emqx_schema.session_ds_checkpoint_interval.desc = "持久会话定期将其状态备份到磁盘。\n这在每个检查点间隔发生。"
emqx_schema.session_ds_checkpoint_interval.label = "持久会话检查点间隔"
emqx_schema.session_ds_commit_timeout.desc = "将持久会话状态提交到存储的事务超时。"
emqx_schema.session_ds_commit_timeout.label = "持久会话提交超时"
emqx_schema.session_ds_message_retention_period.desc = "消息服务器会在此时间段内保留发送到持久会话的消息。"
emqx_schema.session_ds_message_retention_period.label = "消息保留期"
emqx_schema.shared_subscription_group_strategy.desc = "设置共享订阅组为单位的分发策略。该配置是一个从组名到\n策略名的一个 map，组名不得包含 `[A-Za-z0-9]` 之外的特殊字符。"
emqx_schema.shared_subscription_initial_sticky_pick_enum.desc = "当共享订阅策略为 sticky 时，初始订阅者选择的策略。\n - `random`: 随机选择订阅者；\n - `local`: 随机选择当前节点上的订阅者，如果当前节点上没有订阅者，则在集群中随机选择；\n - `hash_clientid`: 根据发布者的客户端 ID 进行哈希，选择订阅者；\n - `hash_topic`: 根据发布的主题进行哈希，选择订阅者。"
emqx_schema.shared_subscription_strategy_enum.desc = "共享订阅的分发策略。\nEMQX 将 **分发状态**（如随机种子、轮询位置和粘性订阅者选择）作为 **发布客户端连接状态** 的一部分进行维护。\n如果发布客户端断开连接并重新连接，则此状态会丢失，必须重新初始化。\n\n- `random`：随机选择一个订阅者进行分发；\n- `round_robin`：共享订阅组中的客户端将依次消费消息，每个发布者独立记录循环进度，因此来自**不同发布者**的两个相邻消息可能会被订阅组中的同一客户端消费；\n- `round_robin_per_group`：共享订阅组中的客户端将依次消费消息，每个节点独立记录循环进度，因此来自**不同节点**的两个相邻消息可能会被订阅组中的同一客户端消费；\n- `local`：随机选择当前节点上的一个订阅者，如果当前节点没有订阅者，则在集群内随机选择；\n- `sticky`：持续将消息分发给最初选择的订阅者，直到他们的会话结束。初始选择基于 `initial_sticky_pick` 的值；\n- `hash_clientid`：哈希发布者的客户端 ID 以选择订阅者；\n- `hash_topic`：哈希发布主题以选择订阅者。"
emqx_schema.socket_tcp_keepalive.desc = "启用 TCP Keepalive（保持连接）。\n该值由三个以逗号分隔的数字组成，格式为 'Idle,Interval,Probes'：\n - Idle：连接空闲多长时间（秒）后，服务器开始发送 Keepalive 探测报文（Linux 默认值 7200）。\n - Interval：每次 TCP Keepalive 探测之间的间隔时间（秒）（Linux 默认值 75）。\n - Probes：如果未从对端收到响应，在放弃连接并关闭之前，最多发送的 TCP Keepalive 探测报文次数（Linux 默认值 9）。\n例如，配置为 \"240,30,5\" 意味着：当连接空闲 240 秒后，EMQX 将开始发送探测报文，每 30 秒发送一次直到收到响应，如果连续 5 没有收到响应，则关闭该连接。\n默认值：'none'。"
emqx_schema.socket_tcp_keepalive.label = "TCP keepalive 选项"
emqx_schema.stats_enable.desc = "启用/禁用统计数据收集功能。"
emqx_schema.stats_enable.label = "启用/禁用统计数据收集功能"
emqx_schema.sys_event_client_connected.desc = "是否开启客户端已连接事件消息。"
emqx_schema.sys_event_client_disconnected.desc = "是否开启客户端已断开连接事件消息。"
emqx_schema.sys_event_client_subscribed.desc = "是否开启客户端已成功订阅主题事件消息。"
emqx_schema.sys_event_client_unsubscribed.desc = "是否开启客户端已成功取消订阅主题事件消息。"
emqx_schema.sys_event_messages.desc = "客户端事件消息。"
emqx_schema.sys_heartbeat_interval.desc = "发送心跳系统消息的间隔时间，它包括：\n  - `$SYS/brokers/<node>/uptime`\n  - `$SYS/brokers/<node>/datetime`"
emqx_schema.sys_msg_interval.desc = "发送 `$SYS` 主题的间隔时间。"
emqx_schema.sys_topics.desc = "系统主题配置。"
emqx_schema.sysmon_broker_pool_mailbox_size_alarm_threshold.desc = "当代理服务器线程池的最大邮箱大小超过该阈值时，会触发告警。代理服务器线程池负责处理添加和移除订阅，以及路由信息的复制。\n\n可能导致此告警触发的原因有多种。以下是一些需要检查或考虑的事项：\n- 增加 EMQX 的 CPU / RAM 资源；\n- 审查客户端的订阅情况，例如，尝试压缩主题过滤器；\n- 检查集群内部网络带宽是否已达到最大值。"
emqx_schema.sysmon_broker_pool_mailbox_size_alarm_threshold.label = "邮箱大小告警"
emqx_schema.sysmon_mnesia_tm_mailbox_size_alarm_threshold.desc = "当 mnesia 事务管理器的邮箱大小超过该阈值时，会触发告警。该进程负责处理 EMQX 内部数据库 mnesia 中的所有事务。\n\n可能导致此告警触发的原因有多种。以下是一些需要检查或考虑的事项：\n- 降低 `max_conn_rate`，以便客户端以较慢的速度加入；\n- 增加 EMQX 的 CPU / RAM 资源；\n- 降低客户端侧的保留消息速率；\n- 检查集群内部网络带宽是否已达到最大值。"
emqx_schema.sysmon_mnesia_tm_mailbox_size_alarm_threshold.label = "mnesia 事务管理器邮箱大小告警"
emqx_schema.sysmon_os_cpu_check_interval.desc = "定期 CPU 检查的时间间隔。"
emqx_schema.sysmon_os_cpu_check_interval.label = "定期 CPU 检查的时间间隔"
emqx_schema.sysmon_os_cpu_high_watermark.desc = "在发出相应告警之前可以使用多少系统 CPU 的阈值，以系统 CPU 负载的百分比表示。"
emqx_schema.sysmon_os_cpu_high_watermark.label = "CPU 高水位线"
emqx_schema.sysmon_os_cpu_low_watermark.desc = "在解除相应告警之前可以使用多少系统 CPU 的阈值，以系统 CPU 负载的百分比表示。"
emqx_schema.sysmon_os_cpu_low_watermark.label = "CPU 低水位线"
emqx_schema.sysmon_os_mem_check_interval.desc = "定期内存检查的时间间隔。"
emqx_schema.sysmon_os_mem_check_interval.label = "内存检查间隔"
emqx_schema.sysmon_os_procmem_high_watermark.desc = "在发出相应告警之前，一个 Erlang 进程可以分配多少系统内存的阈值，以系统内存的百分比表示。"
emqx_schema.sysmon_os_procmem_high_watermark.label = "进程内存高水位线"
emqx_schema.sysmon_os_sysmem_high_watermark.desc = "在发出相应报警之前可以分配多少系统内存的阈值，以系统内存的百分比表示。"
emqx_schema.sysmon_os_sysmem_high_watermark.label = "系统内存高水位线"
emqx_schema.sysmon_top_db_username.desc = "PostgreSQL 数据库的用户名"
emqx_schema.sysmon_top_db_username.label = "DB 用户名"
emqx_schema.sysmon_vm_busy_dist_port.desc = "启用后，当用于集群接点之间 RPC 的连接过忙时，会触发一条带有 <code>busy_dist_port</code> 关键字的 warning 级别日志。\n同时还会发布一条主题为 <code>$SYS/sysmon/busy_dist_port</code> 的 MQTT 系统消息。"
emqx_schema.sysmon_vm_busy_dist_port.label = "启用分布式端口过忙监控"
emqx_schema.sysmon_vm_busy_port.desc = "当一个系统接口（例如 TCP socket）过忙，会触发一条带有 <code>busy_port</code> 关键字的 warning 级别的日志。\n同时还会发布一条主题为 <code>$SYS/sysmon/busy_port</code> 的 MQTT 系统消息。"
emqx_schema.sysmon_vm_busy_port.label = "启用端口过忙监控"
emqx_schema.sysmon_vm_large_heap.desc = "启用后，当一个 Erlang 进程申请了大量内存，系统会触发一条带有 <code>large_heap</code> 关键字的\nwarning 级别日志。同时还会发布一条主题为 <code>$SYS/sysmon/busy_dist_port</code> 的 MQTT 系统消息。"
emqx_schema.sysmon_vm_large_heap.label = "启用大 heap 监控"
emqx_schema.sysmon_vm_long_gc.desc = "当系统检测到某个 Erlang 进程垃圾回收占用过长时间，会触发一条带有 <code>long_gc</code> 关键字的日志。\n同时还会发布一条主题为 <code>$SYS/sysmon/long_gc</code> 的 MQTT 系统消息。"
emqx_schema.sysmon_vm_long_gc.label = "启用长垃圾回收监控"
emqx_schema.sysmon_vm_long_schedule.desc = "启用后，如果 Erlang VM 调度器出现某个任务占用时间过长时，会触发一条带有 'long_schedule' 关键字的日志。\n同时还会发布一条主题为 <code>$SYS/sysmon/long_schedule</code> 的 MQTT 系统消息。"
emqx_schema.sysmon_vm_long_schedule.label = "启用长调度监控"
emqx_schema.sysmon_vm_process_check_interval.desc = "定期进程限制检查的时间间隔。"
emqx_schema.sysmon_vm_process_check_interval.label = "进程限制检查时间"
emqx_schema.sysmon_vm_process_high_watermark.desc = "在发出相应告警之前，本地节点上可以同时存在多少进程的阈值（以进程百分比表示）。"
emqx_schema.sysmon_vm_process_high_watermark.label = "进程数高水位线"
emqx_schema.sysmon_vm_process_low_watermark.desc = "在清除相应告警之前，本地节点上可以同时存在多少进程的阈值（以进程百分比表示）。"
emqx_schema.sysmon_vm_process_low_watermark.label = "进程数低水位线"
emqx_schema.topic_predicate.desc = "在给定主题（或主题过滤器）上评估的谓词，以决定规则是否适用。\n\n定义了以下主题谓词：\n\n* `{ equals = \"t/foo/bar\" }`\n\n    给定主题或主题过滤器与值完全相等。\n\n* `{ matches = \"t/foo/#\" }`\n\n    测试给定主题过滤器是否有效匹配值中的主题过滤器。\n\n    请注意，匹配主题过滤器到主题过滤器可能会产生不寻常的结果。例如，给定主题过滤器 `t/foo/#` 谓词 `{ matches = \"t/foo/+\" }` 评估为 _true_。"
emqx_schema.topic_predicate.label = "主题谓词"
emqx_schema.zones.desc = "<code>zone</code> 是按<code>name</code> 分组的一组配置。\n对于灵活的配置映射，可以将 <code>name</code> 设置为监听器的 <code>zone</code> 配置。\n注：名为 <code>default</code> 的内置区域是自动创建的，无法删除。"
