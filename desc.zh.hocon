emqx_bridge_kinesis.partition_key.label = "分区键"
emqx_bridge_kinesis.payload_template.desc = "用于格式化传出消息的模板。如果未定义，将以 JSON 格式发送所有可用的上下文。"
emqx_bridge_kinesis.payload_template.label = "Payload 模版"
emqx_bridge_kinesis.pool_size.desc = "连接池大小"
emqx_bridge_kinesis.pool_size.label = "连接池大小"
emqx_bridge_kinesis.stream_name.desc = "消息将要被发布到的 Amazon Kinesis 流。"
emqx_bridge_kinesis.stream_name.label = "Amazon Kinesis 流"
emqx_bridge_mongodb.action_parameters.desc = "特定于此动作类型的附加参数"
emqx_bridge_mongodb.action_parameters.label = "动作参数"
emqx_bridge_mongodb.batch_size.desc = "目前 MongoDB 不支持批处理，因此此配置字段无效。内部将其覆盖为1。"
emqx_bridge_mongodb.batch_size.label = "批处理大小"
emqx_bridge_mongodb.collection.desc = "数据将存储在其中的集合"
emqx_bridge_mongodb.collection.label = "要使用的集合"
emqx_bridge_mongodb.desc_config.desc = "MongoDB 动作的配置"
emqx_bridge_mongodb.desc_config.label = "MongoDB 动作配置"
emqx_bridge_mongodb.desc_name.desc = "动作的名称"
emqx_bridge_mongodb.desc_name.label = "动作名称"
emqx_bridge_mongodb.desc_type.desc = "动作的类型"
