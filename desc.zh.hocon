emqx_schema_validation_schema.desc_log_failure.desc = "记录验证失败的配置。"
emqx_schema_validation_schema.desc_log_failure.label = "记录失败"
emqx_schema_validation_schema.desc_schema_validation.desc = "Schema 验证配置。"
emqx_schema_validation_schema.desc_schema_validation.label = "Schema 验证"
emqx_schema_validation_schema.desc_validation.desc = "单条 Schema 验证规则。"
emqx_schema_validation_schema.desc_validation.label = "验证"
emqx_schema_validation_schema.failure_action.desc = "如果验证失败，将如何处理。\n\n  <code>drop</code>：违规消息将被直接丢弃，不进行进一步处理。\n  <code>disconnect</code>：消息不会被发布，发布客户端将被断开连接。\n  <code>ignore</code>：仅记录和追踪失败，不采取其他行动。"
emqx_schema_validation_schema.failure_action.label = "验证失败操作"
emqx_schema_validation_schema.log_failure_at.desc = "将以哪种日志级别记录验证失败。"
emqx_schema_validation_schema.log_failure_at.label = "失败日志级别"
emqx_schema_validation_schema.name.desc = "此校验的名称。在所有校验中必须唯一。只能使用字母、数字和下划线的组合，且不能以数字或下划线开头。"
emqx_schema_validation_schema.name.label = "名称"
emqx_schema_validation_schema.strategy.desc = "校验如何判定检查是否成功。\n\n  <code>all_pass</code>：所有检查都会执行且必须全部通过。\n  <code>any_pass</code>：任一检查通过即可。遇到第一个成功即停止。"
emqx_schema_validation_schema.strategy.label = "策略"
emqx_schema_validation_schema.topics.desc = "此验证规则应验证的单个主题过滤器或主题过滤器列表。"
emqx_schema_validation_schema.topics.label = "主题（过滤器）"
emqx_schema_validation_schema.validations.desc = "Schema 验证规则列表。"
emqx_schema_validation_schema.validations.label = "验证规则"
