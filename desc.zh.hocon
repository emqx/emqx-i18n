emqx_mgmt_api_api_keys.api_key_desc.desc = "API key 字符串，用作 Basic 认证中的用户名。"
emqx_mgmt_api_api_keys.api_key_desc.label = "API Key"
emqx_mgmt_api_api_keys.api_key_list.desc = "查看 API 密钥列表"
emqx_mgmt_api_api_keys.api_key_list.label = "API 密钥列表"
emqx_mgmt_api_api_keys.api_key_scopes_list.desc = "列出所有可用的 API key scope。此 API 只能使用 bearer token 请求。"
emqx_mgmt_api_api_keys.api_key_scopes_list.label = "列出 API key scope"
emqx_mgmt_api_api_keys.api_key_scopes_request.desc = "授予此 API key 的 scope 名称列表。每个 scope 是稳定的功能类别（如 connections、publish、monitoring）。创建时若省略，服务器会物化角色默认值：administrator/viewer 获得所有管理 scope，publisher 仅获得 `publish`。显式传入空列表 `[]` 可创建拒绝全部访问的 key（仅可访问如 `/status` 的匿名端点）。"
emqx_mgmt_api_api_keys.api_key_scopes_request.label = "API key scope（请求）"
emqx_mgmt_api_api_keys.api_key_scopes_response.desc = "授予此 API key 的 scope 名称列表。每个 scope 是稳定的功能类别（如 connections、publish、monitoring）。字面量字符串 `unset` 是仅用于历史记录的哨兵值，表示从没有 scope 功能的版本升级而来的记录；运行时会回退为角色默认值，客户端应将其视为“尚未设置显式 scope 策略”。空列表 `[]` 表示拒绝全部访问（仅可访问如 `/status` 的匿名端点）。"
emqx_mgmt_api_api_keys.api_key_scopes_response.label = "API key scope（响应）"
emqx_mgmt_api_api_keys.api_secret_desc.desc = "API secret 字符串，用作 Basic 认证中的密码。仅在创建时返回，之后无法取回。"
emqx_mgmt_api_api_keys.api_secret_desc.label = "API Secret"
emqx_mgmt_api_api_keys.create_new_api_key.desc = "创建一个新的 API 密钥"
emqx_mgmt_api_api_keys.create_new_api_key.label = "创建 API 密钥"
emqx_mgmt_api_api_keys.created_at_desc.desc = "API key 创建时间（ISO 8601 / epoch second）。"
emqx_mgmt_api_api_keys.created_at_desc.label = "创建时间"
emqx_mgmt_api_api_keys.delete_api_key.desc = "指定 API 密钥 ID 进行删除"
emqx_mgmt_api_api_keys.delete_api_key.label = "删除指定 API 密钥"
emqx_mgmt_api_api_keys.enable_desc.desc = "API key 是否启用。禁用的 key 在认证时会被拒绝。"
emqx_mgmt_api_api_keys.enable_desc.label = "启用"
emqx_mgmt_api_api_keys.expired_at_desc.desc = "过期时间。可为 ISO 8601 时间戳 / epoch second，或 `infinity` 表示永不过期。"
emqx_mgmt_api_api_keys.expired_at_desc.label = "过期时间"
emqx_mgmt_api_api_keys.expired_desc.desc = "API key 是否已过期。只读；由 `expired_at` 派生。"
emqx_mgmt_api_api_keys.expired_desc.label = "已过期"
emqx_mgmt_api_api_keys.get_api_key.desc = "指定 API 密钥 ID 获取详情"
emqx_mgmt_api_api_keys.get_api_key.label = "获取 API 密钥详情"
emqx_mgmt_api_api_keys.name_format.desc = "API key 名称。必须以字母开头，可包含字母、数字、连字符和下划线。长度 1-256 个字符。模式：^[A-Za-z]+[A-Za-z0-9-_]*$"
emqx_mgmt_api_api_keys.name_format.label = "名称"
emqx_mgmt_api_api_keys.name_not_found.desc = "指定名称的 API key 不存在。"
emqx_mgmt_api_api_keys.name_not_found.label = "名称未找到"
emqx_mgmt_api_api_keys.name_pattern.desc = "^[A-Za-z]+[A-Za-z0-9-_]*$"
emqx_mgmt_api_api_keys.name_pattern.label = "名称模式"
emqx_mgmt_api_api_keys.namespace_field.desc = "用于限定此 API key 的命名空间。这是将命名空间编码在 `role` 字符串中（`ns:<namespace>::<role>`）的替代方式。当两种形式同时提供时必须一致，否则请求会被拒绝。若为全局（非命名空间）API key，请省略。"
emqx_mgmt_api_api_keys.namespace_field.label = "命名空间"
emqx_mgmt_api_api_keys.role.desc = "该 API 的角色。命名空间角色写作 `ns:<namespace>::<role>`。不可使用的保留命名空间名称：`global`、`undefined`、`null`、`none`。"
emqx_mgmt_api_api_keys.role.label = "角色"
emqx_mgmt_api_api_keys.scope_info_desc.desc = "该 scope 覆盖范围的可读描述。"
emqx_mgmt_api_api_keys.scope_info_desc.label = "Scope 描述"
emqx_mgmt_api_api_keys.scope_info_name.desc = "Scope 名称：API 端点功能类别的稳定标识符。"
emqx_mgmt_api_api_keys.scope_info_name.label = "Scope 名称"
