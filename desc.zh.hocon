emqx_dashboard_error_code_api.get_error_code.label = "获取错误代码"
emqx_dashboard_monitor_api.actions_executed.desc = "在最后一个采样窗口中执行的动作次数（失败 + 成功）。"
emqx_dashboard_monitor_api.actions_executed.label = "执行的动作"
emqx_dashboard_monitor_api.actions_executed_rate.desc = "最后一个采样窗口中的动作执行率。"
emqx_dashboard_monitor_api.actions_executed_rate.label = "动作执行率"
emqx_dashboard_monitor_api.actions_messages.desc = "最近采样窗口内由动作执行处理的消息数（失败 + 成功）。一次动作执行可能处理一批消息，因此该计数大于或等于动作执行次数。"
emqx_dashboard_monitor_api.actions_messages.label = "动作消息数"
emqx_dashboard_monitor_api.actions_messages_rate.desc = "最近采样窗口内由动作执行处理的消息速率。由于单次动作执行可能处理一批消息，因此该值大于或等于动作执行速率。"
emqx_dashboard_monitor_api.actions_messages_rate.label = "动作消息速率"
emqx_dashboard_monitor_api.bad_rpc.desc = "错误的 RPC"
emqx_dashboard_monitor_api.bad_rpc.label = "错误的 RPC"
emqx_dashboard_monitor_api.clear_monitor.desc = "清除整个集群的监控（统计）数据。"
emqx_dashboard_monitor_api.clear_monitor.label = "清除集群统计数据"
emqx_dashboard_monitor_api.cluster_sessions.desc = "在采样时集群中的会话总数。当 `broker.session_history_retain` 设置为大于 `0s` 的持续时间时，包括已过期的会话。只能表示一个近似值。"
emqx_dashboard_monitor_api.cluster_sessions.label = "集群会话"
emqx_dashboard_monitor_api.connections.desc = "在采样时的连接数。只能表示一个近似值。"
emqx_dashboard_monitor_api.connections.label = "连接数"
emqx_dashboard_monitor_api.current_stats.desc = "当前监控（统计）数据，例如整个集群中的连接数和连接速率。"
emqx_dashboard_monitor_api.current_stats.label = "集群运行统计"
emqx_dashboard_monitor_api.current_stats_node.desc = "节点监控（统计）数据，例如指定节点上的连接数和连接速率。"
emqx_dashboard_monitor_api.current_stats_node.label = "节点运行统计"
