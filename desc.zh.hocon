emqx_bridge_mqtt_pubsub_schema.source_retain_as_published.desc = "是否在远端订阅上设置 MQTT 5.0 的 Retain As Published 订阅选项。设置为 true（默认）时，上游 broker 会保留转发到该订阅的消息 `retain` 标志；设置为 false 时，上游会清除 `retain` 标志。仅在连接器的 `proto_ver` 为 `v5` 时生效。"
emqx_bridge_mqtt_pubsub_schema.source_retain_as_published.label = "按发布保留"
