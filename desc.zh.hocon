emqx_mgmt_api_clients.since.label = "起始时间"
emqx_mgmt_api_clients.subscribe.desc = "强制 broker 代表指定客户端添加订阅。\n订阅会直接安装在客户端通道中，并在通道生命周期内持续存在，就像客户端发起的 SUBSCRIBE 一样。\n该操作按设计绕过 MQTT 授权（ACL）规则：REST API key / 控制台角色才是授权边界，而不是 broker 的 `authorization` 配置。"
emqx_mgmt_api_clients.subscribe.label = "订阅"
emqx_mgmt_api_clients.subscribe_g.desc = "强制 broker 代表指定客户端在一次请求中添加多个订阅。\n每个订阅都会直接安装在客户端通道中，并在通道生命周期内持续存在，就像客户端发起的 SUBSCRIBE 一样。\n该操作按设计绕过 MQTT 授权（ACL）规则：REST API key / 控制台角色才是授权边界，而不是 broker 的 `authorization` 配置。"
emqx_mgmt_api_clients.subscribe_g.label = "批量订阅"
emqx_mgmt_api_clients.subscriptions_cnt.desc = "该客户端已建立的订阅数量。"
emqx_mgmt_api_clients.subscriptions_cnt.label = "订阅数量"
emqx_mgmt_api_clients.subscriptions_max.desc = "该客户端允许的最大订阅数量。"
emqx_mgmt_api_clients.subscriptions_max.label = "最大订阅数"
emqx_mgmt_api_clients.topic.desc = "主题名称。"
emqx_mgmt_api_clients.topic.label = "主题名称"
emqx_mgmt_api_clients.unsubscribe.desc = "强制 broker 代表指定客户端移除订阅。\n该操作按设计绕过 MQTT 授权（ACL）规则：REST API key / 控制台角色才是授权边界，而不是 broker 的 `authorization` 配置。"
emqx_mgmt_api_clients.unsubscribe.label = "取消订阅"
emqx_mgmt_api_clients.unsubscribe_g.desc = "强制 broker 代表指定客户端在一次请求中移除多个订阅。\n该操作按设计绕过 MQTT 授权（ACL）规则：REST API key / 控制台角色才是授权边界，而不是 broker 的 `authorization` 配置。"
emqx_mgmt_api_clients.unsubscribe_g.label = "批量取消订阅"
emqx_mgmt_api_clients.username.desc = "客户端连接时使用的用户名称。"
