emqx_dashboard_api.list_user_scopes_api.desc = "列出控制台登录用户可能拥有的所有 scope 名称及其描述，并包含 `admin_only` 标志以指示该 scope 是否仅限管理员角色。\n返回给任何已认证的登录用户——此端点用于填充控制台 UI 的 scope 选择器，本身不要求特定 scope。"
emqx_dashboard_api.list_user_scopes_api.label = "列出控制台用户 scope"
emqx_dashboard_api.list_users_api.desc = "Dashboard 用户列表"
emqx_dashboard_api.list_users_api.label = "Dashboard 用户列表"
emqx_dashboard_api.login_api.desc = "登录成功后返回 Dashboard 认证 Token。"
emqx_dashboard_api.login_api.label = "获取 Dashboard 认证令牌"
emqx_dashboard_api.login_failed401.desc = "登录失败。MFA 令牌错误或缺失，或用户名或密码错误"
emqx_dashboard_api.login_failed_response400.desc = "登录失败。用户名或密码错误"
emqx_dashboard_api.login_success.desc = "Dashboard 登录成功"
emqx_dashboard_api.logout_api.desc = "Dashboard 用户退出登录"
emqx_dashboard_api.logout_api.label = "Dashboard 用户退出登录"
emqx_dashboard_api.mfa_status.desc = "多重身份认证（MFA）状态。\n- `none`：未启用 MFA\n- `disabled`：用户的 MFA 已禁用\n- 其他值：正在使用的 MFA 机制，例如 `totp`。"
emqx_dashboard_api.mfa_token.desc = "多重身份认证（MFA）token。"
emqx_dashboard_api.new_pwd.desc = "新密码"
emqx_dashboard_api.old_pwd.desc = "旧密码"
emqx_dashboard_api.password.desc = "Dashboard 密码"
emqx_dashboard_api.password_expire_in_seconds.desc = "密码过期的剩余时间（秒）。"
emqx_dashboard_api.role.desc = "用户角色。命名空间角色写作 `ns:<namespace>::<role>`。不可使用的保留命名空间名称：`global`、`undefined`、`null`、`none`。"
emqx_dashboard_api.token.desc = "Dashboard 认证 Token"
emqx_dashboard_api.update_user_api.desc = "更新 Dashboard 用户备注"
emqx_dashboard_api.update_user_api.label = "更新 Dashboard 用户备注"
emqx_dashboard_api.update_user_api200.desc = "更新 Dashboard 用户成功"
emqx_dashboard_api.user_description.desc = "Dashboard 用户备注"
emqx_dashboard_api.user_scopes_request.desc = "控制台用户 scope：在用户角色之外应用的细粒度访问列表。\n\n创建用户时如果省略该字段，服务器会应用角色的默认 scope。管理员获得所有管理 scope 加上四个仅登录的 scope。查看者获得所有管理 scope。发布者（如适用）仅获得 `publish` scope。若要创建拒绝全部访问的用户，请显式传入空列表 `[]`；此时仅可访问诸如 `/status` 等匿名端点。\n\n登录用户可被分配任意 API key 目录中的 scope 以及四个仅登录的 scope：`user_management`、`mfa_management`、`sso_management` 和 `api_key_management`。其中 `user_management`、`sso_management`、`api_key_management` 仅限管理员。`mfa_management` 也可分配给非管理员用户；对非管理员而言，它仅作为自我豁免键，允许用户绕过其自身 MFA 的 `force_mfa` 与 `admin_required` 锁。"
emqx_dashboard_api.user_scopes_response.desc = "控制台用户 scope：在用户角色之外应用的细粒度访问列表。\n\n字面量字符串 `unset` 是仅用于历史记录的哨兵值，表示从不支持控制台用户 scope 的版本升级而来的记录。在运行时，这类记录会回退为该角色的默认 scope。客户端应将 `unset` 视为“尚未设置显式 scope 策略”。空列表 `[]` 表示拒绝全部访问；此时仅可访问诸如 `/status` 等匿名端点。\n\n登录用户可被分配任意 API key 目录中的 scope 以及四个仅登录的 scope：`user_management`、`mfa_management`、`sso_management` 和 `api_key_management`。其中 `user_management`、`sso_management`、`api_key_management` 仅限管理员。`mfa_management` 也可分配给非管理员用户；对非管理员而言，它仅作为自我豁免键，允许用户绕过其自身 MFA 的 `force_mfa` 与 `admin_required` 锁。"
emqx_dashboard_api.username.desc = "Dashboard 用户名"
emqx_dashboard_api.users_api404.desc = "Dashboard 用户不存在"
emqx_dashboard_api.version.desc = "EMQX 版本"
