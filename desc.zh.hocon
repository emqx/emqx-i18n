emqx_telemetry_schema.enable.desc = "设置为 `false` 可以关闭数据发送。"
emqx_telemetry_schema.telemetry_root_doc.desc = "是否启用遥测功能，以允许 EMQX 收集相关的使用信息，并将其共享给 EMQ，用于提升您的产品体验。\nEMQX 在任何情况下都不会收集您的个人信息，例如 MAC 地址、IP 地址或发送的消息内容。\n\n详情请参阅：https://docs.emqx.com/zh/emqx/latest/telemetry/telemetry.html。"
emqx_topic_metrics2_api.bad_request_resp.desc = "集合名称或主题过滤器无效。"
emqx_topic_metrics2_api.bad_request_resp.label = "错误请求"
emqx_topic_metrics2_api.collection_created_resp.desc = "刚创建的主题指标集合。"
emqx_topic_metrics2_api.collection_created_resp.label = "已创建"
emqx_topic_metrics2_api.collection_view_resp.desc = "包含当前计数器的主题指标集合。"
emqx_topic_metrics2_api.collection_view_resp.label = "主题指标集合"
emqx_topic_metrics2_api.conflict_resp.desc = "集合名称已存在，或已达到集群级集合配额。"
emqx_topic_metrics2_api.conflict_resp.label = "冲突"
emqx_topic_metrics2_api.create_collection.desc = "创建由名称标识的新主题指标集合，并在有命名空间时作用于调用者的命名空间。\n\n命名空间管理员：租户命名空间中的客户端会在挂载点前缀下发布（例如命名空间 `acme` 的客户端发布到 `t/x` 时，broker 上显示为 `acme/t/x`）。`topic_filter` 会匹配挂载点应用后的主题，因此命名空间管理员编写的集合过滤器必须包含挂载点前缀才能匹配自身客户端的流量。"
emqx_topic_metrics2_api.create_collection.label = "创建主题指标集合"
emqx_topic_metrics2_api.delete_collection.desc = "按名称删除单个主题指标集合。"
emqx_topic_metrics2_api.delete_collection.label = "删除主题指标集合"
emqx_topic_metrics2_api.delete_collections.desc = "删除调用者可见的所有主题指标集合。"
emqx_topic_metrics2_api.delete_collections.label = "删除所有可见主题指标集合"
emqx_topic_metrics2_api.field_name.desc = "集合名称，在其命名空间内唯一。允许字符：字母、数字、连字符和下划线。最多 64 个字符。在全局并不唯一——相同名称可在不同命名空间中重复使用，因此消费者必须以 `(namespace, name)` 作为键，而非仅用 `name`。"
emqx_topic_metrics2_api.field_name.label = "集合名称"
emqx_topic_metrics2_api.field_namespace.desc = "集合所属命名空间。全局（全集群）集合为 null。"
emqx_topic_metrics2_api.field_namespace.label = "所属命名空间"
emqx_topic_metrics2_api.field_topic_filter.desc = "用于匹配消息的 MQTT 主题过滤器。允许通配符（`+`、`#`）。\n\n对于命名空间集合，过滤器会匹配应用租户挂载点后的发布主题——因此 `acme` 命名空间管理员想跟踪 `t/x` 时，必须使用包含挂载点的过滤器（如 `acme/t/x`）。"
emqx_topic_metrics2_api.field_topic_filter.label = "主题过滤器"
emqx_topic_metrics2_api.get_collection.desc = "读取单个主题指标集合。计数器在集群内聚合。"
emqx_topic_metrics2_api.get_collection.label = "获取主题指标集合"
emqx_topic_metrics2_api.list_collections.desc = "列出调用者可见的所有主题指标集合。"
emqx_topic_metrics2_api.list_collections.label = "列出主题指标集合"
emqx_topic_metrics2_api.not_found_resp.desc = "不存在给定名称的集合。"
emqx_topic_metrics2_api.not_found_resp.label = "未找到"
emqx_topic_metrics2_api.reset_collection.desc = "在集群范围内重置单个集合的计数器。"
emqx_topic_metrics2_api.reset_collection.label = "重置主题指标集合"
emqx_topic_metrics_api.action.desc = "仅支持 reset 重置数据"
emqx_topic_metrics_api.action.label = "操作"
emqx_topic_metrics_api.create_time.desc = "创建时间。标准 rfc3339 时间格式，例如：2018-01-01T12:00:00Z"
emqx_topic_metrics_api.create_time.label = "创建时间"
