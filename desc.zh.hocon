emqx_dashboard_schema.backlog.desc = "排队等待连接的队列的最大长度。"
emqx_dashboard_schema.backlog.label = "排队长度"
emqx_dashboard_schema.bind.desc = "将监听器绑定到指定的地址和端口号，例如 127.0.0.1:18083。\n如果仅配置端口号（例如 18083），则相当于绑定到所有地址 0.0.0.0。\n如果 bind 设置为 0，则禁用监听器。"
emqx_dashboard_schema.bind.label = "监听地址与端口"
emqx_dashboard_schema.bootstrap_users_file.desc = "已废弃，请使用 api_key.bootstrap_file。"
emqx_dashboard_schema.bootstrap_users_file.label = "初始化用户列表（已废弃）"
emqx_dashboard_schema.cors.desc = "CORS（Cross-Origin Resource Sharing，跨域资源共享）允许服务器响应来自任何来源（域名、协议或端口）的请求，启用后允许另一个域名下的服务直接通过 JavaScript 调用 EMQX REST API。"
emqx_dashboard_schema.cors.label = "CORS"
emqx_dashboard_schema.default_mfa.desc = "Dashboard 的默认多重身份认证（MFA）设置。\n当设置为 `none` 时，可在 Dashboard 为每个用户单独启用 MFA。\n如果设置为 `{mechanism = totp}`，用户在首次登录时将自动初始化一个随机的 TOTP 密钥。"
emqx_dashboard_schema.default_mfa.label = "默认 MFA 设置"
emqx_dashboard_schema.default_password.desc = "用于初始化 admin 用户数据库记录的密码。\n注意：在初始化（第一次启动）后更改默认密码将不起作用。\n一旦初始化完成，默认密码 public 必须尽快通过 Dashboard 或 CLI 更改。"
emqx_dashboard_schema.default_password.label = "默认密码"
emqx_dashboard_schema.default_username.desc = "Dashboard 的默认用户名，仅在首次启动 EMQX 之前配置有效。"
emqx_dashboard_schema.default_username.label = "默认用户名"
emqx_dashboard_schema.desc_dashboard.desc = "EMQX Dashboard 配置。"
emqx_dashboard_schema.desc_dashboard.label = "Dashboard"
emqx_dashboard_schema.desc_http.desc = "Dashboard 监听器的配置（plaintext）。"
emqx_dashboard_schema.desc_http.label = "HTTP"
emqx_dashboard_schema.desc_https.desc = "Dashboard 监听器的配置（TLS）。"
emqx_dashboard_schema.desc_https.label = "HTTPS"
emqx_dashboard_schema.desc_listeners.desc = "Dashboard 监听器配置。"
emqx_dashboard_schema.desc_listeners.label = "监听器"
emqx_dashboard_schema.http_listener_settings.desc = "HTTP 监听器的设置。"
emqx_dashboard_schema.http_listener_settings.label = "HTTP 监听器设置"
emqx_dashboard_schema.https_listener_settings.desc = "HTTPS 监听器的设置。"
emqx_dashboard_schema.https_listener_settings.label = "HTTPS 监听器设置"
emqx_dashboard_schema.hwmark_expire_time.desc = "指定高水位线指标的过期间隔，例如会话历史高水位线 (`sessions_hist_hwmark`)。\n高水位线在配置的持续时间内有效。\n当它过期时，系统会扫描到目前为止记录的值，并将高水位线更新为观察到的最高值。\n注意：时间不得超过 7 天 (`7d`)"
emqx_dashboard_schema.hwmark_expire_time.label = "高水位线过期时间"
emqx_dashboard_schema.i18n_lang.desc = "设置 Swagger 多语言的版本，可为 en 或 zh，默认为 en。"
emqx_dashboard_schema.i18n_lang.label = "Swagger API 默认语言"
emqx_dashboard_schema.inet6.desc = "启用 IPv6， 如果机器不支持 IPv6，请关闭此选项，否则会导致 Dashboard 无法使用。"
emqx_dashboard_schema.inet6.label = "IPv6"
emqx_dashboard_schema.ipv6_v6only.desc = "当开启 inet6 功能的同时禁用 IPv4-to-IPv6 映射。该配置仅在 inet6 功能开启时有效。"
emqx_dashboard_schema.ipv6_v6only.label = "IPv6 only"
emqx_dashboard_schema.listener_enable.desc = "忽略或启用该监听器。"
emqx_dashboard_schema.listener_enable.label = "启用监听器"
emqx_dashboard_schema.listeners.desc = "Dashboard 监听器设置。监听器必须有唯一的端口号和 IP 地址的组合。\n例如，可以通过指定 IP 地址 0.0.0.0 来监听机器上给定端口上的所有配置的 IP 地址。\n或者，可以为每个监听器指定唯一的 IP 地址，但使用相同的端口。"
emqx_dashboard_schema.listeners.label = "监听器"
emqx_dashboard_schema.max_connections.desc = "同时处理的最大连接数。"
emqx_dashboard_schema.max_connections.label = "最大连接数"
emqx_dashboard_schema.mfa_mechanism.desc = "多重身份认证（MFA）机制。"
emqx_dashboard_schema.mfa_mechanism.label = "MFA 机制"
emqx_dashboard_schema.mfa_settings.desc = "多重身份认证（MFA）设置。"
emqx_dashboard_schema.mfa_settings.label = "MFA 设置"
emqx_dashboard_schema.num_acceptors.desc = "TCP 协议的 Socket acceptor 池大小, 通常配置为 CPU 核数"
emqx_dashboard_schema.num_acceptors.label = "Acceptor 数量"
emqx_dashboard_schema.password_expired_time.desc = "用户密码的过期时间。默认值 `0` 表示密码永不过期。"
emqx_dashboard_schema.proxy_header.desc = "启用 Proxy Protocol 以提取客户端连接的原始信息，要求使用了代理服务器并且代理服务器也启用 Proxy Protocol。注意：一旦开启了这个功能，就无法再处理普通的 HTTP 请求。"
emqx_dashboard_schema.proxy_header.label = "启用 Proxy Protocol"
emqx_dashboard_schema.sample_interval.desc = "Dashboard 中图表指标的时间间隔。必须小于 60，且被 60 的整除，默认为 10s。"
emqx_dashboard_schema.send_timeout.desc = "发送响应内容的超时时间。"
emqx_dashboard_schema.send_timeout.label = "发送超时时间"
emqx_dashboard_schema.ssl_listener_settings.desc = "Dashboard HTTPS 监听器的 TLS 设置。"
emqx_dashboard_schema.ssl_listener_settings.label = "SSL 监听器设置"
emqx_dashboard_schema.ssl_options.desc = "Dashboard 监听器的 SSL/TLS 选项。"
emqx_dashboard_schema.ssl_options.label = "SSL 选项"
emqx_dashboard_schema.swagger_support.desc = "启用或禁用对 Swagger API 文档的支持。"
emqx_dashboard_schema.swagger_support.label = "Swagger 支持"
emqx_dashboard_schema.token_expired_time.desc = "登录成功返回的 JWT token 过期时间，默认为 60 分钟。"
emqx_dashboard_schema.token_expired_time.label = "登录过期时间"
emqx_dashboard_schema.unsuccessful_login_interval.desc = "累计不成功登录尝试次数的时间间隔。"
emqx_dashboard_schema.unsuccessful_login_interval.label = "不成功登录累计时间间隔"
emqx_dashboard_schema.unsuccessful_login_lock_duration.desc = "在达到最大不成功登录尝试次数后，用户被锁定的时间。"
emqx_dashboard_schema.unsuccessful_login_lock_duration.label = "登录锁定持续时间"
emqx_dashboard_schema.unsuccessful_login_max_attempts.desc = "允许用户的不成功登录尝试的最大次数。\n在配置的时间间隔内达到此次数后，用户将被禁止登录一段时间。"
emqx_dashboard_schema.unsuccessful_login_max_attempts.label = "不成功登录最大尝试次数"
emqx_dashboard_schema_api.get_schema.desc = "获取指定名称的 Schema JSON。\n注意：仅用于 EMQX Dashboard。"
emqx_dashboard_schema_api.get_schema.label = "获取 Schema"
emqx_dashboard_schema_api.schema_json_response.desc = "指定名称的 JSON Schema。"
emqx_dashboard_schema_api.schema_json_response.label = "Schema JSON 响应"
emqx_dashboard_sso_api.backend_name.desc = "后端名称"
emqx_dashboard_sso_api.backend_name.label = "后端名称"
emqx_dashboard_sso_api.backend_name_in_qs.desc = "查询字符串中的 SSO 后端名称。"
emqx_dashboard_sso_api.backend_name_in_qs.label = "后端名称（查询）"
emqx_dashboard_sso_api.backend_not_found.desc = "操作失败。后端不存在"
emqx_dashboard_sso_api.bad_request.desc = "错误请求。SSO code 无效或已过期。"
emqx_dashboard_sso_api.delete_backend.desc = "删除一个后端"
emqx_dashboard_sso_api.delete_backend.label = "删除后端"
emqx_dashboard_sso_api.get_backend.desc = "获取后端的详细信息"
emqx_dashboard_sso_api.get_backend.label = "后端详情"
emqx_dashboard_sso_api.get_sso.desc = "列出所有 SSO 后端"
emqx_dashboard_sso_api.get_sso.label = "SSO 后端"
emqx_dashboard_sso_api.last_error.desc = "该后端的最后一个错误"
emqx_dashboard_sso_api.last_error.label = "最后错误"
emqx_dashboard_sso_api.list_running.desc = "列出所有正在运行的 SSO 后端"
emqx_dashboard_sso_api.list_running.label = "正在运行的后端"
emqx_dashboard_sso_api.login.desc = "获取 Dashboard 认证令牌。"
emqx_dashboard_sso_api.login.label = "获取 Dashboard 认证令牌"
emqx_dashboard_sso_api.login_failed401.desc = "登录失败。用户名或密码错误"
emqx_dashboard_sso_api.mfa_action_setup.desc = "MFA 动作指示：mfa_setup。当用户必须完成 TOTP 设置后才能签发会话 JWT 时，SSO 登录返回该值。"
emqx_dashboard_sso_api.mfa_action_setup.label = "MFA 动作：设置"
emqx_dashboard_sso_api.mfa_action_verify.desc = "MFA 动作指示：mfa_verify。当用户必须验证 TOTP 码后才能签发会话 JWT 时，SSO 登录返回该值。"
emqx_dashboard_sso_api.mfa_action_verify.label = "MFA 动作：验证"
emqx_dashboard_sso_api.mfa_mechanism.desc = "MFA 机制类型。目前仅支持 `totp`。"
emqx_dashboard_sso_api.mfa_mechanism.label = "MFA 机制"
emqx_dashboard_sso_api.redirect.desc = "重定向到 IDP SSO 登录页面"
emqx_dashboard_sso_api.running.desc = "后端是否正在运行"
emqx_dashboard_sso_api.running.label = "正在运行"
emqx_dashboard_sso_api.saml_sso_acs.desc = "SAML SSO ACS URL"
emqx_dashboard_sso_api.saml_sso_acs.label = "SAML SSO ACS"
emqx_dashboard_sso_api.setup_token_response.desc = "用于 MFA 绑定的临时设置 token。一次性、短时有效（5 分钟）。"
emqx_dashboard_sso_api.setup_token_response.label = "设置 Token"
emqx_dashboard_sso_api.sp_saml_metadata.desc = "SP SAML Metadata"
emqx_dashboard_sso_api.sp_saml_metadata.label = "SP SAML 元数据"
emqx_dashboard_sso_api.sso_backend.desc = "SSO 后端类型（如 saml、oidc）。"
emqx_dashboard_sso_api.sso_backend.label = "SSO 后端"
emqx_dashboard_sso_api.sso_code.desc = "从 IdP 重定向回调获得的一次性 SSO code。仅可使用一次；在 token 交换时被消费。"
emqx_dashboard_sso_api.sso_code.label = "SSO Code"
emqx_dashboard_sso_api.sso_username.desc = "来自登录元数据的 SSO 用户名。"
emqx_dashboard_sso_api.sso_username.label = "SSO 用户名"
emqx_dashboard_sso_api.token_exchange.desc = "将一次性 SSO code 交换为实际登录结果（JWT token 或 MFA 元数据）。该 code 在单次使用后即被消费。"
emqx_dashboard_sso_api.token_exchange.label = "SSO Token 交换"
emqx_dashboard_sso_api.update_backend.desc = "更新一个后端"
emqx_dashboard_sso_api.update_backend.label = "更新后端"
emqx_dashboard_sso_api.verify_token_response.desc = "用于 MFA 验证的临时验证 token。一次性、短时有效（5 分钟）。"
emqx_dashboard_sso_api.verify_token_response.label = "验证 Token"
emqx_dashboard_sso_ldap.LDAP.desc = "LDAP（轻量目录访问协议）是一种用于通过网络访问和管理目录信息服务的协议。它可以用作单点登录（SSO）提供商，通过绑定到 LDAP 服务器来认证用户。"
emqx_dashboard_sso_ldap.LDAP.label = "LDAP"
emqx_dashboard_sso_ldap.filter.desc = "LDAP 中匹配用户的过滤器默认为 `(&(objectClass=person)(uid=${username}))`。 对于 Active Directory，默认过滤器是 `(&(objectClass=user)(sAMAccountName=${username}))`。更多详细内容，请参考 [LDAP Filters](https://ldap.com/ldap-filters/)。"
emqx_dashboard_sso_ldap.filter.label = "过滤器"
emqx_dashboard_sso_ldap.ldap_bind.desc = "使用 LDAP 绑定操作作为认证方式的认证器配置。"
emqx_dashboard_sso_ldap.query_timeout.desc = "LDAP 查询超时。"
emqx_dashboard_sso_ldap.query_timeout.label = "查询超时"
emqx_dashboard_sso_mfa_api.bad_request.desc = "错误请求。字段缺失或无效。"
emqx_dashboard_sso_mfa_api.mfa_mechanism.desc = "MFA 机制类型（如 totp）。"
emqx_dashboard_sso_mfa_api.mfa_mechanism.label = "MFA 机制"
emqx_dashboard_sso_mfa_api.mfa_setup.desc = "完成 SSO MFA TOTP 设置：绑定 TOTP 认证器并签发 JWT 会话 token。"
emqx_dashboard_sso_mfa_api.mfa_setup.label = "MFA 设置"
emqx_dashboard_sso_mfa_api.mfa_setup_info.desc = "获取用于二维码展示的 TOTP 设置信息（密钥、机制）。请求体中需包含有效的设置 token。"
emqx_dashboard_sso_mfa_api.mfa_setup_info.label = "MFA 设置信息"
emqx_dashboard_sso_mfa_api.mfa_verify.desc = "验证 SSO MFA TOTP 码并签发 JWT 会话 token。"
emqx_dashboard_sso_mfa_api.mfa_verify.label = "MFA 验证"
emqx_dashboard_sso_mfa_api.setup_token.desc = "来自 SSO 登录流程的临时设置 token。"
emqx_dashboard_sso_mfa_api.setup_token.label = "设置 Token"
emqx_dashboard_sso_mfa_api.sso_backend.desc = "SSO 后端类型（如 saml、oidc）。"
emqx_dashboard_sso_mfa_api.sso_backend.label = "SSO 后端"
emqx_dashboard_sso_mfa_api.sso_username.desc = "来自登录元数据的 SSO 用户名。"
emqx_dashboard_sso_mfa_api.sso_username.label = "SSO 用户名"
emqx_dashboard_sso_mfa_api.totp_code.desc = "来自认证器 App 的 TOTP 码。"
emqx_dashboard_sso_mfa_api.totp_code.label = "TOTP 码"
emqx_dashboard_sso_mfa_api.totp_secret.desc = "用于二维码生成的 TOTP 密钥。"
emqx_dashboard_sso_mfa_api.totp_secret.label = "TOTP 密钥"
emqx_dashboard_sso_mfa_api.unauthorized.desc = "未授权。Token 无效或已过期。"
emqx_dashboard_sso_mfa_api.verify_token.desc = "来自 SSO 登录流程的临时验证 token。"
emqx_dashboard_sso_mfa_api.verify_token.label = "验证 Token"
emqx_dashboard_sso_oidc.OIDC.desc = "OpenID Connect（OIDC）是建立在 OAuth 2.0 协议之上的身份层。它允许客户端根据授权服务器执行的身份验证来验证最终用户的身份。"
emqx_dashboard_sso_oidc.OIDC.label = "OIDC"
emqx_dashboard_sso_oidc.client_file_jwks.desc = "从文件中设置 JWKS。"
emqx_dashboard_sso_oidc.client_file_jwks_file.desc = "JWKS 的内容。"
emqx_dashboard_sso_oidc.client_file_jwks_type.desc = "JWKS 的来源类型。"
emqx_dashboard_sso_oidc.client_jwks.desc = "在此处设置 JWK 或 JWKS 以启用 `private_key_jwt` 授权或 `DPoP` 扩展。"
emqx_dashboard_sso_oidc.clientid.desc = "此后端的 clientId。"
emqx_dashboard_sso_oidc.dashboard_addr.desc = "EMQX Dashboard 的地址。"
emqx_dashboard_sso_oidc.fallback_methods.desc = "一些身份提供商在提供商配置中没有提供所有方法项，将此值设置为这些项的回退。"
emqx_dashboard_sso_oidc.issuer.desc = "OIDC 发行者的 URL。"
emqx_dashboard_sso_oidc.name_var.desc = "将 OIDC 用户信息映射到 Dashboard 名称的模板，默认值是 `${sub}`。"
emqx_dashboard_sso_oidc.name_var_source.desc = "从哪个来源提取信息以构建 Dashboard 用户名。默认为 `userinfo`。\n\n- `userinfo`: 使用 `/userinfo` 端点的响应。\n- `id_token`: 使用访问令牌中包含的声明。"
emqx_dashboard_sso_oidc.namespace_expr.desc = "用于构造 Dashboard 用户命名空间的 [`jq`](https://jqlang.org/manual/) 程序。\n\n该表达式必须恰好返回一个字符串，可以是现有命名空间名称的字符串，或 `null` 值，表示全局命名空间。\n\n任何不符合上述要求的结果都会禁止创建用户。\n\n如未设置，将在全局命名空间创建用户，或在用户已存在时保留其现有命名空间。"
emqx_dashboard_sso_oidc.namespace_source.desc = "从哪个来源提取信息以构造 Dashboard 用户命名空间。默认值为 `userinfo`。\n\n- `userinfo`：使用 `/userinfo` 端点的响应。\n- `id_token`：使用访问令牌中的声明。\n\n注意：配置变更不会立即反映到 EMQX DB 中用户的命名空间，用户命名空间会在成功登录后映射到 EMQX 记录。"
emqx_dashboard_sso_oidc.preferred_auth_methods.desc = "设置有效的身份验证方法及其优先级。"
emqx_dashboard_sso_oidc.provider.desc = "支持 OIDC 协议的身份服务提供商。"
emqx_dashboard_sso_oidc.require_pkce.desc = "获取 token 时是否需要 PKCE。"
emqx_dashboard_sso_oidc.role_expr.desc = "用于构造 Dashboard 用户角色的 [`jq`](https://jqlang.org/manual/) 程序。\n\n该表达式必须恰好返回一个字符串，且必须为有效角色。当前有效角色为：\n- `\"viewer\"`\n- `\"administrator\"`\n\n任何不符合上述要求的结果都会禁止创建用户。\n\n如未设置，将创建 viewer 用户，或在用户已存在时保留其现有角色。"
emqx_dashboard_sso_oidc.role_source.desc = "从哪个来源提取信息以构造 Dashboard 用户角色。默认值为 `userinfo`。\n\n- `userinfo`：使用 `/userinfo` 端点的响应。\n- `id_token`：使用访问令牌中的声明。\n\n注意：配置变更不会立即反映到 EMQX DB 中用户的角色，用户角色会在成功登录后映射到 EMQX 记录。"
emqx_dashboard_sso_oidc.scopes.desc = "范围，默认值是 `[\"openid\"]`."
emqx_dashboard_sso_oidc.secret.desc = "客户端密钥。<br/>\n如需从文件加载密钥而不是内联写入，请使用 <code>file://&lt;path-to-file&gt;</code> 形式；文件内容（去除末尾空白）将作为密钥使用。集群模式下，该文件必须存在于所有 EMQX 节点。"
emqx_dashboard_sso_oidc.session_expiry.desc = "OIDC `state` 的有效时间范围，默认为 `30s`，如果授权服务器返回的代码响应超过此时间范围，将视为无效。"
emqx_dashboard_sso_oidc_api.backend_not_found.desc = "未找到后端"
emqx_dashboard_sso_oidc_api.backend_not_found.label = "未找到后端"
emqx_dashboard_sso_oidc_api.bad_request.desc = "错误请求"
emqx_dashboard_sso_oidc_api.bad_request.label = "错误请求"
emqx_dashboard_sso_oidc_api.code_callback.desc = "OIDC 授权服务器的回调路径。"
emqx_dashboard_sso_oidc_api.code_callback.label = "代码回调"
emqx_dashboard_sso_saml.dashboard_addr.desc = "EMQX Dashboard 的地址。"
emqx_dashboard_sso_saml.dashboard_addr.label = "Dashboard 地址"
emqx_dashboard_sso_saml.idp_metadata_url.desc = "身份提供商的元数据地址。"
emqx_dashboard_sso_saml.idp_metadata_url.label = "IdP 元数据 URL"
emqx_dashboard_sso_saml.idp_signs_assertions.desc = "是否要求 IDP 对 SAML Assertion 进行签名（内部签名）。出于安全考虑，生产环境应至少启用 envelope 或 assertion 签名之一。"
emqx_dashboard_sso_saml.idp_signs_assertions.label = "要求 IDP 对 Assertion 签名"
emqx_dashboard_sso_saml.idp_signs_envelopes.desc = "是否要求 IDP 对 SAML Response 信封进行签名（外部签名）。出于安全考虑，生产环境应至少启用 envelope 或 assertion 签名之一。"
emqx_dashboard_sso_saml.idp_signs_envelopes.label = "要求 IDP 对响应信封签名"
emqx_dashboard_sso_saml.sign_request.desc = "是否签署 SAML 请求。"
emqx_dashboard_sso_saml.sign_request.label = "签署 SAML 请求"
emqx_dashboard_sso_saml.sp_private_key.desc = "SP 的私钥。"
emqx_dashboard_sso_saml.sp_private_key.label = "SP 私钥"
emqx_dashboard_sso_saml.sp_public_key.desc = "SP 的公钥。"
emqx_dashboard_sso_saml.sp_public_key.label = "SP 公钥"
emqx_dashboard_sso_saml_api.backend_not_found.desc = "未找到指定的 SAML 后端。"
emqx_dashboard_sso_saml_api.backend_not_found.label = "未找到后端"
emqx_dashboard_sso_saml_api.login_failed401.desc = "因凭据无效而登录失败。"
emqx_dashboard_sso_saml_api.login_failed401.label = "登录失败"
emqx_dashboard_sso_saml_api.redirect.desc = "重定向到 IdP 登录页面的 URL。"
emqx_dashboard_sso_saml_api.redirect.label = "重定向 URL"
emqx_dashboard_sso_saml_api.saml_sso_acs.desc = "SAML Assertion Consumer Service URL。"
emqx_dashboard_sso_saml_api.saml_sso_acs.label = "SAML SSO ACS"
emqx_dashboard_sso_saml_api.sp_saml_metadata.desc = "Service Provider SAML 元数据。"
emqx_dashboard_sso_saml_api.sp_saml_metadata.label = "SP SAML 元数据"
emqx_dashboard_sso_schema.backend.desc = "后端类型。"
emqx_dashboard_sso_schema.backend.label = "后端类型"
emqx_dashboard_sso_schema.backend_enable.desc = "是否启用该后端"
emqx_dashboard_sso_schema.force_mfa.desc = "是否对 SSO 用户强制启用 MFA（TOTP）。启用后，SSO 用户必须完成 MFA 设置或验证后才能获取控制台 token。"
emqx_dashboard_sso_schema.force_mfa.label = "强制 MFA"
emqx_dashboard_sso_schema.password.desc = "基于密码的后端（如 LDAP）的 SSO 管理员密码。长度最多 100 个字符。"
emqx_dashboard_sso_schema.password.label = "密码"
emqx_dashboard_sso_schema.sso_struct.desc = "Dashboard 单点登录（SSO）。"
emqx_dashboard_sso_schema.sso_struct.label = "Dashboard 单点登录"
emqx_dashboard_sso_schema.username.desc = "基于密码的后端（如 LDAP）的 SSO 管理员用户名。长度最多 100 个字符。"
emqx_dashboard_sso_schema.username.label = "用户名"
emqx_dashboard_swagger.bad_request.desc = "无效请求。"
emqx_dashboard_swagger.bad_request.label = "错误请求"
emqx_dashboard_swagger.count.desc = "匹配查询条件的记录总数。\n注意：仅当查询能够优化且不需要全表扫描时，此字段才会存在。"
emqx_dashboard_swagger.count.label = "总数"
emqx_dashboard_swagger.cursor.desc = "表示当前迭代状态的不透明值。"
emqx_dashboard_swagger.cursor.label = "游标"
emqx_dashboard_swagger.cursor_response.desc = "表示当前迭代状态的不透明值。"
emqx_dashboard_swagger.cursor_response.label = "游标"
emqx_dashboard_swagger.error_codes.desc = "无效请求的可能错误原因代码。"
emqx_dashboard_swagger.error_codes.label = "错误代码"
emqx_dashboard_swagger.hasnext.desc = "指示是否还有更多结果可用于下一页。"
emqx_dashboard_swagger.hasnext.label = "是否有下一页"
emqx_dashboard_swagger.limit.desc = "每页返回的结果数量。"
emqx_dashboard_swagger.limit.label = "每页限制"
emqx_dashboard_swagger.page.desc = "要获取的结果所在页码。"
emqx_dashboard_swagger.page.label = "页码"
emqx_dashboard_swagger.position.desc = "一个不透明的 token，可用于后续请求以获取下一批结果：`?position={prev_response.meta.position}`。\n用于替代 `page` 参数以遍历高度动态的数据。可以省略或设置为 `none` 以获取第一批数据。"
emqx_dashboard_swagger.position.label = "位置"
emqx_dashboard_swagger.start.desc = "当前数据集合中第一个元素的位置。"
emqx_dashboard_swagger.start.label = "起始位置"
emqx_delayed_api.bad_msgid_format.desc = "消息 ID 格式错误"
emqx_delayed_api.bad_msgid_format.label = "消息 ID 格式错误"
emqx_delayed_api.bad_topic_name.desc = "错误的主题名称"
emqx_delayed_api.bad_topic_name.label = "错误的主题名称"
emqx_delayed_api.count.desc = "延迟消息总数"
emqx_delayed_api.count.label = "延迟消息总数"
emqx_delayed_api.delayed_interval.desc = "延迟时间(秒)"
emqx_delayed_api.delayed_interval.label = "延迟时间(秒)"
emqx_delayed_api.delayed_remaining.desc = "剩余时间(秒)"
emqx_delayed_api.delayed_remaining.label = "剩余时间(秒)"
emqx_delayed_api.delete_api.desc = "删除延迟消息"
emqx_delayed_api.delete_api.label = "删除延迟消息"
emqx_delayed_api.expected_at.desc = "期望的发送时间, RFC 3339 格式"
emqx_delayed_api.expected_at.label = "期望的发送时间"
emqx_delayed_api.from_clientid.desc = "消息的 ClientID"
emqx_delayed_api.from_clientid.label = "消息的 ClientID"
emqx_delayed_api.from_username.desc = "消息的 Username"
emqx_delayed_api.from_username.label = "消息的 Username"
emqx_delayed_api.get_message_api.desc = "查看延迟消息"
emqx_delayed_api.get_message_api.label = "查看延迟消息"
emqx_delayed_api.illegality_limit.desc = "数量上限不合法"
emqx_delayed_api.illegality_limit.label = "数量上限不合法"
emqx_delayed_api.list_api.desc = "查看延迟消息列表"
emqx_delayed_api.list_api.label = "查看延迟消息列表"
emqx_delayed_api.msgid.desc = "延迟消息 ID"
emqx_delayed_api.msgid.label = "延迟消息 ID"
emqx_delayed_api.msgid_not_found.desc = "未找到对应消息"
emqx_delayed_api.msgid_not_found.label = "未找到对应消息"
emqx_delayed_api.no_delayed_message.desc = "此主题下没有找到延迟消息"
emqx_delayed_api.no_delayed_message.label = "未找到延迟消息"
emqx_delayed_api.node.desc = "消息来源节点"
emqx_delayed_api.node.label = "消息来源节点"
emqx_delayed_api.payload.desc = "消息内容, base64 格式。如果消息的大小超过 2048 字节，则消息原始内容不予返回，请求将返回 'PAYLOAD_TO_LARGE'"
emqx_delayed_api.payload.label = "消息内容"
emqx_delayed_api.publish_at.desc = "消息发布时间，即延迟消息的创建时间, RFC 3339 格式"
emqx_delayed_api.publish_at.label = "消息发布时间"
emqx_delayed_api.qos.desc = "QoS"
emqx_delayed_api.qos.label = "QoS"
emqx_delayed_api.topic.desc = "主题"
emqx_delayed_api.topic.label = "主题"
emqx_delayed_api.update_api.desc = "开启或者关闭功能，或者设置延迟消息数量上限"
emqx_delayed_api.update_api.label = "更新配置"
emqx_delayed_api.update_success.desc = "配置更新成功"
emqx_delayed_api.update_success.label = "配置更新成功"
emqx_delayed_api.view_limit.desc = "每页返回数据条目"
emqx_delayed_api.view_limit.label = "分页大小"
emqx_delayed_api.view_page.desc = "特定页的页码"
emqx_delayed_api.view_page.label = "分页页码"
emqx_delayed_api.view_status_api.desc = "查看慢订阅状态"
emqx_delayed_api.view_status_api.label = "查看慢订阅状态"
emqx_ds_schema.backend_type.desc = "持久化存储后端。\n\n请注意，无法在不丢失数据的情况下更改现有持久化存储的后端。"
emqx_ds_schema.backend_type.label = "后端类型"
emqx_ds_schema.builtin_data_dir.desc = "内置存储后端相关数据的根目录。\n\n默认情况下，它等于 `node.data_dir/ds/`。"
emqx_ds_schema.builtin_data_dir.label = "数据库位置"
emqx_ds_schema.builtin_layout.desc = "存储布局是一种在磁盘上排列来自各种主题和客户端消息的方法。\n\n根据工作负载类型和主题结构的不同，可以采用不同的数据存储策略，以最大化地提高从持久存储中读取消息的效率。"
emqx_ds_schema.builtin_layout.label = "存储布局"
emqx_ds_schema.builtin_local.desc = "没有网络功能的嵌入式持久化存储后端。\n\n此后端不支持集群，但其开销低于 `builtin_raft`。\n建议在严格的单节点部署中使用。"
emqx_ds_schema.builtin_local.label = "内置本地"
emqx_ds_schema.builtin_n_shards.desc = "持久化存储将数据分成多个分片。\n此配置参数定义分片的数量。\n请注意，它仅在持久化存储数据库初始化期间生效。\n在数据库已经创建后更改此配置参数将不会产生任何效果。"
emqx_ds_schema.builtin_n_shards.label = "分片数量"
emqx_ds_schema.builtin_optimistic_transaction.desc = "事务设置。"
emqx_ds_schema.builtin_optimistic_transaction.label = "事务设置"
emqx_ds_schema.builtin_raft.desc = "支持数据复制的嵌入式持久化存储后端。\n\n此后端旨在用于集群化的 EMQX 部署。\n它在多个 EMQX 节点上复制每个持久化存储分片的数据。"
emqx_ds_schema.builtin_raft.label = "内置 Raft"
emqx_ds_schema.builtin_raft_max_retries.desc = "遇到可恢复的间歇性故障时的最大重试次数。"
emqx_ds_schema.builtin_raft_max_retries.label = "最大重试次数"
emqx_ds_schema.builtin_raft_n_sites.desc = "需要共享存储分片集责任的存储站点数量。\n在此上下文中，站点是启用了消息持久性的 EMQX 节点。\n请注意，这仅在持久存储数据库初始化期间生效。\n在此阶段，至少需要上线这么多站点以在它们之间分配分片，否则消息存储将不可用。\n初始化完成后，站点可能会下线，这将根据下线站点的数量和复制因子影响可用性。"
emqx_ds_schema.builtin_raft_n_sites.label = "初始站点数量"
emqx_ds_schema.builtin_raft_replication_factor.desc = "每个分片应有的相同副本数量。\n增加此数字可以提高持久性和可用性，但会消耗更多资源。\n复制工作需要健康的副本仲裁，因此一般情况下选择奇数个副本是一个好选择。\n请注意，这仅在持久存储数据库初始化期间生效。\n在数据库已创建后更改此配置参数不会生效。"
emqx_ds_schema.builtin_raft_replication_factor.label = "复制因子"
emqx_ds_schema.builtin_raft_retry_interval.desc = "重试尝试之间的休眠时间。"
emqx_ds_schema.builtin_raft_retry_interval.label = "重试间隔"
emqx_ds_schema.db_group.desc = "将持久存储分配给具有给定名称的数据库组。某些资源（例如磁盘使用配额）将在组的所有成员之间共享。\n\n数据库组的后端应与存储的后端匹配。"
emqx_ds_schema.db_group.label = "数据库组"
emqx_ds_schema.db_group_backend.desc = "分配给组的所有数据库使用的后端。"
emqx_ds_schema.db_group_backend.label = "组后端"
emqx_ds_schema.db_group_name.desc = "组的唯一标识符"
emqx_ds_schema.db_group_name.label = "组名称"
emqx_ds_schema.db_group_record.desc = "使用内置后端的持久存储组相关的设置。"
emqx_ds_schema.db_group_record.label = "数据库组"
emqx_ds_schema.db_group_rocksdb_threads.desc = "每个持久存储组的 RocksDB 后台线程数。\n\nRocksDB 使用两个线程池：高优先级和低优先级。\n前者用于将内存表转储到磁盘，\n后者用于压缩。\n\n默认情况下，两个池的大小都设置为脏 IO 调度器的数量。"
emqx_ds_schema.db_group_rocksdb_threads.label = "RocksDB 线程池大小"
emqx_ds_schema.db_group_storage_quota.desc = "分配给组的所有持久存储的总磁盘空间限额。\n\n当持久存储的总大小超过配额时，\n尝试写入新数据将失败，直到释放一些磁盘空间。\n\n内置后端将此值视为软配额：\n即使从数据库中删除数据，磁盘空间利用率也可能增加，\n直到数据库被压缩。\n\n对于 `builtin_raft` 后端，配额检查由领导节点执行。\n只有拥有本地副本的分片才计入配额。\n\n当配额超出时，会触发 `db_storage_quota_exceeded:<DB>` 告警。\n\n超出配额的后果取决于数据库：\n- `messages`：持久会话无法接收新消息。\n  缓解措施：\n  + 减少 `durable_sessions.message_retention_period` 配置参数。\n  + 使用 `mqtt.subscription_max_qos_rules` 将某些主题的订阅 QoS 设置为 0。\n    向 QoS 0 订阅传递消息不使用磁盘空间。\n- `sessions`：持久会话从代理断开连接。\n  缓解措施：\n  + 踢出离线会话。\n  + 限制最大会话数量。"
emqx_ds_schema.db_group_storage_quota.label = "存储配额"
emqx_ds_schema.db_group_write_buffer_size.desc = "为数据库写入缓冲区分配的最大总 RAM。"
emqx_ds_schema.db_group_write_buffer_size.label = "写入缓冲区大小"
emqx_ds_schema.db_groups_root.desc = "数据库组配置的映射。\n\n数据库组用于在持久存储数据库之间共享某些资源。\n例如，`storage_quota` 参数设置分配给组的所有持久存储的总磁盘使用限额。"
emqx_ds_schema.db_groups_root.label = "数据库组"
emqx_ds_schema.layout_builtin_wildcard_optimized.desc = "通配符优化 布局旨在最大化覆盖大量主题的通配符订阅的吞吐量。\n\n例如，它可以处理大量客户端将数据发布到包含其客户端 ID 的主题的场景，如：sensor/%device-version%/%clientid%/temperature、sensor/%device-version%/%clientid%/pressure 等。\n此布局将自动将此类主题分组到单个流中，因此订阅包含通配符的主题过滤器（如 sensor/+/+/temperature）的客户端将能够以单个批次消费所有设备发布的消息。\n\n此布局对非通配符订阅也是有效的。"
emqx_ds_schema.layout_builtin_wildcard_optimized.label = "通配符优化存储布局"
emqx_ds_schema.layout_builtin_wildcard_optimized_type.desc = "通配符优化布局类型。"
emqx_ds_schema.layout_builtin_wildcard_optimized_type.label = "布局类型"
emqx_ds_schema.lts_wildcard_thresholds.desc = "不同主题级别的通配符阈值数组。\n\nEMQX 可以自动将相似的主题分组在一起，以提高消息存储和检索的效率。\n\n要理解此配置的含义，可以将 MQTT 主题视为一棵树。\n当特定树节点的子节点数量达到阈值时，EMQX 会执行分组。\n\n当主题结构已知时，调整此参数会有所帮助。\n例如，在多个客户端向包含其客户端 ID 的主题发布消息的情况下，\n如 `sensor/<clientid>/temperature/<room>`。\n由于主题的 `<clientid>` 和 `<room>` 部分是可变的，可以通过将此参数设置为 `[100, 0, 100, 0, 100]` 来降低主题级别 2 和 4 的通配符阈值。\n\n数组的每个元素对应于主题的特定级别。\n\n数组的最后一个元素也对应于所有剩余级别。\n\n数组不能为空。"
emqx_ds_schema.lts_wildcard_thresholds.label = "通配符阈值"
emqx_ds_schema.messages.desc = "MQTT 消息持久化存储的配置。"
emqx_ds_schema.messages.label = "MQTT 消息存储"
emqx_ds_schema.mq_messages.desc = "包含消息队列消息的持久存储的配置。"
emqx_ds_schema.mq_messages.label = "消息队列消息"
emqx_ds_schema.mq_states.desc = "包含消息队列状态的持久存储的配置。"
emqx_ds_schema.mq_states.label = "消息队列状态"
emqx_ds_schema.optimistic_transaction.desc = "内置持久存储后端的事务设置。"
emqx_ds_schema.optimistic_transaction.label = "事务"
emqx_ds_schema.otx_conflict_window.desc = "内置持久存储后端在称为冲突跟踪窗口的时间段内跟踪最近的更新。\n\n早于窗口开始的事务将被自动拒绝。\n因此，实际上，此参数限制了事务可以运行的时间。\n\n较高的值可以减少因长时间运行而拒绝事务的风险，但可能会增加 RAM 需求。\n\n此值应大于刷新间隔。"
emqx_ds_schema.otx_conflict_window.label = "冲突跟踪窗口"
emqx_ds_schema.otx_flush_interval.desc = "指定操作在提交到存储之前可能在缓冲区中停留的最长时间。\n参数的较大值可能会提高吞吐量，但会对延迟产生负面影响。"
emqx_ds_schema.otx_flush_interval.label = "事务刷新间隔"
emqx_ds_schema.otx_idle_flush_interval.desc = "如果分片在此期间未收到新事务，则缓冲区会提前刷新。"
emqx_ds_schema.otx_idle_flush_interval.label = "空闲事务刷新间隔"
emqx_ds_schema.otx_max_pending.desc = "指定可以在缓冲区中保留的最大操作数。\n当此值被超过时，无论其他因素如何，缓冲区都会被刷新。"
emqx_ds_schema.otx_max_pending.label = "最大待处理操作"
emqx_ds_schema.rocksdb_allow_fallocate.desc = "如果 OS 和文件系统支持，允许 RocksDB 通过 `fallocate` 进行文件空间预分配。\n文件空间预分配用于提升文件写入/追加性能，但会以每个分片显著的磁盘占用为代价，尤其是在空或稀疏的 DB 中。\n\n如果启用，请确保数据目录所在卷有足够的可用空间，例如至少数 GB。\n\n如果数据目录使用 `btrfs` 文件系统，建议保持禁用。\n在 `btrfs` 上，额外分配的空间无法释放。对于 DS 数据库这可能很显著，因为在单个站点上拥有大量分片很常见。\n\n更多细节请参考 RocksDB C++ API 文档中的 `allow_fallocate` 标志。"
emqx_ds_schema.rocksdb_allow_fallocate.label = "允许文件空间预分配"
emqx_ds_schema.rocksdb_cache_size.desc = "RocksDB 块缓存的大小。\n\n请注意，增加此值不一定会减少 I/O，因为压缩数据可能驻留在操作系统的页面缓存中，但可以在牺牲内存使用的情况下减少 CPU 负载。\n\n数据库的每个分片都有自己的缓存。"
emqx_ds_schema.rocksdb_cache_size.label = "RocksDB 缓存大小"
emqx_ds_schema.rocksdb_max_open_files.desc = "每个分片的最大打开文件描述符数。"
emqx_ds_schema.rocksdb_max_open_files.label = "最大打开文件数"
emqx_ds_schema.rocksdb_options.desc = "有关内置持久存储后端使用的 RocksDB 数据库行为的选项。"
emqx_ds_schema.rocksdb_options.label = "RocksDB 选项"
emqx_ds_schema.rocksdb_write_buffer_size.desc = "RocksDB 内存表的最大大小。\n\n内存表是一个缓冲区，新写入的数据在刷新到磁盘之前保存在其中。\n\n数据库的每个分片都有自己的内存表。"
emqx_ds_schema.rocksdb_write_buffer_size.label = "RocksDB 写入缓冲区大小"
emqx_ds_schema.sessions.desc = "包含持久会话状态和元数据的持久存储的配置。"
emqx_ds_schema.sessions.label = "MQTT 会话存储"
emqx_ds_schema.shared_subs.desc = "包含元数据和共享订阅的主题重放进度的持久存储的配置。"
emqx_ds_schema.shared_subs.label = "持久共享订阅"
emqx_ds_schema.streams_messages.desc = "包含消息流消息的持久存储配置。"
emqx_ds_schema.streams_messages.label = "消息流消息"
emqx_ds_schema.timers.desc = "包含定时器的持久存储的配置。"
emqx_ds_schema.timers.label = "持久定时器存储"
emqx_ds_shared_sub_schema.enable.desc = "启用共享订阅功能。"
emqx_ds_shared_sub_schema.enable.label = "启用共享订阅"
emqx_ds_shared_sub_schema.leader_periodical_actions_interval.desc = "Leader 执行周期性操作的时间间隔（毫秒）。"
emqx_ds_shared_sub_schema.leader_periodical_actions_interval.label = "Leader 周期性操作间隔"
emqx_ds_shared_sub_schema.leader_renew_streams_interval.desc = "Leader 刷新流的时间间隔（毫秒）。"
emqx_ds_shared_sub_schema.leader_renew_streams_interval.label = "Leader 刷新数据流时间间隔"
emqx_ds_shared_sub_schema.session_find_leader_timeout.desc = "会话查找 Leader 的超时时间（毫秒）。\n如果会话在此时间内无法找到 Leader，会话将重试。"
emqx_ds_shared_sub_schema.session_find_leader_timeout.label = "会话查找 Leader 超时时间"
emqx_ds_shared_sub_schema.session_ping_leader_interval.desc = "会话（Session）向 Leader 发送 ping 的时间间隔（毫秒）。"
emqx_ds_shared_sub_schema.session_ping_leader_interval.label = "会话 Ping Leader 间隔"
emqx_ds_shared_sub_schema.session_ping_leader_timeout.desc = "会话等待主节点响应 ping 的超时时间（单位：毫秒）。\n如果主节点在此时间内未响应 ping，\n会话将认为主节点已丢失，并尝试寻找新的主节点。"
emqx_ds_shared_sub_schema.session_ping_leader_timeout.label = "会话 Ping 主节点超时"
emqx_ds_shared_sub_schema.session_unsubscribe_timeout.desc = "会话等待数据流达到一致状态并报告给主节点的超时时间（单位：毫秒）。\n如果超时时间到达，会话将向主节点发送最新已知的一致状态。"
emqx_ds_shared_sub_schema.session_unsubscribe_timeout.label = "会话取消订阅超时"
