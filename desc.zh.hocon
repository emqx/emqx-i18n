emqx_bridge_influxdb.ping_with_auth.desc = "控制 EMQX 是否在 `/ping` 健康检查请求中包含连接器凭据。如果你的 InfluxDB 服务在 `/ping` 上要求认证，请启用此选项。默认值为 `false`，保持之前的行为并在不认证的情况下发送 `/ping`。"
emqx_bridge_influxdb.ping_with_auth.label = "携带认证 Ping"
emqx_bridge_influxdb.write_syntax.desc = "使用 InfluxDB API Line Protocol 写入 InfluxDB 的数据，支持占位符<br/>\n参考 [InfluxDB 2.3 Line Protocol](https://docs.influxdata.com/influxdb/v2.3/reference/syntax/line-protocol/) 及\n[InfluxDB 1.8 Line Protocol](https://docs.influxdata.com/influxdb/v1.8/write_protocols/line_protocol_tutorial/) <br/>\nTLDR: <br/>\n\n```\n<measurement>[,<tag_key>=<tag_value>[,<tag_key>=<tag_value>]] <field_key>=<field_value>[,<field_key>=<field_value>] [<timestamp>]\n```\n注意，整形数值占位符后需要添加一个字符 `i` 类型标识。例如 `${payload.int_value}i`"
emqx_bridge_influxdb.write_syntax.label = "写语句"
