emqx_mgmt_api_trace.payload_encode.desc = "确定跟踪文件中负载格式的格式。<br/>\n`text`：基于文本的协议或纯文本协议。\n当负载为 JSON 编码时推荐使用。<br/>\n`hex`：二进制十六进制编码。\n当负载为自定义二进制协议时推荐使用。<br/>\n`hidden`：负载被模糊化为 `******`"
emqx_mgmt_api_trace.payload_encode.label = "负载编码"
