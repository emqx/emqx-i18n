emqx_authn_mysql_schema.query.label = "查询 SQL"
emqx_authn_mysql_schema.query_timeout.desc = "SQL 查询的超时时间。"
emqx_authn_mysql_schema.query_timeout.label = "查询超时"
emqx_authn_password_hashing.bcrypt.desc = "BCRYPT 密码哈希算法的设置。"
emqx_authn_password_hashing.bcrypt.label = "BCRYPT"
emqx_authn_password_hashing.bcrypt_name.desc = "对于 BCRYPT 密码哈希，必须将名称设置为 'bcrypt'"
emqx_authn_password_hashing.bcrypt_name.label = "BCRYPT"
emqx_authn_password_hashing.bcrypt_rw.desc = "bcrypt 密码哈希算法的设置（用于具有写入能力的数据库后端）。"
emqx_authn_password_hashing.bcrypt_rw.label = "BCRYPT"
emqx_authn_password_hashing.bcrypt_salt_rounds.desc = "BCRYPT 密码生成的工作因子。"
emqx_authn_password_hashing.bcrypt_salt_rounds.label = "盐轮数"
emqx_authn_password_hashing.dk_length.desc = "PBKDF2 算法派生密钥的字节长度。"
emqx_authn_password_hashing.dk_length.label = "派生密钥长度"
emqx_authn_password_hashing.pbkdf2.desc = "PBKDF2 密码哈希算法的设置。"
emqx_authn_password_hashing.pbkdf2.label = "PBKDF2"
emqx_authn_password_hashing.pbkdf2_iterations.desc = "PBKDF2 算法的迭代次数。较高的值提供更好的安全性，但需要更多计算。"
emqx_authn_password_hashing.pbkdf2_iterations.label = "PBKDF2 迭代"
emqx_authn_password_hashing.pbkdf2_mac_fun.desc = "指定在 PBKDF2 算法中使用哪个 HMAC 函数。注意，自 5.8.3 版本以来，不再支持 md4、md5、ripemd160。"
emqx_authn_password_hashing.pbkdf2_mac_fun.label = "PBKDF2 MAC 函数"
emqx_authn_password_hashing.pbkdf2_name.desc = "对于 PBKDF2 密码哈希，必须将名称设置为 'pbkdf2'"
emqx_authn_password_hashing.pbkdf2_name.label = "PBKDF2"
emqx_authn_password_hashing.salt_position.desc = "PLAIN、SHA、SHA256 和 SHA512 算法的盐位置。"
emqx_authn_password_hashing.salt_position.label = "盐位置"
emqx_authn_password_hashing.simple.desc = "简单算法（如 PLAIN、SHA、SHA256 和 SHA512）的设置。"
emqx_authn_password_hashing.simple.label = "简单算法"
emqx_authn_password_hashing.type_ro.desc = "密码哈希验证的选项。"
emqx_authn_password_hashing.type_ro.label = "密码哈希选项"
emqx_authn_password_hashing.type_rw.desc = "密码哈希创建和验证的选项。"
emqx_authn_password_hashing.type_rw.label = "密码哈希选项"
emqx_authn_postgresql_schema.postgresql.desc = "使用 PostgreSQL 作为认证数据源的认证器的配置项。"
