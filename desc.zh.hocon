emqx_bridge_kinesis.aws_access_key_id.label = "AWS 访问密钥 ID"
emqx_bridge_kinesis.aws_secret_access_key.desc = "连接到 Amazon Kinesis 的 AWS 秘密访问密钥。"
emqx_bridge_kinesis.aws_secret_access_key.label = "AWS 秘密访问密钥"
