emqx_schema_validation_schema.check_sql_type.desc = "使用规则引擎的 SQL 语法验证消息，此语法与规则引擎中的语法一致，但需省略 FROM 子句。任何生成值的 SQL 语句表示验证成功；如果没有返回值，则验证失败。例如，语句 <code>SELECT payload.foo + payload.bar as sum WHERE sum > 0</code> 用于验证字段 foo 和 bar 的和为正数。"
emqx_schema_validation_schema.check_sql_type.label = "SQL schema 检查"
emqx_schema_validation_schema.checks.desc = "在验证过程中将执行的检查。它们将按照定义的顺序进行评估。"
emqx_schema_validation_schema.checks.label = "检查"
emqx_schema_validation_schema.config_enable.desc = "是否启用此功能。"
emqx_schema_validation_schema.config_enable.label = "启用"
