emqx_bridge_mongodb.enable.desc = "启用或停用该 MongoDB 动作"
emqx_bridge_mongodb.enable.label = "启用或停用"
emqx_bridge_mongodb.mongodb_action.desc = "与 MongoDB 连接器交互的动作"
emqx_bridge_mongodb.mongodb_action.label = "MongoDB 动作"
emqx_bridge_mongodb.mongodb_parameters.desc = "特定于此 MongoDB 连接器类型的一组参数，mongo_type 可以是 single（独立）、sharded（分片）或 rs（副本集）之一。"
emqx_bridge_mongodb.mongodb_parameters.label = "MongoDB 类型特定参数"
emqx_bridge_mongodb.mongodb_rs_conf.desc = "MongoDB (Replica Set) 配置"
emqx_bridge_mongodb.mongodb_rs_conf.label = "MongoDB (Replica Set) 配置"
emqx_bridge_mongodb.mongodb_sharded_conf.desc = "MongoDB (Sharded) 配置"
emqx_bridge_mongodb.mongodb_sharded_conf.label = "MongoDB (Sharded) 配置"
emqx_bridge_mongodb.mongodb_single_conf.desc = "MongoDB (Standalone) 配置"
emqx_bridge_mongodb.mongodb_single_conf.label = "MongoDB (Standalone) 配置"
emqx_bridge_mongodb.mqtt_topic.desc = "MQTT 主题或主题过滤器作为数据源（动作输入）。如果将规则动作用作数据源，则此配置应保留为空，否则消息将在 MongoDB 中重复。"
emqx_bridge_mongodb.mqtt_topic.label = "源 MQTT 主题"
emqx_bridge_mongodb.payload_template.desc = "用于格式化发送消息的模板。如果未定义，规则引擎将使用 JSON 格式序列化所有可见输入，例如 clientid、主题、有效载荷等。"
emqx_bridge_mongodb.payload_template.label = "有效载荷模版"
emqx_bridge_mqtt_connector_schema.bridge_mode.desc = "如果启用桥接模式。\n注意：此设置仅适用于 MQTT 协议版本早于5.0的情况，远程 MQTT\n代理必须支持此功能。\n如果将 bridge_mode 设置为true，则桥接将指示远程代理它是一个桥接而不是普通客户端。\n这意味着循环检测将更加有效，并且保留的消息将被正确传递。"
emqx_bridge_mqtt_connector_schema.bridge_mode.label = "桥接模式"
emqx_bridge_mqtt_connector_schema.clean_start.desc = "在重新连接到入口动作时是否启动新会话"
emqx_bridge_mqtt_connector_schema.clean_start.label = "新会话"
emqx_bridge_mqtt_connector_schema.clientid_prefix.desc = "附加到 egress 动作使用的 clientid 前缀（可选）。"
emqx_bridge_mqtt_connector_schema.clientid_prefix.label = "Clientid 前缀"
emqx_bridge_mqtt_connector_schema.config_connector.desc = "MQTT connector 的配置。"
emqx_bridge_mqtt_connector_schema.config_connector.label = "MQTT 连接器"
emqx_bridge_mqtt_connector_schema.connect_timeout.desc = "连接远程代理服务器的超时时间。在尝试建立初始连接时，连接的工作进程会暂停，直到达到设定的超时时间为止。"
emqx_bridge_mqtt_connector_schema.connect_timeout.label = "连接超时时间"
emqx_bridge_mqtt_connector_schema.egress_desc.desc = "egress 配置定义了此动作如何将消息从本地代理转发到远程代理。<br/>\n允许在'remote.topic'、'local.qos'、'local.retain'、'local.payload'中使用带有变量的模板。<br/>\n注意：如果将此动作用作规则的动作，并且还配置了'local.topic'，则从规则获取的数据和与\n'local.topic'匹配的 MQTT 消息都将被转发。"
emqx_bridge_mqtt_connector_schema.egress_desc.label = "Egress 配置"
emqx_bridge_mqtt_connector_schema.egress_local.desc = "关于从本地代理接收消息的配置。"
emqx_bridge_mqtt_connector_schema.egress_local.label = "本地配置"
emqx_bridge_mqtt_connector_schema.egress_local_topic.desc = "要转发到远程代理的本地主题"
emqx_bridge_mqtt_connector_schema.egress_local_topic.label = "本地主题"
emqx_bridge_mqtt_connector_schema.egress_pool_size.desc = "将发布消息到远程代理的 MQTT 客户端池的大小。<br/>\n每个 MQTT 客户端都将分配'clientid'，格式为'${clientid_prefix}:${bridge_name}:egress:${node}:${n}'\n其中'n'是池中客户端的编号。\n\n如果 `static_clientids` 不为空，则此选项无效。当使用静态客户端 ID 时，池的大小始终根据每个节点分配的 ID 数量来确定。"
emqx_bridge_mqtt_connector_schema.egress_pool_size.label = "客户端池大小"
emqx_bridge_mqtt_connector_schema.egress_remote.desc = "关于向远程代理发送消息的配置。"
emqx_bridge_mqtt_connector_schema.egress_remote.label = "远程配置"
emqx_bridge_mqtt_connector_schema.egress_remote_qos.desc = "要发送的 MQTT 消息的 QoS 级别。<br/>\n允许使用带有变量的模板。"
emqx_bridge_mqtt_connector_schema.egress_remote_qos.label = "远程 QoS"
emqx_bridge_mqtt_connector_schema.egress_remote_topic.desc = "要转发到远程代理的主题。<br/>\n允许使用带有变量的模板。"
emqx_bridge_mqtt_connector_schema.egress_remote_topic.label = "远程主题"
emqx_bridge_mqtt_connector_schema.ingress_desc.desc = "ingress 配置定义了此动作如何从远程 MQTT 代理接收消息，然后将它们发送到本地代理。<br/>\n允许在'remote.qos'、'local.topic'、'local.qos'、'local.retain'、'local.payload'中使用带有变量的模板。<br/>\n注意：如果将此动作用作规则的输入，并且还配置了'local.topic'，则从远程代理获取的消息将发送到'local.topic'和规则。"
emqx_bridge_mqtt_connector_schema.ingress_desc.label = "Ingress 配置"
emqx_bridge_mqtt_connector_schema.ingress_local.desc = "关于向本地代理发送消息的配置。"
emqx_bridge_mqtt_connector_schema.ingress_local.label = "Local 配置"
emqx_bridge_mqtt_connector_schema.ingress_local_qos.desc = "要发送的 MQTT 消息的 QoS 级别。<br/>\n允许使用带有变量的模板。"
emqx_bridge_mqtt_connector_schema.ingress_local_qos.label = "本地 QoS"
emqx_bridge_mqtt_connector_schema.ingress_local_topic.desc = "要发送到本地代理的主题。<br/>\n允许使用带有变量的模板。"
emqx_bridge_mqtt_connector_schema.ingress_local_topic.label = "本地主题"
emqx_bridge_mqtt_connector_schema.ingress_pool_size.desc = "将从远程代理接收消息的 MQTT 客户端池的大小。<br/>\n仅当'remote.topic'是共享订阅主题或主题过滤器时才会尊重此值，\n（例如$share/name1/topic1或$share/name2/topic2/#），否则只会使用一个 MQTT 客户端。\n每个 MQTT 客户端都将分配'clientid'，格式为'${clientid_prefix}:${bridge_name}:ingress:${node}:${n}'\n其中'n'是池中客户端的编号。\n注意：当 EMQX 进行集群化时，非共享订阅将无法正常工作。\n\n如果 `static_clientids` 不为空，则此选项无效。当使用静态客户端 ID 时，池的大小始终根据每个节点分配的 ID 数量来确定。"
emqx_bridge_mqtt_connector_schema.ingress_pool_size.label = "客户端池大小"
emqx_bridge_mqtt_connector_schema.ingress_remote.desc = "关于向远程代理订阅的配置。"
emqx_bridge_mqtt_connector_schema.ingress_remote.label = "Remote 配置"
emqx_bridge_mqtt_connector_schema.ingress_remote_qos.desc = "订阅远程代理时要使用的 QoS 级别."
emqx_bridge_mqtt_connector_schema.ingress_remote_qos.label = "远程 QoS"
emqx_bridge_mqtt_connector_schema.ingress_remote_topic.desc = "从远程代理接收消息的主题"
emqx_bridge_mqtt_connector_schema.ingress_remote_topic.label = "远程主题"
emqx_bridge_mqtt_connector_schema.max_inflight.desc = "MQTT 协议的最大 inflight（已发送但未确认）消息数"
emqx_bridge_mqtt_connector_schema.max_inflight.label = "最大 inflight 消息数"
emqx_bridge_mqtt_connector_schema.mode.desc = "MQTT 动作的模式。<br/>\n- cluster_shareload：在 emqx 集群中的每个节点上创建一个 MQTT 连接。<br/>\n在'cluster_shareload'模式下，来自远程代理的传入负载通过\n使用共享订阅进行共享。<br/>\n请注意，'clientid'将以节点名称作为后缀，以避免\n不同节点之间的 clientid 冲突。并且我们只能使用共享订阅\n作为入口连接的'remote.topic'的主题过滤器。"
emqx_bridge_mqtt_connector_schema.mode.label = "MQTT 动作模式"
emqx_bridge_mqtt_connector_schema.password.desc = "MQTT 协议的密码。使用静态 clientid 时，如果定义了该值且该静态 clientid 没有关联特定密码，则使用此值。<br/>\n如需从文件加载密码而不是内联写入，请使用 <code>file://&lt;path-to-file&gt;</code> 形式；文件内容（去除末尾空白）将作为密码使用。集群模式下，该文件必须存在于所有 EMQX 节点。"
emqx_bridge_mqtt_connector_schema.password.label = "密码"
emqx_bridge_mqtt_connector_schema.payload.desc = "要发送的 MQTT 消息的有效载荷。<br/>\n允许使用带有变量的模板。"
emqx_bridge_mqtt_connector_schema.payload.label = "有效载荷"
emqx_bridge_mqtt_connector_schema.proto_ver.desc = "MQTT协议版本"
emqx_bridge_mqtt_connector_schema.proto_ver.label = "协议版本"
emqx_bridge_mqtt_connector_schema.retain.desc = "要发送的 MQTT 消息的'retain'标志。<br/>\n允许使用带有变量的模板。"
emqx_bridge_mqtt_connector_schema.retain.label = "保留消息标志"
emqx_bridge_mqtt_connector_schema.retry_interval.desc = "在未收到 ACK 的情况下，MQTT 桥接器重试发送 QoS1/QoS2 消息的延迟。"
emqx_bridge_mqtt_connector_schema.retry_interval.label = "重试间隔"
emqx_bridge_mqtt_connector_schema.server.desc = "远程 MQTT 代理的主机和端口"
emqx_bridge_mqtt_connector_schema.server.label = "代理 IP 和端口"
emqx_bridge_mqtt_connector_schema.server_configs.desc = "与服务器相关的配置。"
emqx_bridge_mqtt_connector_schema.server_configs.label = "服务器配置。"
emqx_bridge_mqtt_connector_schema.static_clientid_entry.desc = "将 EMQX 节点名称映射到静态客户端 ID 的条目。\n\n如果定义了任何条目，则只有与这些条目匹配的 EMQX 节点才会启动具有相应 clientid 的 MQTT 客户端。"
emqx_bridge_mqtt_connector_schema.static_clientid_entry.label = "静态 ClientId 条目"
emqx_bridge_mqtt_connector_schema.static_clientid_entry_clientid.desc = "分配给此节点的静态客户端 ID。"
emqx_bridge_mqtt_connector_schema.static_clientid_entry_clientid.label = "静态 clientid"
emqx_bridge_mqtt_connector_schema.static_clientid_entry_ids.desc = "分配给此节点的静态客户端 ID 数组。"
emqx_bridge_mqtt_connector_schema.static_clientid_entry_ids.label = "静态 clientids"
emqx_bridge_mqtt_connector_schema.static_clientid_entry_node.desc = "节点名称（例如：`emqx@10.0.0.1`）。"
