emqx_bridge_iotdb.config_parameters_column_category.label = "列类别"
emqx_bridge_iotdb.config_parameters_data_type.desc = "数据类型，可以是：\n\n- test\n- boolean\n- int32\n- int64\n- float\n- double"
emqx_bridge_iotdb.config_parameters_data_type.label = "数据类型"
emqx_bridge_iotdb.config_parameters_measurement.desc = "也称 Measurement，支持使用 ${var} 格式的占位符。"
emqx_bridge_iotdb.config_parameters_measurement.label = "字段"
emqx_bridge_iotdb.config_parameters_timestamp.desc = "时间戳。支持格式为 ${var} 的占位符，最终值可以是：\n\n- now: 使用当前时间（毫秒）\n- now_ms: 同上\n- now_us: 使用当前时间（微秒）\n- now_ns: 使用当前时间（纳秒）\n- 任何整数: 直接使用该值作为时间戳\n- 占位符: 使用 payload 中的值作为时间戳"
emqx_bridge_iotdb.config_parameters_timestamp.label = "时间戳"
emqx_bridge_iotdb.config_parameters_value.desc = "值。支持格式为 ${var} 的占位符"
emqx_bridge_iotdb.config_parameters_value.label = "值"
emqx_bridge_iotdb.config_table_name.desc = "要写入数据的 IoTDB 表名。"
emqx_bridge_iotdb.config_table_name.label = "表名"
emqx_bridge_iotdb.config_write_to_table.desc = "是否将数据写入 IoTDB 表或时序。\n注意：当为 true 时，连接器还必须将 \"SQL Dialect\" 设置为 \"table\"。"
emqx_bridge_iotdb.config_write_to_table.label = "写入表"
emqx_bridge_iotdb.creation_opts.desc = "创建选项"
emqx_bridge_iotdb.creation_opts.label = "创建选项"
emqx_bridge_iotdb.desc_config.desc = "IoTDB 数据桥接配置"
emqx_bridge_iotdb.desc_config.label = "IoTDB 配置"
