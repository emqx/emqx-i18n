emqx_otel_sampler_api.white_list_type.label = "白名单类型"
emqx_otel_schema.client_connect_disconnect.desc = "启用/禁用在配置的采样比率下，所有客户端的连接/断开连接事件的后台追踪。"
emqx_otel_schema.client_connect_disconnect.label = "追踪客户端连接/断开连接"
emqx_otel_schema.client_messaging.desc = "启用/禁用在配置的采样比率和追踪级别下，所有客户端的消息传输事件的后台追踪。"
emqx_otel_schema.client_messaging.label = "追踪消息传输事件"
emqx_otel_schema.client_subscribe_unsubscribe.desc = "启用/禁用在配置的采样比率下，所有客户端的订阅/取消订阅事件的后台追踪。"
emqx_otel_schema.client_subscribe_unsubscribe.label = "追踪客户端订阅/取消订阅"
emqx_otel_schema.clientid_match_rules_max.desc = "客户端 ID 匹配白名单的最大长度。"
emqx_otel_schema.clientid_match_rules_max.label = "客户端 ID 匹配白名单的最大数量"
emqx_otel_schema.cluster_identifier.desc = "添加到 Span 的属性中的一个属性值。属性键为 cluster.id\n通常，设置一个简单且易于识别的名称，或者使用集群名称来标识不同的 EMQX 集群。"
emqx_otel_schema.cluster_identifier.label = "集群标识符"
emqx_otel_schema.e2e_tracing_options.desc = "端到端追踪选项。"
emqx_otel_schema.e2e_tracing_options.label = "端到端追踪选项"
emqx_otel_schema.enable.desc = "启用或禁用 open telemetry 指标"
emqx_otel_schema.enable.label = "启用"
emqx_otel_schema.exporter_endpoint.desc = "导出器将要发送 Open Telemetry 信号数据的目标 URL。"
emqx_otel_schema.exporter_endpoint.label = "导出器端点"
emqx_otel_schema.exporter_headers.desc = "与 OpenTelemetry 信号数据一起发送的 HTTP 头。\n头是一个以头名称为键的映射。"
emqx_otel_schema.exporter_headers.label = "导出器头"
emqx_otel_schema.exporter_protocol.desc = "Open Telemetry 导出器的传输协议"
emqx_otel_schema.exporter_protocol.label = "导出器协议"
emqx_otel_schema.exporter_ssl.desc = "Open Telemetry 导出器的 SSL 配置"
emqx_otel_schema.exporter_ssl.label = "SSL 选项"
emqx_otel_schema.exporting_timeout.desc = "Open Telemetry信号导出运行被取消之前可以运行的时间。"
emqx_otel_schema.exporting_timeout.label = "导出超时"
emqx_otel_schema.follow_traceparent.desc = "启用/禁用，是否通过 User-Property 跟随客户端传递的 traceparent。"
emqx_otel_schema.follow_traceparent.label = "跟随 Traceparent"
emqx_otel_schema.max_queue_size.desc = "最大队列大小。达到此大小后，Open Telemetry 信号将被丢弃。"
emqx_otel_schema.max_queue_size.label = "最大队列大小"
emqx_otel_schema.msg_trace_level.desc = "消息发布过程中的所有消息交换的追踪级别。\n- 0：将记录消息发布过程中的基本事件作为 Span。\n 包括 'client.connect'、'client.authz'、'message.route'、'message.forward'、'message.handle_forward'、'broker.publish'。\n- 1：除了基本事件外，\n 事件 'broker.puback'、'client.puback'、'broker.pubrec'、'client.pubrec' 将作为 Span 记录。\n 也就是 QoS1 或 QoS2 消息交互中的第一个响应数据包。\n- 2：除了级别 1 的事件外，\n 事件 'broker.pubrel'、'client.pubrel'、'broker.pubcomp'、'client.pubcomp' 将作为 Span 记录。"
emqx_otel_schema.msg_trace_level.label = "消息追踪级别"
emqx_otel_schema.opentelemetry.desc = "Open Telemetry 工具包配置"
emqx_otel_schema.opentelemetry.label = "Open Telemetry"
emqx_otel_schema.otel_exporter.desc = "Open Telemetry 导出器"
emqx_otel_schema.otel_exporter.label = "导出器"
emqx_otel_schema.otel_log_handler_level.desc = "Open Telemetry 日志处理器的日志级别。"
emqx_otel_schema.otel_log_handler_level.label = "日志级别"
emqx_otel_schema.otel_logs.desc = "Open Telemetry 日志配置。如果启用，EMQX 将安装一个日志处理器，根据 Open Telemetry 日志数据模型格式化事件，并将它们导出到配置的 Open Telemetry 收集器或后端。"
emqx_otel_schema.otel_logs.label = "Open Telemetry 日志"
emqx_otel_schema.otel_metrics.desc = "Open Telemetry 指标配置。"
emqx_otel_schema.otel_metrics.label = "Open Telemetry 指标"
emqx_otel_schema.otel_traces.desc = "Open Telemetry 追踪配置。"
emqx_otel_schema.otel_traces.label = "Open Telemetry 追踪"
emqx_otel_schema.sample_ratio.desc = "列出事件类型的后台追踪采样比率。"
emqx_otel_schema.sample_ratio.label = "采样比率"
emqx_otel_schema.scheduled_delay.desc = "两次连续导出 Open Telemetry 信号之间的延迟间隔。"
emqx_otel_schema.scheduled_delay.label = "计划延迟间隔"
emqx_otel_schema.topic_match_rules_max.desc = "基于主题匹配的白名单最大长度。"
emqx_otel_schema.topic_match_rules_max.label = "最大主题匹配白名单数量"
emqx_otel_schema.trace_all.desc = "如果启用，将追踪所有发布的消息，如果无法从消息中提取追踪 ID，则生成新的追踪 ID。\n否则，只追踪带有追踪上下文的消息。默认禁用。\n注意：改设置只有当 `追踪模式` 设置为 `legacy` 的时候才生效。"
emqx_otel_schema.trace_all.label = "追踪全部"
emqx_otel_schema.trace_filter.desc = "Open Telemetry 追踪过滤器配置"
emqx_otel_schema.trace_filter.label = "追踪过滤器"
emqx_otel_schema.trace_mode.desc = "OpenTelemetry 追踪模式。\n- legacy: 使用旧的追踪方法，只追踪消息发布和传递。\n Span 名称将与 5.9 之前的版本兼容。\n- e2e: 端到端追踪模式。所有客户端行为都将被追踪：\n - 连接和断开连接\n - 订阅和取消订阅\n - 消息事件，如 PUBLISH、PUBACK、PUBREL 等。\n 启用后（对于每种事件类型），将对所有客户端进行后台追踪，按配置的采样比例进行。\n 更多详情见 Dashboard 或 API 文档。\n 从 Dashboard 中，您还可以为一组客户端或主题在后台追踪的基础上添加额外的追踪白名单。"
emqx_otel_schema.trace_mode.label = "追踪模式"
emqx_otel_schema.trace_rule_engine.desc = "按配置的采样比例，为所有客户端启用或禁用规则引擎执行的后台追踪。"
emqx_otel_schema.trace_rule_engine.label = "规则引擎追踪"
emqx_plugins_api_endpoint.gateway_desc.desc = "对此端点的请求将传递到插件实现。有关请求和响应详情，请参阅插件文档。"
emqx_plugins_api_endpoint.gateway_desc.label = "插件 API 网关"
emqx_plugins_schema.api_endpoint.desc = "插件 API 端点转发配置。"
emqx_plugins_schema.api_endpoint.label = "插件 API 端点"
emqx_plugins_schema.api_endpoint_timeout.desc = "插件 API 回调处理的请求超时。"
emqx_plugins_schema.api_endpoint_timeout.label = "插件 API 超时"
emqx_plugins_schema.check_interval.desc = "检查间隔：检查集群中插件的状态是否一致，<br/>\n如果连续 3 次检查结果不一致，则报警。"
emqx_plugins_schema.enable.desc = "设置为“true”以启用此插件。"
emqx_plugins_schema.enable.label = "启用"
emqx_plugins_schema.install_dir.desc = "插件安装包的目录，出于安全考虑，该目录应该值允许 <code>emqx</code>，或用于运行 EMQX 服务的用户拥有写入权限。"
emqx_plugins_schema.install_dir.label = "安装目录"
emqx_plugins_schema.name_vsn.desc = "插件的名称{name}-{version}。<br/>\n它应该与插件的发布包名称一致，如 my_plugin-0.1.0。"
emqx_plugins_schema.name_vsn.label = "名称-版本"
emqx_plugins_schema.plugins.desc = "管理 EMQX 插件。<br/>\n插件可以是 EMQX 安装包中的一部分，也可以是一个独立的安装包。<br/>\n独立安装的插件称为“外部插件”。"
emqx_plugins_schema.plugins.label = "插件"
emqx_plugins_schema.state.desc = "描述插件的状态"
emqx_plugins_schema.state.label = "插件状态"
emqx_plugins_schema.states.desc = "一组插件的状态。插件将按照定义的顺序启动"
emqx_plugins_schema.states.label = "插件启动顺序及状态"
emqx_postgresql.application_name.desc = "用于 PostgreSQL 连接的应用名称。此值会显示在 PostgreSQL 活动视图和日志中。长度必须为 1 到 63 字节，且不能包含零字节。"
emqx_postgresql.application_name.label = "应用名称"
emqx_postgresql.config_connector.desc = "PostgreSQL 连接器的配置。"
emqx_postgresql.config_connector.label = "PostgreSQL 连接器配置"
emqx_postgresql.server.desc = "要连接的 IPv4 或 IPv6 地址或主机名。<br/>\n一个主机条目的格式为：Host[:Port]。<br/>\n如果没有指定 [:Port]，将使用 PostgreSQL 默认端口 5432。"
emqx_postgresql.server.label = "服务器主机"
emqx_postgresql_connector_schema.application_name.desc = "用于 PostgreSQL 连接的应用名称。此值会显示在 PostgreSQL 活动视图和日志中。长度必须为 1 到 63 字节，且不能包含零字节。"
emqx_postgresql_connector_schema.application_name.label = "应用名称"
emqx_postgresql_connector_schema.config_connector.desc = "PostgreSQL 连接器的配置。"
emqx_postgresql_connector_schema.config_connector.label = "PostgreSQL 连接器配置"
emqx_postgresql_connector_schema.server.desc = "用于连接的 IPv4 或 IPv6 地址或主机名。<br/>\n一个主机条目具有以下格式：Host[:Port]。<br/>\n如果未指定 [:Port]，将使用 PostgreSQL 默认端口5432。"
emqx_postgresql_connector_schema.server.label = "服务器主机"
emqx_prometheus_api.get_prom_auth_data.desc = "获取 AuthN、AuthZ 和 Banned 的 Prometheus 指标"
emqx_prometheus_api.get_prom_auth_data.label = "Auth 的 Prometheus 指标"
emqx_prometheus_api.get_prom_conf_info.desc = "获取 Prometheus 配置信息"
emqx_prometheus_api.get_prom_conf_info.label = "获取 Prometheus 配置信息"
emqx_prometheus_api.get_prom_data.desc = "获取 Prometheus 数据"
emqx_prometheus_api.get_prom_data.label = "获取 Prometheus 数据"
emqx_prometheus_api.get_prom_data_integration_data.desc = "获取数据集成的 Prometheus 指标"
emqx_prometheus_api.get_prom_data_integration_data.label = "数据集成的 Prometheus 指标"
emqx_prometheus_api.get_prom_message_transformation.desc = "获取消息验证的 Prometheus 指标"
emqx_prometheus_api.get_prom_message_transformation.label = "消息验证的 Prometheus 指标"
emqx_prometheus_api.get_prom_schema_validation.desc = "获取 Schema 验证的 Prometheus 指标."
emqx_prometheus_api.get_prom_schema_validation.label = "Schema 验证 Prometheus 指标"
emqx_prometheus_api.get_prom_topic_metrics.desc = "获取主题指标集合（v2）的 Prometheus 指标。每个集合的计数器以集合名称作为标签暴露为 Prometheus gauges。"
emqx_prometheus_api.get_prom_topic_metrics.label = "主题指标集合的 Prometheus 指标"
emqx_prometheus_api.mode_parameter.desc = "指标格式模式。\n\n`node`：\n返回本地节点的指标。如果未指定 `mode`，这是默认行为。\n\n`all_nodes_aggregated`：\n返回所有节点的指标。\n如果可能，计算所有节点指标的算术和或逻辑和。\n\n`all_nodes_unaggregated`：\n返回所有节点的指标，指标未聚合。\n返回结果中将包含节点名称，以指示某些指标是在某个节点上返回的。"
emqx_prometheus_api.mode_parameter.label = "模式参数"
emqx_prometheus_api.ns_stats.desc = "获取 Prometheus 命名空间指标"
emqx_prometheus_api.ns_stats.label = "命名空间 Prometheus 指标"
emqx_prometheus_api.qp_namespace.desc = "用于按命名空间过滤指标的查询参数。"
emqx_prometheus_api.qp_namespace.label = "命名空间过滤"
emqx_prometheus_api.update_prom_conf_info.desc = "更新 Prometheus 配置"
emqx_prometheus_api.update_prom_conf_info.label = "更新 Prometheus 配置"
emqx_prometheus_schema.collectors.desc = "虚拟机的内部高级指标最初是禁用的\n通常只在性能测试期间启用。\n启用它们将增加 CPU 负载。"
emqx_prometheus_schema.enable_basic_auth.desc = "启用或禁用 Prometheus 抓取 API 的认证（basic 或 bearer），不影响 Push Gateway。\n从 6.3.0 起默认值为 `true`，因此 `/api/v5/prometheus/*` 下的抓取端点需要凭据。\n设置为 `false` 时，端点无需认证即可访问，与 6.3.0 之前的行为一致。"
emqx_prometheus_schema.headers.desc = "推送到 Push Gateway 的 HTTP Headers 列表。<br/>\n例如，<code> { Authorization = \"some-authz-tokens\"}</code>"
emqx_prometheus_schema.interval.desc = "数据推送间隔"
emqx_prometheus_schema.job_name.desc = "推送到 Push Gateway 的 Job 名称。可用变量为：<br/>\n- ${cluster_name}: EMQX 集群的名称。<br/>\n- ${name}: EMQX 节点的名称。<br/>\n- ${host}: EMQX 节点主机名。\n例如，当 EMQX 节点名为 <code>emqx@127.0.0.1</code> 则 name 变量的值为 <code>emqx</code>，host 变量的值为 <code>127.0.0.1</code>。<br/>\n默认值为: <code>${name}/instance/${name}~${host}</code>"
emqx_prometheus_schema.latency_buckets.desc = "用于延迟直方图分桶的逗号分隔时间时长值。"
emqx_prometheus_schema.latency_buckets.label = "延迟直方图分桶"
emqx_prometheus_schema.legacy_deprecated_setting.desc = "自5.4.0版本起弃用。"
emqx_prometheus_schema.legacy_enable.desc = "自5.4.0版本起弃用，改用 `prometheus.push_gateway.url`。"
emqx_prometheus_schema.legacy_headers.desc = "自5.4.0版本起弃用，改用 `prometheus.push_gateway.headers`。"
emqx_prometheus_schema.legacy_interval.desc = "自5.4.0版本起弃用，改用 `prometheus.push_gateway.interval`。"
emqx_prometheus_schema.legacy_job_name.desc = "自5.4.0版本起弃用，改用 `prometheus.push_gateway.job_name`。"
emqx_prometheus_schema.legacy_mnesia_collector.desc = "自5.4.0版本起弃用，改用 `prometheus.collectors.mnesia`。"
emqx_prometheus_schema.legacy_push_gateway_server.desc = "自5.4.0版本起弃用，改用 `prometheus.push_gateway.url`。"
emqx_prometheus_schema.legacy_vm_dist_collector.desc = "自5.4.0版本起弃用，改用 `prometheus.collectors.vm_dist`。"
emqx_prometheus_schema.legacy_vm_memory_collector.desc = "自5.4.0版本起弃用，改用 `prometheus.collectors.vm_memory`。"
emqx_prometheus_schema.legacy_vm_msacc_collector.desc = "自5.4.0版本起弃用，改用 `prometheus.collectors.vm_msacc`。"
emqx_prometheus_schema.legacy_vm_statistics_collector.desc = "自5.4.0版本起弃用，改用 `prometheus.collectors.vm_statistics`。"
emqx_prometheus_schema.legacy_vm_system_info_collector.desc = "自5.4.0版本起弃用，改用 `prometheus.collectors.vm_system_info`。"
emqx_prometheus_schema.mnesia_collector.desc = "开启或关闭 Mnesia 采集器, 使用 mnesia:system_info/1 收集 Mnesia 相关指标"
emqx_prometheus_schema.namespaced_metrics_limiter.desc = "命名空间指标抓取端点的速率限制选项。"
emqx_prometheus_schema.namespaced_metrics_limiter.label = "限制器"
emqx_prometheus_schema.namespaced_metrics_limiter_rate.desc = "从所有命名空间请求数据时的最大请求速率。对特定命名空间的请求不受速率限制。"
emqx_prometheus_schema.namespaced_metrics_limiter_rate.label = "速率"
emqx_prometheus_schema.prometheus.desc = "默认启用 EMQX 的 Prometheus 抓取端点。\n从 6.3.0 开始，抓取端点默认需要认证；可设置 `prometheus.enable_basic_auth = false` 恢复此前无需认证的行为。\n可以使用如下 `curl` 命令检查端点：\n`curl -f -u <api-key>:<api-secret> \"127.0.0.1:18083/api/v5/prometheus/stats\"`。"
emqx_prometheus_schema.prometheus.label = "Prometheus"
emqx_prometheus_schema.push_gateway.desc = "Push Gateway 是可选的，如果 Prometheus 要抓取 EMQX，则不应配置。"
emqx_prometheus_schema.push_gateway_enable.desc = "启用或禁用 Pushgateway。"
emqx_prometheus_schema.push_gateway_method.desc = "推送指标到 Pushgateway 的 HTTP 方法。可选项如下：<br/>\n - <code>put</code>: 所有在 URL 中指定分组键的指标会被通过 PUT 推送的指标替换。<br/>\n - <code>post</code>: POST 方法与 PUT 方法完全相同，但仅替换与新推送的指标同名的指标。<br/>\n默认值为 <code>put</code>。"
emqx_prometheus_schema.push_gateway_url.desc = "Pushgateway 服务器的 URL。Push Gateway 是可选的，如果 Prometheus 要抓取 EMQX，则不应配置。"
emqx_prometheus_schema.recommend_setting.desc = "推荐的设置"
emqx_prometheus_schema.vm_dist_collector.desc = "开启或关闭 VM 分布采集器，收集 Erlang 分布机制中涉及的套接字和进程的信息。"
emqx_prometheus_schema.vm_memory_collector.desc = "开启或关闭 VM 内存采集器, 使用 erlang:memory/0 收集 Erlang 虚拟机动态分配的内存信息，同时提供基本的 (D)ETS 统计信息"
emqx_prometheus_schema.vm_msacc_collector.desc = "开启或关闭 VM msacc 采集器, 使用 erlang:statistics(microstate_accounting) 收集微状态计数指标"
emqx_prometheus_schema.vm_statistics_collector.desc = "开启或关闭 VM 统计采集器, 使用 erlang:statistics/1 收集 Erlang VM 相关指标"
emqx_prometheus_schema.vm_system_info_collector.desc = "开启或关闭 VM 系统信息采集器, 使用 erlang:system_info/1 收集 Erlang VM 相关指标"
emqx_psk_schema.chunk_size.desc = "将 PSK 文件导入到内建数据时每个块的大小"
emqx_psk_schema.enable.desc = "是否开启 TLS PSK 支持"
emqx_psk_schema.init_file.desc = "如果设置了初始化文件，EMQX 将在启动时从初始化文件中导入 PSK 信息到内建数据库中。\n这个文件需要按行进行组织，每一行必须遵守如下格式: <code>PSKIdentity:SharedSecret</code>\n例如: <code>mydevice1:c2VjcmV0</code>"
emqx_psk_schema.psk_authentication.desc = "此配置用于启用 TLS-PSK 身份验证。\n\nPSK 是 “Pre-Shared-Keys” 的缩写。\n\n注意: 确保 SSL 监听器仅启用了 'tlsv1.2'，并且配置了 PSK 密码套件，例如 'RSA-PSK-AES256-GCM-SHA384'。\n\n可以通过查看监听器中的 SSL 选项，了解更多详细信息。\n\n可以通过配置 'init_file' 来设置初始化的 ID 和 密钥"
emqx_psk_schema.separator.desc = "PSK 文件中 <code>PSKIdentity</code> 和 <code>SharedSecret</code> 之间的分隔符"
emqx_redis.cluster.desc = "Cluster 模式。当 Redis 服务器在集群模式下运行时必须设置为'cluster'。"
emqx_redis.cluster.label = "Cluster 模式"
emqx_redis.database.desc = "Redis 数据库 ID。"
emqx_redis.database.label = "数据库 ID"
emqx_redis.redis_cluster_connector.desc = "集群模式下的 Redis 连接器。"
emqx_redis.redis_cluster_connector.label = "Redis 集群连接器"
emqx_redis.redis_sentinel_connector.desc = "Sentinel 模式下的 Redis 连接器。"
emqx_redis.redis_sentinel_connector.label = "Redis Sentinel 连接器"
emqx_redis.redis_single_connector.desc = "Single 模式下的 Redis 连接器。"
emqx_redis.redis_single_connector.label = "Redis Single 连接器"
emqx_redis.sentinel.desc = "Sentinel 模式。 当 Redis 服务器在 Senitel 模式下运行时必须设置为 'sentinel' 。"
emqx_redis.sentinel.label = "Sentinel 模式"
emqx_redis.sentinel_desc.desc = "Redis sentinel 模式下的集群名称。"
emqx_redis.sentinel_desc.label = "Cluster 名称"
emqx_redis.sentinel_password.desc = "用于与 Redis Sentinel 认证的密码。当 Sentinel 不要求认证时请留空。"
emqx_redis.sentinel_password.label = "Sentinel 密码"
emqx_redis.sentinel_username.desc = "用于与 Redis Sentinel 认证的用户名。当 Sentinel 不要求 ACL 用户名认证时请留空。"
emqx_redis.sentinel_username.label = "Sentinel 用户名"
emqx_redis.server.desc = "将要连接的 IPv4 或 IPv6 地址，或者主机名。主机名具有以下形式：Host[:Port]。如果未指定 [:Port]，则使用 Redis 默认端口 6379。"
emqx_redis.server.label = "服务器地址"
emqx_redis.servers.desc = "集群将要连接的节点列表。 节点之间用逗号分隔，如：Node[,Node]。每个节点的配置为：将要连接的 IPv4 或 IPv6 地址或主机名。主机名具有以下形式：Host[:Port]。如果未指定 [:Port]，则使用 Redis 默认端口 6379。"
emqx_redis.servers.label = "服务器列表"
emqx_redis.single.desc = "Single 模式。 当 Redis 服务器在 Single 模式下运行时必须设置为 'single' 。"
emqx_redis.single.label = "Single 模式"
emqx_resource_schema.batch_size.desc = "最大批量请求大小。如果设为 1，则无批处理。"
emqx_resource_schema.batch_size.label = "最大批量请求大小"
emqx_resource_schema.batch_time.desc = "在较低消息率情况下尝试累积批量输出时的最大等待间隔，以提高资源的利用率。"
emqx_resource_schema.batch_time.label = "批量等待最大间隔"
emqx_resource_schema.buffer_seg_bytes.desc = "当缓存模式是 <code>volatile_offload</code> 时适用。该配置用于指定缓存到磁盘上的文件的大小。"
emqx_resource_schema.buffer_seg_bytes.label = "缓存文件大小"
emqx_resource_schema.creation_opts.desc = "资源启动相关的选项。"
emqx_resource_schema.creation_opts.label = "资源启动选项"
emqx_resource_schema.dispatch_strategy.desc = "当查询未设置显式 pick key 时的分发策略。默认值 <code>per_clientid</code> 保持现有行为。设置为 <code>random</code> 可将此类查询分散到多个工作进程。"
emqx_resource_schema.dispatch_strategy.label = "分发策略"
emqx_resource_schema.enable_batch.desc = "启用批量模式。"
emqx_resource_schema.enable_batch.label = "启用批量模式"
emqx_resource_schema.enable_queue.desc = "启用磁盘缓存队列（仅对 egress 方向桥接有用）。"
emqx_resource_schema.enable_queue.label = "启用磁盘缓存队列"
emqx_resource_schema.health_check_interval.desc = "健康检查间隔。"
emqx_resource_schema.health_check_interval.label = "健康检查间隔"
emqx_resource_schema.health_check_interval_jitter.desc = "一个均匀的随机延迟将被添加到健康检查间隔中，以便来自同一 Connector 的动作和源在不同的时刻开始它们的健康检查。"
emqx_resource_schema.health_check_interval_jitter.label = "健康检查间隔抖动"
emqx_resource_schema.health_check_timeout.desc = "健康检查超时。如果健康检查调用返回结果的时间超过此时间，则资源被视为断开连接。"
emqx_resource_schema.health_check_timeout.label = "健康检查超时"
emqx_resource_schema.inflight_window.desc = "请求飞行队列窗口大小。当请求模式为异步时，如果需要严格保证来自同一 MQTT 客户端的消息有序，则必须将此值设为 1。"
emqx_resource_schema.inflight_window.label = "请求飞行队列窗口"
emqx_resource_schema.max_buffer_bytes.desc = "每个缓存 worker 允许使用的最大字节数。"
emqx_resource_schema.max_buffer_bytes.label = "缓存队列最大长度"
emqx_resource_schema.query_mode.desc = "请求模式。可选 '同步/异步'，默认为'异步'模式。"
emqx_resource_schema.query_mode.label = "请求模式"
emqx_resource_schema.request_ttl.desc = "从请求进入缓冲区的时刻开始，如果请求在指定的时间内仍然停留在缓冲区中，或者已经发送但没有及时收到响应或确认，该请求将被视为过期。"
emqx_resource_schema.request_ttl.label = "请求 TTL（生存时间）"
emqx_resource_schema.resource_opts.desc = "资源相关的选项。"
emqx_resource_schema.resource_opts.label = "资源选项"
emqx_resource_schema.resume_interval.desc = "在发送失败后尝试重传飞行窗口中的请求的时间间隔。"
emqx_resource_schema.resume_interval.label = "重试时间间隔"
emqx_resource_schema.start_after_created.desc = "是否在创建资源后立即启动资源。"
emqx_resource_schema.start_after_created.label = "创建后立即启动"
emqx_resource_schema.start_timeout.desc = "在回复资源创建请求前等待资源进入健康状态的时间。"
emqx_resource_schema.start_timeout.label = "启动超时时间"
emqx_resource_schema.worker_pool_size.desc = "缓存队列 worker 数量。仅对 egress 类型的桥接有意义。当桥接仅有 ingress 方向时，可设置为 0，否则必须大于 0。"
emqx_resource_schema.worker_pool_size.label = "缓存池大小"
emqx_retainer_api.config_content.desc = "配置内容"
emqx_retainer_api.config_not_found.desc = "配置不存在"
emqx_retainer_api.delete_matching_api.desc = "删除对应的消息"
