emqx_gateway_schema.fields_ws_opts_max_frame_size.desc = "单个 MQTT 数据包的最大长度。"
emqx_gateway_schema.fields_ws_opts_max_frame_size.label = "最大帧大小"
emqx_gateway_schema.fields_ws_opts_path.desc = "WebSocket 的M QTT 协议路径。因此，EMQX Broker 的 WebSocket 地址是：<code>ws://{ip}:{port}/mqtt</code>"
emqx_gateway_schema.fields_ws_opts_path.label = "WS MQTT 路径"
emqx_gateway_schema.fields_ws_opts_piggyback.desc = "WebSocket 消息是否允许包含多个 MQTT 数据包。"
emqx_gateway_schema.fields_ws_opts_piggyback.label = "MQTT 搭载"
emqx_gateway_schema.fields_ws_opts_proxy_address_header.desc = "用于传递客户端 IP 地址信息的 HTTP 请求头。\n当 EMQX 集群部署在负载均衡器后面时相关。"
emqx_gateway_schema.fields_ws_opts_proxy_address_header.label = "代理地址请求头"
emqx_gateway_schema.fields_ws_opts_proxy_port_header.desc = "用于传递客户端端口信息的 HTTP 请求头。\n当 EMQX 集群部署在负载均衡器后面时相关。"
emqx_gateway_schema.fields_ws_opts_proxy_port_header.label = "代理端口请求头"
emqx_gateway_schema.fields_ws_opts_supported_subprotocols.desc = "逗号分隔的支持的子协议列表。"
emqx_gateway_schema.fields_ws_opts_supported_subprotocols.label = "支持的子协议"
emqx_gateway_schema.gateway_common_authentication.desc = "网关的认证器配置，对该网关下所以的监听器生效。如果每个监听器需要配置不同的认证器，需要配置监听器下的 <code>authentication</code> 字段"
emqx_gateway_schema.gateway_common_clientinfo_override.desc = "ClientInfo 重写。"
emqx_gateway_schema.gateway_common_clientinfo_override_clientid.desc = "clientid 重写模板"
emqx_gateway_schema.gateway_common_clientinfo_override_password.desc = "password 重写模板"
emqx_gateway_schema.gateway_common_clientinfo_override_username.desc = "username 重写模板"
emqx_gateway_schema.gateway_common_enable.desc = "是否启用该网关"
emqx_gateway_schema.gateway_common_enable_stats.desc = "是否开启客户端统计"
emqx_gateway_schema.gateway_common_idle_timeout.desc = "客户端连接过程的空闲时间。该配置用于：\n  1. 一个新创建的客户端进程如果在该时间间隔内没有收到任何客户端请求，将被直接关闭。\n  2. 一个正在运行的客户进程如果在这段时间后没有收到任何客户请求，将进入休眠状态以节省资源。"
emqx_gateway_schema.gateway_common_listener_access_rules.desc = "一个包含字符串规则的访问规则列表，用于限制或允许来自某些地址的访问。\n列表中较早出现的规则优先匹配。\n格式为 allow | deny <address> | <CIDR> | all。\n\n例如：\n\n[\"deny 192.168.1.1\", \"allow 192.168.1.0/24\", \"deny all\"]"
emqx_gateway_schema.gateway_common_listener_bind.desc = "监听器绑定的 IP 地址或端口。"
emqx_gateway_schema.gateway_common_listener_enable.desc = "是否启用该监听器。"
emqx_gateway_schema.gateway_common_listener_enable_authn.desc = "配置 <code>true</code> （默认值）启用客户端进行身份认证。\n配置 <code>false</code> 时，将不对客户端做任何认证。"
emqx_gateway_schema.gateway_common_listener_max_conn_rate.desc = "监听器支持的最大连接速率。"
emqx_gateway_schema.gateway_common_listener_max_connections.desc = "监听器支持的最大连接数。"
emqx_gateway_schema.gateway_mountpoint.desc = "发布或订阅时，在所有主题前增加前缀字符串。\n当消息投递给订阅者时，前缀字符串将从主题名称中删除。挂载点是用户可以用来实现不同监听器之间的消息路由隔离的一种方式。\n例如，如果客户端 A 在 `listeners.tcp.\\<name>.mountpoint` 设置为 `some_tenant` 的情况下订阅 `t`，\n则客户端实际上订阅了 `some_tenant/t` 主题。\n类似地，如果另一个客户端 B（连接到与客户端 A 相同的侦听器）向主题 `t` 发送消息，\n则该消息被路由到所有订阅了 `some_tenant/t` 的客户端，因此客户端 A 将收到该消息，带有 主题名称`t`。 设置为 `\"\"` 以禁用该功能。\n挂载点字符串中可用的变量：<br/>\n   - <code>${clientid}</code>：clientid<br/>\n   - <code>${username}</code>：用户名"
emqx_gateway_schema.listener_name_to_settings_map.desc = "从监听器名称到配置参数的映射。"
emqx_gateway_schema.ssl_listener_options.desc = "SSL Socket 配置。"
emqx_gateway_schema.tcp_listener_acceptors.desc = "Acceptor 进程池大小。"
emqx_gateway_schema.tcp_listener_proxy_protocol.desc = "如果为 EMQX 部署了反向代理，并且在代理上启用了 PROXY 协议以传递客户端的真实 IP，\n则需要开启此选项，以便 EMQX 能够从 PROXY 协议头中提取客户端的真实 IP。\nEMQX 将自动检测 PROXY 协议的版本，并支持 V1 和 V2。\n\n有关 PROXY 协议的详细描述，请参考：https://www.haproxy.com/blog/haproxy/proxy-protocol/。"
emqx_gateway_schema.tcp_listener_proxy_protocol_timeout.desc = "接收 Proxy Protocol 报文头的超时时间。如果在超时内没有收到 Proxy Protocol 包，EMQX 将关闭 TCP 连接。"
emqx_gateway_schema.tcp_listener_tcp_opts.desc = "TCP Socket 配置。"
emqx_gateway_schema.tcp_listeners.desc = "配置 TCP 类型的监听器。"
emqx_gateway_schema.tcp_udp_listeners.desc = "监听器配置。"
emqx_gateway_schema.udp_health_check.desc = "一些云平台使用“请求-回复”机制来检查 UDP 端口是否健康，这里可以配置这对内容。"
emqx_gateway_schema.udp_health_check_reply.desc = "回复的内容。"
emqx_gateway_schema.udp_health_check_request.desc = "请求的内容。"
emqx_gateway_schema.udp_listener_active_n.desc = "为 Socket 指定 {active, N} 选项。\n参见：https://erlang.org/doc/man/inet.html#setopts-2"
emqx_gateway_schema.udp_listener_buffer.desc = "Socket 在用户空间的缓冲区大小。"
emqx_gateway_schema.udp_listener_recbuf.desc = "Socket 在内核空间接收缓冲区的大小。"
emqx_gateway_schema.udp_listener_reuseaddr.desc = "允许重用本地处于 TIME_WAIT 的端口号。"
emqx_gateway_schema.udp_listener_sndbuf.desc = "Socket 在内核空间发送缓冲区的大小。"
emqx_gateway_schema.udp_listener_udp_opts.desc = "UDP Socket 配置。"
emqx_gateway_schema.udp_listeners.desc = "配置 UDP 类型的监听器。"
emqx_gbt32960_schema.max_retry_times.desc = "最大重新发送次数"
emqx_gbt32960_schema.message_queue_len.desc = "最大消息队列长度"
emqx_gbt32960_schema.retry_interval.desc = "重新发送时间间隔"
