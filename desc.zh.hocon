emqx_bridge_confluent_producer.buffer_memory_overload_protection.desc = "当缓冲模式设置为<code>memory</code>时适用。在高内存压力下，EMQX 将丢弃旧的缓冲消息。注意：此配置仅在 Linux 上有效。"
emqx_bridge_confluent_producer.buffer_memory_overload_protection.label = "内存过载保护"
emqx_bridge_confluent_producer.buffer_mode.desc = "消息缓冲模式。\n\n<code>memory</code>：在内存中缓冲所有消息。如果 EMQX 节点重启，这些消息将会丢失。\n<code>disk</code>：在磁盘上缓冲所有消息。磁盘上的消息能够在 EMQX 节点重启后保留。\n<code>hybrid</code>：首先在内存中缓冲消息，当达到一定限制（参见<code>segment_bytes</code>配置了解更多信息）时，开始将消息转移到磁盘。像<code>memory</code>模式一样，如果 EMQX 节点重启，这些消息将会丢失。"
emqx_bridge_confluent_producer.buffer_mode.label = "缓冲模式"
emqx_bridge_confluent_producer.buffer_per_partition_limit.desc = "每个 Confluent 分区允许缓冲的字节数。当超出此限制时，旧消息将被丢弃以换取新消息的缓冲空间。"
emqx_bridge_confluent_producer.buffer_per_partition_limit.label = "分区缓冲限制"
emqx_bridge_confluent_producer.buffer_segment_bytes.desc = "当缓冲模式设置为<code>disk</code>或<code>hybrid</code>时适用。\n此值用于指定每个磁盘缓冲文件的大小。"
emqx_bridge_confluent_producer.buffer_segment_bytes.label = "分段文件字节数"
emqx_bridge_confluent_producer.compression.desc = "压缩方法。"
emqx_bridge_confluent_producer.compression.label = "压缩"
emqx_bridge_confluent_producer.config_enable.desc = "启用（是）或停用（否）此动作。"
emqx_bridge_confluent_producer.config_enable.label = "是否启用"
emqx_bridge_confluent_producer.connect_timeout.desc = "TCP 连接建立的最大等待时间（包括启用认证时的认证时间）。"
emqx_bridge_confluent_producer.connect_timeout.label = "连接超时"
emqx_bridge_confluent_producer.connector_type.desc = "连接器的类型"
emqx_bridge_confluent_producer.connector_type.label = "连接器类型"
emqx_bridge_confluent_producer.desc_config.desc = "Confluent 动作的配置"
emqx_bridge_confluent_producer.desc_config.label = "Confluent 动作配置"
emqx_bridge_confluent_producer.desc_name.desc = "动作名称，用作动作的可读描述。"
emqx_bridge_confluent_producer.desc_name.label = "动作名称"
emqx_bridge_confluent_producer.desc_type.desc = "动作的类型"
emqx_bridge_confluent_producer.desc_type.label = "动作类型"
emqx_bridge_confluent_producer.kafka_header_value_encode_mode.desc = "Confluent 头部值编码模式<br/>\n - None：仅向 Confluent 头部添加二进制值；<br/>\n - JSON：仅向 Confluent 头部添加 JSON 值，并在发送前将其编码为 JSON 字符串。"
emqx_bridge_confluent_producer.kafka_header_value_encode_mode.label = "Confluent 头部值编码模式"
emqx_bridge_confluent_producer.kafka_headers.desc = "提供用作 Confluent 头部的占位符<br/>\n例如<code>${pub_props}</code><br/>\n注意，占位符的值必须是对象：\n<code>{\"foo\": \"bar\"}</code>\n或键值对数组：\n<code>[{\"key\": \"foo\", \"value\": \"bar\"}]</code>"
emqx_bridge_confluent_producer.kafka_headers.label = "Confluent 头部"
emqx_bridge_confluent_producer.kafka_message.desc = "呈现 Confluent 消息的模版。"
emqx_bridge_confluent_producer.kafka_message.label = "Confluent 消息模版"
emqx_bridge_confluent_producer.kafka_message_key.desc = "用于呈现 Confluent 消息键的模版。如果模板呈现为空值（即在规则引擎上下文中没有此类数据字段），则使用 Confluent 的 NULL（而不是空字符串）。"
emqx_bridge_confluent_producer.kafka_message_key.label = "消息键"
emqx_bridge_confluent_producer.kafka_message_timestamp.desc = "使用哪个时间戳。时间戳应为毫秒级 Unix 纪元时间，可以是字符串格式，例如<code>1661326462115</code>或<code>'1661326462115'</code>。当找不到所需数据字段或找到的数据不是有效的整数时，将使用当前系统时间戳。"
emqx_bridge_confluent_producer.kafka_message_timestamp.label = "消息时间戳"
emqx_bridge_confluent_producer.kafka_message_value.desc = "用于呈现 Confluent 消息键的模版。如果模板呈现为空值（即在规则引擎上下文中没有此类数据字段），则使用 Confluent 的 NULL（而不是空字符串）。"
emqx_bridge_confluent_producer.kafka_message_value.label = "消息值"
emqx_bridge_confluent_producer.kafka_producer.desc = "Confluent 生产者配置。"
emqx_bridge_confluent_producer.kafka_producer.label = "Confluent 生产者"
emqx_bridge_confluent_producer.kafka_topic.desc = "事件中心名称。支持使用模版（例如：`t-${payload.t}`）。"
emqx_bridge_confluent_producer.kafka_topic.label = "事件中心名称"
emqx_bridge_confluent_producer.max_batch_bytes.desc = "最大 Confluent 消息批量字节数。大多数 Kafka 环境的默认最低值是 1 MB，EMQX 的默认值比 1 MB 更小是因为需要补偿 Kafka 消息编码所需要的额外字节（尤其是当每条消息都很小的情况下）。当单个消息的大小超过该限制时，它仍然会被发送，（相当于该批量中只有单个消息）。"
emqx_bridge_confluent_producer.max_batch_bytes.label = "最大批量字节数"
emqx_bridge_confluent_producer.max_inflight.desc = "Confluent 生产者在接收到 Confluent 的确认之前，每个分区允许发送的批次的最大数量。较高的值通常意味着更好的吞吐量。然而，当这个值大于1时，可能会有消息重新排序的风险。"
emqx_bridge_confluent_producer.max_inflight.label = "飞行窗口"
emqx_bridge_confluent_producer.max_linger_bytes.desc = "每个分区生产者在发送数据前，为了收集批量消息进行缓冲，最多可以等待的消息字节数。"
emqx_bridge_confluent_producer.max_linger_bytes.label = "最大等待字节数"
emqx_bridge_confluent_producer.max_linger_time.desc = "每个分区生产者为了收集批量消息进行缓冲的最长等待时间。\n默认值为 0，表示不等待。 对于非内存缓冲模式，建议配置至少 5ms 以减少 IOPS（每秒输入输出操作次数）。"
emqx_bridge_confluent_producer.max_linger_time.label = "最大等待时间"
emqx_bridge_confluent_producer.metadata_request_timeout.desc = "从 Confluent 获取元数据的最大等待时间。"
emqx_bridge_confluent_producer.metadata_request_timeout.label = "元数据请求超时"
emqx_bridge_confluent_producer.min_metadata_refresh_interval.desc = "客户端刷新 Confluent Kafka 代理和主题元数据的最短时间间隔。设置过小的值可能会给 Confluent 增加额外的负载。"
emqx_bridge_confluent_producer.min_metadata_refresh_interval.label = "最小元数据刷新间隔"
emqx_bridge_confluent_producer.mqtt_topic.desc = "将 MQTT 主题或主题过滤器作为数据源（动作输入）。如果使用规则动作作为数据源，则应将此配置保留为空，否则消息将在 Confluent 中重复。"
emqx_bridge_confluent_producer.mqtt_topic.label = "源 MQTT 主题"
emqx_bridge_confluent_producer.oauth_client_credentials_client_id.desc = "用于从 OAuth 服务器请求令牌的客户端 ID。"
emqx_bridge_confluent_producer.oauth_client_credentials_client_id.label = "OAuth 客户端 ID"
emqx_bridge_confluent_producer.oauth_client_credentials_client_secret.desc = "用于从 OAuth 服务器请求令牌的客户端密钥。"
emqx_bridge_confluent_producer.oauth_client_credentials_client_secret.label = "OAuth 客户端密钥"
emqx_bridge_confluent_producer.oauth_client_credentials_endpoint_uri.desc = "生成访问令牌的 OAuth 令牌端点的 URI。"
emqx_bridge_confluent_producer.oauth_client_credentials_endpoint_uri.label = "OAuth 令牌端点 URI"
emqx_bridge_confluent_producer.oauth_client_credentials_extensions.desc = "如果需要，指定要传递到 SASL 握手的扩展。"
emqx_bridge_confluent_producer.oauth_client_credentials_extensions.label = "SASL 扩展"
emqx_bridge_confluent_producer.oauth_client_credentials_grant_type.desc = "OAuth 授权类型"
emqx_bridge_confluent_producer.oauth_client_credentials_grant_type.label = "OAuth 授权类型"
emqx_bridge_confluent_producer.oauth_client_credentials_identity_pool_id.desc = "连接时在 SASL 扩展中使用的 Confluent 身份池 ID。"
emqx_bridge_confluent_producer.oauth_client_credentials_identity_pool_id.label = "身份池 ID"
emqx_bridge_confluent_producer.oauth_client_credentials_logical_cluster.desc = "连接时在 SASL 扩展中使用的 Confluent 集群 ID。"
emqx_bridge_confluent_producer.oauth_client_credentials_logical_cluster.label = "逻辑集群 ID"
emqx_bridge_confluent_producer.oauth_client_credentials_mechanism.desc = "SASL 认证机制"
emqx_bridge_confluent_producer.oauth_client_credentials_mechanism.label = "SASL 认证机制"
emqx_bridge_confluent_producer.oauth_client_credentials_scope.desc = "如果需要，指定在请求 OAuth 访问令牌时提供的 `scope`。"
emqx_bridge_confluent_producer.oauth_client_credentials_scope.label = "OAuth 请求范围"
emqx_bridge_confluent_producer.partition_count_refresh_interval.desc = "Confluent 生产者发现分区数量增加的时间间隔。\n在 Confluent 中增加分区数量后，EMQX 将开始根据<code>partition_strategy</code>\n在分发消息时考虑新发现的分区。"
emqx_bridge_confluent_producer.partition_count_refresh_interval.label = "分区数刷新间隔"
emqx_bridge_confluent_producer.partition_strategy.desc = "分区策略是用来指导生产者如何将消息分配到 Confluent 的各个分区。\n\n<code>random</code>: 为每条消息随机选择一个分区。\n<code>key_dispatch</code>: 根据 Confluent 消息键的哈希值将消息分配到分区，确保拥有相同键的消息能够一致地被分配到特定分区。"
emqx_bridge_confluent_producer.partition_strategy.label = "分区策略"
emqx_bridge_confluent_producer.partitions_limit.desc = "限制为给定主题产生数据的分区数量。\n特殊值 all_partitions 用于利用主题的所有分区。\n设置的值如果大于分区总数则无效。"
emqx_bridge_confluent_producer.partitions_limit.label = "最大分区数"
emqx_bridge_confluent_producer.producer_buffer.desc = "配置生产者消息缓冲区。\n\n在 EMQX 有更多消息需要发送而 Confluent 跟不上时，或者 Confluent 宕机时，告诉 Confluent 生产者如何缓冲消息。"
emqx_bridge_confluent_producer.producer_buffer.label = "消息缓冲"
emqx_bridge_confluent_producer.producer_health_check_topic.desc = "专用于更精确的连接器健康检查的主题名称。"
emqx_bridge_confluent_producer.producer_health_check_topic.label = "连接器健康检查主题"
emqx_bridge_confluent_producer.producer_kafka_ext_header_key.desc = "Confluent 头部的键。支持${var}格式的占位符。"
emqx_bridge_confluent_producer.producer_kafka_ext_header_key.label = "额外的 Confluent 头部键"
emqx_bridge_confluent_producer.producer_kafka_ext_header_value.desc = "Confluent 头部的值。支持${var}格式的占位符。"
emqx_bridge_confluent_producer.producer_kafka_ext_header_value.label = "额外的 Confluent 头部值"
emqx_bridge_confluent_producer.producer_kafka_ext_headers.desc = "请提供更多的 Confluent 头部键值对<br/>\n这里的键值对将与<code>kafka_headers</code>字段的值结合后发送给 Confluent。"
emqx_bridge_confluent_producer.producer_kafka_ext_headers.label = "更多的 Confluent 头部"
emqx_bridge_confluent_producer.producer_kafka_opts.desc = "Confluent 生产者配置。"
emqx_bridge_confluent_producer.producer_kafka_opts.label = "Confluent 生产者"
emqx_bridge_confluent_producer.producer_opts.desc = "本地 MQTT 数据源和 Confluent 动作配置。"
emqx_bridge_confluent_producer.producer_opts.label = "MQTT 到 Confluent"
emqx_bridge_confluent_producer.query_mode.desc = "查询模式。可选'sync/async'，默认'async'。"
emqx_bridge_confluent_producer.query_mode.label = "查询模式"
emqx_bridge_confluent_producer.required_acks.desc = "Confluent 分区领导者的确认标准。它确定了在向 EMQX Confluent 生产者回送确认前，需要从追随者分区获得的确认等级。\n\n<code>all_isr</code>：要求所有同步副本进行确认。\n<code>leader_only</code>：仅要求分区领导者的确认。"
emqx_bridge_confluent_producer.required_acks.label = "所需确认"
emqx_bridge_confluent_producer.resource_opts.desc = "资源选项。"
emqx_bridge_confluent_producer.resource_opts.label = "资源选项"
emqx_bridge_confluent_producer.server_name_indication.desc = "TLS 握手的服务器名称指示（SNI）设置。<br/>\n- <code>auto</code>：客户端将使用<code>\"servicebus.windows.net\"</code>作为 SNI。<br/>\n- <code>disable</code>：如果您不希望客户端发送 SNI。<br/>\n- 其他字符串值将按原样发送。"
emqx_bridge_confluent_producer.server_name_indication.label = "SNI"
emqx_bridge_confluent_producer.socket_nodelay.desc = "当设置为'true'时，TCP 缓冲区将尽可能快地发送。否则，操作系统内核可能会暂时缓冲小的 TCP 数据包（默认40毫秒）。"
emqx_bridge_confluent_producer.socket_nodelay.label = "无延迟"
emqx_bridge_confluent_producer.socket_opts.desc = "额外的套接字选项。"
emqx_bridge_confluent_producer.socket_opts.label = "套接字选项"
emqx_bridge_confluent_producer.socket_receive_buffer.desc = "微调套接字接收缓冲区。为实现高吞吐量，默认值已调整。"
emqx_bridge_confluent_producer.socket_receive_buffer.label = "套接字接收缓冲区大小"
emqx_bridge_confluent_producer.socket_send_buffer.desc = "微调套接字发送缓冲区。为实现高吞吐量，默认值已调整。"
emqx_bridge_confluent_producer.socket_send_buffer.label = "套接字发送缓冲区大小"
emqx_bridge_confluent_producer.socket_tcp_keepalive.desc = "启用 TCP keepalive。\n值为三个逗号分隔的数字，格式为 'Idle,Interval,Probes'\n - Idle：连接需要空闲的秒数，服务器才开始发送 keep-alive 探测包（Linux 默认 7200）。\n - Interval：TCP keep-alive 探测包之间的秒数（Linux 默认 75）。\n - Probes：在放弃并关闭连接之前，最多发送的 TCP keep-alive 探测包数（Linux 默认 9）。\n例如 \"240,30,5\" 表示：在连接空闲 240 秒后发送 TCP keepalive 探测，每隔 30 秒发送一次，直到收到响应，如果连续丢失 5 个响应，连接应该被关闭。\n默认：'none'"
emqx_bridge_confluent_producer.socket_tcp_keepalive.label = "TCP keepalive 选项"
emqx_bridge_confluent_producer.ssl_client_opts.desc = "Confluent 客户端的 TLS/SSL 选项。"
emqx_bridge_confluent_producer.ssl_client_opts.label = "TLS/SSL 选项"
emqx_bridge_confluent_producer.sync_query_timeout.desc = "此参数定义同步查询的超时限制。仅在动作查询模式配置为'sync'时适用。"
emqx_bridge_confluent_producer.sync_query_timeout.label = "同步查询超时"
emqx_bridge_couchbase_action_schema.couchbase.desc = "将传入事件上传到 Couchbase 服务的动作。"
emqx_bridge_couchbase_action_schema.couchbase.label = "上传到 Couchbase"
emqx_bridge_couchbase_action_schema.max_retries.desc = "发送请求时发生错误的最大重试次数。"
emqx_bridge_couchbase_action_schema.max_retries.label = "最大重试次数"
emqx_bridge_couchbase_action_schema.parameters.desc = "动作的参数集。"
emqx_bridge_couchbase_action_schema.parameters.label = "Couchbase 动作参数"
emqx_bridge_couchbase_action_schema.sql.desc = "SQL 模版。"
emqx_bridge_couchbase_action_schema.sql.label = "SQL 模版"
emqx_bridge_couchbase_connector_schema.config_connector.desc = "用于连接 Couchbase 服务的连接器配置。"
emqx_bridge_couchbase_connector_schema.config_connector.label = "Couchbase 连接器配置"
emqx_bridge_couchbase_connector_schema.connect_timeout.desc = "连接到 HTTP 服务器时的超时时间。"
emqx_bridge_couchbase_connector_schema.connect_timeout.label = "连接超时"
emqx_bridge_couchbase_connector_schema.password.desc = "访问 Couchbase 服务的密码。"
emqx_bridge_couchbase_connector_schema.password.label = "密码"
emqx_bridge_couchbase_connector_schema.pipelining.desc = "一个正整数，表示是否连续发送 HTTP 请求。当设置为 1 时，表示每次发送 HTTP 请求后，需要等待服务器返回再继续发送下一个请求。"
emqx_bridge_couchbase_connector_schema.pipelining.label = "HTTP 流水线"
emqx_bridge_couchbase_connector_schema.pool_size.desc = "指定与 Couchbase 服务对接时连接池中可以维持的并发连接数。"
emqx_bridge_couchbase_connector_schema.pool_size.label = "连接池大小"
emqx_bridge_couchbase_connector_schema.server.desc = "要连接的 IPv4 或 IPv6 地址或主机名。<br/>\n  主机条目的格式为：`Host[:Port]`。`Host[:Port]`.<br/>\n  如果未指定 `[:Port]`，则使用 Couchbase 默认的查询服务端口 8093。"
emqx_bridge_couchbase_connector_schema.server.label = "服务器地址"
emqx_bridge_couchbase_connector_schema.username.desc = "访问 Couchbase 服务的用户名。"
emqx_bridge_couchbase_connector_schema.username.label = "用户名"
emqx_bridge_datalayers.action_parameters_arrow_flight.desc = "使用 Arrow Flight 驱动的特定附加参数"
emqx_bridge_datalayers.action_parameters_arrow_flight.label = "动作参数"
emqx_bridge_datalayers.action_parameters_influx.desc = "使用 Influx Line Protocol 的特定附加参数"
emqx_bridge_datalayers.action_parameters_influx.label = "动作参数"
emqx_bridge_datalayers.connector.desc = "Datalayers 连接器配置"
emqx_bridge_datalayers.connector.label = "Datalayers 连接器"
emqx_bridge_datalayers.datalayers_action.desc = "用于与 Datalayers 连接器交互的动作。"
emqx_bridge_datalayers.datalayers_action.label = "Datalayers 动作"
emqx_bridge_datalayers.desc_config.desc = "Datalayers 数据集成的配置"
emqx_bridge_datalayers.desc_config.label = "Datalayers 数据集成配置"
emqx_bridge_datalayers.desc_name.desc = "数据集成的名称。"
emqx_bridge_datalayers.desc_name.label = "数据集成名称"
emqx_bridge_datalayers.desc_type.desc = "数据集成的类型。"
emqx_bridge_datalayers.desc_type.label = "数据集成类型"
emqx_bridge_datalayers.sql_template.desc = "SQL 模板"
emqx_bridge_datalayers.sql_template.label = "SQL 模板"
emqx_bridge_datalayers.write_syntax.desc = "用于写入数据点的 InfluxDB 行协议配置。这是一种基于文本的格式，提供数据点的测量、标签集、字段集和时间戳，并支持占位符。\n详见 [InfluxDB 1.8 行协议](https://docs.influxdata.com/influxdb/v1.8/write_protocols/line_protocol_tutorial/) <br/>\n简短说明：<br/>\n```\n<measurement>[,<tag_key>=<tag_value>[,<tag_key>=<tag_value>]] <field_key>=<field_value>[,<field_key>=<field_value>] [<timestamp>]\n```\n请注意，整数值的占位符必须带有后缀 `i`。 例如 `${payload.int_value}i`。"
emqx_bridge_datalayers.write_syntax.label = "写入语法"
emqx_bridge_datalayers_connector.database.desc = "Datalayers 数据库"
emqx_bridge_datalayers_connector.database.label = "数据库"
