emqx_exhook_api.status.desc = "Exhook 服务器的状态。<br/>\nconnected: 连接成功<br/>\nconnecting: 连接失败，重连中<br/>\ndisconnected: 连接失败，且未设置自动重连<br/>\ndisabled: 该服务器未开启<br/>\nerror: 查看该服务器状态时发生错误"
emqx_exhook_api.status.label = "Exhook 服务器的状态"
emqx_exhook_api.update_server.desc = "更新 Exhook 服务器"
emqx_exhook_api.update_server.label = "更新 Exhook 服务器"
emqx_exhook_schema.auto_reconnect.desc = "自动重连到 gRPC 服务器的设置。\n当 gRPC 服务器不可用时，Exhook 将会按照这里设置的间隔时间进行重连，并重新初始化注册的钩子"
emqx_exhook_schema.enable.desc = "开启这个 Exhook 服务器"
emqx_exhook_schema.failed_action.desc = "当 gRPC 请求失败后的操作"
emqx_exhook_schema.keepalive.desc = "当没有其他数据交换时，是否向连接的对端套接字定期的发送探测包。如果另一端没有响应，则认为连接断开，并向控制进程发送错误消息。"
emqx_exhook_schema.name.desc = "ExHook 服务器名称"
emqx_exhook_schema.nodelay.desc = "如果为 true，则为套接字设置 TCP_NODELAY 选项，这意味着会立即发送数据包"
emqx_exhook_schema.pool_size.desc = "gRPC 客户端进程池大小"
emqx_exhook_schema.recbuf.desc = "套接字的最小接收缓冲区大小"
emqx_exhook_schema.request_timeout.desc = "gRPC 服务器请求超时"
emqx_exhook_schema.servers.desc = "ExHook 服务器列表"
emqx_exhook_schema.sndbuf.desc = "套接字的最小发送缓冲区大小"
emqx_exhook_schema.socket_options.desc = "连接套接字设置"
emqx_exhook_schema.url.desc = "gRPC 服务器地址"
emqx_exproto_schema.exproto.desc = "ExProto 网关"
emqx_exproto_schema.exproto_grpc_handler_address.desc = "对端 gRPC 服务器地址。"
emqx_exproto_schema.exproto_grpc_handler_service_name.desc = "用于处理连接事件的服务名称\n在初始版本中，我们期望使用流来提高 ConnectionHandler 中请求的效率。\n但不幸的是，不同流之间的事件顺序混乱。\n这导致 OnSocketCreated 事件可能会\n在 OnReceivedBytes 之后到达。\n因此，自 v5.0.25 起，我们添加了 `ConnectionUnaryHandler` 服务，并强制在其中使用了 Unary，以避免顺序问题。"
emqx_exproto_schema.exproto_grpc_handler_ssl.desc = "gRPC 客户端的 SSL 配置。"
emqx_exproto_schema.exproto_grpc_server_bind.desc = "服务监听地址和端口。"
emqx_exproto_schema.exproto_grpc_server_ssl.desc = "服务 SSL 配置。"
emqx_exproto_schema.exproto_handler.desc = "配置 ExProto 网关需要请求的 <code>ConnectionHandler</code> 服务地址。\n该服务用于给 ExProto 提供客户端的 Socket 事件处理、字节解码、订阅消息接收等功能。"
emqx_exproto_schema.exproto_server.desc = "配置 ExProto 网关需要启动的 <code>ConnectionAdapter</code> 服务。\n该服务用于提供客户端的认证、发布、订阅和数据下行等功能。"
emqx_ft_api.cursor_to_start_listing.desc = "开始列出文件的游标。"
emqx_ft_api.cursor_to_start_listing.label = "开始列出的游标"
