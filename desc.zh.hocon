emqx_gcp_device_api.registry.desc = "设备注册标识"
emqx_gcp_device_api.registry.label = "注册"
emqx_jt808_schema.authentication_url.desc = "JT/T 808 设备认证中心的 URL。"
emqx_jt808_schema.ignore_unsupported_frames.desc = "是否忽略不支持的 JT/T 808 数据帧。<br/>\n- <code>true</code>，网关会记录不支持的帧并忽略。 <br/>\n- <code>false</code>，网关在收到不支持的帧时将断开客户端连接。<br/>\n默认值为 true。"
emqx_jt808_schema.jt808_allow_anonymous.desc = "允许匿名访问 JT/T 808 网关。registry_url.descJT/T 808 设备注册中心 URL。authentication_url.descJT/T 808 设备身份验证中心 URL。jt808_up_topic.descJT/T 808 协议上行消息的主题。jt808_dn_topic.descJT/T 808 协议下行消息的主题。"
emqx_jt808_schema.jt808_auth.desc = "JT/T 808 网关的认证设置。"
emqx_jt808_schema.jt808_dn_topic.desc = "JT/T 808 协议下行消息的主题。"
emqx_jt808_schema.jt808_frame_max_length.desc = "JT/T 808 帧的最大长度。"
emqx_jt808_schema.jt808_up_topic.desc = "JT/T 808 协议上行消息的主题。"
emqx_jt808_schema.max_retry_times.desc = "最大重发次数"
emqx_jt808_schema.message_queue_len.desc = "最大消息队列长度"
emqx_jt808_schema.parse_unknown_message.desc = "是否处理并转发无法识别的 Message ID。<br/>\n- <code>true</code>：处理无法识别的 Message ID，其消息体以 Base64 编码后转发。<br/>\n- <code>false</code>：收到无法识别的 Message ID 时报告并记录错误。<br/>\n默认值为 true。"
emqx_jt808_schema.registry_url.desc = "JT/T 808 设备注册中心的 URL。"
emqx_jt808_schema.retry_interval.desc = "重发时间间隔"
emqx_jt808_schema.string_encoding.desc = "JT/T 808 线协议中 STRING 类型字段的字符编码。<br/>\n- <code>utf8</code>：字符串按 UTF-8 编码处理（兼容旧行为，默认）。<br/>\n- <code>gbk</code>：字符串按 JT/T 808 规范的 GBK 编码处理；与 MQTT 负载之间转换为 UTF-8。<br/>\n注意：无论此设置如何，MQTT 负载始终使用 UTF-8。如果中文文本出现乱码（Mojibake），请设为 <code>gbk</code>。"
emqx_ldap.base_dn.desc = "与基本对象条目（或根）相关的名称。\n搜索用户的起点。"
emqx_ldap.base_dn.label = "基本 DN"
emqx_ldap.filter.desc = "定义哪些条件必须被依次满足的过滤器\n用于搜索匹配一条给定的条目.<br>\n筛选器的语法遵循 RFC 4515，并且还支持占位符。"
emqx_ldap.filter.label = "过滤器"
emqx_ldap.request_timeout.desc = "设置每个单独请求所使用的最大时间（以毫秒为单位）。"
emqx_ldap.request_timeout.label = "请求超时"
emqx_ldap.server.desc = "要连接的 IPv4 或 IPv6 地址或主机名。<br/>\n主机名条目的格式为：`主机[:端口]`。<br/>\n如果 `[:端口]` 未指定， 将使用 LDAP 默认端口 389。"
emqx_ldap.server.label = "服务器地址"
emqx_license_http_api.bad_license_key.desc = "错误的 License 密钥"
emqx_license_http_api.bad_license_key.label = "错误的 License 密钥"
emqx_license_http_api.bad_setting_value.desc = "错误的设置值"
emqx_license_http_api.bad_setting_value.label = "错误的设置值"
emqx_license_http_api.desc_license_info_api.desc = "获取 License 信息"
emqx_license_http_api.desc_license_info_api.label = "License 信息"
emqx_license_http_api.desc_license_key_api.desc = "更新一个 License 密钥"
emqx_license_http_api.desc_license_key_api.label = "更新 License"
emqx_license_http_api.desc_license_setting_api.desc = "更新 License 设置"
emqx_license_http_api.desc_license_setting_api.label = "更新 license 设置"
emqx_license_http_api.desc_session_hwm_history_api.desc = "获取会话高水位线历史。返回按天或按月的会话峰值计数。"
emqx_license_http_api.desc_session_hwm_history_api.label = "会话高水位线历史"
emqx_license_http_api.example_license_key_string.desc = "用于更新 License key 的请求示例。"
emqx_license_http_api.example_license_key_string.label = "License Key 字符串示例"
emqx_license_http_api.param_history_limit.desc = "返回的最大行数。`daily` 默认 30，`monthly` 默认 24（匹配 24 个月保留窗口）。"
emqx_license_http_api.param_history_limit.label = "限制"
emqx_license_http_api.param_history_period.desc = "聚合周期：`daily` 每天一行，`monthly` 将每日峰值折叠为月级最大值。默认 `monthly`。"
emqx_license_http_api.param_history_period.label = "周期"
emqx_license_http_api.resp_count.desc = "返回的数据行数。"
emqx_license_http_api.resp_count.label = "数量"
emqx_license_http_api.resp_data.desc = "高水位线记录数组，按时间从新到旧。"
emqx_license_http_api.resp_data.label = "数据"
emqx_license_http_api.resp_period.desc = "此响应使用的聚合周期（`daily` 或 `monthly`）。"
emqx_license_http_api.resp_period.label = "周期"
emqx_license_http_api.resp_row_hwm.desc = "该周期内观察到的会话峰值计数。"
emqx_license_http_api.resp_row_hwm.label = "高水位线"
emqx_license_http_api.resp_row_observed_at.desc = "观察到峰值的时间戳（RFC 3339）。"
emqx_license_http_api.resp_row_observed_at.label = "观察时间"
emqx_license_http_api.resp_row_period.desc = "日历周期标签，例如按日为 `2026-04-18`，按月为 `2026-04`。"
emqx_license_http_api.resp_row_period.label = "周期标签"
emqx_license_schema.connection_high_watermark_field.desc = "连接数超过该值时，系统会触发 License 连接配额使用告警"
emqx_license_schema.connection_high_watermark_field.label = "连接高水位线"
emqx_license_schema.connection_low_watermark_field.desc = "连接数低于此值是，系统会清除连接配额使用告警"
emqx_license_schema.connection_low_watermark_field.label = "连接低水位线"
emqx_license_schema.dynamic_max_connections.desc = "仅适用于 BC license 类型。此配置设置当前集群的 license 配额。\n此值不能超过 license key 中指定的连接限制。"
emqx_license_schema.dynamic_max_connections.label = "动态连接限制"
emqx_license_schema.high_watermark_timezone.desc = "用于确定会话高水位线历史的本地日界时区。\n使用 `system` 表示跟随节点主机本地时区，或提供显式偏移，如 `+02:00`。"
emqx_license_schema.high_watermark_timezone.label = "会话高水位线时区"
emqx_license_schema.key_field.desc = "该配置项用于设置 License 密钥，支持以下输入格式：\n\n- **直接密钥**：直接以字符串形式输入密钥内容；\n- **文件路径**：指定包含密钥的文件路径，路径需以 file:// 开头；\n- **\"default\"**：使用字符串值 default，应用默认的单节点社区 License；\n- **\"evaluation\"**：使用字符串值 evaluation，应用限制为 25 个连接的评估 License。\n\n注意：无效的 License 密钥或错误的文件路径可能会导致 EMQX 启动失败。\n如果使用文件路径，EMQX 将每隔 2 分钟尝试重新加载该文件中的 License 密钥。\n如果重新加载失败，EMQX 会记录一条错误级别日志，并继续使用之前成功加载的 License。"
emqx_license_schema.key_field.label = "License 密钥"
emqx_license_schema.license_root.desc = "用于配置 EMQX Enterprise 的 License。\n\nEMQX 默认提供一个单节点社区 License。\n该默认 License 不允许用于商业用途。\n\n您可以在此申请正式 License：https://www.emqx.com/apply-licenses/emqx?version=5。"
emqx_license_schema.license_root.label = "License"
emqx_limiter_schema.bytes_burst.desc = "可以突发发送的字节数，超出常规的 `bytes_rate`。\n\n例如：`100MB/60m`：每 60 分钟内，可以在短时间内发送最多 100MB 的数据。"
emqx_limiter_schema.bytes_burst.label = "数据发布突发量"
emqx_limiter_schema.bytes_rate.desc = "限制单个客户端每个节点可以向代理发送的字节数。\n\n一旦达到限制，EMQX 将丢弃 QoS 0 消息并拒绝 QoS 1 和 QoS 2 消息，\n返回“配额超出”错误代码 (0x97)。\n\n字节的单位可以是：B、KB、MB、GB。\n\n例如：\n\n- `500KB/s`：每秒钟只接收 500 千字节，剩余字节将被丢弃/拒绝。\n- `500MB/10s`：每 10 秒只接收 500 兆字节，剩余字节将被丢弃/拒绝。"
emqx_limiter_schema.bytes_rate.label = "数据发布速率"
emqx_limiter_schema.delivery_bytes_burst.desc = "每个节点在常规 `delivery_bytes_rate` 之上，允许突发发送的字节数。\n\n仅在使用内存会话时生效（即 `durable_sessions.enable = false`）。\n\n例如：`100MB/60m`：每 60 分钟一次，短时间内最多可发送 100 MB。"
emqx_limiter_schema.delivery_bytes_burst.label = "数据投递突发"
emqx_limiter_schema.delivery_bytes_rate.desc = "限制每个节点 Broker 向单个客户端发送的字节数。注意，这与 `bytes_rate` 的方向相反。\n\n仅在使用内存会话时生效（即 `durable_sessions.enable = false`）。\n\n达到限制后，EMQX 将丢弃 QoS 0 消息，并将 QoS 1 和 QoS 2 消息放入客户端内部队列，稍后重试。\n\n字节单位可以是：B、KB、MB、GB。\n\n例如：\n\n- `500KB/s`：每秒只接收 500 KB，其余字节将被丢弃/拒绝/入队。\n- `500MB/10s`：每 10 秒只接收 500 MB，其余字节将被丢弃/拒绝/入队。"
emqx_limiter_schema.delivery_bytes_rate.label = "数据投递速率"
emqx_limiter_schema.delivery_messages_burst.desc = "每个节点在常规 `delivery_messages_rate` 之上，允许突发发送的消息数。\n\n仅在使用内存会话时生效（即 `durable_sessions.enable = false`）。\n\n例如：`10000/60m`：每 60 分钟一次，短时间内最多可发送 10000 条消息。"
emqx_limiter_schema.delivery_messages_burst.label = "消息投递突发"
emqx_limiter_schema.delivery_messages_rate.desc = "限制每个节点 Broker 向单个客户端发送的消息数。注意，这与 `messages_rate` 的方向相反。\n\n仅在使用内存会话时生效（即 `durable_sessions.enable = false`）。\n\n达到限制后，EMQX 将丢弃 QoS 0 消息，并将 QoS 1 和 QoS 2 消息放入客户端内部队列，稍后重试。\n\n例如：\n\n- `500/s`：每秒只接收 500 条消息，其余消息将被丢弃/拒绝/入队。\n- `500/10s`：每 10 秒只接收 500 条消息，其余消息将被丢弃/拒绝/入队。"
emqx_limiter_schema.delivery_messages_rate.label = "消息投递速率"
emqx_limiter_schema.max_conn_burst.desc = "可以突发接受的连接数，超出常规速率，每个节点。\n\n例如：`10000/60m`：每 60 分钟内，可以在短时间内接受最多 10000 个连接。"
emqx_limiter_schema.max_conn_burst.label = "最大连接突发量"
emqx_limiter_schema.max_conn_rate.desc = "限制此监听器每个节点接受连接的速度。\n\n当达到限制后，EMQX 会在新连接被接受后立即关闭它们，从而有效清空等待被接受的连接队列。\n\n例如：\n\n- `1000/s`：每秒只接受 1000 个连接。\n- `1000/10s`：每 10 秒只接受 1000 个连接。"
emqx_limiter_schema.max_conn_rate.label = "最大连接速率"
emqx_limiter_schema.messages_burst.desc = "可以突发发送的消息数，超出常规的 `messages_rate`，每个节点。\n\n例如：`10000/60m`：每 60 分钟内，可以在短时间内发送最多 10000 条消息。"
emqx_limiter_schema.messages_burst.label = "消息发布突发量"
emqx_limiter_schema.messages_rate.desc = "限制单个客户端每个节点可以向代理发送的消息数量。\n\n一旦达到限制，EMQX 将丢弃 QoS 0 消息并拒绝 QoS 1 和 QoS 2 消息，\n返回“配额超出”错误代码 (0x97)。\n\n例如：\n\n- `500/s`：每秒只接收 500 条消息，剩余消息将被丢弃/拒绝。\n- `500/10s`：每 10 秒只接收 500 条消息，剩余消息将被丢弃/拒绝。"
emqx_limiter_schema.messages_rate.label = "消息发布速率"
emqx_limiter_schema.mqtt.desc = "MQTT 相关限流器。"
emqx_limiter_schema.subscribes_burst.desc = "限制单个客户端在每个节点上一次性向 broker 发送的订阅包数量。"
emqx_limiter_schema.subscribes_burst.label = "订阅突发"
emqx_limiter_schema.subscribes_rate.desc = "限制单个客户端在每个节点上向 broker 发送的订阅包速率。\n\n达到限制后，EMQX 将不处理该包，并回复带有 `SUBACK` 与 \"Quota Exceeded\" 错误码（0x97）的响应。"
emqx_limiter_schema.subscribes_rate.label = "订阅速率"
emqx_lwm2m_api.client_not_found.desc = "未找到客户端"
emqx_lwm2m_api.client_not_found.label = "未找到客户端"
