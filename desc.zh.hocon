emqx_metrics.actions_messages.desc = "规则引擎动作执行处理的消息数量。一次动作执行可能处理一批消息，因此该计数大于或等于动作执行次数。"
emqx_metrics.authentication_failure.desc = "客户端认证失败的次数"
emqx_metrics.authentication_success.desc = "客户端认证成功的次数"
emqx_metrics.authentication_success_anonymous.desc = "由于匿名导致的客户端认证成功次数"
emqx_metrics.authorization_allow.desc = "授权允许的次数"
emqx_metrics.authorization_cache_hit.desc = "授权缓存命中的次数"
emqx_metrics.authorization_cache_miss.desc = "授权缓存未命中的次数"
emqx_metrics.authorization_deny.desc = "授权拒绝的次数"
emqx_metrics.bytes_received.desc = "接收到的字节数"
emqx_metrics.bytes_sent.desc = "此连接发送的字节数"
emqx_metrics.client_auth_anonymous.desc = "以匿名方式登录的客户端数量"
emqx_metrics.client_authenticate.desc = "客户端认证的次数"
emqx_metrics.client_authorize.desc = "授权规则检查的次数"
emqx_metrics.client_connack.desc = "发送的 CONNACK 数据包数量"
emqx_metrics.client_connect.desc = "客户端连接的次数"
emqx_metrics.client_connected.desc = "成功连接的客户端数量"
emqx_metrics.client_disconnected.desc = "客户端断开连接的次数"
emqx_metrics.client_post_authn.desc = "`client.post_authn` 钩子的调用次数（在认证链成功后运行）"
emqx_metrics.client_subscribe.desc = "客户端订阅的次数"
emqx_metrics.client_unsubscribe.desc = "客户端取消订阅的次数"
emqx_metrics.delivery_dropped.desc = "发送时被丢弃的消息总数"
emqx_metrics.delivery_dropped_expired.desc = "由于消息过期而在发送时被丢弃的消息数量"
emqx_metrics.delivery_dropped_filter.desc = "发送时因订阅过滤器不匹配而丢弃的消息数"
emqx_metrics.delivery_dropped_no_local.desc = "由于 No Local 订阅选项而在发送时被丢弃的消息数量"
emqx_metrics.delivery_dropped_qos0_msg.desc = "由于 mqtt.mqueue_store_qos0=false 而在发送时被丢弃的 QoS 0 消息数量"
emqx_metrics.delivery_dropped_queue_full.desc = "由于消息队列已满而在发送时被丢弃的消息数量"
emqx_metrics.delivery_dropped_too_large.desc = "由于长度超过限制而在发送时被丢弃的消息数量"
emqx_metrics.messages_acked.desc = "接收到的 PUBACK 和 PUBREC 数据包数量"
emqx_metrics.messages_delayed.desc = "延迟发布的消息数量"
emqx_metrics.messages_delivered.desc = "转发到内部订阅过程的消息数量"
emqx_metrics.messages_dropped.desc = "在转发到订阅过程之前被丢弃的消息数量"
emqx_metrics.messages_dropped_await_pubrel_timeout.desc = "由于等待 PUBREL 超时而被丢弃的消息数量"
emqx_metrics.messages_dropped_no_subscribers.desc = "由于没有订阅者而被丢弃的消息数量"
