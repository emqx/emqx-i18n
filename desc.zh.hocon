emqx_bridge_alloydb_connector_schema.config_connector.label = "Google AlloyDB 连接器配置"
emqx_bridge_aws_timestream_action_schema.action_parameters.desc = "动作的参数集。"
emqx_bridge_aws_timestream_action_schema.action_parameters.label = "AWS Timestream 动作参数"
emqx_bridge_aws_timestream_action_schema.aws_timestream.desc = "将传入事件追加到 AWS Timestream 的动作。"
emqx_bridge_aws_timestream_action_schema.aws_timestream.label = "上传到 AWS Timestream 用于 InfluxDB"
emqx_bridge_aws_timestream_connector_schema.config_connector.desc = "连接到 AWS Timestream 用于 InfluxDB 的配置。"
emqx_bridge_aws_timestream_connector_schema.config_connector.label = "AWS Timestream 连接器配置"
emqx_bridge_azure_blob_storage_action_schema.aggreg_parameters.desc = "配置了聚合上传模式的动作参数集。"
emqx_bridge_azure_blob_storage_action_schema.aggreg_parameters.label = "Azure Blob Storage 聚合上传模式动作参数"
emqx_bridge_azure_blob_storage_action_schema.aggregated_blob_template.desc = "用于聚合上传的 Azure Blob Storage blob 名称模板。<br/>\n  模板可以包含以下变量的占位符：\n  <ul>\n  <li><code>${action}</code>: 动作名称（必需）。</li>\n  <li><code>${node}</code>: 执行上传的 EMQX 节点名称（必需）。</li>\n  <li><code>${datetime.{format}}</code>: 聚合开始的日期和时间，格式根据 <code>{format}</code> 字符串指定（必需）：\n      <ul>\n      <li><code>${datetime.rfc3339utc}</code>：RFC3339 格式的 UTC 日期和时间，</li>\n      <li><code>${datetime.rfc3339}</code>：RFC3339 格式的本地时区日期和时间，</li>\n      <li><code>${datetime.unix}</code>：Unix 时间戳，</li>\n      <li><code>${datetime.YYYY}</code>、<code>${datetime.MM}</code>、<code>${datetime.DD}</code>：零填充的年、月、日（UTC），</li>\n      <li><code>${datetime.hh}</code>、<code>${datetime.mm}</code>、<code>${datetime.ss}</code>：零填充的时、分、秒（UTC），</li>\n      <li><code>${datetime.DOY}</code>：零填充的一年中的第几天 001-366（UTC）。</li>\n      </ul>\n      每个日期/时间部分令牌可带显式时区前缀：<code>utc</code>（与无前缀相同）或 <code>local</code>（EMQX 节点系统时区）。示例：<code>${datetime.local.YYYY}</code>、<code>${datetime.utc.hh}</code>。不接受其他时区。\n      Hive 分区布局示例：<code>year=${datetime.YYYY}/month=${datetime.MM}/day=${datetime.DD}/hour=${datetime.hh}/${action}_${node}_N${sequence}.json</code>。\n  </li>\n  <li><code>${datetime_until.{format}}</code>：聚合结束的日期和时间，包含相同的格式选项。</li>\n  <li><code>${sequence}</code>：同一时间间隔内聚合上传的序列号（必需）。</li>\n  </ul>\n  所有其他占位符都被视为无效。注意，如果模板中缺少标记为必需的占位符，它们将作为路径后缀添加到 Azure Blob Storage blob 名称中。"
emqx_bridge_azure_blob_storage_action_schema.aggregated_blob_template.label = "Azure Blob Storage blob 名称模版"
emqx_bridge_azure_blob_storage_action_schema.aggregated_container_name.desc = "Azure Blob Storage 容器名称。不支持使用模版。"
emqx_bridge_azure_blob_storage_action_schema.aggregated_container_name.label = "Azure Blob Storage 容器名称"
emqx_bridge_azure_blob_storage_action_schema.aggregated_mode.desc = "启用基于时间的事件聚合，并将其作为单个对象上传到 Azure Blob Storage 服务。"
emqx_bridge_azure_blob_storage_action_schema.aggregated_mode.label = "Azure Blob Storage 聚合上传"
emqx_bridge_azure_blob_storage_action_schema.aggregation.desc = "控制聚合上传过程的参数集。"
emqx_bridge_azure_blob_storage_action_schema.aggregation.label = "Aggregation 参数"
emqx_bridge_azure_blob_storage_action_schema.aggregation_interval.desc = "在上传之前，将事件聚合为单个对象的时间长度。"
emqx_bridge_azure_blob_storage_action_schema.aggregation_interval.label = "时间间隔"
emqx_bridge_azure_blob_storage_action_schema.aggregation_max_records.desc = "每个聚合对象允许的记录（事件）数量。每次聚合上传包含的事件不会超过该数量，但可以少于该数量。<br/>\n  如果事件速率足够高，则在同一时间间隔内可能会有多个聚合上传。这些上传将具有不同但连续的序列号，它们将成为 Azure Blob Storage blob 名称的一部分。"
emqx_bridge_azure_blob_storage_action_schema.aggregation_max_records.label = "最大记录数"
emqx_bridge_azure_blob_storage_action_schema.azure_blob_storage.desc = "将传入事件上传到 Azure Blob Storage 服务的动作。"
emqx_bridge_azure_blob_storage_action_schema.azure_blob_storage.label = "上传到 Azure Blob Storage"
emqx_bridge_azure_blob_storage_action_schema.direct_blob_template.desc = "Azure Blob Storage blob 名称。"
emqx_bridge_azure_blob_storage_action_schema.direct_blob_template.label = "Blob 名称"
emqx_bridge_azure_blob_storage_action_schema.direct_container_template.desc = "Azure Blob Storage 容器名称。"
emqx_bridge_azure_blob_storage_action_schema.direct_container_template.label = "容器名称"
emqx_bridge_azure_blob_storage_action_schema.direct_content_template.desc = "要上传的 Azure Blob Storage blob 的内容。支持使用模板。"
emqx_bridge_azure_blob_storage_action_schema.direct_content_template.label = "Azure Blob Storage Blob 内容"
emqx_bridge_azure_blob_storage_action_schema.direct_mode.desc = "启用将事件作为单独对象上传到 Azure Blob Storage 服务。"
emqx_bridge_azure_blob_storage_action_schema.direct_mode.label = "Azure Blob Storage 直接上传"
emqx_bridge_azure_blob_storage_action_schema.direct_parameters.desc = "直接上传模式的动作参数集。动作支持 Azure Blob Storage 容器名称、blob 名称和 blob 内容的模板。"
emqx_bridge_azure_blob_storage_action_schema.direct_parameters.label = "Azure Blob Storage 直接上传模式动作参数"
emqx_bridge_azure_blob_storage_action_schema.parameters.desc = "一系列动作单数。"
emqx_bridge_azure_blob_storage_action_schema.parameters.label = "Azure Blob Storage 动作参数"
emqx_bridge_azure_blob_storage_connector_schema.account_key.desc = "Azure Blob Storage 服务的访问密钥。"
emqx_bridge_azure_blob_storage_connector_schema.account_key.label = "访问密钥"
emqx_bridge_azure_blob_storage_connector_schema.account_name.desc = "Azure Blob Storage 服务的账户名称。"
emqx_bridge_azure_blob_storage_connector_schema.account_name.label = "账户名称"
emqx_bridge_azure_blob_storage_connector_schema.config_connector.desc = "用来连接 Azure Blob Storage 服务的连接器配置。"
emqx_bridge_azure_blob_storage_connector_schema.config_connector.label = "Azure Blob Storage 连接器配置"
emqx_bridge_azure_event_grid_connector_schema.config_connector.desc = "连接到 Azure Event Grid 的连接器配置。"
emqx_bridge_azure_event_grid_connector_schema.config_connector.label = "Azure Event Grid 连接器配置"
emqx_bridge_azure_event_grid_hybrid_schema.action_config.desc = "将传入事件追加到 Azure Event Grid 的动作。"
emqx_bridge_azure_event_grid_hybrid_schema.action_config.label = "导入到 Azure Event Grid"
emqx_bridge_azure_event_grid_hybrid_schema.source_config.desc = "从 Azure Event Grid 接收传入事件的源。"
emqx_bridge_azure_event_grid_hybrid_schema.source_config.label = "从 Azure Event Grid 消费"
emqx_bridge_azure_event_hub.actions.desc = "一个动作的配置项"
emqx_bridge_azure_event_hub.actions.label = "动作配置"
emqx_bridge_azure_event_hub.allow_auto_topic_creation.desc = "设置为 true 以允许通过元数据获取请求自动创建主题。"
emqx_bridge_azure_event_hub.allow_auto_topic_creation.label = "允许自动创建主题"
emqx_bridge_azure_event_hub.auth_sasl_mechanism.desc = "SASL 认证机制"
emqx_bridge_azure_event_hub.auth_sasl_mechanism.label = "认证机制"
emqx_bridge_azure_event_hub.auth_sasl_password.desc = "用于连接 Azure Event Hubs 的连接字符串。应为命名空间共享访问策略的 \"连接字符串-主键\"。"
emqx_bridge_azure_event_hub.auth_sasl_password.label = "连接字符串"
emqx_bridge_azure_event_hub.auth_username_password.desc = "基于用户名/密码进行认证"
emqx_bridge_azure_event_hub.auth_username_password.label = "用户名/密码认证"
emqx_bridge_azure_event_hub.authentication.desc = "认证配置"
emqx_bridge_azure_event_hub.authentication.label = "认证"
emqx_bridge_azure_event_hub.bootstrap_hosts.desc = "逗号分隔的 Azure Event Hubs Kafka 命名空间主机名 <code>host[:port]</code> ，用于引导客户端。  默认端口号为 9093。"
emqx_bridge_azure_event_hub.bootstrap_hosts.label = "主机列表"
emqx_bridge_azure_event_hub.bridge_v2_type.desc = "动作的类型。"
emqx_bridge_azure_event_hub.bridge_v2_type.label = "动作类型"
emqx_bridge_azure_event_hub.buffer_memory_overload_protection.desc = "当缓冲模式设置为<code>memory</code>时适用。\n在内存压力较高时，EMQX 会丢弃旧的缓冲消息。\n高内存阈值由配置项 <code>sysmon.os.sysmem_high_watermark</code> 定义。\n注意：此设置仅在 Linux 上有效。"
emqx_bridge_azure_event_hub.buffer_memory_overload_protection.label = "内存过载保护"
emqx_bridge_azure_event_hub.buffer_mode.desc = "消息缓存模式。\n\n<code>memory</code>: 将所有消息缓存在内存中。如果 EMQX 节点重新启动，消息将丢失。\n<code>disk</code>: 将消息缓存在磁盘上，确保它们在 EMQX 节点重新启动时仍然存在。\n<code>hybrid</code>: 消息最初在内存中缓存。当它们达到一定限制时 (更多详细信息请参考 <code>segment_bytes</code> 配置)，它们会逐渐转移到磁盘上。与 <code>memory</code> 模式类似，如果 EMQX 节点重新启动，消息将丢失。"
emqx_bridge_azure_event_hub.buffer_mode.label = "缓存模式"
emqx_bridge_azure_event_hub.buffer_per_partition_limit.desc = "每个 Azure Event Hubs 分区允许缓冲的字节数。当超出此限制时，将丢弃较旧的消息以为新消息的缓冲腾出空间。"
emqx_bridge_azure_event_hub.buffer_per_partition_limit.label = "分区缓冲限制"
emqx_bridge_azure_event_hub.buffer_segment_bytes.desc = "适用于缓冲模式设置为<code>disk</code>或<code>hybrid</code>。\n此设置指定存储在磁盘上的每个缓冲文件的大小。"
emqx_bridge_azure_event_hub.buffer_segment_bytes.label = "分段文件字节数"
emqx_bridge_azure_event_hub.compression.desc = "压缩方法"
emqx_bridge_azure_event_hub.compression.label = "压缩"
emqx_bridge_azure_event_hub.config_enable.desc = "启用 (是) 或 停用 (否) 该动作。"
emqx_bridge_azure_event_hub.config_enable.label = "是否启用"
emqx_bridge_azure_event_hub.connect_timeout.desc = "TCP 连接建立的最大等待时间（包括如果已启用身份认证则包括身份认证时间）"
emqx_bridge_azure_event_hub.connect_timeout.label = "连接超时"
emqx_bridge_azure_event_hub.connector_type.desc = "连接器类型"
emqx_bridge_azure_event_hub.connector_type.label = "连接器类型"
emqx_bridge_azure_event_hub.desc_config.desc = "Azure Event Hubs 数据桥接配置项。"
emqx_bridge_azure_event_hub.desc_config.label = "Azure Event Hubs 数据桥接配置项"
emqx_bridge_azure_event_hub.desc_name.desc = "桥接名称，作为桥接的一个可读描述。"
emqx_bridge_azure_event_hub.desc_name.label = "桥接名称"
emqx_bridge_azure_event_hub.desc_type.desc = "动作的类型。"
emqx_bridge_azure_event_hub.desc_type.label = "动作类型"
emqx_bridge_azure_event_hub.kafka_header_value_encode_mode.desc = "Azure Event Hubs 头部值的编码模式。<br/>\n - None: 仅将二进制值添加到 Azure Event Hubs 头部;<br/>\n - JSON: 仅将 JSON 值添加到 Azure Event Hubs 头部，并在发送前将其编码为 JSON 字符串。"
emqx_bridge_azure_event_hub.kafka_header_value_encode_mode.label = "Azure Event Hubs 头部值编码模式"
emqx_bridge_azure_event_hub.kafka_headers.desc = "为Azure Event Hubs头部提供一个占位符。例如：<code>${pub_props}</code>。<br/>\n注意，占位符的值必须是一个对象：\n<code>{\"foo\": \"bar\"}</code>\n或者是一组键值对：\n<code>[{\"key\": \"foo\", \"value\": \"bar\"}]</code>"
emqx_bridge_azure_event_hub.kafka_headers.label = "Azure Event Hubs 头部"
emqx_bridge_azure_event_hub.kafka_message.desc = "呈现 Azure Event Hubs 消息的模版。"
emqx_bridge_azure_event_hub.kafka_message.label = "Azure Event Hubs 消息模版"
emqx_bridge_azure_event_hub.kafka_message_key.desc = "用于呈现 Azure Event Hubs 消息键的模版。如果模板呈现为空值（即在规则引擎上下文中没有此类数据字段），则使用 Azure Event Hubs 的 NULL（而不是空字符串）。"
emqx_bridge_azure_event_hub.kafka_message_key.label = "消息键"
emqx_bridge_azure_event_hub.kafka_message_timestamp.desc = "要使用哪个时间戳。时间戳需为毫秒精度的 Unix 时间戳，可以采用字符串格式，例如 <code>1661326462115</code> 或 <code>'1661326462115'</code>。 当未找到此模板的所需数据字段，或者找到的数据不是有效的整数时，将使用当前系统时间戳。"
emqx_bridge_azure_event_hub.kafka_message_timestamp.label = "消息时间戳"
emqx_bridge_azure_event_hub.kafka_message_value.desc = "用于呈现 Azure Event Hubs 消息值的模版。如果模板呈现为空值（即在规则引擎上下文中没有此类数据字段），则使用 Azure Event Hubs 的 NULL（而不是空字符串）。"
emqx_bridge_azure_event_hub.kafka_message_value.label = "消息值"
emqx_bridge_azure_event_hub.kafka_producer.desc = "Azure Event Hubs 生产者配置。"
emqx_bridge_azure_event_hub.kafka_producer.label = "Azure Event Hubs 生产者"
emqx_bridge_azure_event_hub.kafka_topic.desc = "Event Hubs 的名称。支持使用模版（例如：`t-${payload.t}`）。"
emqx_bridge_azure_event_hub.kafka_topic.label = "Event Hubs 名称"
emqx_bridge_azure_event_hub.max_batch_bytes.desc = "在 Azure Event Hubs 消息批次中收集的最大字节数。"
emqx_bridge_azure_event_hub.max_batch_bytes.label = "最大批次字节数"
emqx_bridge_azure_event_hub.max_inflight.desc = "Azure Event Hubs 生产者在接收到 Azure Event Hubs 的确认之前，每个分区允许发送的批次的最大数量。较高的值通常意味着更好的吞吐量。然而，当这个值大于1时，可能会有消息重新排序的风险。"
emqx_bridge_azure_event_hub.max_inflight.label = "飞行窗口"
emqx_bridge_azure_event_hub.max_linger_bytes.desc = "每个分区生产者在发送数据前，为了收集批量消息进行缓冲，最多可以等待的消息字节数。"
emqx_bridge_azure_event_hub.max_linger_bytes.label = "最大等待字节数"
emqx_bridge_azure_event_hub.max_linger_time.desc = "每个分区生产者为了收集批量消息进行缓冲的最长等待时间。\n默认值为 0，表示不等待。 对于非内存缓冲模式，建议配置至少 5ms 以减少 IOPS（每秒输入输出操作次数）。"
emqx_bridge_azure_event_hub.max_linger_time.label = "最大等待时间"
emqx_bridge_azure_event_hub.metadata_request_timeout.desc = "从 Azure Event Hubs 获取元数据时的最大等待时间。"
emqx_bridge_azure_event_hub.metadata_request_timeout.label = "元数据请求超时"
emqx_bridge_azure_event_hub.min_metadata_refresh_interval.desc = "客户端在刷新 Azure Event Hubs Kafka 代理和主题元数据之前必须等待的最小时间间隔。设置太小的值可能会给 Azure Event Hubs 增加额外的负载。"
emqx_bridge_azure_event_hub.min_metadata_refresh_interval.label = "元数据刷新的最小时间间隔"
emqx_bridge_azure_event_hub.mqtt_topic.desc = "将 MQTT 主题或主题过滤器作为数据源（动作输入）。如果使用规则动作作为数据源，则应将此配置保留为空，否则消息将在 Azure Event Hubs 中重复。"
emqx_bridge_azure_event_hub.mqtt_topic.label = "源 MQTT 主题"
emqx_bridge_azure_event_hub.partition_count_refresh_interval.desc = "Azure Event Hubs 生产者发现分区数量增加的时间间隔。\n在 Azure Event Hubs 中增加分区数量后，EMQX 将开始根据<code>partition_strategy</code>\n在分发消息时考虑新发现的分区。"
emqx_bridge_azure_event_hub.partition_count_refresh_interval.label = "分区数刷新间隔"
emqx_bridge_azure_event_hub.partition_strategy.desc = "分区策略是用来指导生产者如何将消息分配到Azure Event Hubs的各个分区。\n\n<code>random</code>: 为每条消息随机选择一个分区。\n<code>key_dispatch</code>: 根据 Azure Event Hubs 消息键的哈希值将消息分配到分区，确保拥有相同键的消息能够一致地被分配到特定分区。"
emqx_bridge_azure_event_hub.partition_strategy.label = "分区策略"
emqx_bridge_azure_event_hub.partitions_limit.desc = "限制为给定主题产生数据的分区数量。\n特殊值 all_partitions 用于利用主题的所有分区。\n设置的值大于分区总数时无效。"
emqx_bridge_azure_event_hub.partitions_limit.label = "最大分区数"
emqx_bridge_azure_event_hub.producer_buffer.desc = "配置生产者消息缓冲区。\n\n告诉 Azure Event Hubs 生产者，在 EMQX 需要发送的消息多于 Azure Event Hubs 能够处理的消息时，或者 Azure Event Hubs 宕机时，如何缓冲消息。"
emqx_bridge_azure_event_hub.producer_buffer.label = "消息缓冲区"
emqx_bridge_azure_event_hub.producer_health_check_topic.desc = "专用于更精确的连接器健康检查的主题名称。"
emqx_bridge_azure_event_hub.producer_health_check_topic.label = "连接器健康检查主题"
emqx_bridge_azure_event_hub.producer_kafka_ext_header_key.desc = "Azure Event Hubs 头部的键。支持格式为${var}的占位符。"
emqx_bridge_azure_event_hub.producer_kafka_ext_header_key.label = "额外的 Azure Event Hubs 头部键"
emqx_bridge_azure_event_hub.producer_kafka_ext_header_value.desc = "Azure Event Hubs 头部的值。支持格式为${var}的占位符。"
emqx_bridge_azure_event_hub.producer_kafka_ext_header_value.label = "额外的 Azure Event Hubs 头部值"
emqx_bridge_azure_event_hub.producer_kafka_ext_headers.desc = "请提供更多的 Azure Event Hubs 标头键值对<br/>这里的键值对将与<code>kafka_headers</code>字段的值合并，然后发送到 Azure Event Hubs。"
emqx_bridge_azure_event_hub.producer_kafka_ext_headers.label = "额外的 Azure Event Hubs 标头"
emqx_bridge_azure_event_hub.producer_kafka_opts.desc = "Azure Event Hubs 生产者配置"
emqx_bridge_azure_event_hub.producer_kafka_opts.label = "Azure Event Hubs 生产者"
emqx_bridge_azure_event_hub.producer_opts.desc = "本地的 MQTT 数据源和 Azure Event Hubs 的桥接配置。"
emqx_bridge_azure_event_hub.producer_opts.label = "MQTT 桥接至 Azure Event Hubs"
emqx_bridge_azure_event_hub.query_mode.desc = "查询模式。可选'sync/async'，默认为'async'。"
emqx_bridge_azure_event_hub.query_mode.label = "查询模式"
emqx_bridge_azure_event_hub.required_acks.desc = "Azure Event Hubs 分区领导者的确认标准。它确定了在向 EMQX Azure Event Hubs 生产者回送确认前，需要从追随者分区获得的确认等级。\n\n<code>all_isr</code>：要求所有同步副本进行确认。\n<code>leader_only</code>：仅要求分区领导者的确认。"
emqx_bridge_azure_event_hub.required_acks.label = "所需确认"
emqx_bridge_azure_event_hub.resource_opts.desc = "资源选项。"
emqx_bridge_azure_event_hub.resource_opts.label = "资源选项"
emqx_bridge_azure_event_hub.server_name_indication.desc = "TLS 握手的服务器名称指示（SNI）设置。<br/>\n- <code>auto</code>：客户端将使用<code>\"servicebus.windows.net\"</code>作为SNI。<br/>\n- <code>disable</code>：如果您希望阻止客户端发送SNI。<br/>\n- 其他字符串值将按原样发送。"
emqx_bridge_azure_event_hub.server_name_indication.label = "SNI"
emqx_bridge_azure_event_hub.socket_nodelay.desc = "当设置为'true'时，TCP 缓冲区将尽快发送。否则，操作系统内核可能会暂时缓冲小的TCP数据包（默认为40毫秒）。"
emqx_bridge_azure_event_hub.socket_nodelay.label = "无延迟"
emqx_bridge_azure_event_hub.socket_opts.desc = "额外的套接字选项。"
emqx_bridge_azure_event_hub.socket_opts.label = "套接字选项"
emqx_bridge_azure_event_hub.socket_receive_buffer.desc = "对套接字接收缓冲区进行微调。默认值已经优化以提高吞吐量。"
emqx_bridge_azure_event_hub.socket_receive_buffer.label = "套接字接收缓冲区大小"
emqx_bridge_azure_event_hub.socket_send_buffer.desc = "微调套接字发送缓冲区。默认值已调整为实现高吞吐量。"
emqx_bridge_azure_event_hub.socket_send_buffer.label = "Socket 发送缓冲区大小"
emqx_bridge_azure_event_hub.socket_tcp_keepalive.desc = "启用 Azure Event Hubs 桥接连接的 TCP keepalive 功能。\n该值由三个以逗号分隔的数字组成，格式为 'Idle,Interval,Probes'\n - Idle: 连接在服务器开始发送 keepalive 探测之前必须处于空闲状态的秒数（Linux 默认值为 7200 秒）。\n - Interval: TCP keepalive 探测之间的秒数（Linux 默认值为 75 秒）。\n - Probes: 在放弃并终止连接之前，从另一端未获得响应时要发送的 TCP keepalive 探测的最大数量（Linux 默认值为 9 次）。\n例如 \"240,30,5\" 表示：在连接空闲 240 秒后发送 TCP 保活探测，每隔 30 秒发送一次，直到收到响应，如果连续丢失 5 个响应，连接应该被关闭。\n默认值： 'none'"
emqx_bridge_azure_event_hub.socket_tcp_keepalive.label = "TCP keepalive 选项"
emqx_bridge_azure_event_hub.ssl_client_opts.desc = "用于 Azure Event Hubs 客户端的 TLS/SSL 选项。"
emqx_bridge_azure_event_hub.ssl_client_opts.label = "TLS/SSL 选项"
emqx_bridge_azure_event_hub.sync_query_timeout.desc = "此参数定义同步查询的超时限制。仅当桥接查询模式配置为 'sync' 时适用。"
emqx_bridge_azure_event_hub.sync_query_timeout.label = "同步查询超时"
