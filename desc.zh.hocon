emqx_mgmt_api_publish.bad_request_code.desc = "错误请求"
emqx_mgmt_api_publish.bad_request_code.label = "错误请求代码"
emqx_mgmt_api_publish.error_message.desc = "失败的详细原因。"
emqx_mgmt_api_publish.message_id.desc = "全局唯一的一个消息 ID，方便用于关联和追踪。"
emqx_mgmt_api_publish.message_properties.desc = "PUBLISH 消息里的 Property 字段。"
emqx_mgmt_api_publish.msg_content_type.desc = "消息内容类型必须是 UTF-8 编码的字符串。"
emqx_mgmt_api_publish.msg_correlation_data.desc = "关联数据的标识符，服务器必须将关联数据原封不动地发送给接收应用消息的所有的订阅者。"
emqx_mgmt_api_publish.msg_message_expiry_interval.desc = "消息过期间隔的标识符。如果消息过期间隔已过，而服务器未能开始向匹配的订阅者转发消息，则必须删除该订阅者的消息副本。"
emqx_mgmt_api_publish.msg_payload_format_indicator.desc = "Payload 格式，0 (0x00) 字节表示是未指定格式的数据，相当于没有发送 Payload 格式指示；1 (0x01) 字节表示 Payload 是 UTF-8 编码的字符数据，Payload 中的 UTF-8 数据必须是按照 Unicode 的规范和 RFC 3629 的标准要求进行编码的。"
emqx_mgmt_api_publish.msg_response_topic.desc = "响应主题的标识符。响应主题必须是 UTF-8 编码的，且不得包含通配符字符。"
emqx_mgmt_api_publish.msg_user_properties.desc = "指定 MQTT 消息的 User Property 键值对。注意，如果出现重复的键，只有最后一个会保留。"
emqx_mgmt_api_publish.payload.desc = "MQTT 消息体."
emqx_mgmt_api_publish.payload_encoding.desc = "MQTT 消息体的编码方式，可以是 <code>base64</code> 或 <code>plain</code>。当设置为 <code>base64</code> 时，消息在发布前会先被解码，可以用于发布二进制等数据。"
emqx_mgmt_api_publish.publish_api.desc = "发布单条信息。<br/>\n可能的 HTTP 状态码如下：<br/>\n200: 消息被成功发送到至少一个订阅。<br/>\n202: 没有匹配到任何订阅。<br/>\n400: 消息编码错误，如非法主题，或 QoS 超出范围等。<br/>\n503: 服务重启等过程中导致转发失败。"
emqx_mgmt_api_publish.publish_api.label = "发布单条信息"
emqx_mgmt_api_publish.publish_bulk_api.desc = "批量发布多条消息。<br/>\n可能的 HTTP 状态码如下：<br/>\n200: 所有的消息都被成功发送到至少一个订阅。<br/>\n202: 至少有一个消息没有匹配到任何订阅。<br/>\n400: 至少有一个消息编码错误，如非法主题，或 QoS 超出范围等。<br/>\n503: 至少有一个小因为服务重启的原因导致转发失败。<br/>\n\n请求的 Body 或者 Body 中包含的某个消息无法通过 API 规范的类型检查时，HTTP 响应的消息与发布单个消息的 API\n <code>/publish</code> 是一样的。\n如果所有的消息都是合法的，那么 HTTP 返回的内容是一个 JSON 数组，每个元素代表了该消息转发的状态。"
emqx_mgmt_api_publish.publish_bulk_api.label = "批量发布多条消息"
emqx_mgmt_api_publish.qos.desc = "QoS"
emqx_mgmt_api_publish.reason_code.desc = "MQTT 消息发布的错误码，这些错误码也是 MQTT 规范中 PUBACK 消息可能携带的错误码。<br/>\n当前支持如下错误码：<br/>\n\n16(0x10)：没能匹配到任何订阅；<br/>\n131(0x81)：消息转发时发生错误，例如 EMQX 服务重启；<br/>\n144(0x90)：主题名称非法；<br/>\n151(0x97)：受到了速率限制，或者消息尺寸过大。全局消息大小限制可以通过配置项 <code>mqtt.max_packet_size</code> 来进行修改。<br/>\n注意：消息尺寸的是通过主题和消息体的字节数进行估算的，具体发布时所占用的字节数可能会稍大于这个估算的值。"
emqx_mgmt_api_publish.retain.desc = "保留消息，布尔型字段，用于表示该消息是否是保留消息。"
emqx_mgmt_api_publish.topic_name.desc = "主题"
