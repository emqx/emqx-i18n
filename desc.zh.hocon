emqx_streams_schema.max_shard_message_bytes.desc = "消息流中分片的最大字节数。分片数量在持久存储设置中为所有消息流配置。注意，此限制不考虑复制因子。因此，消息流的总字节限制为 `n_shards * replication_factor * max_shard_message_bytes`。"
emqx_streams_schema.max_shard_message_bytes.label = "最大分片消息字节数"
emqx_streams_schema.max_shard_message_count.desc = "消息流中分片的最大消息数。分片数量在持久存储设置中为所有消息流配置。消息流的总计数限制为 `n_shards * max_shard_message_count`。"
emqx_streams_schema.max_shard_message_count.label = "最大分片消息数"
emqx_streams_schema.max_stream_count.desc = "可以创建的最大消息流数量。"
