emqx_bridge_redis_schema.redis_action.desc = "与 Redis 连接器交互的动作。"
emqx_bridge_redis_schema.redis_action.label = "Redis 动作"
emqx_bridge_redis_schema.redis_parameters.desc = "特定于某个 Redis 连接器类型的参数集，`redis_type`可以是`single`，`cluster`或`sentinel`之一。"
emqx_bridge_redis_schema.redis_parameters.label = "Redis 类型特定参数"
