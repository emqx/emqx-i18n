emqx_bridge_bigtable_action_schema.set_cell_family_name.label = "列族名称"
emqx_bridge_bigtable_action_schema.set_cell_timestamp_micros.desc = "包含变更时间戳（微秒）的键名。请确保在规则 SQL 中显式写出（例如：`SELECT x as key_name, ...`）。"
emqx_bridge_bigtable_action_schema.set_cell_timestamp_micros.label = "微秒时间戳"
emqx_bridge_bigtable_action_schema.set_cell_type.desc = "设置单元格变更。"
emqx_bridge_bigtable_action_schema.set_cell_type.label = "设置单元格"
emqx_bridge_bigtable_action_schema.set_cell_value.desc = "包含变更值的键名。请确保在规则 SQL 中显式写出（例如：`SELECT x as key_name, ...`）。"
emqx_bridge_bigtable_action_schema.set_cell_value.label = "值"
