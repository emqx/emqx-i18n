emqx_bridge_rocketmq.key.desc = "用于消息键的值。支持占位符，例如：`${payload.key}`。"
emqx_bridge_rocketmq.key.label = "键"
emqx_bridge_rocketmq.rocketmq_action.desc = "RocketMQ 动作的配置。"
emqx_bridge_rocketmq.rocketmq_action.label = "RocketMQ 动作配置"
emqx_bridge_rocketmq.strategy.desc = "生产者键派发策略。可能的值：`key_dispatch`、`roundrobin`。默认是 `roundrobin`。"
emqx_bridge_rocketmq.tag.desc = "用于消息标签的值。支持占位符，例如：`${payload.tag}`。"
emqx_bridge_rocketmq.tag.label = "标签"
emqx_bridge_rocketmq.template.desc = "模板, 默认为空，为空时将会将整个消息转发给 RocketMQ。 <br/>\n            模板可以是任意带有占位符的合法字符串, 例如:<br/>            ${id}, ${username}, ${clientid}, ${timestamp}<br/>\n            {\"id\" : ${id}, \"username\" : ${username}}"
emqx_bridge_rocketmq.template.label = "模板"
emqx_bridge_rocketmq_connector.access_key.desc = "RocketMQ 服务器的 `accessKey`。"
emqx_bridge_rocketmq_connector.access_key.label = "AccessKey"
emqx_bridge_rocketmq_connector.namespace.desc = "如果你正在使用阿里云的 RocketMQ 服务并且启用了命名空间，或者您在自己的 RocketMQ 服务器中配置了命名空间，则必须配置命名空间字段。对于阿里云中的 RocketMQ 服务，命名空间就是实例 ID。"
emqx_bridge_rocketmq_connector.namespace.label = "命名空间 / 实例 ID"
emqx_bridge_rocketmq_connector.refresh_interval.desc = "RocketMQ 主题路由更新间隔。"
emqx_bridge_rocketmq_connector.refresh_interval.label = "主题路由更新间隔"
emqx_bridge_rocketmq_connector.secret_key.desc = "RocketMQ 服务器的 `secretKey`。<br/>\n如需从文件加载密钥而不是内联写入，请使用 <code>file://&lt;path-to-file&gt;</code> 形式；文件内容（去除末尾空白）将作为密钥使用。集群模式下，该文件必须存在于所有 EMQX 节点。"
emqx_bridge_rocketmq_connector.secret_key.label = "SecretKey"
emqx_bridge_rocketmq_connector.security_token.desc = "RocketMQ 服务器安全 token"
emqx_bridge_rocketmq_connector.security_token.label = "安全 token"
emqx_bridge_rocketmq_connector.send_buffer.desc = "RocketMQ 驱动的套字节发送消息的缓冲区大小"
emqx_bridge_rocketmq_connector.send_buffer.label = "发送消息的缓冲区大小"
emqx_bridge_rocketmq_connector.servers.desc = "将要连接的 IPv4 或 IPv6 地址，或者主机名。<br/>\n主机名具有以下形式：`Host[:Port]`。<br/>\n如果未指定 `[:Port]`，则使用 RocketMQ 默认端口 9876。"
emqx_bridge_rocketmq_connector.servers.label = "服务器地址"
emqx_bridge_rocketmq_connector.sync_timeout.desc = "RocketMQ 驱动同步调用的超时时间。"
emqx_bridge_rocketmq_connector.sync_timeout.label = "同步调用超时时间"
emqx_bridge_rocketmq_connector.topic.desc = "RocketMQ 主题"
emqx_bridge_rocketmq_connector.topic.label = "RocketMQ 主题"
emqx_bridge_s3.config_connector.desc = "配置连接到兼容 S3 API 存储服务的连接器。"
emqx_bridge_s3.config_connector.label = "S3 连接器配置"
emqx_bridge_s3_upload.s3_aggregated_container.desc = "规定包含聚合事件的上传文件格式的设置。"
emqx_bridge_s3_upload.s3_aggregated_container.label = "聚合事件容器"
emqx_bridge_s3_upload.s3_aggregated_container_csv.desc = "记录（事件）将被聚合并上传为 CSV 文件。"
emqx_bridge_s3_upload.s3_aggregated_container_csv.label = "CSV 容器"
emqx_bridge_s3_upload.s3_aggregated_container_csv_column_order.desc = "在此指定的事件字段将首先作为列出现在生成的 CSV 文件中。<br/>\nCSV 文件将包含聚合事件的所有字段；然而，未在此设置中明确提到的列将按字典顺序跟在指定的列之后。"
emqx_bridge_s3_upload.s3_aggregated_container_csv_column_order.label = "CSV 列顺序"
emqx_bridge_s3_upload.s3_aggregated_upload_key.desc = "聚合上传的 S3 对象键模板。<br/>\n此模板可以包含以下变量的占位符：\n<ul>\n<li><code>${action}</code>: 动作名称（必需）。</li>\n<li><code>${node}</code>: 执行上传的 EMQX 节点名称（必需）。</li>\n<li><code>${datetime.{format}}</code>: 聚合开始的日期和时间，按 <code>{format}</code> 字符串格式化（必需）：\n    <ul>\n    <li><code>${datetime.rfc3339utc}</code>: RFC3339 格式的 UTC 日期和时间，</li>\n    <li><code>${datetime.rfc3339}</code>: RFC3339 格式的本地时区日期和时间，</li>\n    <li><code>${datetime.unix}</code>: Unix 时间戳，</li>\n    <li><code>${datetime.YYYY}</code>、<code>${datetime.MM}</code>、<code>${datetime.DD}</code>: 零填充的年、月、日（UTC），</li>\n    <li><code>${datetime.hh}</code>、<code>${datetime.mm}</code>、<code>${datetime.ss}</code>: 零填充的时、分、秒（UTC），</li>\n    <li><code>${datetime.DOY}</code>: 零填充的一年中的第几天 001-366（UTC）。</li>\n    </ul>\n    每个日期/时间部分令牌可带显式时区前缀：<code>utc</code>（与无前缀相同）或 <code>local</code>（EMQX 节点系统时区）。示例：<code>${datetime.local.YYYY}</code>、<code>${datetime.utc.hh}</code>。不接受其他时区。\n    Hive 分区布局示例：<code>year=${datetime.YYYY}/month=${datetime.MM}/day=${datetime.DD}/hour=${datetime.hh}/${action}_${node}_N${sequence}.json</code>。\n</li>\n<li><code>${datetime_until.{format}}</code>: 聚合结束的日期和时间，包含相同的格式选项。</li>\n<li><code>${sequence}</code>: 同一时间间隔内聚合上传的序列号（必需）。</li>\n</ul>\n所有其他占位符均被视为无效。注意，标记为必需的占位符如果在模板中缺失，将作为路径后缀添加到 S3 对象键中。"
emqx_bridge_s3_upload.s3_aggregated_upload_key.label = "S3 对象健模版"
emqx_bridge_s3_upload.s3_aggregated_upload_mode.desc = "启用基于时间的传入事件聚合，并将它们作为一个单独的对象上传到 S3 服务。"
emqx_bridge_s3_upload.s3_aggregated_upload_mode.label = "聚合 S3 上传"
emqx_bridge_s3_upload.s3_aggregated_upload_parameters.desc = "聚合上传操作的参数集。"
emqx_bridge_s3_upload.s3_aggregated_upload_parameters.label = "聚合 S3 上传操作参数"
emqx_bridge_s3_upload.s3_aggregation.desc = "管理聚合过程的参数集。"
emqx_bridge_s3_upload.s3_aggregation.label = "聚合参数"
emqx_bridge_s3_upload.s3_aggregation_interval.desc = "上传前，事件将在单个对象中聚合的时间长度。"
emqx_bridge_s3_upload.s3_aggregation_interval.label = "时间间隔"
emqx_bridge_s3_upload.s3_aggregation_max_records.desc = "每个聚合对象可以包含的最大记录（事件）数量。虽然每次上传不会超过这个限制，但可能包含较少的事件。如果事件发生率很高，在同一时间间隔内可能会有多次聚合上传，这些上传将具有不同但连续的序列号，这些序列号将成为 S3 对象键的一部分。"
emqx_bridge_s3_upload.s3_aggregation_max_records.label = "最大记录数"
emqx_bridge_s3_upload.s3_direct_upload_mode.desc = "启用将事件作为单独的对象上传到 S3 服务。"
emqx_bridge_s3_upload.s3_direct_upload_mode.label = "直接 S3 上传"
emqx_bridge_s3_upload.s3_direct_upload_parameters.desc = "上传操作的一组参数。操作支持在 S3 存储桶名称、对象键和对象内容中使用模板。"
emqx_bridge_s3_upload.s3_direct_upload_parameters.label = "直接 S3 上传操作参数"
emqx_bridge_s3_upload.s3_object_content.desc = "S3 对象的内容。支持模板。"
emqx_bridge_s3_upload.s3_object_content.label = "S3 对象内容"
emqx_bridge_s3_upload.s3_parameters.desc = "上传操作的一组参数。"
emqx_bridge_s3_upload.s3_parameters.label = "S3 上传参数"
emqx_bridge_s3_upload.s3_upload.desc = "将传入事件上传到 S3 API 兼容服务的操作。"
emqx_bridge_s3_upload.s3_upload.label = "上传到 S3"
emqx_bridge_s3tables_action_schema.action_parameters.desc = "动作的参数集。"
emqx_bridge_s3tables_action_schema.action_parameters.label = "S3Tables 动作参数"
emqx_bridge_s3tables_action_schema.aggregation.desc = "管理聚合过程的参数集。"
emqx_bridge_s3tables_action_schema.aggregation.label = "聚合参数"
emqx_bridge_s3tables_action_schema.aggregation_container.desc = "用于配置数据文件格式的选项。"
emqx_bridge_s3tables_action_schema.aggregation_container.label = "数据文件格式"
