emqx_mq_schema.gc_interval.label = "垃圾回收间隔"
emqx_mq_schema.is_lastvalue.desc = "指示消息队列是否具有最后值语义。最后值语义意味着消息覆盖同一主题中具有相同队列键的先前消息。"
emqx_mq_schema.is_lastvalue.label = "是否为最后值"
emqx_mq_schema.key_expression.desc = "用于确定最后值消息队列中消息键的表达式。"
emqx_mq_schema.key_expression.label = "键表达式"
emqx_mq_schema.local_max_inflight.desc = "从消息队列到 MQTT 客户端的最大飞行消息数。"
emqx_mq_schema.local_max_inflight.label = "本地最大飞行"
emqx_mq_schema.max_queue_count.desc = "可以创建的最大消息队列数。"
emqx_mq_schema.max_queue_count.label = "最大队列数"
emqx_mq_schema.max_shard_message_bytes.desc = "消息队列分片的最大字节数。分片数量在持久存储设置中为所有消息队列配置。请注意，此限制不考虑复制因子。因此，消息队列的总字节限制为 `n_shards * replication_factor * max_shard_message_bytes`。"
emqx_mq_schema.max_shard_message_bytes.label = "最大分片消息字节数"
emqx_mq_schema.max_shard_message_count.desc = "消息队列分片的最大消息数。分片数量在持久存储设置中为所有消息队列配置。消息队列的总计数限制为 `n_shards * max_shard_message_count`。"
emqx_mq_schema.max_shard_message_count.label = "最大分片消息数"
emqx_mq_schema.mq.desc = "消息队列的全局设置。"
emqx_mq_schema.mq.label = "消息队列设置"
emqx_mq_schema.mq_individual_limits.desc = "单个消息队列的字节大小和计数限制。"
emqx_mq_schema.mq_individual_limits.label = "消息队列限制"
emqx_mq_schema.name.desc = "消息队列的名称。"
emqx_mq_schema.name.label = "名称"
emqx_mq_schema.ping_interval.desc = "订阅者和消费者进程之间相互 ping 以确保连接的间隔时间。"
emqx_mq_schema.ping_interval.label = "ping 间隔"
emqx_mq_schema.redispatch_interval.desc = "消息被拒绝后重新分发的间隔时间。"
emqx_mq_schema.redispatch_interval.label = "重新分发间隔"
emqx_mq_schema.regular_queue_retention_period.desc = "常规消息队列中消息的最大保留期。单个消息队列可以设置更短的保留期。"
emqx_mq_schema.regular_queue_retention_period.label = "常规队列保留期"
emqx_mq_schema.stream_max_buffer_size.desc = "消息队列消费者缓冲的 DS 流中最大消息数。"
emqx_mq_schema.stream_max_buffer_size.label = "流最大缓冲区大小"
emqx_mq_schema.stream_max_unacked.desc = "当 DS 停止向消息队列消费者流发送消息时的阈值，因为其缓冲区已满。"
emqx_mq_schema.stream_max_unacked.label = "流最大未确认"
emqx_mq_schema.topic_filter.desc = "用于确定哪些消息进入消息队列的过滤器。"
emqx_mq_schema.topic_filter.label = "主题过滤器"
emqx_mqttsn_schema.mqttsn.desc = "MQTT-SN 网关配置。当前实现仅支持 v1.2 版本"
emqx_mqttsn_schema.mqttsn_broadcast.desc = "是否周期性广播 ADVERTISE 消息"
emqx_mqttsn_schema.mqttsn_enable_qos3.desc = "是否允许无连接的客户端发送 QoS 等于 -1 的消息。\n该功能主要用于支持轻量的 MQTT-SN 客户端实现，它不会向网关建立连接，注册主题，也不会发起订阅；它只使用 QoS 为 -1 来发布消息"
emqx_mqttsn_schema.mqttsn_gateway_id.desc = "MQTT-SN 网关 ID。\n当 <code>broadcast</code> 打开时，MQTT-SN 网关会使用该 ID 来广播 ADVERTISE 消息"
emqx_mqttsn_schema.mqttsn_predefined.desc = "预定义主题列表。\n预定义的主题列表，是一组 主题 ID 和 主题名称 的映射关系。使用预先定义的主题列表，可以减少 MQTT-SN 客户端和网关对于固定主题的注册请求"
emqx_mqttsn_schema.mqttsn_predefined_id.desc = "主题 ID。范围：1-65535"
emqx_mqttsn_schema.mqttsn_predefined_topic.desc = "主题名称。注：不支持通配符"
emqx_mqttsn_schema.mqttsn_subs_resume.desc = "在会话被重用后，网关是否主动向客户端注册对已订阅主题名称"
emqx_mt_api.bulk_config_bad_request.desc = "无效的配置"
emqx_mt_api.bulk_config_bad_request.label = "无效的配置"
emqx_mt_api.bulk_delete_ns.desc = "批量删除命名空间"
emqx_mt_api.bulk_delete_ns.label = "批量删除命名空间"
emqx_mt_api.bulk_export_ns_configs.desc = "导出一个或多个命名空间配置。"
emqx_mt_api.bulk_export_ns_configs.label = "批量导出命名空间配置"
emqx_mt_api.bulk_import_configs.desc = "批量更新或插入命名空间的配置。"
emqx_mt_api.bulk_import_configs.label = "批量导入命名空间配置"
emqx_mt_api.bulk_import_ns_configs.desc = "导入一个或多个命名空间配置。"
emqx_mt_api.bulk_import_ns_configs.label = "批量导入命名空间配置"
emqx_mt_api.client_count.desc = "统计命名空间中的所有客户端数量。"
emqx_mt_api.client_count.label = "客户端数量统计"
emqx_mt_api.client_count_desc.desc = "客户端数量"
emqx_mt_api.client_count_desc.label = "客户端数量"
emqx_mt_api.client_list.desc = "列出命名空间中的所有客户端。\n当存在更多页面时，响应将携带\n`Link: <?last_clientid=...&limit=...>; rel=\"next\"` 头（RFC 8288），\n其 URI 引用将相对于请求 URL 解析。\n若无该头，表示当前页面为最后一页。"
emqx_mt_api.client_list.label = "客户端列表"
emqx_mt_api.clients_being_kicked.desc = "来自此命名空间的客户端仍在被踢出。"
emqx_mt_api.clients_being_kicked.label = "正在踢出的客户端"
emqx_mt_api.create_managed_ns.desc = "创建托管命名空间。不可使用的保留名称：`global`、`undefined`、`null`、`none`。"
emqx_mt_api.create_managed_ns.label = "创建命名空间"
emqx_mt_api.cursor_conflict.desc = "请求同时携带了包含式（`first_*`）与排他式（`last_*`）键集游标。它们互斥；最多使用一个。"
emqx_mt_api.cursor_conflict.label = "游标参数冲突"
emqx_mt_api.delete_ns.desc = "删除命名空间。这将导致该命名空间下的所有客户端被异步踢出。"
emqx_mt_api.delete_ns.label = "删除命名空间"
emqx_mt_api.example_list.desc = "列表响应示例。"
emqx_mt_api.example_list.label = "列表示例"
emqx_mt_api.first_clientid_in_query.desc = "包含式键集游标：返回字典序大于或等于该值的客户端 ID。适用于精确匹配查询（如 `first_clientid=foo&limit=1`）。与 `last_clientid` 互斥。"
emqx_mt_api.first_clientid_in_query.label = "首个客户端 ID"
emqx_mt_api.first_ns_in_query.desc = "包含式键集游标：返回字典序大于或等于该值的命名空间。适用于精确匹配查询（如 `first_ns=foo&limit=1`）。与 `last_ns` 互斥。"
emqx_mt_api.first_ns_in_query.label = "首个命名空间"
emqx_mt_api.get_managed_ns_config.desc = "获取显式创建的命名空间配置"
emqx_mt_api.get_managed_ns_config.label = "获取命名空间配置"
emqx_mt_api.invalid_configuration.desc = "无效的配置。"
emqx_mt_api.invalid_configuration.label = "无效的配置"
emqx_mt_api.invalid_configurations.desc = "无效的配置。"
emqx_mt_api.invalid_configurations.label = "无效的配置"
emqx_mt_api.kick_all_clients.desc = "踢出命名空间中的所有客户端（异步）"
emqx_mt_api.kick_all_clients.label = "踢出命名空间中的所有客户端（异步）"
emqx_mt_api.kick_process_started.desc = "踢出进程已启动。"
emqx_mt_api.kick_process_started.label = "踢出进程已启动"
emqx_mt_api.kick_process_underway.desc = "踢出进程已在进行中。"
emqx_mt_api.kick_process_underway.label = "踢出进程进行中"
emqx_mt_api.last_client_in_query.desc = "上一页的最后一个客户端。\n对于第一页，请使用空字符串。"
emqx_mt_api.last_client_in_query.label = "最后一个客户端 ID"
emqx_mt_api.last_clientid_in_query.desc = "排他式键集游标：返回字典序大于该值的客户端 ID。第一页请省略或使用空字符串。与 `first_clientid` 互斥。"
emqx_mt_api.last_clientid_in_query.label = "最后一个客户端 ID"
emqx_mt_api.last_ns_in_query.desc = "排他式键集游标：返回字典序大于该值的命名空间。第一页请省略或使用空字符串。与 `first_ns` 互斥。"
emqx_mt_api.last_ns_in_query.label = "最后一个命名空间"
emqx_mt_api.limit_in_query.desc = "要返回的项目数量。"
emqx_mt_api.limit_in_query.label = "返回限制"
emqx_mt_api.managed_ns_list.desc = "列出所有托管命名空间。\n命名空间按字典序排序，因此该 API 可用于基于前缀的模糊搜索。\n当存在更多页面时，响应将携带\n`Link: <?last_ns=...&limit=...>; rel=\"next\"` 头（RFC 8288），\n其 URI 引用将相对于请求 URL 解析。\n若无该头，表示当前页面为最后一页。"
emqx_mt_api.managed_ns_list.label = "列出命名空间"
emqx_mt_api.managed_ns_list_details.desc = "列出所有托管命名空间及其详细信息，包括命名空间配置（会话与限流）。\n命名空间按字典序排序，因此该 API 可用于基于前缀的模糊搜索。\n当存在更多页面时，响应将携带\n`Link: <?last_ns=...&limit=...>; rel=\"next\"` 头（RFC 8288），\n其 URI 引用将相对于请求 URL 解析。\n若无该头，表示当前页面为最后一页。"
emqx_mt_api.managed_ns_list_details.label = "列出托管命名空间及其详细信息"
emqx_mt_api.max_configurations_reached.desc = "已达到最大配置数量。"
emqx_mt_api.max_configurations_reached.label = "已达到最大配置数量"
emqx_mt_api.metrics.desc = "获取命名空间指标。"
emqx_mt_api.metrics.label = "指标"
emqx_mt_api.namespace_not_found.desc = "未找到命名空间。"
emqx_mt_api.namespace_not_found.label = "未找到命名空间"
emqx_mt_api.ns_list.desc = "列出所有命名空间。\n命名空间按字典序排序，因此该 API 可用于基于前缀的模糊搜索。\n当存在更多页面时，响应将携带\n`Link: <?last_ns=...&limit=...>; rel=\"next\"` 头（RFC 8288），\n其 URI 引用将相对于请求 URL 解析。\n若无该头，表示当前页面为最后一页。"
emqx_mt_api.ns_list.label = "列出命名空间"
emqx_mt_api.ns_list_details.desc = "列出所有命名空间及其详细信息。\n命名空间按字典序排序，因此该 API 可用于基于前缀的模糊搜索。\n当存在更多页面时，响应将携带\n`Link: <?last_ns=...&limit=...>; rel=\"next\"` 头（RFC 8288），\n其 URI 引用将相对于请求 URL 解析。\n若无该头，表示当前页面为最后一页。"
emqx_mt_api.ns_list_details.label = "列出命名空间及其详细信息"
emqx_mt_api.param_path_ns.desc = "路径参数中的命名空间。不可使用的保留名称：`global`、`undefined`、`null`、`none`。"
emqx_mt_api.param_path_ns.label = "命名空间"
emqx_mt_api.side_effects_failed.desc = "一些副作用未能执行。"
emqx_mt_api.side_effects_failed.label = "副作用执行失败"
emqx_mt_api.update_managed_ns_config.desc = "更新命名空间配置"
emqx_mt_api.update_managed_ns_config.label = "更新命名空间配置"
emqx_mt_schema.allow_only_managed_namespaces.desc = "如果启用该选项，来自自动创建的命名空间的客户端将被拒绝连接。\n无法解析命名空间的客户端也将被拒绝连接。"
emqx_mt_schema.allow_only_managed_namespaces.label = "仅允许显式创建的命名空间"
emqx_mt_schema.config.desc = "多租户（Multi-Tenancy）配置。"
emqx_mt_schema.config.label = "多租户"
emqx_mt_schema.default_max_sessions.desc = "每个命名空间默认允许的最大活动会话数。\n如果达到上限，新客户端的访问将被拒绝。\n在线修改配置不会影响正在运行的会话。"
emqx_mt_schema.default_max_sessions.label = "默认最大会话数"
emqx_mt_schema.post_auth_tns_expression.desc = "认证链完成后评估的表达式，其渲染结果将写回 `client_attrs.tns`，这是多租户配额与路由决策使用的租户命名空间键。\n留空则禁用（默认）。为空时，多租户仅从 `mqtt.client_attrs_init` 解析 `tns`（在认证前评估）。\n配置后，表达式可引用 `mqtt.client_attrs_init` 可用的任意绑定（如 <code>username</code>、<code>clientid</code>、<code>cert_common_name</code>），以及 <code>client_attrs.*</code>（合并了认证前与认证响应属性）。例如：<code>client_attrs.tag</code> 使多租户应用将认证服务器提供的 <code>tag</code> 属性作为租户命名空间。带回退的示例：\n<code>coalesce(client_attrs.tag, username)</code>。\n如果表达式渲染为空字符串，将保留已有的 <code>tns</code> 值（若有）。如果表达式出错，会记录警告日志，并将客户端视为没有 <code>tns</code>。\n不可用作命名空间的保留名称：<code>global</code>、<code>undefined</code>、<code>null</code>、<code>none</code>；解析为其中之一的客户端将被拒绝。"
emqx_mt_schema.post_auth_tns_expression.label = "认证后 tns 表达式"
emqx_mysql.server.desc = "用于连接的 IPv4 或 IPv6 地址或主机名。<br/>\n主机条目的格式如下：主机[:端口]。<br/>\n如果未指定[:端口]，将使用 MySQL 的默认端口3306。"
emqx_mysql.server.label = "服务器主机"
emqx_nats_schema.authn_jwt.desc = "通过 NATS 风格的 JWT 凭据对客户端进行认证。可选。该模式与 NATS Server 账号 JWT 工作流兼容，可与 token 和 nkey 认证一起使用。"
emqx_nats_schema.authn_nkeys.desc = "通过允许的 NKEY 公钥进行认证（以 “U...” 开头的 NATS nkey）。可选。配置后，仅允许具有匹配 NKEY 的客户端连接，并通过签名挑战/响应完成认证（建议使用 nkeys 工具生成密钥）。可与 authn_token 一起使用；若两者都未设置，则默认使用用户名/密码认证。\n可配置多个 NKEY，每行一个公钥。"
emqx_nats_schema.authn_token.desc = "认证 Token。可选。可以同时配置 Token 认证和用户名/密码认证。"
emqx_nats_schema.default_heartbeat_interval.desc = "服务器到客户端 PING 消息的默认心跳间隔。默认：30。"
emqx_nats_schema.heartbeat_wait_timeout.desc = "心跳超时阈值。如果在此期间未收到心跳响应，服务器将标记客户端为离线。默认：5s。"
emqx_nats_schema.internal_authn.desc = "NATS 客户端的内部认证方法。方法按数组顺序评估，并在首次成功匹配时停止。"
emqx_nats_schema.internal_authn_jwt.desc = "NATS JWT 认证方法。"
emqx_nats_schema.internal_authn_nkey.desc = "NKEY 挑战/响应认证方法。"
emqx_nats_schema.internal_authn_token.desc = "基于 Token 的认证方法。"
emqx_nats_schema.jwt.desc = "与账号公钥关联的账号 JWT 内容。"
emqx_nats_schema.jwt_resolver.desc = "用于获取客户端认证所需账号 JWT 的解析器设置。"
emqx_nats_schema.jwt_resolver_memory.desc = "内存中的 JWT 解析器设置。"
emqx_nats_schema.jwt_resolver_preload_entry.desc = "一个预加载的账号 JWT 条目。"
emqx_nats_schema.max_payload_size.desc = "每个 NATS PUB/HPUB 消息允许的最大 Payload 字节数。"
emqx_nats_schema.nats.desc = "NATS 网关为 EMQX 提供了接受 NATS 客户端连接的能力。"
emqx_nats_schema.protocol.desc = "NATS 服务器协议的一组设置。"
emqx_nats_schema.pubkey.desc = "在解析器预加载中作为查找键的账号公钥。"
emqx_nats_schema.resolver.desc = "账号 JWT 解析器配置。目前仅支持 `memory`。"
emqx_nats_schema.resolver_preload.desc = "内存解析器的预加载账号 JWT 条目。"
emqx_nats_schema.server_id.desc = "服务器 ID。"
emqx_nats_schema.server_name.desc = "服务器名称。"
emqx_nats_schema.tcp_ws_listeners.desc = "网关的 Websocket 监听器采用与 MQTT Websocket 监听器相同的结构。"
emqx_nats_schema.trusted_operators.desc = "受信任的 operator 公钥列表。解析器仅接受可由这些 operator 验证的账号 JWT。"
emqx_nats_schema.type.desc = "解析器类型。仅支持 `memory`。"
emqx_nats_schema.verify_exp.desc = "是否验证 JWT `exp`（过期）声明。"
emqx_nats_schema.verify_nbf.desc = "是否验证 JWT `nbf`（生效前）声明。"
emqx_nats_schema.websocket.desc = "Websocket 选项。"
emqx_nats_schema.ws_listener.desc = "Websocket 监听器。"
emqx_nats_schema.wss_listener.desc = "Websocket over TLS 监听器。"
emqx_node_rebalance_api.abs_conn_threshold.desc = "当前节点上的连接数与迁入节点上的平均连接数的最大期望差值，低于此比例是重平衡过程的目的。"
emqx_node_rebalance_api.abs_conn_threshold.label = "连接数差值"
emqx_node_rebalance_api.abs_sess_threshold.desc = "当前节点上的会话数与迁入节点上的平均会话数之间的最大期望差值，低于此比例是节点疏散过程的目的。"
emqx_node_rebalance_api.abs_sess_threshold.label = "会话数差值"
emqx_node_rebalance_api.bad_request.desc = "错误的请求"
emqx_node_rebalance_api.bad_request.label = "错误的请求"
emqx_node_rebalance_api.cluster_purge_start.desc = "开始清除进程"
emqx_node_rebalance_api.cluster_purge_start.label = "开始清除"
emqx_node_rebalance_api.cluster_purge_stop.desc = "停止清除进程"
emqx_node_rebalance_api.cluster_purge_stop.label = "停止清除"
emqx_node_rebalance_api.conn_evict_rate.desc = "每秒迁出连接数"
emqx_node_rebalance_api.conn_evict_rate.label = "迁出速率"
emqx_node_rebalance_api.conn_evict_rpc_timeout.desc = "重平衡期间连接驱逐的 RPC 超时。"
emqx_node_rebalance_api.conn_evict_rpc_timeout.label = "连接驱逐 RPC 超时"
emqx_node_rebalance_api.coordinator_status_donor_conn_avg.desc = "每个迁出节点的平均连接数"
emqx_node_rebalance_api.coordinator_status_donor_conn_avg.label = "迁出节点连接平均值"
emqx_node_rebalance_api.coordinator_status_donor_sess_avg.desc = "每个迁出节点的平均会话数"
emqx_node_rebalance_api.coordinator_status_donor_sess_avg.label = "迁出节点会话平均数"
