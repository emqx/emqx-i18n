emqx_gcp_device_api.gcp_devices_post.desc = "从 GCP IoT Core 导入认证和配置数据"
emqx_gcp_device_api.gcp_devices_post.label = "导入 GCP 设备"
emqx_gcp_device_api.imported_counter.desc = "成功导入的 GCP 设备数量"
emqx_gcp_device_api.imported_counter_errors.desc = "因错误未被导入的 GCP 设备数量"
emqx_gcp_device_api.key.desc = "公钥"
