emqx_retainer_schema.allow_never_expire.desc = "如果为 true，设置为永不过期的保留消息（即 `Message-Expiry-Interval = 0`）将不会受到过期时间覆盖的影响。此配置仅在 `msg_expiry_interval_override` 设置时生效。"
emqx_retainer_schema.backend.desc = "保留消息的存储后端"
emqx_retainer_schema.backends.desc = "用于存储保留消息的外部后端。"
emqx_retainer_schema.batch_deliver_limiter.desc = "（已弃用）保留消息投递的限流器名称。\n限流器可以用来防止短时间内向客户端发送太多的消息，从而避免过多的消息导致客户端队列堵塞甚至崩溃。\n这个名称需要是指向 `limiter.batch` 下的一个真实存在的限流器。\n如果这个字段为空，则不使用限流器。"
emqx_retainer_schema.batch_deliver_number.desc = "批量派发时每批的数量。0 代表一次性全部派发"
emqx_retainer_schema.batch_read_number.desc = "从存储读取消息时的批量大小。设置为 0 与设置为 1000 的效果相同。"
emqx_retainer_schema.delivery_rate.desc = "发送保留消息的最大速率"
emqx_retainer_schema.enable.desc = "是否开启消息保留功能"
emqx_retainer_schema.flow_control.desc = "流控设置"
emqx_retainer_schema.index_specs.desc = "保留索引规范：正序整数数组列表。\n每个数组指定一个索引。索引规范中的数字是主题中的基于 1 的单词位置。指定位置的单词将用于索引。<br/>\n例如，拥有 <code>[2, 4]</code> 索引可以优化 <code>+/X/+/Y/...</code> 主题通配符订阅。"
emqx_retainer_schema.max_payload_size.desc = "允许存储的保留消息的最大大小。EMQX 将拒绝存储超过此大小的保留消息，并输出包含关键字 'retain_failed_for_payload_size_exceeded_limit' 的错误日志。\n\n0 表示保留消息大小不受限制。"
emqx_retainer_schema.max_publish_rate.desc = "发布保留消息的最大速率。超过该限制发布的消息会被传递，但不会作为保留消息存储。"
emqx_retainer_schema.max_retained_messages.desc = "消息保留的数量上限。0 表示无限"
emqx_retainer_schema.mnesia_config.desc = "存储保留消息的内部数据库配置。"
emqx_retainer_schema.mnesia_config_storage_type.desc = "选择消息是存放在磁盘还是内存中"
emqx_retainer_schema.mnesia_config_type.desc = "后端类型"
emqx_retainer_schema.mnesia_enable.desc = "启用内置的 Mnesia 后端。"
emqx_retainer_schema.msg_clear_interval.desc = "消息清理间隔。0 代表不进行清理"
emqx_retainer_schema.msg_clear_limit.desc = "每次在 `msg_clear_interval` 期间清除的过期消息数量上限。设置合理的限制可以防止清理过程运行时间过长并消耗过多资源。"
emqx_retainer_schema.msg_expiry_interval.desc = "消息保留时间。0 代表永久保留"
emqx_retainer_schema.msg_expiry_interval_override.desc = "如果设置了此值，它将优先于任何在保留的 MQTT 消息中指定的 `Message-Expiry-Interval` 属性，从而允许消息在必要时更早过期。此覆盖设置仅适用于垃圾回收过程：它不会影响正在写入的消息的过期时间，也不会影响在迭代过程中已经写入的消息的过期时间。因此，当覆盖时，可能会被垃圾回收的消息在订阅保留主题时仍然可见。"
emqx_retainer_schema.retainer.desc = "与处理 `PUBLISH` 包相关的配置，其中 `retain` 标志设置为 1。"
emqx_retainer_schema.stop_publish_clear_msg.desc = "当 PUBLISH 消息的保留标志被设置且有效载荷为空时，是否继续发布消息。\n参见：\nhttp://docs.oasis-open.org/mqtt/mqtt/v3.1.1/os/mqtt-v3.1.1-os.html#_Toc398718038"
