emqx_authn_cinfo_schema.check.desc = "对客户端信息进行的检查。\n它定义了一个匹配条件，并在条件为 `true` 时返回结果。\n如果所有检查都被跳过，则返回默认结果 `ignore`。"
emqx_authn_cinfo_schema.check.label = "客户端信息检查"
emqx_authn_cinfo_schema.checks.desc = "对客户端信息执行的一组检查。\n如果所有检查都被跳过，则返回默认结果 `ignore`。\n`ignore` 结果表示将认证流程交由链中的下一个认证器处理。"
emqx_authn_cinfo_schema.checks.label = "客户端信息检查列表"
emqx_authn_cinfo_schema.cinfo.desc = "基于客户端信息（如用户名、客户端ID、\n客户端属性以及从 TLS 证书提取的数据）进行客户端认证。"
emqx_authn_cinfo_schema.cinfo.label = "客户端信息认证"
emqx_authn_cinfo_schema.is_match.desc = "一个 Variform 表达式或表达式数组，用于评估一组从客户端信息派生的预绑定变量。\n支持的变量：\n- `username`: 客户端的用户名。\n- `password`：客户端的密码。\n- `clientid`: 客户端的 ID。\n- `client_attrs.*`: 客户端的属性。\n- `peerhost`: 客户端的 IP 地址。\n- `cert_subject`: TLS 证书的主题。\n- `cert_common_name`: TLS 证书通用名称。\n- `zone`：客户端连接所使用监听器所属的配置区域。\n\n如果所有表达式的结果都是字符串值 `'true'`，则从此认证器返回对应的 `result`。\n如果任一表达式的结果不是 `'true'`，则跳过当前检查。\n例如：若希望确保客户端 ID 与其 TLS 证书的通用名称始终一致，可使用表达式 `str_eq(clientid, cert_common_name)`。"
emqx_authn_cinfo_schema.is_match.label = "匹配条件"
emqx_authn_cinfo_schema.result.desc = "当匹配条件为 `true` 时返回的结果。\n支持的结果：\n- `ignore`: 将身份验证交由链中的下一个认证器处理。\n- `allow`: 允许客户端连接。\n- `deny`: 拒绝客户端连接。"
emqx_authn_cinfo_schema.result.label = "结果"
emqx_authn_http_schema.body.desc = "HTTP 请求体。"
emqx_authn_http_schema.body.label = "请求体"
emqx_authn_http_schema.get.desc = "使用 HTTP Server 作为认证服务的认证器的配置项 (使用 GET 请求)。"
emqx_authn_http_schema.headers.desc = "HTTP Headers 列表"
emqx_authn_http_schema.headers.label = "请求头"
emqx_authn_http_schema.headers_no_content_type.desc = "HTTP Headers 列表 (无 <code>content-type</code>) 。"
emqx_authn_http_schema.headers_no_content_type.label = "请求头(无 content-type)"
emqx_authn_http_schema.method.desc = "HTTP 请求方法。"
emqx_authn_http_schema.method.label = "请求方法"
emqx_authn_http_schema.post.desc = "使用 HTTP Server 作为认证服务的认证器的配置项 (使用 POST 请求)。"
emqx_authn_http_schema.request_timeout.desc = "HTTP 请求超时时长。"
emqx_authn_http_schema.request_timeout.label = "请求超时"
emqx_authn_http_schema.url.desc = "认证 HTTP 服务器地址。"
emqx_authn_http_schema.url.label = "URL"
emqx_authn_jwt_schema.acl_claim_name.desc = "用于获取 ACL 规则的 JWT 声明名称。"
emqx_authn_jwt_schema.acl_claim_name.label = "ACL 声明名称"
emqx_authn_jwt_schema.algorithm.desc = "JWT 签名算法，支持 HMAC (配置为 <code>hmac-based</code>）和 RSA、ECDSA (配置为 <code>public-key</code>)。"
emqx_authn_jwt_schema.algorithm.label = "JWT 签名算法"
emqx_authn_jwt_schema.cacertfile.desc = "包含 PEM 编码的 CA 证书的文件的路径。"
emqx_authn_jwt_schema.cacertfile.label = "CA 证书文件"
emqx_authn_jwt_schema.certfile.desc = "包含用户证书的文件的路径。"
emqx_authn_jwt_schema.certfile.label = "证书文件"
emqx_authn_jwt_schema.disconnect_after_expire.desc = "在 token 过期后断开客户端连接。"
emqx_authn_jwt_schema.disconnect_after_expire.label = "过期后断开链接"
emqx_authn_jwt_schema.enable.desc = "启用/禁用 SSL。"
emqx_authn_jwt_schema.enable.label = "启用/禁用 SSL"
emqx_authn_jwt_schema.endpoint.desc = "JWKS 端点， 它是一个以 JWKS 格式返回服务端的公钥集的只读端点。"
emqx_authn_jwt_schema.endpoint.label = "JWKS 端点"
emqx_authn_jwt_schema.from.desc = "指定客户端连接请求中 JWT 的位置。"
emqx_authn_jwt_schema.from.label = "JWT 的位置"
emqx_authn_jwt_schema.jwks_headers.desc = "JWKS 请求中需要发送的 HTTP 请求头列表。"
emqx_authn_jwt_schema.jwks_headers.label = "HTTP 请求头"
emqx_authn_jwt_schema.jwt_hmac.desc = "用于认证的 JWT 使用 HMAC 算法签发时的配置。"
emqx_authn_jwt_schema.jwt_jwks.desc = "用于认证的 JWTs 需要从 JWKS 端点获取时的配置。"
emqx_authn_jwt_schema.jwt_public_key.desc = "用于认证的 JWT 使用 RSA 或 ECDSA 算法签发时的配置。"
emqx_authn_jwt_schema.keyfile.desc = "包含 PEM 编码的用户私钥的文件的路径。"
emqx_authn_jwt_schema.keyfile.label = "私钥文件"
emqx_authn_jwt_schema.max_fail_count.desc = "在缓存密钥失效之前，连续 JWKS 刷新失败的最大次数。"
emqx_authn_jwt_schema.max_fail_count.label = "最大失败次数"
emqx_authn_jwt_schema.on_missing_jwt.desc = "当配置的 JWT 凭证字段缺失时采取的动作。使用 <code>deny</code> 立即拒绝认证，或使用 <code>ignore</code> 跳过此认证器并让认证链继续。"
emqx_authn_jwt_schema.on_missing_jwt.label = "JWT 缺失时"
emqx_authn_jwt_schema.public_key.desc = "用于验证 JWT 的公钥。"
emqx_authn_jwt_schema.public_key.label = "公钥"
emqx_authn_jwt_schema.refresh_interval.desc = "JWKS 刷新间隔。"
emqx_authn_jwt_schema.refresh_interval.label = "JWKS 刷新间隔"
emqx_authn_jwt_schema.secret.desc = "使用 HMAC 算法时用于验证 JWT 的密钥"
emqx_authn_jwt_schema.secret.label = "Secret"
emqx_authn_jwt_schema.secret_base64_encoded.desc = "密钥是否为 base64 编码。"
emqx_authn_jwt_schema.secret_base64_encoded.label = "密钥是否为 Base64 编码"
emqx_authn_jwt_schema.server_name_indication.desc = "服务器名称指示（SNI）。"
emqx_authn_jwt_schema.server_name_indication.label = "服务器名称指示"
emqx_authn_jwt_schema.ssl.desc = "SSL 选项。"
emqx_authn_jwt_schema.ssl.label = "SSL 选项"
emqx_authn_jwt_schema.use_jwks.desc = "是否使用 JWKS。"
emqx_authn_jwt_schema.use_jwks.label = "是否使用 JWKS"
emqx_authn_jwt_schema.verify.desc = "指定握手过程中是否校验对端证书。"
emqx_authn_jwt_schema.verify.label = "验证"
emqx_authn_jwt_schema.verify_claims.desc = "需要验证的自定义声明列表，是一个由名称/值对组成的列表。指定一个键(Key)来查找 JWT 中对应的声明(Claim)，并提供一个预期值(Expected Value)来与声明的实际值进行比较，以确保只有满足特定条件的 JWT 才能被接受和使用。\n例如要求 JWT 中的特定声明(如 clientid)的值必须与当前连接的客户端 ID 相匹配。\n预期值可以使用以下占位符：\n- <code>${username}</code>: 将在运行时被替换为客户端连接时使用的用户名\n- <code>${clientid}</code>: 将在运行时被替换为客户端连接时使用的客户端 ID\n身份认证将确认 JWT 中的声明值（从密码字段中获取）与 <code>verify_claims</code> 中要求的内容是否匹配。"
emqx_authn_jwt_schema.verify_claims.label = "自定义声明检查"
emqx_authn_kerberos_schema.principal.desc = "服务器的 Kerberos 主体。\n例如： <code>mqtt/emqx-cluster-1.example.com@MY_REALM.EXAMPLE.COM</code>。\n注意：所使用的领域需要在 EMQX 节点的 /etc/krb5.conf 文件中配置。"
emqx_authn_kerberos_schema.principal.label = "Kerberos 主体"
emqx_authn_ldap_schema.acl_ttl_attribute.desc = "指示使用哪个属性来表示 ACL TTL。"
emqx_authn_ldap_schema.acl_ttl_attribute.label = "ACL TTL 属性"
emqx_authn_ldap_schema.bind_method.desc = "通过 LDAP 绑定操作进行认证。"
emqx_authn_ldap_schema.bind_password.desc = "绑定密码的模板。"
emqx_authn_ldap_schema.bind_password.label = "绑定密码"
emqx_authn_ldap_schema.clientid_override_attribute.desc = "指示哪个属性用于表示 clientid 覆盖值。"
emqx_authn_ldap_schema.clientid_override_attribute.label = "ClientIdOverride 属性"
emqx_authn_ldap_schema.hash_method.desc = "通过将本地密码与经过由`密码属性`指定的算法加密的密码进行比对来进行认证。"
emqx_authn_ldap_schema.is_superuser_attribute.desc = "指示哪个属性用于表示用户是否为超级用户。"
emqx_authn_ldap_schema.is_superuser_attribute.label = "是否为超级用户属性"
emqx_authn_ldap_schema.ldap.desc = "使用 LDAP 作为认证数据源的认证器的配置项。"
emqx_authn_ldap_schema.method.desc = "认证方式。"
emqx_authn_ldap_schema.method_type.desc = "认证方式类型。"
emqx_authn_ldap_schema.password_attribute.desc = "指示哪个属性用于表示用户密码。"
emqx_authn_ldap_schema.password_attribute.label = "密码属性"
emqx_authn_ldap_schema.query_timeout.desc = "LDAP 查询的超时时间。"
emqx_authn_ldap_schema.query_timeout.label = "查询超时"
emqx_authn_mnesia_schema.bootstrap_file.desc = "引导文件将用户导入内置数据库。\n对于数据库中已存在的用户 ID，不会重复导入。\n文件内容格式由 `bootstrap_type` 决定。"
emqx_authn_mnesia_schema.bootstrap_file.label = "引导文件路径"
emqx_authn_mnesia_schema.bootstrap_type.desc = "指定引导文件的内容类型。\n\n- **`plain`**:\n  - 所需数据字段： `user_id`, `password`, `is_superuser`\n  - `user_id`: 可以是客户端 ID 或用户名，具体取决于内置数据库认证的 `user_id_type` 配置。\n  - `password`: 用户的明文密码。\n  - `is_superuser`: 布尔值，用户是否为管理员。\n\n- **`hash`**:\n  - 所需数据字段 `user_id`,`password_hash`,`salt`,`is_superuser`\n  - 定义与 `plain` 类型相似，为提高安全性增加了 `password_hash` 和 `salt`。\n\n内容可以是 CSV 或 JSON 格式。\n\n这是一个 CSV 示例：`user_id,password_hash,salt,is_superuser\\nmy_user,b6c743545a7817ae8c8f624371d5f5f0373234bb0ff36b8ffbf19bce0e06ab75,de1024f462fb83910fd13151bd4bd235,true`\n\nJSON 内容应解码为对象数组，例如：`[{\"user_id\": \"my_user\",\"password\": \"s3cr3tp@ssw0rd\",\"is_superuser\": true}]`.\n\n`password_hash` 的哈希字符串取决于内容数据库认证机制中 `password_hash_algorithm` 的配置。例如，如果配置为 `password_hash_algorithm {name = sha256, salt_position = suffix}`，则在哈希之前将 salt 添加到密码中。等效的 Python 表达式为： `hashlib.sha256(password + salt).hexdigest()`."
emqx_authn_mnesia_schema.builtin_db.desc = "使用内置数据库作为认证数据源的认证器的配置项。"
emqx_authn_mnesia_schema.user_id_type.desc = "指定用于客户端身份 ID 认证的字段。"
emqx_authn_mnesia_schema.user_id_type.label = "账号类型"
emqx_authn_mongodb_schema.clientid_override_field.desc = "定义客户端 clientid 覆盖的文档字段。"
emqx_authn_mongodb_schema.clientid_override_field.label = "ClientId 覆盖字段"
emqx_authn_mongodb_schema.collection.desc = "存储认证数据的集合。"
emqx_authn_mongodb_schema.collection.label = "集合"
emqx_authn_mongodb_schema.filter.desc = "在查询中定义过滤条件的条件表达式。\n过滤器支持如下占位符：\n- <code>${username}</code>: 将在运行时被替换为客户端连接时使用的用户名\n- <code>${clientid}</code>: 将在运行时被替换为客户端连接时使用的客户端 ID"
emqx_authn_mongodb_schema.filter.label = "过滤器"
emqx_authn_mongodb_schema.is_superuser_field.desc = "定义用户是否具有超级用户权限的字段。"
emqx_authn_mongodb_schema.is_superuser_field.label = "超级用户字段"
emqx_authn_mongodb_schema.password_hash_field.desc = "存储密码散列值字段。"
emqx_authn_mongodb_schema.password_hash_field.label = "密码散列字段"
emqx_authn_mongodb_schema.replica-set.desc = "使用 MongoDB (Replica Set) 作为认证数据源的认证器的配置项。"
emqx_authn_mongodb_schema.salt_field.desc = "用于存储盐值的字段。"
emqx_authn_mongodb_schema.salt_field.label = "盐值字段"
emqx_authn_mongodb_schema.sharded-cluster.desc = "使用 MongoDB (Sharded Cluster) 作为认证数据源的认证器的配置项。"
emqx_authn_mongodb_schema.single.desc = "使用 MongoDB (Standalone) 作为认证数据源的认证器的配置项。"
emqx_authn_mysql_schema.mysql.desc = "使用 MySQL 作为认证数据源的认证器的配置项。"
