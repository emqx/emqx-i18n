emqx_bridge_redis.desc_name.label = "动作名称"
emqx_bridge_redis.desc_type.desc = "动作的类型"
emqx_bridge_redis.desc_type.label = "动作类型"
emqx_bridge_redis.redis_type.desc = "单一模式。当 Redis 服务器在单一模式下运行时，必须设置为 'single'。\n哨兵模式。当 Redis 服务器在哨兵模式下运行时，必须设置为 'sentinel'。\n集群模式。当Redis服务器在集群模式下运行时，必须设置为 'cluster'。"
emqx_bridge_redis.redis_type.label = "Redis 类型"
emqx_bridge_redis_schema.batch_size.desc = "这个参数定义了批处理计数的上限。\n将这个值设置为1将有效地禁用批处理，因为它表示每个批处理将只处理一个项目。\n关于 Redis 集群模式的注意事项：\n在 Redis 集群模式的情况下不支持批处理。\n因此，batch_size 总是设置为1，\n反映了该模式对于批处理操作固有的限制。"
emqx_bridge_redis_schema.batch_size.label = "批处理大小"
emqx_bridge_redis_schema.batch_time.desc = "在低消息速率下积累批处理时的最大等待间隔，以实现更高效的资源使用。"
emqx_bridge_redis_schema.batch_time.label = "最大批处理等待时间，在 Redis Cluster 模式下禁用"
emqx_bridge_redis_schema.producer_action.desc = "动作的参数。"
