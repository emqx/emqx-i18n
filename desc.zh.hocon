emqx_ft_api.file_id.label = "文件 ID"
emqx_ft_api.file_list.desc = "列出已上传的所有文件"
emqx_ft_api.file_list.label = "文件列表"
emqx_ft_api.file_list_transfer.desc = "根据客户端 ID 或者文件 ID 列出所有已上传的文件"
emqx_ft_api.file_list_transfer.label = "传输文件列表"
emqx_ft_api.file_transfer_get_config.desc = "显示当前文件传输配置。"
emqx_ft_api.file_transfer_get_config.label = "获取文件传输配置"
emqx_ft_api.file_transfer_update_config.desc = "替换文件传输配置。"
emqx_ft_api.file_transfer_update_config.label = "更新文件传输配置"
emqx_ft_api.files_not_found.desc = "请求传输的文件未找到。"
emqx_ft_api.files_not_found.label = "文件未找到"
emqx_ft_api.invalid_cursor.desc = "无效的游标"
emqx_ft_api.invalid_cursor.label = "无效的游标"
emqx_ft_api.mqtt_client_id.desc = "MQTT 客户端 ID"
emqx_ft_api.mqtt_client_id.label = "MQTT 客户端 ID"
emqx_ft_api.operation_success.desc = "操作成功"
emqx_ft_api.operation_success.label = "操作成功"
emqx_ft_api.service_unavailable.desc = "服务不可用"
emqx_ft_api.service_unavailable.label = "服务不可用"
emqx_ft_schema.assemble_timeout.desc = "文件拼接超时。<br/>\n在收到 'fin' 消息后 EMQX 会对文件进行拼接，如果发生超时（例如系统过载），则会给 'fin' 的 PUBACK 中包含一个错误码（0x80）。"
emqx_ft_schema.backend_enable.desc = "是否启用该后端"
emqx_ft_schema.enable.desc = "启用文件传输（File Transfer）服务。<br/>\n文件传输服务允许客户端使用 `$file` 主题将分片上传到 EMQX。\n启用文件传输服务表示 `$file` 主题前缀已被预留，用于提供文件传输服务。<br/>\n这个开关也会影响文件传输 REST API 的可用性，以及依赖存储的后台任务（例如垃圾回收）。"
emqx_ft_schema.init_timeout.desc = "指定文件传输初始化的时间限制。在<br/>\nEMQX 服务器过载时可能发生初始化超时。超时后给 `init` 的 PUBACK 中包含一个错误码 （0x80）。"
emqx_ft_schema.local_storage.desc = "EMQX 节点本地用文件系统于存储文件分片的相关配置。"
emqx_ft_schema.local_storage_exporter.desc = "将文件导出到本地存储。"
emqx_ft_schema.local_storage_exporter_backend.desc = "将文件导出到本地存储<br/>\n该配置项指定所有分片都传输完成了的文件进行导出到本地存储的相关行为。"
emqx_ft_schema.local_storage_exporter_root.desc = "导出到本地文件时使用的根目录。"
emqx_ft_schema.local_storage_segments.desc = "本地文件系统存储配置，包括已上传的文件分片和临时数据。"
emqx_ft_schema.local_storage_segments_gc.desc = "文件系统中临时文件的垃圾回收配置。"
emqx_ft_schema.local_storage_segments_root.desc = "文件分片存储的根目录。"
emqx_ft_schema.s3_exporter.desc = "将文件导出到 AWS s3 API 兼容的对象存储服务。"
emqx_ft_schema.storage_backend.desc = "文件后端存储配置"
emqx_ft_schema.storage_gc_interval.desc = "运行垃圾回收的时间间隔。"
emqx_ft_schema.storage_gc_max_segments_ttl.desc = "分片的临时存储的最大 TTL。<br/>\n该配置为系统全局上限，所有的分片都不会超过这个 TTL，即使某些文件传输指定了一个更大的 TTL。"
emqx_ft_schema.storage_gc_min_segments_ttl.desc = "分片的临时存储的最小 TTL。<br/>\n分片在超过这个 TTL 之前不被垃圾回收。\n该配置为系统全局下限，所有的分片都不会低于这个 TTL，即使某些文件传输指定了一个更小的 TTL。"
emqx_ft_schema.store_segment_timeout.desc = "文件片段保存超时。<br/>\nEMQX 收到文件分片后，会对它进行保存，如果发生超时（例如系统过载），则会给这个发布消息的 PUBACK 中包含一个错误码（0x80）。"
emqx_ft_storage_exporter_fs_api.file_get.desc = "根据文件 ID 下载指定文件"
emqx_ft_storage_exporter_fs_api.file_get.label = "获取文件"
emqx_ft_storage_exporter_fs_api.file_reference.desc = "文件引用"
emqx_ft_storage_exporter_fs_api.file_reference.label = "文件引用"
