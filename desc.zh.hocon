emqx_authn_redis_schema.cluster.desc = "使用 Redis (Cluster) 作为认证数据源的认证器的配置项。"
emqx_authn_redis_schema.cmd.desc = "用于查询密码散列等用于认证的数据的 Redis 命令，目前仅支持 <code>HGET</code> 与 <code>HMGET</code>。"
emqx_authn_redis_schema.cmd.label = "Redis 命令"
emqx_authn_redis_schema.sentinel.desc = "使用 Redis (Sentinel) 作为认证数据源的认证器的配置项。"
emqx_authn_redis_schema.single.desc = "使用 Redis (Standalone) 作为认证数据源的认证器的配置项。"
emqx_authn_schema.authentication_cache.desc = "认证缓存设置。"
emqx_authn_schema.authentication_cache.label = "认证缓存"
emqx_authn_schema.backend.desc = "后端类型。"
emqx_authn_schema.backend.label = "后端类型"
emqx_authn_schema.enable.desc = "设为 <code>true</code> 或 <code>false</code> 以禁用此认证数据源。"
emqx_authn_schema.enable.label = "启用"
emqx_authn_schema.failed.desc = "当前数据源执行查询失败次数。"
emqx_authn_schema.failed.label = "查询失败次数"
emqx_authn_schema.global_authentication.desc = "默认的 MQTT 监听器的全局认证配置。\n\n有关每个监听器的单独配置，请参阅监听器配置中的<code>authentication</code>。\n\n此选项可配置为：\n<ul>\n  <li><code>[]</code>: 默认值，允许 *所有* 登录</li>\n  <li>one: 例如 <code>{enable:true,backend:\"built_in_database\",mechanism=\"password_based\"}</code></li>\n  <li>chain: 结构体数组。</li>\n</ul>\n\n当配置了一个认证链时，登录凭据将按照配置的顺序检查后端，直到可以做出'允许'或'拒绝'的决定。\n\n如果在完全遍历认证链之后没有决定，登录将被拒绝。"
emqx_authn_schema.global_authentication.label = "全局认证"
emqx_authn_schema.ignore_backend_failures.desc = "在强化安全配置文件中忽略认证后端失败，并继续链中的下一个认证器。"
emqx_authn_schema.ignore_backend_failures.label = "忽略后端失败"
emqx_authn_schema.listener_authentication.desc = "每个监听器的认证覆盖。\n认证可以是一个单一的认证器实例，也可以是一个认证器链，表示为一个数组\n在对登录进行身份认证（用户名、客户端 ID 等）时，将按照配置的顺序检查认证器。"
emqx_authn_schema.listener_authentication.label = "每个监听器的认证覆盖。"
emqx_authn_schema.matched.desc = "当前数据源执行查询次数。"
emqx_authn_schema.matched.label = "查询次数"
emqx_authn_schema.mechanism.desc = "认证方式。"
emqx_authn_schema.mechanism.label = "认证方式"
emqx_authn_schema.metrics.desc = "认证器统计指标。"
emqx_authn_schema.metrics.label = "指标"
emqx_authn_schema.metrics_failed.desc = "在当前认证器中找到需要的认证信息，并且返回认证失败的次数。"
emqx_authn_schema.metrics_failed.label = "认证失败次数"
emqx_authn_schema.metrics_nomatch.desc = "在当前认证器中没有找到需要的认证信息，忽略认证的次数。"
emqx_authn_schema.metrics_nomatch.label = "忽略认证次数"
emqx_authn_schema.metrics_rate.desc = "当前认证器执行速度，次/秒。"
emqx_authn_schema.metrics_rate.label = "认证速度"
emqx_authn_schema.metrics_rate_last5m.desc = "当前认证器在最近 5 分钟内平均执行速度，单位：次/秒。"
emqx_authn_schema.metrics_rate_last5m.label = "近 5 分钟内平均认证速度"
emqx_authn_schema.metrics_rate_max.desc = "当前认证器曾经达到的最大认证速度，单位：次/秒。"
emqx_authn_schema.metrics_rate_max.label = "最大认证速度"
emqx_authn_schema.metrics_success.desc = "在当前认证器中找到需要的认证信息，并且实例返回认证成功的次数。"
emqx_authn_schema.metrics_success.label = "认证成功次数"
emqx_authn_schema.metrics_total.desc = "当前认证器执行认证的总次数。"
emqx_authn_schema.metrics_total.label = "认证总次数"
emqx_authn_schema.node.desc = "节点名称。"
emqx_authn_schema.node.label = "节点名称"
emqx_authn_schema.node_error.desc = "节点上的错误信息。"
emqx_authn_schema.node_error.label = "节点错误信息"
emqx_authn_schema.node_metrics.desc = "每个节点上认证器的统计指标。"
emqx_authn_schema.node_metrics.label = "节点指标"
emqx_authn_schema.node_status.desc = "每个节点上数据源的状态。"
emqx_authn_schema.node_status.label = "节点数据源状态"
emqx_authn_schema.precondition.desc = "一个 Variform 表达式，用于评估一组从客户端信息派生的预绑定变量。\n\n支持的变量：\n- `username`：客户端的用户名\n- `password`：客户端的密码\n- `clientid`：客户端的 ID\n- `client_attrs.*`：客户端的属性\n- `cert_common_name`：客户端 TLS 证书的主题字段\n- `cert_subject`：客户端 TLS 证书的通用名称（CN）\n- `peersni`：TLS 客户端发送的 SNI（服务器名称指示）\n- `listener`：监听器 ID（例如 `tcp:default`）\n- `zone`：关联的配置区域。\n\n表达式必须评估为字符串值 'true'，此认证器才会被调用。\n如果表达式评估为其他值，则跳过此认证器。\n\n示例：\n- 仅在客户端从监听器 `ssl:letsencryt` 连接时调用：\n  `str_eq(listener, 'ssl:letsencryt')`\n- 如果用户名为空则跳过：\n  `not(is_empty_val(username))`\n- 仅在密码存在且区域为 'zone1' 时调用：\n  `iif(is_empty_val(password), false, str_eq(zone, 'zone1'))`\n\n在 EMQX 文档中查找有关 Variform 表达式的更多信息。"
emqx_authn_schema.precondition.label = "前置条件"
emqx_authn_schema.rate.desc = "当前数据源执行查询速度，单位：次/秒。"
emqx_authn_schema.rate.label = "查询速度"
emqx_authn_schema.rate_last5m.desc = "当前数据源在最近 5 分钟内平均执行速度，单位：次/秒。"
emqx_authn_schema.rate_last5m.label = "近 5 分钟内平均查询速度"
emqx_authn_schema.rate_max.desc = "当前认数据源曾经达到的最大查询速度，单位：次/秒。"
emqx_authn_schema.rate_max.label = "最大查询速度"
