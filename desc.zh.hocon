emqx_authz_schema.node_status.desc = "每个节点上数据源的状态。"
emqx_authz_schema.node_status.label = "节点数据源状态"
emqx_authz_schema.nomatch.desc = "没有匹配到任何授权规则的次数。"
emqx_authz_schema.nomatch.label = "没有匹配到任何授权规则的次数"
emqx_authz_schema.precondition.desc = "在调用此授权源之前，使用客户端和请求信息评估的 Variform 表达式。\n\n支持的客户端变量包括：\n- `username`：客户端的用户名\n- `clientid`：客户端的 client ID\n- `client_attrs.*`：客户端属性\n- `cert_common_name`：客户端 TLS 证书中的通用名称（CN）\n- `cert_subject`：客户端 TLS 证书中的 Subject 字段\n- `peersni`：TLS 客户端发送的 SNI（Server Name Indication）\n- `listener`：监听器 ID（如 `tcp:default`）\n- `zone`：关联的配置区。\n\n支持的请求变量包括：\n- `action`：授权动作，取值为 `publish` 或 `subscribe`\n- `topic`：正在授权的主题\n\n当表达式评估结果不为 true 时，将跳过该授权源。\n\n示例：\n- 仅在 publish 授权时调用：\n  `str_eq(action, 'publish')`\n- 仅当主题匹配客户端作用域的主题过滤器时调用：\n  `topic_match(topic, topic_join([clientid, '#']))`"
emqx_authz_schema.precondition.label = "前置条件"
emqx_authz_schema.rate.desc = "命中速率，单位：次/秒。"
emqx_authz_schema.rate.label = "速率"
emqx_authz_schema.rate_last5m.desc = "5 分钟内平均命中速率，单位：次/秒。"
emqx_authz_schema.rate_last5m.label = "5 分钟内速率"
emqx_authz_schema.rate_max.desc = "最大命中速率，单位：次/秒。"
emqx_authz_schema.rate_max.label = "最大速率"
emqx_authz_schema.sources.desc = "<br/>\n授权（ACL）数据提供者的数组。\n它被设计为一个数组，而不是哈希映射，因此可以\n将源按顺序排列形成访问控制链。<br/>\n\n在授权 '发布' 或 '订阅' 操作时，配置的\n源会按顺序检查。在检查 ACL 源时，\n如果未找到客户端（通过用户名或客户端 ID 标识），\n则继续检查下一个源。一旦返回 '允许' 或 '拒绝' 决定，\n立即停止检查。<br/>\n\n如果在任何源中都未找到客户端，\n则应用 'authorization.no_match' 中配置的默认操作。<br/>\n\n注意：\n源元素由它们的 '类型' 标识。\n不允许配置两个或更多相同类型的源。"
emqx_authz_schema.sources.label = "数据源"
emqx_authz_schema.status.desc = "数据源状态。"
emqx_authz_schema.status.label = "数据源状态"
emqx_authz_schema.success.desc = "请求成功次数。"
emqx_authz_schema.success.label = "成功"
emqx_authz_schema.topic_template_allow.desc = "控制插入到授权主题模板中的客户端可控值是否可以包含 MQTT 主题过滤字符。"
emqx_authz_schema.topic_template_allow.label = "主题模板允许的字符"
emqx_authz_schema.topic_template_allow_hash.desc = "允许在插入到授权主题模板的值中包含井号（<code>#</code>）。"
emqx_authz_schema.topic_template_allow_hash.label = "允许井号"
emqx_authz_schema.topic_template_allow_plus.desc = "允许在插入到授权主题模板的值中包含加号（<code>+</code>）。"
emqx_authz_schema.topic_template_allow_plus.label = "允许加号"
emqx_authz_schema.topic_template_allow_slash.desc = "允许在插入到授权主题模板的值中包含斜杠字符（<code>/</code>）。"
emqx_authz_schema.topic_template_allow_slash.label = "允许斜杠"
emqx_authz_schema.type.desc = "数据后端类型"
emqx_authz_schema.type.label = "类型"
emqx_auto_subscribe_api.list_auto_subscribe_api.desc = "获取自动订阅主题列表"
emqx_auto_subscribe_api.list_auto_subscribe_api.label = "获取自动订阅主题列表"
emqx_auto_subscribe_api.update_auto_subscribe_api.desc = "更新自动订阅主题列表"
emqx_auto_subscribe_api.update_auto_subscribe_api.label = "更新自动订阅主题"
emqx_auto_subscribe_api.update_auto_subscribe_api_response409.desc = "超出自动订阅主题列表长度限制"
emqx_auto_subscribe_api.update_auto_subscribe_api_response409.label = "超出自动订阅主题列表长度限制"
emqx_auto_subscribe_schema.auto_subscribe.desc = "设备成功登录后，通过预定义的订阅表示法自动为设备完成订阅。支持使用占位符。"
emqx_auto_subscribe_schema.auto_subscribe.label = "自动订阅"
emqx_auto_subscribe_schema.nl.desc = "默认值为 0。\nMQTT v3.1.1：如果你订阅了自己发布的主题，你将收到所有自己发布的消息。\nMQTT v5：如果在订阅时将此选项设置为 1，服务器将不会将你发布的消息转发给你。"
emqx_auto_subscribe_schema.nl.label = "No Local"
emqx_auto_subscribe_schema.qos.desc = "默认值 0。消息服务质量。\n至多一次（0）\n至少一次（1）\n恰好一次（2）"
emqx_auto_subscribe_schema.qos.label = "QoS"
emqx_auto_subscribe_schema.rap.desc = "默认值为 0。此选项用于指定服务器在向客户端转发消息时是否保留 RETAIN 标记，而且此选项不影响保留消息中的 RETAIN 标记。因此，当选项 Retain As Publish 设置为 0 时，客户端将直接根据消息中的 RETAIN 标记来区分这是普通的转发消息还是保留消息，而不是判断此消息是否为订阅后首次收到的消息（转发的消息可能在保留消息之前发送，这取决于不同消息服务器的具体实现）。"
emqx_auto_subscribe_schema.rap.label = "Retain As Publish"
emqx_auto_subscribe_schema.rh.desc = "默认值为 0。此选项用于指定客户端建立订阅时，服务器是否向客户端转发保留的消息。\n当 Retain Handling 等于 0 时，只要客户端成功订阅，服务器就会发送保留消息。\n当 Retain Handling 等于 1 时，如果客户端成功订阅并且此前不存在此订阅，服务器发送保留消息。毕竟，有时客户端重新发起订阅只是为了改变 QoS，并不意味着它想再次接收保留的消息。\n当 Retain Handling 等于 2 时，即使客户端成功订阅，服务器也不会发送保留消息。"
emqx_auto_subscribe_schema.rh.label = "Retain Handling"
emqx_auto_subscribe_schema.topic.desc = "主题名称，支持占位符。例如：client/${clientid}/username/${username}/host/${host}/port/${port}\n为必填字段，且不能为空字符串。"
emqx_auto_subscribe_schema.topic.label = "主题"
emqx_bridge_alloydb_action_schema.action_parameters.desc = "动作的参数集。"
emqx_bridge_alloydb_action_schema.action_parameters.label = "动作参数"
emqx_bridge_alloydb_action_schema.alloydb.desc = "将传入事件追加到 Google AlloyDB 的动作。"
emqx_bridge_alloydb_action_schema.alloydb.label = "上传到 Google AlloyDB"
emqx_bridge_alloydb_action_schema.parameters.desc = "动作特定参数。"
emqx_bridge_alloydb_action_schema.parameters.label = "参数"
