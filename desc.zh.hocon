emqx_bridge_http_connector.path.desc = "URL 路径。"
emqx_bridge_http_connector.path.label = "URL 路径"
emqx_bridge_http_connector.pool_size.desc = "连接池大小。"
emqx_bridge_http_connector.pool_size.label = "连接池大小"
