emqx_bridge_http_schema.config_body.desc = "HTTP 请求的主体。<br/>\n如果未提供，主体将是所有可用字段的 JSON 对象。<br/>\n这里的“所有可用字段”是指在触发此 Webhook 时的 MQTT 消息的上下文（当 local_topic 已设置并接收到 MQTT 消息时触发），<br/>或者当此 Webhook 用作规则的动作时，在触发此 Webhook 时的事件上下文。<br/>允许使用带有变量的模板。"
emqx_bridge_http_schema.config_body.label = "HTTP 请求体"
emqx_bridge_http_schema.config_enable_bridge.desc = "启用或停用动作"
emqx_bridge_http_schema.config_enable_bridge.label = "启用或停用动作"
emqx_bridge_http_schema.config_headers.desc = "HTTP 请求头。<br/>\n允许使用带有变量的模板。"
emqx_bridge_http_schema.config_headers.label = "HTTP 请求头"
emqx_bridge_http_schema.config_max_retries.desc = "如果发送请求时出错，最大的重试次数。"
emqx_bridge_http_schema.config_max_retries.label = "HTTP 请求最大重试次数"
emqx_bridge_http_schema.config_method.desc = "HTTP 请求的方法。所有可用的方法包括：post、put、get、delete。<br/>\n允许使用带有变量的模板。"
emqx_bridge_http_schema.config_method.label = "HTTP 方法"
emqx_bridge_http_schema.config_parameters_opts.desc = "HTTP 动作的参数"
emqx_bridge_http_schema.config_parameters_opts.label = "参数"
emqx_bridge_http_schema.config_path.desc = "此动作的 URL 路径。<br/>\n此路径将附加到连接器的 <code>url</code> 配置，以形成完整的 URL 地址。\n此选项允许使用带有变量的模板。例如，<code>/room/${room_no}</code>。"
emqx_bridge_http_schema.config_path.label = "URL 路径"
emqx_bridge_http_schema.config_request_timeout.desc = "HTTP 请求超时时间"
emqx_bridge_http_schema.config_request_timeout.label = "HTTP 请求超时"
emqx_bridge_http_schema.config_url.desc = "HTTP 动作的 URL。<br/>\n此路径允许使用带有变量的模板，但变量不能用于方案、主机或端口部分。<br/>\n例如，<code> http://localhost:9901/${topic} </code> 是允许的，但\n<code> http://${host}:9901/message </code> 或 <code> http://localhost:${port}/message </code>\n是不允许的。"
emqx_bridge_http_schema.config_url.label = "HTTP 动作"
