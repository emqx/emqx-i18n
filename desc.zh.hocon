emqx_bridge_pulsar.auth_basic.desc = "基本认证的参数。"
emqx_bridge_pulsar.auth_basic.label = "基本认证参数"
emqx_bridge_pulsar.auth_basic_password.desc = "基本认证密码，即 `username:password` 认证字符串中的 `password` 部分。<br/>\n如需从文件加载密码而不是内联写入，请使用 <code>file://&lt;path-to-file&gt;</code> 形式；文件内容（去除末尾空白）将作为密码使用。集群模式下，该文件必须存在于所有 EMQX 节点。"
emqx_bridge_pulsar.auth_basic_password.label = "密码"
emqx_bridge_pulsar.auth_basic_username.desc = "基本认证用户名。"
emqx_bridge_pulsar.auth_basic_username.label = "用户名"
emqx_bridge_pulsar.auth_token.desc = "Token 认证的参数。"
emqx_bridge_pulsar.auth_token.label = "Token 认证参数"
emqx_bridge_pulsar.auth_token_jwt.desc = "JWT 认证 token。<br/>\n如需从文件加载 token 而不是内联写入，请使用 <code>file://&lt;path-to-file&gt;</code> 形式；文件内容（去除末尾空白）将作为 token 使用。集群模式下，该文件必须存在于所有 EMQX 节点。"
emqx_bridge_pulsar.auth_token_jwt.label = "JWT"
emqx_bridge_pulsar.authentication.desc = "认证参数。"
emqx_bridge_pulsar.authentication.label = "认证"
emqx_bridge_pulsar.buffer_memory_overload_protection.desc = "缓存模式是 <code>memory</code> 或 <code>hybrid</code> 时适用。当系统处于高内存压力时，从队列中丢弃旧的消息以减缓内存增长。注意，该配置仅在 Linux 系统中有效。"
emqx_bridge_pulsar.buffer_memory_overload_protection.label = "内存过载保护"
emqx_bridge_pulsar.buffer_mode.desc = "消息缓存模式。\n<code>memory</code>: 所有的消息都缓存在内存里。如果 EMQX 服务重启，缓存的消息会丢失。\n<code>disk</code>: 缓存到磁盘上。EMQX 重启后会继续发送重启前未发送完成的消息。\n<code>hybrid</code>: 先将消息缓存在内存中，当内存中的消息堆积超过一定限制（配置项 <code>segment_bytes</code> 描述了该限制）后，后续的消息会缓存到磁盘上。与 <code>memory</code> 模式一样，如果 EMQX 服务重启，缓存的消息会丢失。"
emqx_bridge_pulsar.buffer_mode.label = "缓存模式"
emqx_bridge_pulsar.buffer_per_partition_limit.desc = "为每个 Pulsar 分区设置的最大缓存字节数。当超过这个上限之后，老的消息会被丢弃，为新的消息腾出空间。"
emqx_bridge_pulsar.buffer_per_partition_limit.label = "Pulsar 分区缓存上限"
emqx_bridge_pulsar.buffer_segment_bytes.desc = "当缓存模式是 <code>disk</code> 或 <code>hybrid</code> 时适用。该配置用于指定缓存到磁盘上的文件的大小。"
emqx_bridge_pulsar.buffer_segment_bytes.label = "缓存文件大小"
emqx_bridge_pulsar.config_connector.desc = "Pulsar 连接器配置。"
emqx_bridge_pulsar.config_connector.label = "Pulsar 连接器"
emqx_bridge_pulsar.config_enable.desc = "启用（true）或停用（false）该 Pulsar 数据桥接。"
emqx_bridge_pulsar.config_enable.label = "启用或停用"
emqx_bridge_pulsar.connect_timeout.desc = "建立 TCP 连接时的最大等待时长（若启用认证，这个等待时长也包含完成认证所需时间）。"
emqx_bridge_pulsar.connect_timeout.label = "连接超时时间"
emqx_bridge_pulsar.connector_resource_opts.desc = "Pulsar 连接器资源选项。"
emqx_bridge_pulsar.connector_resource_opts.label = "资源选项"
emqx_bridge_pulsar.desc_name.desc = "动作名称，可读的标识符。"
emqx_bridge_pulsar.desc_name.label = "动作名称"
emqx_bridge_pulsar.desc_type.desc = "桥接类型"
emqx_bridge_pulsar.desc_type.label = "桥接类型"
emqx_bridge_pulsar.producer_batch_size.desc = "在一个 Pulsar 消息中批处理的单个请求的最大数量。"
emqx_bridge_pulsar.producer_batch_size.label = "批量大小"
emqx_bridge_pulsar.producer_buffer.desc = "配置消息缓存的相关参数。\n\n当 EMQX 需要发送的消息超过 Pulsar 处理能力，或者当 Pulsar 临时下线时，EMQX 内部会将消息缓存起来。"
emqx_bridge_pulsar.producer_buffer.label = "消息缓存"
emqx_bridge_pulsar.producer_compression.desc = "压缩方法。"
emqx_bridge_pulsar.producer_compression.label = "压缩"
emqx_bridge_pulsar.producer_max_batch_bytes.desc = "最大消息批量字节数。大多数 Pulsar 环境的默认最低值是 5 MB，EMQX 的默认值比 5 MB 更小是因为需要补偿 Pulsar 消息编码所需要的额外字节（尤其是当每条消息都很小的情况下）。当单个消息的大小超过该限制时，它仍然会被发送，（相当于该批量中只有单个消息）。"
emqx_bridge_pulsar.producer_max_batch_bytes.label = "最大批量字节数"
emqx_bridge_pulsar.producer_pulsar_topic.desc = "Pulsar 主题名称"
emqx_bridge_pulsar.producer_pulsar_topic.label = "Pulsar 主题名称"
emqx_bridge_pulsar.producer_retention_period.desc = "当没有连接到 Pulsar 代理时，信息将被缓冲的时间。 较长的时间意味着将使用更多的内存/磁盘"
emqx_bridge_pulsar.producer_retention_period.label = "保留期"
emqx_bridge_pulsar.producer_send_buffer.desc = "TCP socket 的发送缓存调优。默认值是针对高吞吐量的一个推荐值。"
emqx_bridge_pulsar.producer_send_buffer.label = "Socket 发送缓存大小"
emqx_bridge_pulsar.producer_strategy.desc = "设置消息发布时应该如何选择 Pulsar 分区。\n\n<code>random</code>: 为每个消息随机选择一个分区。\n<code>roundrobin</code>: 依次为每条信息挑选可用的生产商。\n<code>key_dispatch</code>: 将一批信息中的第一条信息的 Pulsar 信息密钥哈希到一个分区编号。"
emqx_bridge_pulsar.producer_strategy.label = "分区选择策略"
emqx_bridge_pulsar.pulsar_producer_struct.desc = "Pulsar 桥接配置"
emqx_bridge_pulsar.pulsar_producer_struct.label = "Pulsar 桥接配置"
emqx_bridge_pulsar.servers.desc = "以逗号分隔的 <code>scheme://host[:port]</code> 格式的 Pulsar URL 列表，支持的 scheme 有 <code>pulsar://</code> （默认）和<code>pulsar+ssl://</code>。默认的端口是 6650。"
emqx_bridge_pulsar.servers.label = "服务员"
emqx_bridge_pulsar_pubsub_schema.action_parameters.desc = "针对动作的详细配置。"
emqx_bridge_pulsar_pubsub_schema.action_parameters.label = "动作"
emqx_bridge_pulsar_pubsub_schema.producer_key_template.desc = "渲染 Pulsar 消息键的模板。"
emqx_bridge_pulsar_pubsub_schema.producer_key_template.label = "消息的键"
emqx_bridge_pulsar_pubsub_schema.producer_max_inflight.desc = "生产者在必须等待回执之前可以发送到每个分区的最大消息批次数。\n设置更高的数字可以提高吞吐量。"
emqx_bridge_pulsar_pubsub_schema.producer_max_inflight.label = "最大 Inflight"
emqx_bridge_pulsar_pubsub_schema.producer_message_opts.desc = "渲染 Pulsar 消息的模版。"
emqx_bridge_pulsar_pubsub_schema.producer_message_opts.label = "Pulsar 消息模版"
emqx_bridge_pulsar_pubsub_schema.producer_pulsar_message.desc = "渲染 Pulsar 消息的模版。"
emqx_bridge_pulsar_pubsub_schema.producer_pulsar_message.label = "Pulsar 消息模版"
emqx_bridge_pulsar_pubsub_schema.producer_sync_timeout.desc = "同步发布时等待从 Pulsar 接收回执的最大等待时间。"
emqx_bridge_pulsar_pubsub_schema.producer_sync_timeout.label = "同步发布超时"
emqx_bridge_pulsar_pubsub_schema.producer_value_template.desc = "渲染 Pulsar 消息值的模版。"
emqx_bridge_pulsar_pubsub_schema.producer_value_template.label = "消息的值"
emqx_bridge_pulsar_pubsub_schema.publisher_action.desc = "发布消息到 Pulsar 主题。"
emqx_bridge_pulsar_pubsub_schema.publisher_action.label = "发布动作"
emqx_bridge_quasardb_action_schema.action_parameters.desc = "动作的参数集合。"
emqx_bridge_quasardb_action_schema.action_parameters.label = "QuasarDB 动作参数"
emqx_bridge_quasardb_action_schema.health_check_table.desc = "用于动作健康检查的表名。目前无法直接从 SQL 推断表名。若设置此值，将在动作健康检查期间使用 `SHOW TABLE <table>` 语句探测表是否存在。"
emqx_bridge_quasardb_action_schema.health_check_table.label = "用于健康检查的表名"
emqx_bridge_quasardb_action_schema.quasardb.desc = "将传入事件追加到 QuasarDB 的动作。"
emqx_bridge_quasardb_action_schema.quasardb.label = "上传到 QuasarDB"
emqx_bridge_quasardb_action_schema.sql.desc = "用于插入数据的 SQL。支持 `${clientid}` 等占位符变量。\n\n注意：QuasarDB ODBC 驱动不支持预处理语句。因此，任何已知解析为 `STRING` 或 `BLOB` 类型的值，必须在 SQL 查询中手动加引号（`'`）。"
emqx_bridge_quasardb_action_schema.sql.label = "SQL"
emqx_bridge_quasardb_connector_schema.cluster_public_key.desc = "集群公钥（如有）。"
emqx_bridge_quasardb_connector_schema.cluster_public_key.label = "集群公钥"
