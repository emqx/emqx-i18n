emqx_gcp_device_api.expires_at.label = "过期时间"
emqx_gcp_device_api.gcp_device.desc = "使用 GCP 设备作为认证数据源的认证器配置。"
emqx_gcp_device_api.gcp_device_all_info.desc = "关于 GCP 设备的完整信息，包括创建时间"
emqx_gcp_device_api.gcp_device_all_info.label = "GCP 设备所有信息"
emqx_gcp_device_api.gcp_device_delete.desc = "移除一个从 GCP IoT Core 导入的设备"
emqx_gcp_device_api.gcp_device_delete.label = "移除 GCP 设备"
