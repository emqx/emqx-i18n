emqx_ocpp_schema.message_format_checking.desc = "Whether to enable message format legality checking.\nEMQX checks the message format of the upload stream and download stream against the\nformat defined in json-schema.\nWhen the check fails, emqx will reply with a corresponding answer message.\n\nThe checking strategy can be one of the following values:\n- <code>all</code>: check all messages\n- <code>upstream_only</code>: check upload stream messages only\n- <code>dnstream_only</code>: check download stream messages only\n- <code>disable</code>: don't check any messages"
emqx_ocpp_schema.upstream_error_topic.desc = "The topic for Upload stream error topic."
emqx_ocpp_schema.upstream_reply_topic.desc = "The topic for Upload stream Reply messages."
emqx_ocpp_schema.upstream_topic.desc = "The topic for Upload stream Call Request messages."
emqx_ocpp_schema.upstream_topic_override_mapping.desc = "Upload stream topic override mapping by Message Name."
emqx_ocpp_schema.ws.desc = "Websocket listener."
emqx_ocpp_schema.wss.desc = "Websocket over TLS listener."
emqx_oracle.role.desc = "Select which role to use to link to the Oracle database.<br/>- <code>normal</code>: Does not use any special roles<br/>- <code>sysdba</code>: System database administrator role with advanced privileges"
emqx_oracle.role.label = "Role"
