emqx_mt_schema.config.label = "Multi-tenancy"
emqx_mt_schema.default_max_sessions.desc = "The default number of live sessions allowed for each namespace.\nAccess will be denied for new clients if limit is reached.\nOnline config changes do not affect running sessions."
emqx_mt_schema.default_max_sessions.label = "Default Max Number of Sessions"
emqx_mysql.server.desc = "The IPv4 or IPv6 address or the hostname to connect to.<br/>\nA host entry has the following form: `Host[:Port]`.<br/>\nThe MySQL default port 3306 is used if `[:Port]` is not specified."
