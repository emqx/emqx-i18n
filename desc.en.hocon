emqx_bridge_gcp_pubsub.attributes_template.desc = "The template for formatting the outgoing message attributes.  Undefined values will be rendered as empty string values.  Empty keys are removed from the attribute map."
emqx_bridge_gcp_pubsub.attributes_template.label = "Attributes template"
emqx_bridge_gcp_pubsub.connect_timeout.desc = "The timeout when connecting to the HTTP server."
emqx_bridge_gcp_pubsub.connect_timeout.label = "Connect Timeout"
emqx_bridge_gcp_pubsub.consumer.desc = "GCP PubSub Consumer configuration."
emqx_bridge_gcp_pubsub.consumer.label = "GCP PubSub Consumer"
emqx_bridge_gcp_pubsub.consumer_mqtt_payload.desc = "The template for transforming the incoming GCP PubSub message.  By default, it will use JSON format to serialize inputs from the GCP PubSub message.  Available fields are:\n<code>message_id</code>: the message ID assigned by GCP PubSub.\n<code>publish_time</code>: message timestamp assigned by GCP PubSub.\n<code>topic</code>: GCP PubSub topic.\n<code>value</code>: the payload of the GCP PubSub message.  Omitted if there's no payload.\n<code>attributes</code>: an object containing string key-value pairs.  Omitted if there are no attributes.\n<code>ordering_key</code>: GCP PubSub message ordering key.  Omitted if there's none."
emqx_bridge_gcp_pubsub.consumer_mqtt_payload.label = "Payload Template"
emqx_bridge_gcp_pubsub.consumer_mqtt_qos.desc = "MQTT QoS level applied when publishing messages that are consumed from GCP PubSub."
emqx_bridge_gcp_pubsub.consumer_mqtt_qos.label = "QoS"
emqx_bridge_gcp_pubsub.consumer_mqtt_topic.desc = "Local topic to which consumed GCP PubSub messages should be published to."
emqx_bridge_gcp_pubsub.consumer_mqtt_topic.label = "MQTT Topic"
emqx_bridge_gcp_pubsub.consumer_opts.desc = "Local MQTT publish and GCP PubSub consumer configs."
emqx_bridge_gcp_pubsub.consumer_opts.label = "GCP PubSub to MQTT"
emqx_bridge_gcp_pubsub.consumer_pubsub_topic.desc = "GCP PubSub topic to consume from."
emqx_bridge_gcp_pubsub.consumer_pubsub_topic.label = "GCP PubSub"
emqx_bridge_gcp_pubsub.consumer_pull_max_messages.desc = "The maximum number of messages to retrieve from GCP PubSub in a single pull request. The actual number may be less than the specified value."
emqx_bridge_gcp_pubsub.consumer_pull_max_messages.label = "Maximum Messages to Pull"
emqx_bridge_gcp_pubsub.consumer_topic_mapping.desc = "Defines the mapping between GCP PubSub topics and MQTT topics. Must contain at least one item."
emqx_bridge_gcp_pubsub.consumer_topic_mapping.label = "Topic Mapping"
emqx_bridge_gcp_pubsub.desc_config.desc = "Configuration for a GCP PubSub bridge."
emqx_bridge_gcp_pubsub.desc_config.label = "GCP PubSub Configuration"
emqx_bridge_gcp_pubsub.desc_name.desc = "Action name, used as a human-readable identifier."
emqx_bridge_gcp_pubsub.desc_name.label = "Action Name"
emqx_bridge_gcp_pubsub.desc_type.desc = "The action type."
emqx_bridge_gcp_pubsub.desc_type.label = "Action Type"
emqx_bridge_gcp_pubsub.kv_pair_desc.desc = "Key-value pair."
emqx_bridge_gcp_pubsub.kv_pair_desc.label = "Key-value pair"
emqx_bridge_gcp_pubsub.kv_pair_key.desc = "Key"
emqx_bridge_gcp_pubsub.kv_pair_key.label = "Key"
emqx_bridge_gcp_pubsub.kv_pair_value.desc = "Value"
emqx_bridge_gcp_pubsub.kv_pair_value.label = "Value"
emqx_bridge_gcp_pubsub.local_topic.desc = "The MQTT topic filter to be forwarded to GCP PubSub. All MQTT 'PUBLISH' messages with the topic\nmatching `local_topic` will be forwarded.<br/>\nNOTE: if this bridge is used as the action of a rule (EMQX rule engine), and also local_topic is\nconfigured, then both the data got from the rule and the MQTT messages that match local_topic\nwill be forwarded."
emqx_bridge_gcp_pubsub.local_topic.label = "Local Topic"
emqx_bridge_gcp_pubsub.max_retries.desc = "Max retry times if an error occurs when sending a request."
emqx_bridge_gcp_pubsub.max_retries.label = "Max Retries"
emqx_bridge_gcp_pubsub.ordering_key_template.desc = "The template for formatting the outgoing message ordering key.  Undefined values will be rendered as empty string values.  This value will not be added to the message if it's empty."
emqx_bridge_gcp_pubsub.ordering_key_template.label = "Ordering Key template"
emqx_bridge_gcp_pubsub.payload_template.desc = "The template for formatting the outgoing messages.  If undefined, will send all the available context in JSON format."
emqx_bridge_gcp_pubsub.payload_template.label = "Payload template"
emqx_bridge_gcp_pubsub.pipelining.desc = "A positive integer. Whether to send HTTP requests continuously, when set to 1, it means that after each HTTP request is sent, you need to wait for the server to return and then continue to send the next request."
emqx_bridge_gcp_pubsub.pipelining.label = "HTTP Pipelining"
emqx_bridge_gcp_pubsub.pool_size.desc = "The pool size."
emqx_bridge_gcp_pubsub.pool_size.label = "Pool Size"
emqx_bridge_gcp_pubsub.producer_attributes.desc = "List of key-value pairs representing templates to construct the attributes for a given GCP PubSub message.  Both keys and values support the placeholder `${var_name}` notation.  Keys that are undefined or resolve to an empty string are omitted from the attribute map."
emqx_bridge_gcp_pubsub.producer_attributes.label = "Attributes Template"
emqx_bridge_gcp_pubsub.producer_ordering_key.desc = "Template for the Ordering Key of a given GCP PubSub message.  If the resolved value is undefined or an empty string, the ordering key property is omitted from the message."
emqx_bridge_gcp_pubsub.producer_ordering_key.label = "Ordering Key Template"
emqx_bridge_gcp_pubsub.pubsub_topic.desc = "The GCP PubSub topic to publish messages to."
emqx_bridge_gcp_pubsub.pubsub_topic.label = "GCP PubSub Topic"
emqx_bridge_gcp_pubsub.service_account_json.desc = "JSON containing the GCP Service Account credentials to be used with PubSub.\nWhen a GCP Service Account is created (as described in https://developers.google.com/identity/protocols/oauth2/service-account#creatinganaccount), you have the option of downloading the credentials in JSON form.  That's the file needed."
emqx_bridge_gcp_pubsub.service_account_json.label = "GCP Service Account Credentials"
