emqx_mt_api.managed_ns_list.desc = "List all managed namespaces\nThe namespaces are sorted in lexicographical order,\nso this API can be used for prefix based fuzzy search."
emqx_mt_api.managed_ns_list.label = "List managed namespaces"
emqx_mt_api.ns_list.desc = "List all namespaces\nThe namespaces are sorted in lexicographical order,\nso this API can be used for prefix based fuzzy search."
emqx_mt_api.ns_list.label = "List Namespaces"
