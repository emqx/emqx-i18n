emqx_bridge_pulsar.auth_basic.desc = "Parameters for basic authentication."
emqx_bridge_pulsar.auth_basic.label = "Basic auth parameters"
emqx_bridge_pulsar.auth_basic_password.desc = "Basic authentication password. The `password` part of the `username:password` authentication string."
emqx_bridge_pulsar.auth_basic_password.label = "Password"
emqx_bridge_pulsar.auth_basic_username.desc = "Basic authentication username. The `username` part of the `username:password` authentication string."
emqx_bridge_pulsar.auth_basic_username.label = "Username"
emqx_bridge_pulsar.auth_token.desc = "Parameters for token authentication."
emqx_bridge_pulsar.auth_token.label = "Token auth params"
emqx_bridge_pulsar.auth_token_jwt.desc = "JWT authentication token."
emqx_bridge_pulsar.auth_token_jwt.label = "JWT"
emqx_bridge_pulsar.authentication.desc = "Authentication configs."
emqx_bridge_pulsar.authentication.label = "Authentication"
emqx_bridge_pulsar.buffer_memory_overload_protection.desc = "Applicable when buffer mode is set to <code>memory</code>\nEMQX will drop old buffered messages under high memory pressure.\nThe high memory threshold is defined in config <code>sysmon.os.sysmem_high_watermark</code>.\n NOTE: This config only works on Linux."
emqx_bridge_pulsar.buffer_memory_overload_protection.label = "Memory Overload Protection"
emqx_bridge_pulsar.buffer_mode.desc = "Message buffer mode.\n<code>memory</code>: Buffer all messages in memory. The messages will be lost\n in case of EMQX node restart\\n<code>disk</code>: Buffer all messages on disk.\n The messages on disk are able to survive EMQX node restart.\n<code>hybrid</code>: Buffer message in memory first, when up to certain limit\n (see <code>segment_bytes</code> config for more information), then start offloading\n messages to disk, Like <code>memory</code> mode, the messages will be lost in\n case of EMQX node restart."
emqx_bridge_pulsar.buffer_mode.label = "Buffer Mode"
emqx_bridge_pulsar.buffer_per_partition_limit.desc = "Number of bytes allowed to buffer for each Pulsar partition.\n When this limit is exceeded, old messages will be dropped in a trade for credits\n for new messages to be buffered."
emqx_bridge_pulsar.buffer_per_partition_limit.label = "Per-partition Buffer Limit"
emqx_bridge_pulsar.buffer_segment_bytes.desc = "Applicable when buffer mode is set to <code>disk</code> or <code>hybrid</code>.\nThis value is to specify the size of each on-disk buffer file."
emqx_bridge_pulsar.buffer_segment_bytes.label = "Segment File Bytes"
emqx_bridge_pulsar.config_connector.desc = "Pulsar connector config"
emqx_bridge_pulsar.config_connector.label = "Pulsar Connector"
emqx_bridge_pulsar.config_enable.desc = "Enable (true) or disable (false) this Pulsar bridge."
emqx_bridge_pulsar.config_enable.label = "Enable or Disable"
emqx_bridge_pulsar.connect_timeout.desc = "Maximum wait time for TCP connection establishment (including authentication time if enabled)."
emqx_bridge_pulsar.connect_timeout.label = "Connect Timeout"
emqx_bridge_pulsar.connector_resource_opts.desc = "Pulsar connector resource options"
emqx_bridge_pulsar.connector_resource_opts.label = "Resource Options"
emqx_bridge_pulsar.desc_name.desc = "Bridge name, used as a human-readable description of the bridge."
emqx_bridge_pulsar.desc_name.label = "Bridge Name"
emqx_bridge_pulsar.desc_type.desc = "The Bridge Type"
emqx_bridge_pulsar.desc_type.label = "Bridge Type"
emqx_bridge_pulsar.producer_batch_size.desc = "Maximum number of individual requests to batch in a Pulsar message."
emqx_bridge_pulsar.producer_batch_size.label = "Batch size"
emqx_bridge_pulsar.producer_buffer.desc = "Configure producer message buffer.\"\nTell Pulsar producer how to buffer messages when EMQX has more messages to\"\n send than Pulsar can keep up, or when Pulsar is down."
emqx_bridge_pulsar.producer_buffer.label = "Message Buffer"
emqx_bridge_pulsar.producer_compression.desc = "Compression method."
emqx_bridge_pulsar.producer_compression.label = "Compression"
emqx_bridge_pulsar.producer_local_topic.desc = "MQTT topic or topic filter as data source (bridge input)\n If rule action is used as data source, this config should be left empty,\n otherwise messages will be duplicated in Pulsar."
emqx_bridge_pulsar.producer_local_topic.label = "Source MQTT Topic"
emqx_bridge_pulsar.producer_max_batch_bytes.desc = "Maximum bytes to collect in a Pulsar message batch. Most of the Pulsar brokers\n default to a limit of 5 MB batch size. EMQX's default value is less than 5 MB in\n order to compensate Pulsar message encoding overheads (especially when each individual\n message is very small). When a single message is over the limit, it is still\n sent (as a single element batch)."
emqx_bridge_pulsar.producer_max_batch_bytes.label = "Max Batch Bytes"
emqx_bridge_pulsar.producer_pulsar_topic.desc = "Pulsar topic name"
emqx_bridge_pulsar.producer_pulsar_topic.label = "Pulsar topic name"
emqx_bridge_pulsar.producer_retention_period.desc = "The amount of time messages will be buffered while there is no connection to\n the Pulsar broker.  Longer times mean that more memory/disk will be used"
emqx_bridge_pulsar.producer_retention_period.label = "Retention Period"
emqx_bridge_pulsar.producer_send_buffer.desc = "Fine tune the socket send buffer. The default value is tuned for high throughput."
emqx_bridge_pulsar.producer_send_buffer.label = "Socket Send Buffer Size"
emqx_bridge_pulsar.producer_strategy.desc = "Partition strategy is to tell the producer how to dispatch messages to Pulsar partitions.\n\n<code>random</code>: Randomly pick a partition for each message.\n<code>roundrobin</code>: Pick each available producer in turn for each message.\n<code>key_dispatch</code>: Hash Pulsar message key of the first message in a batch\n to a partition number."
emqx_bridge_pulsar.producer_strategy.label = "Partition Strategy"
emqx_bridge_pulsar.pulsar_producer_struct.desc = "Configuration for a Pulsar bridge."
emqx_bridge_pulsar.pulsar_producer_struct.label = "Pulsar Bridge Configuration"
emqx_bridge_pulsar.servers.desc = "A comma separated list of Pulsar URLs in the form <code>scheme://host[:port]</code>\n for the client to connect to. The supported schemes are <code>pulsar://</code> (default)\n and <code>pulsar+ssl://</code>. The default port is 6650."
emqx_bridge_pulsar.servers.label = "Servers"
emqx_bridge_pulsar_pubsub_schema.action_parameters.desc = "Action specific configs."
emqx_bridge_pulsar_pubsub_schema.action_parameters.label = "Action"
emqx_bridge_pulsar_pubsub_schema.producer_key_template.desc = "Template to render Pulsar message key."
emqx_bridge_pulsar_pubsub_schema.producer_key_template.label = "Message Key"
emqx_bridge_pulsar_pubsub_schema.producer_max_inflight.desc = "The maximum number of message batches that the producer can send to each partition before it must wait for a receipt.\nSetting a higher number can enhance throughput."
emqx_bridge_pulsar_pubsub_schema.producer_max_inflight.label = "Max Inflight"
emqx_bridge_pulsar_pubsub_schema.producer_message_opts.desc = "Template to render a Pulsar message."
emqx_bridge_pulsar_pubsub_schema.producer_message_opts.label = "Pulsar Message Template"
emqx_bridge_pulsar_pubsub_schema.producer_pulsar_message.desc = "Template to render a Pulsar message."
emqx_bridge_pulsar_pubsub_schema.producer_pulsar_message.label = "Pulsar Message Template"
emqx_bridge_pulsar_pubsub_schema.producer_sync_timeout.desc = "Maximum wait time for receiving a receipt from Pulsar when publishing synchronously."
emqx_bridge_pulsar_pubsub_schema.producer_sync_timeout.label = "Sync publish timeout"
emqx_bridge_pulsar_pubsub_schema.producer_value_template.desc = "Template to render Pulsar message value."
emqx_bridge_pulsar_pubsub_schema.producer_value_template.label = "Message Value"
emqx_bridge_pulsar_pubsub_schema.publisher_action.desc = "Publish message to Pulsar topic"
emqx_bridge_pulsar_pubsub_schema.publisher_action.label = "Publish Action "
emqx_bridge_rabbitmq.config_enable.desc = "Enable or disable this bridge"
emqx_bridge_rabbitmq.config_enable.label = "Enable or Disable Bridge"
emqx_bridge_rabbitmq.desc_config.desc = "Configuration for a RabbitMQ bridge."
emqx_bridge_rabbitmq.desc_config.label = "RabbitMQ Bridge Configuration"
emqx_bridge_rabbitmq.desc_name.desc = "Bridge name."
emqx_bridge_rabbitmq.desc_name.label = "Bridge Name"
emqx_bridge_rabbitmq.desc_type.desc = "The Bridge Type"
emqx_bridge_rabbitmq.desc_type.label = "Bridge Type"
emqx_bridge_rabbitmq.local_topic.desc = "The MQTT topic filter to be forwarded to RabbitMQ. All MQTT 'PUBLISH' messages with the topic matching the local_topic will be forwarded.\n    NOTE: if this bridge is used as the action of a rule (EMQX rule engine), and also local_topic is configured, then both the data got from the rule and the MQTT messages that match local_topic will be forwarded."
emqx_bridge_rabbitmq.local_topic.label = "Local Topic"
emqx_bridge_rabbitmq_connector_schema.auto_reconnect.desc = "The interval for attempting to reconnect to the RabbitMQ server if the connection is lost."
emqx_bridge_rabbitmq_connector_schema.auto_reconnect.label = "Auto Reconnect"
emqx_bridge_rabbitmq_connector_schema.config_connector.desc = "The configuration for the RabbitMQ connector."
emqx_bridge_rabbitmq_connector_schema.config_connector.label = "RabbitMQ Connector Configuration"
emqx_bridge_rabbitmq_connector_schema.connector_resource_opts.desc = "Connector resource options."
emqx_bridge_rabbitmq_connector_schema.connector_resource_opts.label = "Connector Resource Options"
emqx_bridge_rabbitmq_connector_schema.delivery_mode.desc = "The delivery mode for messages published to RabbitMQ. Delivery mode non_persistent (1) is suitable for messages that don't require persistence across RabbitMQ restarts, whereas delivery mode persistent (2) is designed for messages that must survive RabbitMQ restarts."
emqx_bridge_rabbitmq_connector_schema.delivery_mode.label = "Message Delivery Mode"
emqx_bridge_rabbitmq_connector_schema.exchange.desc = "The name of the RabbitMQ exchange where the messages will be sent. Supports templates (e.g.: `e-${payload.e}`). Leave blank and configure `routing_key` to the specified Queue to use RabbitMQ's default Exchange."
emqx_bridge_rabbitmq_connector_schema.exchange.label = "Exchange"
emqx_bridge_rabbitmq_connector_schema.exchange_type.desc = "The type of the RabbitMQ exchange (direct, fanout, or topic)."
emqx_bridge_rabbitmq_connector_schema.exchange_type.label = "Exchange Type"
emqx_bridge_rabbitmq_connector_schema.heartbeat.desc = "The interval for sending heartbeat messages to the RabbitMQ server."
emqx_bridge_rabbitmq_connector_schema.heartbeat.label = "Heartbeat"
emqx_bridge_rabbitmq_connector_schema.password.desc = "The password used to authenticate with the RabbitMQ server."
emqx_bridge_rabbitmq_connector_schema.password.label = "Password"
emqx_bridge_rabbitmq_connector_schema.payload_template.desc = "The template for formatting the payload of the message before sending it to RabbitMQ. Template placeholders, such as ${field1.sub_field}, will be substituted with the respective field's value. When left empty, the entire input message will be used as the payload, formatted as a JSON text. This behavior is equivalent to specifying ${.} as the payload template."
emqx_bridge_rabbitmq_connector_schema.payload_template.label = "Payload Template"
emqx_bridge_rabbitmq_connector_schema.pool_size.desc = "The size of the connection pool."
emqx_bridge_rabbitmq_connector_schema.pool_size.label = "Pool Size"
emqx_bridge_rabbitmq_connector_schema.port.desc = "The port number on which the RabbitMQ server is listening (default is 5672)."
emqx_bridge_rabbitmq_connector_schema.port.label = "Port"
emqx_bridge_rabbitmq_connector_schema.publish_confirmation_timeout.desc = "The timeout for waiting for RabbitMQ to confirm message publication when using publisher confirms."
emqx_bridge_rabbitmq_connector_schema.publish_confirmation_timeout.label = "Publish Confirmation Timeout"
emqx_bridge_rabbitmq_connector_schema.routing_key.desc = "The routing key used to route messages to the correct queue in the RabbitMQ exchange. Supports templates (e.g.: `k-${payload.r}`)."
emqx_bridge_rabbitmq_connector_schema.routing_key.label = "Routing Key"
emqx_bridge_rabbitmq_connector_schema.server.desc = "The RabbitMQ server address that you want to connect to (for example, localhost)."
emqx_bridge_rabbitmq_connector_schema.server.label = "Server"
emqx_bridge_rabbitmq_connector_schema.timeout.desc = "The timeout for waiting on the connection to be established."
emqx_bridge_rabbitmq_connector_schema.timeout.label = "Connection Timeout"
emqx_bridge_rabbitmq_connector_schema.username.desc = "The username used to authenticate with the RabbitMQ server."
emqx_bridge_rabbitmq_connector_schema.username.label = "Username"
emqx_bridge_rabbitmq_connector_schema.virtual_host.desc = "The virtual host to use when connecting to the RabbitMQ server."
emqx_bridge_rabbitmq_connector_schema.virtual_host.label = "Virtual Host"
emqx_bridge_rabbitmq_connector_schema.wait_for_publish_confirmations.desc = "A boolean value that indicates whether to wait for RabbitMQ to confirm message publication when using publisher confirms."
emqx_bridge_rabbitmq_connector_schema.wait_for_publish_confirmations.label = "Wait for Publish Confirmations"
emqx_bridge_rabbitmq_pubsub_schema.action_parameters.desc = "The action config defines how this bridge send messages to the remote RabbitMQ broker"
emqx_bridge_rabbitmq_pubsub_schema.action_parameters.label = "Action Parameters"
emqx_bridge_rabbitmq_pubsub_schema.publisher_action.desc = "Action configs."
emqx_bridge_rabbitmq_pubsub_schema.publisher_action.label = "Action"
emqx_bridge_rabbitmq_pubsub_schema.source_no_ack.desc = "Whether to use no_ack mode when consuming messages from the RabbitMQ broker."
emqx_bridge_rabbitmq_pubsub_schema.source_no_ack.label = "Source No Ack"
emqx_bridge_rabbitmq_pubsub_schema.source_parameters.desc = "The source config defines how this bridge receive messages from the remote RabbitMQ broker"
emqx_bridge_rabbitmq_pubsub_schema.source_parameters.label = "Source Parameters"
emqx_bridge_rabbitmq_pubsub_schema.source_queue.desc = "The queue name of the RabbitMQ broker."
emqx_bridge_rabbitmq_pubsub_schema.source_queue.label = "Source Queue"
emqx_bridge_rabbitmq_pubsub_schema.subscriber_source.desc = "Source configs."
emqx_bridge_rabbitmq_pubsub_schema.subscriber_source.label = "Source"
emqx_bridge_redis.command_template.desc = "Redis command template used to export messages. Each list element stands for a command name or its argument.\nFor example, to push payloads in a Redis list by key `msgs`, the elements should be the following:\n`rpush`, `msgs`, `${payload}`."
emqx_bridge_redis.command_template.label = "Redis Command Template"
emqx_bridge_redis.config_enable.desc = "Enable or disable this action ."
emqx_bridge_redis.config_enable.label = "Enable Or Disable Action"
emqx_bridge_redis.desc_action_parameters.desc = "The parameters of the action."
emqx_bridge_redis.desc_action_parameters.label = "Action Parameters"
emqx_bridge_redis.desc_config.desc = "Configuration for a Redis action."
emqx_bridge_redis.desc_config.label = "Redis Action Configuration"
emqx_bridge_redis.desc_local_topic.desc = "The MQTT topic filter to be forwarded to Redis. All MQTT 'PUBLISH' messages with the topic\nmatching the local_topic will be forwarded.<br/>\nNOTE: If this action is used as the action of a rule (EMQX rule engine), and also local_topic is\nconfigured, then both the data got from the rule and the MQTT messages that match local_topic\nwill be forwarded."
emqx_bridge_redis.desc_local_topic.label = "Local Topic"
emqx_bridge_redis.desc_name.desc = "Action name, used as a human-readable identifier."
emqx_bridge_redis.desc_name.label = "Action Name"
emqx_bridge_redis.desc_type.desc = "The Action Type"
emqx_bridge_redis.desc_type.label = "Action Type"
emqx_bridge_redis.redis_type.desc = "Single mode. Must be set to 'single' when Redis server is running in single mode.\nSentinel mode. Must be set to 'sentinel' when Redis server is running in sentinel mode.\nCluster mode. Must be set to 'cluster' when Redis server is running in clustered mode."
emqx_bridge_redis.redis_type.label = "Redis Type"
emqx_bridge_redis_schema.batch_size.desc = "This parameter defines the upper limit of the batch count.\nSetting this value to 1 effectively disables batching, as it indicates that only one item will be processed per batch.\nNote on Redis Cluster Mode:\nIn the context of Redis Cluster Mode, it is important to note that batching is not supported.\nConsequently, the batch_size is always set to 1,\nreflecting the mode inherent limitation in handling batch operations."
emqx_bridge_redis_schema.batch_size.label = "Batch Size"
emqx_bridge_redis_schema.batch_time.desc = "Maximum waiting interval when accumulating a batch at a low message rates for more efficient resource usage."
emqx_bridge_redis_schema.batch_time.label = "Max batch wait time, disable when in Redis Cluster Mode."
emqx_bridge_redis_schema.producer_action.desc = "The parameters of the action."
emqx_bridge_redis_schema.producer_action.label = "Action Parameters"
emqx_bridge_redis_schema.redis_action.desc = "Action to interact with a Redis connector."
emqx_bridge_redis_schema.redis_action.label = "Redis Action"
emqx_bridge_redis_schema.redis_parameters.desc = "Set of parameters specific for the given type of this Redis connector, `redis_type` can be one of `single`, `cluster` or `sentinel`."
emqx_bridge_redis_schema.redis_parameters.label = "Redis Type Specific Parameters"
