emqx_jt808_schema.authentication_url.desc = "The JT/T 808 device authentication central URL."
emqx_jt808_schema.ignore_unsupported_frames.desc = "Whether to ignore unsupported frames. <br/>\n- <code>true</code>, unsupported frames will be logged and ignored. <br/>\n- <code>false</code>, the gateway will disconnect the client when receiving an unsupported frame.<br/>\nThe default value is true."
emqx_jt808_schema.jt808_allow_anonymous.desc = "Allow anonymous access to the JT/T 808 Gateway."
emqx_jt808_schema.jt808_auth.desc = "Authentication settings of the JT/T 808 Gateway."
emqx_jt808_schema.jt808_dn_topic.desc = "The topic of the JT/T 808 protocol downstream message."
emqx_jt808_schema.jt808_frame_max_length.desc = "The maximum length of the JT/T 808 frame."
emqx_jt808_schema.jt808_up_topic.desc = "The topic of the JT/T 808 protocol upstream message."
