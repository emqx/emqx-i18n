emqx_rule_api_schema.metrics_actions_failed.desc = "How many times the rule failed to call the actions."
emqx_rule_api_schema.metrics_actions_failed.label = "Failed Action"
emqx_rule_api_schema.metrics_actions_failed_out_of_service.desc = "How many times the rule has failed to call actions due to the action is out of service. For example, a bridge is disabled or stopped."
emqx_rule_api_schema.metrics_actions_failed_out_of_service.label = "Fail Action"
emqx_rule_api_schema.metrics_actions_failed_unknown.desc = "The number of action failures that have occurred due to unanticipated reasons. For more information on these errors, please refer to the EMQX log file."
emqx_rule_api_schema.metrics_actions_failed_unknown.label = "Unknown Failures"
emqx_rule_api_schema.metrics_actions_success.desc = "How many times the rule successided to call the actions."
emqx_rule_api_schema.metrics_actions_success.label = "Success Action"
emqx_rule_api_schema.metrics_actions_total.desc = "How many times the actions are called by the rule. This value may several times of 'matched', depending on the number of the actions of the rule."
emqx_rule_api_schema.metrics_actions_total.label = "Action Total"
emqx_rule_api_schema.metrics_sql_failed.desc = "How many times the SQL statement has failed"
emqx_rule_api_schema.metrics_sql_failed.label = "SQL Failed"
emqx_rule_api_schema.metrics_sql_failed_exception.desc = "How many times the SQL is failed due to exceptions. This may because of a crash when calling a SQL function, or trying to do arithmetic operation on undefined variables"
emqx_rule_api_schema.metrics_sql_failed_exception.label = "SQL Exception"
emqx_rule_api_schema.metrics_sql_failed_unknown.desc = "How many times the SQL is failed due to an unknown error."
emqx_rule_api_schema.metrics_sql_failed_unknown.label = "SQL Unknown Error"
emqx_rule_api_schema.metrics_sql_matched.desc = "How many times the FROM clause of the SQL is matched."
emqx_rule_api_schema.metrics_sql_matched.label = "Matched"
emqx_rule_api_schema.metrics_sql_matched_rate.desc = "The rate of matched, times/second"
emqx_rule_api_schema.metrics_sql_matched_rate.label = "Matched Rate"
emqx_rule_api_schema.metrics_sql_matched_rate_last5m.desc = "The average rate of matched in last 5 minutes, times/second"
emqx_rule_api_schema.metrics_sql_matched_rate_last5m.label = "Average Matched Rate"
emqx_rule_api_schema.metrics_sql_matched_rate_max.desc = "The max rate of matched, times/second"
emqx_rule_api_schema.metrics_sql_matched_rate_max.label = "Max Matched Rate"
emqx_rule_api_schema.metrics_sql_passed.desc = "How many times the SQL is passed"
emqx_rule_api_schema.metrics_sql_passed.label = "SQL Passed"
