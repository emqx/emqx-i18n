emqx_jt808_schema.registry_url.desc = "The JT/T 808 device registry central URL."
emqx_jt808_schema.retry_interval.desc = "Re-send time interval"
emqx_ldap.base_dn.desc = "The name of the base object entry (or possibly the root) relative to\nwhich the Search is to be performed."
emqx_ldap.base_dn.label = "Base DN"
emqx_ldap.bind_password.desc = "The template for password to bind."
emqx_ldap.bind_password.label = "Bind Password"
emqx_ldap.filter.desc = "The filter that defines the conditions that must be fulfilled in order\nfor the Search to match a given entry.<br>\nThe syntax of the filter follows RFC 4515 and also supports placeholders."
emqx_ldap.filter.label = "Filter"
emqx_ldap.request_timeout.desc = "Sets the maximum time in milliseconds that is used for each individual request."
emqx_ldap.request_timeout.label = "Request Timeout"
emqx_ldap.server.desc = "The IPv4 or IPv6 address or the hostname to connect to.<br/>\nA host entry has the following form: `Host[:Port]`.<br/>\nThe LDAP default port 389 is used if `[:Port]` is not specified."
emqx_ldap.server.label = "Server Host"
emqx_license_http_api.desc_license_info_api.desc = "Get license info"
emqx_license_http_api.desc_license_info_api.label = "License info"
emqx_license_http_api.desc_license_key_api.desc = "Update a license key"
emqx_license_http_api.desc_license_key_api.label = "Update license"
emqx_license_http_api.desc_license_setting_api.desc = "Update license setting"
emqx_license_http_api.desc_license_setting_api.label = "Update license setting"
emqx_license_schema.connection_high_watermark_field.desc = "High watermark limit above which license connection quota usage alarms are activated"
emqx_license_schema.connection_high_watermark_field.label = "Connection high watermark"
emqx_license_schema.connection_low_watermark_field.desc = "Low watermark limit below which license connection quota usage alarms are deactivated"
emqx_license_schema.connection_low_watermark_field.label = "Connection low watermark"
emqx_license_schema.dynamic_max_connections.desc = "Only applicable for \"Business Critical\" license type. This config sets the current allocation of license for the current cluster.\nThis value cannot exceed the connections limit assigned in the license key."
emqx_license_schema.dynamic_max_connections.label = "Dynamic Connections Limit"
emqx_license_schema.key_field.desc = "This configuration parameter is designated for the license key and supports below input formats:\n\n- Direct Key: Enter the secret key directly as a string value.\n- File Path: Specify the path to a file that contains the secret key. Ensure the path starts with `file://`.\n- \"default\": Use string value `default` to apply the default single-node community license.\n- \"evaluation\": Use string value `evaluation` to apply the 25-connection limit evaluation license.\n\nNote: An invalid license key or an incorrect file path may prevent EMQX from starting successfully.\nIf a file path is used, EMQX attempts to reload the license key from the file every 2 minutes.\nAny failure in reloading the license file will be recorded as an error level log message,\nand EMQX continues to apply the license loaded previously."
emqx_license_schema.key_field.label = "License string"
emqx_license_schema.license_root.desc = "Defines the EMQX Enterprise license.\n\nEMQX is initially provided with a default single-node community license.\nThe default license is not permitted for commercial use.\n\nApply for an official license here: https://www.emqx.com/apply-licenses/emqx?version=5"
emqx_license_schema.license_root.label = "License"
emqx_limiter_schema.bytes_burst.desc = "Additional number of bytes that can be sent in a burst.\n\nFor example: `100MB/60m`: Once in 60 minutes, up to 100 megabytes can be sent in a short period of time."
emqx_limiter_schema.bytes_burst.label = "Data Publish Burst"
emqx_limiter_schema.bytes_rate.desc = "Used to limit the number of bytes a single client can send to EMQX per second.\n\nOnce the limit is reached, EMQX will drop QoS 0 messages and reject QoS 1 and QoS 2 messages\nwith \"Quota Exceeded\" error code (0x97).\n\nThe unit of the bytes could be: B, KB, MB, GB.\n\nFor example:\n\n- `500KB/s`: Only 500 kilobytes per second will be received, and the remaining bytes will be dropped/rejected.\n- `500MB/10s`: Only 500 megabytes will be received every 10 seconds, and the remaining bytes will be dropped/rejected."
emqx_limiter_schema.bytes_rate.label = "Data Publish Rate"
emqx_limiter_schema.max_conn_burst.desc = "Number of connections that can be accepted in a burst.\n\nFor example: `10000/60m`: Once in 60 minutes, up to 10000 connections can be accepted in a short period of time."
emqx_limiter_schema.max_conn_burst.label = "Maximum Connection Burst"
emqx_limiter_schema.max_conn_rate.desc = "Used to limit the rate at which the current listener accepts connections.\n\nOnce the limit is reached, EMQX will pause fetching connections from the Accept queue, thereby delaying or rejecting new connections.\n\nFor example:\n\n- `1000/s`: Only accepts 1000 connections per second.\n- `1000/10s`: Only accepts 1000 connections every 10 seconds."
emqx_limiter_schema.max_conn_rate.label = "Maximum Connection Rate"
emqx_limiter_schema.messages_burst.desc = "Additional number of messages that can be sent in a burst.\n\nFor example: `10000/60m`: Once in 60 minutes, up to 10000 messages can be sent in a short period of time."
emqx_limiter_schema.messages_burst.label = "Messages Publish Burst"
emqx_limiter_schema.messages_rate.desc = "Used to limit the number of messages a single client can send to EMQX per second.\n\nOnce the limit is reached, EMQX will drop QoS 0 messages and reject QoS 1 and QoS 2 messages\nwith \"Quota Exceeded\" error code (0x97).\n\nFor example:\n\n- `500/s`: Only 500 messages will be received per second, and the remaining messages will be dropped/rejected.\n- `500/10s`: Only 500 messages will be received every 10 seconds and the remaining messages will be dropped/rejected."
emqx_limiter_schema.messages_rate.label = "Messages Publish Rate"
emqx_limiter_schema.mqtt.desc = "MQTT related limiters."
emqx_lwm2m_api.dataType.desc = "Data Type"
emqx_lwm2m_api.lookup_resource.desc = "Look up a resource"
emqx_lwm2m_api.name.desc = "Resource Name"
emqx_lwm2m_api.observe_resource.desc = "Observe or Cancel observe a resource"
emqx_lwm2m_api.operations.desc = "Resource Operations"
emqx_lwm2m_api.path.desc = "Resource Path"
emqx_lwm2m_api.read_resource.desc = "Send a read command to a resource"
emqx_lwm2m_api.write_resource.desc = "Send a write command to a resource"
emqx_lwm2m_schema.lwm2m.desc = "The LwM2M Gateway configuration. This gateway only supports the v1.0.1 protocol."
emqx_lwm2m_schema.lwm2m_auto_observe.desc = "Automatically observe the object list of REGISTER packet."
emqx_lwm2m_schema.lwm2m_lifetime_max.desc = "Maximum value of lifetime allowed to be set by the LwM2M client."
emqx_lwm2m_schema.lwm2m_lifetime_min.desc = "Minimum value of lifetime allowed to be set by the LwM2M client."
emqx_lwm2m_schema.lwm2m_qmode_time_window.desc = "The value of the time window during which the network link is considered valid by the LwM2M Gateway in QMode mode.\nFor example, after receiving an update message from a client, any messages within this time window are sent directly to the LwM2M client, and all messages beyond this time window are temporarily stored in memory."
emqx_lwm2m_schema.lwm2m_translators.desc = "Topic configuration for LwM2M's gateway publishing and subscription."
emqx_lwm2m_schema.lwm2m_translators_command.desc = "The topic for receiving downstream commands.\nFor each new LwM2M client that succeeds in going online, the gateway creates a subscription relationship to receive downstream commands and send it to the LwM2M client"
emqx_lwm2m_schema.lwm2m_translators_notify.desc = "The topic for gateway to publish the notify events from LwM2M client.\nAfter succeed observe a resource of LwM2M client, Gateway will send the notify events via this topic, if the client reports any resource changes"
emqx_lwm2m_schema.lwm2m_translators_register.desc = "The topic for gateway to publish the register events from LwM2M client."
emqx_lwm2m_schema.lwm2m_translators_response.desc = "The topic for gateway to publish the acknowledge events from LwM2M client"
