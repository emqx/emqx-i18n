emqx_bridge_greptimedb.greptimedb_action.desc = "Action to interact with a GreptimeDB connector"
emqx_bridge_greptimedb.greptimedb_action.label = "GreptimeDB Action"
emqx_bridge_greptimedb.local_topic.desc = "The MQTT topic filter to be forwarded to the GreptimeDB. All MQTT 'PUBLISH' messages with the topic\nmatching the local_topic will be forwarded.<br/>\nNOTE: If this Sink is used as the action of a rule (EMQX rule engine), and also local_topic is\nconfigured, then both the data got from the rule and the MQTT messages that match local_topic\nwill be forwarded."
emqx_bridge_greptimedb.local_topic.label = "Local Topic"
emqx_bridge_greptimedb.write_syntax.desc = "Conf of GreptimeDB gRPC protocol to write data points. Write syntax is a text-based format that provides the measurement, tag set, field set, and timestamp of a data point, and placeholder supported, which is the same as InfluxDB line protocol.\nSee also [InfluxDB 2.3 Line Protocol](https://docs.influxdata.com/influxdb/v2.3/reference/syntax/line-protocol/) and\n[GreptimeDB 1.8 Line Protocol](https://docs.influxdata.com/influxdb/v1.8/write_protocols/line_protocol_tutorial/) <br/>\nTLDR:<br/>\n```\n<measurement>[,<tag_key>=<tag_value>[,<tag_key>=<tag_value>]] <field_key>=<field_value>[,<field_key>=<field_value>] [<timestamp>]\n```\nPlease note that a placeholder for an integer value must be annotated with a suffix `i`. For example `${payload.int_value}i`."
emqx_bridge_greptimedb.write_syntax.label = "Write Syntax"
emqx_bridge_greptimedb_connector.dbname.desc = "GreptimeDB database."
emqx_bridge_greptimedb_connector.dbname.label = "Database"
emqx_bridge_greptimedb_connector.greptimedb.desc = "GreptimeDB's protocol. Support GreptimeDB v1.8 and before."
emqx_bridge_greptimedb_connector.greptimedb.label = "HTTP API Protocol"
emqx_bridge_greptimedb_connector.password.desc = "GreptimeDB password."
emqx_bridge_greptimedb_connector.password.label = "Password"
emqx_bridge_greptimedb_connector.precision.desc = "GreptimeDB time precision."
emqx_bridge_greptimedb_connector.precision.label = "Time Precision"
emqx_bridge_greptimedb_connector.protocol.desc = "GreptimeDB's protocol. gRPC API."
emqx_bridge_greptimedb_connector.protocol.label = "Protocol"
emqx_bridge_greptimedb_connector.server.desc = "The IPv4 or IPv6 address or the hostname to connect to.<br/>\nA host entry has the following form: `Host[:Port]`.<br/>\nThe GreptimeDB default port 8086 is used if `[:Port]` is not specified."
emqx_bridge_greptimedb_connector.server.label = "Server Host"
