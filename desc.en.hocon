emqx_bridge_iotdb.creation_opts.label = "Creation Options"
emqx_bridge_iotdb.desc_config.desc = "Configuration for Apache IoTDB bridge."
emqx_bridge_iotdb.desc_config.label = "IoTDB Bridge Configuration"
