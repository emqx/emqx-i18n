emqx_bridge_tablestore.desc_measurement.desc = "The measurement. It can either be a static value or a placeholder like `${payload.measurement}`."
emqx_bridge_tablestore.desc_measurement.label = "Measurement"
emqx_bridge_tablestore.desc_meta_update_model.desc = "The update mode for time-series metadata. Can be one of:\n- MUM_NORMAL: Normal mode. When sending messages in this mode, Tablestore will create the timeseries metadata if not exits.\n- MUM_IGNORE: Do not update metadata. When sending messages in this mode, Tablestore will not try to create the timeseries metadata.\nDefaults to MUM_NORMAL"
emqx_bridge_tablestore.desc_meta_update_model.label = "Meta Update Model"
emqx_bridge_tablestore.desc_table_name.desc = "Table name. It can either be a static value or a placeholder like `${payload.table_name}`."
emqx_bridge_tablestore.desc_table_name.label = "Table Name"
emqx_bridge_tablestore.desc_tags.desc = "Tags. The tag key and tag value can either be static strings or a placeholder like `${payload.tag_key}` and `${payload.tag_value}`."
emqx_bridge_tablestore.desc_tags.label = "Tags"
emqx_bridge_tablestore.desc_timestamp.desc = "The timestamp in microsecond of the field.\nIt can either be a static value or a placeholder like `${payload.microsecond_timestamp}`.\nIf not provided or set to `NOW`, the millisecond timestamp when EMQX writes to Tablestore will be used."
emqx_bridge_tablestore.desc_timestamp.label = "Timestamp"
emqx_bridge_tablestore.pool_size.desc = "The pool size."
emqx_bridge_tablestore.pool_size.label = "Pool Size"
emqx_bridge_tablestore.storage_model_type.desc = "Storage model type. Can be one of `timeseries` or `order`."
emqx_bridge_tablestore.storage_model_type.label = "Storage Model Type"
emqx_bridge_tablestore.tablestore_action.desc = "Action to interact with a Tablestore connector"
emqx_bridge_tablestore.tablestore_action.label = "Tablestore Action"
emqx_bridge_tablestore.tablestore_fields.desc = "Tablestore fields."
emqx_bridge_tablestore.tablestore_fields.label = "Tablestore Fields"
emqx_bridge_tablestore.tablestore_fields_column.desc = "Column name of the field. It can either be a static value or a placeholder like `${payload.column}`"
emqx_bridge_tablestore.tablestore_fields_column.label = "Column"
emqx_bridge_tablestore.tablestore_fields_isbinary.desc = "~Whether try to write binary values as `binary` type. Defaults to `false`, means that write binary values as strings.\nIt can either be a static value or a placeholder like `${payload.is_binary}`.~"
emqx_bridge_tablestore.tablestore_fields_isbinary.label = "Is Binary"
emqx_bridge_tablestore.tablestore_fields_isint.desc = "Whether try to write numeric value as `integer`. Defaults to `false`, means that write integers as floats.\nIt can either be a static value or a placeholder like `${payload.is_int}`."
emqx_bridge_tablestore.tablestore_fields_isint.label = "Is Int"
emqx_bridge_tablestore.tablestore_fields_value.desc = "Value of the field. It can either be a static value or a placeholder like `${payload.value}`"
emqx_bridge_tablestore.tablestore_fields_value.label = "Value"
emqx_bridge_tdengine.action_parameters.desc = "TDengine action parameters"
emqx_bridge_tdengine.action_parameters.label = "Parameters"
emqx_bridge_tdengine.config_enable.desc = "Enable or disable this bridge"
emqx_bridge_tdengine.config_enable.label = "Enable Or Disable Bridge"
emqx_bridge_tdengine.desc_config.desc = "Configuration for a TDengine bridge."
emqx_bridge_tdengine.desc_config.label = "TDengine Bridge Configuration"
emqx_bridge_tdengine.desc_name.desc = "Bridge name."
emqx_bridge_tdengine.desc_name.label = "Bridge Name"
emqx_bridge_tdengine.desc_type.desc = "The Bridge Type"
emqx_bridge_tdengine.desc_type.label = "Bridge Type"
emqx_bridge_tdengine.local_topic.desc = "The MQTT topic filter to be forwarded to TDengine. All MQTT 'PUBLISH' messages with the topic\nmatching the local_topic will be forwarded.<br/>\nNOTE: if this bridge is used as the action of a rule (EMQX rule engine), and also local_topic is\nconfigured, then both the data got from the rule and the MQTT messages that match local_topic\nwill be forwarded."
emqx_bridge_tdengine.local_topic.label = "Local Topic"
emqx_bridge_tdengine.sql_template.desc = "SQL Template"
emqx_bridge_tdengine.sql_template.label = "SQL Template"
emqx_bridge_tdengine_connector.desc_config.desc = "Configuration for TDengine Connector."
emqx_bridge_tdengine_connector.desc_config.label = "TDengine Connector Configuration"
emqx_bridge_tdengine_connector.server.desc = "The IPv4 or IPv6 address or the hostname to connect to.<br/>\nA host entry has the following form: `Host[:Port]`.<br/>\nThe TDengine default port 6041 is used if `[:Port]` is not specified.<br/>\nThis field also supports an HTTPS URLs to connect to the TDengine Cloud. For example: `https://gw.us-west-2.aws.cloud.tdengine.com `"
emqx_bridge_tdengine_connector.server.label = "Server Host"
emqx_bridge_tdengine_connector.token.desc = "The token used when connecting to TDengine Cloud. <br/>\nIf this value is provided, it will override the authentication method of Username and Password.<br/>\nDefault is empty."
emqx_bridge_v2_api.actions_summary.desc = "Summarize actions."
emqx_bridge_v2_api.desc_api1.desc = "List all created bridges."
emqx_bridge_v2_api.desc_api1.label = "List All Bridges"
emqx_bridge_v2_api.desc_api10.desc = "Lists the available action types."
emqx_bridge_v2_api.desc_api10.label = "List action types"
emqx_bridge_v2_api.desc_api11.desc = "Lists the available source types."
emqx_bridge_v2_api.desc_api11.label = "List source types"
emqx_bridge_v2_api.desc_api2.desc = "Create a new bridge by type and name."
emqx_bridge_v2_api.desc_api2.label = "Create Bridge"
emqx_bridge_v2_api.desc_api3.desc = "Get a bridge by id."
emqx_bridge_v2_api.desc_api3.label = "Get Bridge"
emqx_bridge_v2_api.desc_api4.desc = "Update a bridge by id."
