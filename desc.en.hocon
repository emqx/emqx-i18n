emqx_bridge_iotdb.auth_basic.label = "Basic auth params"
emqx_bridge_iotdb.config_auth_basic_password.desc = "The password as configured at the IoTDB REST interface"
emqx_bridge_iotdb.config_auth_basic_password.label = "HTTP Basic Auth Password"
emqx_bridge_iotdb.config_auth_basic_username.desc = "The username as configured at the IoTDB REST interface"
emqx_bridge_iotdb.config_auth_basic_username.label = "HTTP Basic Auth Username"
emqx_bridge_iotdb.config_authentication.desc = "Authentication configuration"
emqx_bridge_iotdb.config_authentication.label = "Authentication"
emqx_bridge_iotdb.config_base_url.desc = "The base URL of the external IoTDB service's REST interface."
emqx_bridge_iotdb.config_base_url.label = "IoTDB REST Service Base URL"
emqx_bridge_iotdb.config_device_id.desc = "The IoTDB device ID this data should be inserted for.\nIf left empty, the MQTT message payload must contain a `device_id` field,\nor EMQX's rule-engine SQL must produce a `device_id` field."
emqx_bridge_iotdb.config_device_id.label = "Device ID"
emqx_bridge_iotdb.config_enable.desc = "Enable or disable this bridge"
emqx_bridge_iotdb.config_enable.label = "Enable Or Disable Bridge"
emqx_bridge_iotdb.config_iotdb_version.desc = "The version of the IoTDB system to connect to."
emqx_bridge_iotdb.config_iotdb_version.label = "IoTDB Version"
emqx_bridge_iotdb.config_is_aligned.desc = "Whether to align the timeseries"
emqx_bridge_iotdb.config_is_aligned.label = "Align Timeseries"
emqx_bridge_iotdb.config_max_retries.desc = "HTTP request max retry times if failed."
emqx_bridge_iotdb.config_max_retries.label = "HTTP Request Max Retries"
emqx_bridge_iotdb.config_parameters_data_type.desc = "Data Type, can be:\n\n- text\n- boolean\n- int32\n- int64\n- float\n- double"
emqx_bridge_iotdb.config_parameters_data_type.label = "Data type"
emqx_bridge_iotdb.config_parameters_measurement.desc = "Measurement. Placeholders in format of ${var} is supported"
emqx_bridge_iotdb.config_parameters_measurement.label = "Measurement"
emqx_bridge_iotdb.config_parameters_timestamp.desc = "Timestamp. Placeholders in format of ${var} is supported, can be:\n\n- now: use the current time in milliseconds\n- now_ms: same as above\n- now_us: use the current time in microseconds\n- now_ns: use the current time in nanoseconds\n- any integer: use the value directly as the timestamp\n- Placeholder: use the value from the payload as the timestamp"
emqx_bridge_iotdb.config_parameters_timestamp.label = "Timestamp"
emqx_bridge_iotdb.config_parameters_value.desc = "Value. Placeholders in format of ${var} is supported"
emqx_bridge_iotdb.config_parameters_value.label = "Value"
