emqx_ds_shared_sub_api.durable_queues_get.desc = "Get the list of durable queues."
emqx_ds_shared_sub_api.durable_queues_get.label = "Durable Queues"
emqx_ds_shared_sub_api.durable_queues_post.desc = "Declare new durable queue."
emqx_ds_shared_sub_api.durable_queues_post.label = "Declare Durable Queue"
emqx_ds_shared_sub_api.param_queue_id.desc = "The ID of the durable queue."
emqx_ds_shared_sub_api.param_queue_id.label = "Queue ID"
emqx_ds_shared_sub_schema.enable.desc = "Enable the shared subscription feature."
emqx_ds_shared_sub_schema.enable.label = "Enable Shared Subscription"
emqx_ds_shared_sub_schema.leader_periodical_actions_interval.desc = "The interval in milliseconds for the leader to perform periodical actions."
emqx_ds_shared_sub_schema.leader_periodical_actions_interval.label = "Leader Periodical Actions Interval"
emqx_ds_shared_sub_schema.leader_renew_streams_interval.desc = "The interval in milliseconds for the leader to renew the streams."
emqx_ds_shared_sub_schema.leader_renew_streams_interval.label = "Leader Renew Streams Interval"
emqx_ds_shared_sub_schema.session_find_leader_timeout.desc = "The timeout in milliseconds for the session to find a leader.\nIf the session cannot find a leader within this time, the session will retry."
emqx_ds_shared_sub_schema.session_find_leader_timeout.label = "Session Find Leader Timeout"
emqx_ds_shared_sub_schema.session_ping_leader_interval.desc = "The interval in milliseconds for the session to ping the leader."
emqx_ds_shared_sub_schema.session_ping_leader_interval.label = "Session Ping Leader Interval"
emqx_ds_shared_sub_schema.session_ping_leader_timeout.desc = "The timeout in milliseconds for the session to wait for the leader to respond to the ping.\nIf the leader does not respond to the ping within this time, the session will consider\nthe leader as lost and try to find a new leader."
emqx_ds_shared_sub_schema.session_ping_leader_timeout.label = "Session Ping Leader Timeout"
emqx_ds_shared_sub_schema.session_unsubscribe_timeout.desc = "The timeout in milliseconds for the session to wait for the streams to reach\nconsistent state that may be reported to the leader. If the timeout is reached,\nthe session will send the latest known consistent state to the leader."
emqx_ds_shared_sub_schema.session_unsubscribe_timeout.label = "Session Unsubscribe Timeout"
