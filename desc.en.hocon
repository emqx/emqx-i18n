emqx_bridge_greptimedb.connector.label = "GreptimeDB Connector"
emqx_bridge_greptimedb.desc_config.desc = "Configuration for an GreptimeDB action."
emqx_bridge_greptimedb.desc_config.label = "GreptimeDB Action Configuration"
emqx_bridge_greptimedb.desc_name.desc = "The name of the action."
