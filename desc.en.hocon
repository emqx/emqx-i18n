emqx_bridge_v2_api.desc_api6.desc = "Reset a bridge metrics by id."
emqx_bridge_v2_api.desc_api6.label = "Reset Bridge Metrics"
emqx_bridge_v2_api.desc_api7.desc = "Start bridge on all nodes in the cluster."
emqx_bridge_v2_api.desc_api7.label = "Cluster Bridge Operation"
emqx_bridge_v2_api.desc_api8.desc = "Start bridge on a specific node."
emqx_bridge_v2_api.desc_api8.label = "Node Bridge Operation"
emqx_bridge_v2_api.desc_api9.desc = "Test creating a new bridge."
emqx_bridge_v2_api.desc_api9.label = "Test Bridge Creation"
emqx_bridge_v2_api.desc_bridge_metrics.desc = "Get bridge metrics by id."
emqx_bridge_v2_api.desc_bridge_metrics.label = "Get Bridge Metrics"
emqx_bridge_v2_api.desc_enable_bridge.desc = "Enable or Disable bridge on all nodes in the cluster."
emqx_bridge_v2_api.desc_enable_bridge.label = "Cluster Bridge Enable"
emqx_bridge_v2_api.desc_param_path_enable.desc = "Whether to enable this bridge."
emqx_bridge_v2_api.desc_param_path_enable.label = "Enable bridge"
emqx_bridge_v2_api.desc_param_path_id.desc = "The bridge id. Must be of format {type}:{name}."
emqx_bridge_v2_api.desc_param_path_id.label = "Bridge ID"
emqx_bridge_v2_api.desc_param_path_node.desc = "The node name, e.g. 'emqx@127.0.0.1'."
emqx_bridge_v2_api.desc_param_path_node.label = "The node name"
emqx_bridge_v2_api.desc_param_path_operation_cluster.desc = "Operation can be one of: 'start'."
emqx_bridge_v2_api.desc_param_path_operation_cluster.label = "Cluster Operation"
emqx_bridge_v2_api.desc_param_path_operation_on_node.desc = "Operation can be one of: 'start'."
emqx_bridge_v2_api.desc_param_path_operation_on_node.label = "Node Operation"
emqx_bridge_v2_api.desc_qs_also_delete_dep_actions.desc = "Whether to cascade delete dependent actions."
emqx_bridge_v2_api.desc_qs_also_delete_dep_actions.label = "Cascade delete dependent actions?"
emqx_bridge_v2_api.sources_summary.desc = "Summarize actions."
emqx_bridge_v2_schema.config_enable.desc = "Enable (true) or disable (false) this action."
emqx_bridge_v2_schema.config_enable.label = "Enable or Disable"
emqx_bridge_v2_schema.desc_bridges_v2.desc = "Configuration for actions."
emqx_bridge_v2_schema.desc_bridges_v2.label = "Action Configuration"
emqx_bridge_v2_schema.desc_sources.desc = "Configuration for sources."
emqx_bridge_v2_schema.desc_sources.label = "Source Configuration"
emqx_bridge_v2_schema.fallback_action_kind.desc = "Fallback kind."
emqx_bridge_v2_schema.fallback_action_kind.label = "Kind"
emqx_bridge_v2_schema.fallback_action_reference.desc = "A fallback Action that will be triggered if a query to this action fails.  The same message context that triggered the primary action will be sent unmodified to the fallbacks."
emqx_bridge_v2_schema.fallback_action_reference.label = "Fallback Action"
emqx_bridge_v2_schema.fallback_action_reference_name.desc = "Fallback Action name."
emqx_bridge_v2_schema.fallback_action_reference_name.label = "Name"
emqx_bridge_v2_schema.fallback_action_reference_type.desc = "Fallback Action type."
emqx_bridge_v2_schema.fallback_action_reference_type.label = "Type"
emqx_bridge_v2_schema.fallback_action_republish.desc = "Republish fallback action.  Works the same way as the Republish rule action from Rule Engine."
emqx_bridge_v2_schema.fallback_action_republish.label = "Republish"
emqx_bridge_v2_schema.fallback_actions.desc = "List of fallback actions that will be triggered if a query to this action fails."
emqx_bridge_v2_schema.fallback_actions.label = "Fallback Actions"
emqx_bridge_v2_schema.mqtt_topic.desc = "MQTT topic or topic filter as data source (action input).  If rule action is used as data source, this config should be left empty, otherwise messages will be duplicated in the remote system."
emqx_bridge_v2_schema.mqtt_topic.label = "Source MQTT Topic"
emqx_bridge_v2_schema.undefined_vars_as_null.desc = "When writing to databases, treat undefined variables as NULL.\nWhen this option is enabled, if undefined variables (like ${var}) are used in templates, they will be replaced with \"NULL\" instead of the string \"undefined\". If this option is not enabled (default), the string \"undefined\" might be inserted.\nThis option should always be `true` if possible; the default value `false` is only to ensure backward compatibility."
emqx_bridge_v2_schema.undefined_vars_as_null.label = "Undefined Vars as Null"
emqx_cluster_link_schema.clientid.desc = "Optional Base MQTT client ID for connecting to the remote EMQX cluster. If omitted, local `cluster.name` is used. EMQX maintains several connections between linked clusters, so distinct suffixes are automatically appended to the base client ID."
emqx_cluster_link_schema.clientid.label = "Base Client ID"
emqx_cluster_link_schema.enable.desc = "Enable or disable a cluster link. The link is enabled by default, disabling it allows stopping the link without removing its configuration. The link must be enabled on both sides to be operational. Disabling the link should also be done on both clusters in order to free up all associated resources."
emqx_cluster_link_schema.enable.label = "Enable"
emqx_cluster_link_schema.link.desc = "Cluster link configuration"
emqx_cluster_link_schema.link.label = "Cluster Link"
emqx_cluster_link_schema.link_name.desc = "Linked (remote) cluster name. Must be exactly equal to the value of `cluster.name` configured at the remote cluster. Must not be equal to the local cluster.name. All configured cluster link names must be unique."
emqx_cluster_link_schema.link_name.label = "Linked Cluster Name"
emqx_cluster_link_schema.links.desc = "The list of the linked EMQX clusters."
emqx_cluster_link_schema.links.label = "Cluster Links"
emqx_cluster_link_schema.max_inflight.desc = "Max inflight (sent, but un-acked) messages of the MQTT protocol"
emqx_cluster_link_schema.max_inflight.label = "Max Inflight Message"
emqx_cluster_link_schema.password.desc = "Optional MQTT username for connecting to the remote EMQX cluster."
emqx_cluster_link_schema.password.label = "Password"
emqx_cluster_link_schema.pool_size.desc = "Size of the pool of MQTT clients that will publish messages to the linked EMQX broker."
emqx_cluster_link_schema.pool_size.label = "Connection Pool Size"
emqx_cluster_link_schema.server.desc = "MQTT host and port of the remote EMQX broker."
emqx_cluster_link_schema.server.label = "MQTT Server"
emqx_cluster_link_schema.ssl.desc = "SSL configuration for connecting to the remote EMQX cluster."
emqx_cluster_link_schema.ssl.label = "SSL Options"
emqx_cluster_link_schema.topics.desc = "MQTT topics to be forwarded by the linked remote EMQX broker to the local broker. Messages are only forwarded if the local EMQX broker has matching subscriber(s).\nWildcards are supported. Setting empty topics list on one side of the link can be used to establish unidirectional links: the side with the empty topics won't receive remote messages, but it can forward relevant messages to its linked counterpart (according to the topics configured on that side of the link)."
emqx_cluster_link_schema.topics.label = "Topics"
emqx_cluster_link_schema.username.desc = "Optional MQTT username for connecting to the remote EMQX cluster."
emqx_cluster_link_schema.username.label = "Username"
emqx_coap_api.content_type.desc = "Payload type"
emqx_coap_api.message_id.desc = "Message ID"
emqx_coap_api.method.desc = "Request method type"
emqx_coap_api.payload.desc = "The content of the payload"
emqx_coap_api.response_code.desc = "Response code"
emqx_coap_api.send_coap_request.desc = "Send a CoAP request message to the client"
emqx_coap_api.timeout.desc = "Timespan for response"
emqx_coap_api.token.desc = "Message token, can be empty"
emqx_coap_schema.coap.desc = "The CoAP Gateway configuration.\nThis gateway is implemented based on RFC-7252 and https://core-wg.github.io/coap-pubsub/draft-ietf-core-pubsub.html"
emqx_coap_schema.coap_connection_required.desc = "Enable or disable connection mode.\nConnection mode is a feature of non-standard protocols. When connection mode is enabled, it is necessary to maintain the creation, authentication and alive of connection resources"
emqx_coap_schema.coap_heartbeat.desc = "The gateway server required minimum heartbeat interval.\nWhen connection mode is enabled, this parameter is used to set the minimum heartbeat interval for the connection to be alive"
emqx_coap_schema.coap_notify_type.desc = "The Notification Message will be delivered to the CoAP client if a new message received on an observed topic.\nThe type of delivered coap message can be set to:<br/>\n  - non: Non-confirmable;<br/>\n  - con: Confirmable;<br/>\n  - qos: Mapping from QoS type of received message, QoS0 -> non, QoS1,2 -> con"
emqx_coap_schema.coap_publish_qos.desc = "The Default QoS Level indicator for publish request.\nThis option specifies the QoS level for the CoAP Client when publishing a message to EMQX PUB/SUB system, if the publish request is not carried `qos` option. The indicator can be set to:<br/>\n  - qos0, qos1, qos2: Fixed default QoS level<br/>\n  - coap: Dynamic QoS level by the message type of publish request<br/>\n    * qos0: If the publish request is non-confirmable<br/>\n    * qos1: If the publish request is confirmable"
emqx_coap_schema.coap_subscribe_qos.desc = "The Default QoS Level indicator for subscribe request.\nThis option specifies the QoS level for the CoAP Client when establishing a subscription membership, if the subscribe request is not carried `qos` option. The indicator can be set to:<br/>\n  - qos0, qos1, qos2: Fixed default QoS level<br/>\n  - coap: Dynamic QoS level by the message type of subscribe request<br/>\n    * qos0: If the subscribe request is non-confirmable<br/>\n    * qos1: If the subscribe request is confirmable"
emqx_conf_schema.audit_file_handler_path.desc = "Name the audit log file."
emqx_conf_schema.audit_file_handler_path.label = "Audit Log File Name"
emqx_conf_schema.audit_handler_level.desc = "The log level for the audit log handler.<br/>\n- Requests that take longer than 3 seconds to process are logged as <code>warning</code> logs.<br/>\n- GET requests with HTTP status codes between 200-300 are logged as <code>debug</code> logs.<br/>\n- Non-GET Requests with HTTP status codes between 200-300 are logged as <code>info</code> logs.<br/>\n- Requests with HTTP status codes between 300-400 are logged as <code>warning</code> logs.<br/>\n- Requests with HTTP status codes between 400-500 are logged as <code>error</code> logs.<br/>\n- Defaults to info."
emqx_conf_schema.audit_handler_level.label = "Log Level"
emqx_conf_schema.audit_log_ignore_high_frequency_request.desc = "Ignore high frequency requests to avoid flooding the audit log,\nsuch as publish/subscribe kick out http api requests are ignored."
emqx_conf_schema.audit_log_ignore_high_frequency_request.label = "Ignore High Frequency Request"
emqx_conf_schema.audit_log_max_filter_limit.desc = "Store the latest N log entries in a database for allow `/audit` HTTP API to filter and retrieval of log data.\nThe interval for purging redundant log records is maintained within a range of 10~20 seconds."
emqx_conf_schema.audit_log_max_filter_limit.label = "Max Filter Limit"
emqx_conf_schema.authorization.desc = "Authorization a.k.a. ACL.<br/>\nIn EMQX, MQTT client access control is extremely flexible.<br/>\nAn out-of-the-box set of authorization data sources are supported.\nFor example,<br/>\n'file' source is to support concise and yet generic ACL rules in a file;<br/>\n'built_in_database' source can be used to store per-client customizable rule sets,\nnatively in the EMQX node;<br/>\n'http' source to make EMQX call an external HTTP API to make the decision;<br/>\n'PostgreSQL' etc. to look up clients or rules from external databases"
emqx_conf_schema.authorization.label = "Authorization"
emqx_conf_schema.cluster_autoclean.desc = "Remove disconnected nodes from the cluster after this interval."
emqx_conf_schema.cluster_autoclean.label = "Cluster Auto Clean"
emqx_conf_schema.cluster_autoheal.desc = "If <code>true</code>, the node will try to heal network partitions automatically."
emqx_conf_schema.cluster_autoheal.label = "Cluster Auto Heal"
emqx_conf_schema.cluster_call_cleanup_interval.desc = "Time interval to clear completed but stale transactions.\nEnsure that the number of completed transactions is less than the <code>max_history</code>."
emqx_conf_schema.cluster_call_cleanup_interval.label = "Clean Up Interval"
emqx_conf_schema.cluster_call_max_history.desc = "Retain the maximum number of completed transactions (for queries)."
emqx_conf_schema.cluster_call_max_history.label = "Cluster Call Max History"
emqx_conf_schema.cluster_call_retry_interval.desc = "Time interval to retry after a failed call."
emqx_conf_schema.cluster_call_retry_interval.label = "Cluster Call Retry Interval"
emqx_conf_schema.cluster_discovery_strategy.desc = "Service discovery method for the cluster nodes. Possible values are:\n- manual: Use <code>emqx ctl cluster</code> command to manage cluster.<br/>\n- static: Configure static nodes list by setting <code>seeds</code> in config file.<br/>\n- dns: Use DNS A record to discover peer nodes.<br/>\n- etcd: Use etcd to discover peer nodes.<br/>\n- k8s: Use Kubernetes API to discover peer pods."
emqx_conf_schema.cluster_discovery_strategy.label = "Cluster Discovery Strategy"
emqx_conf_schema.cluster_dns_name.desc = "The domain name from which to discover peer EMQX nodes' IP addresses.\nApplicable when <code>cluster.discovery_strategy = dns</code>"
emqx_conf_schema.cluster_dns_name.label = "Cluster Dns Name"
emqx_conf_schema.cluster_dns_record_type.desc = "DNS record type."
emqx_conf_schema.cluster_dns_record_type.label = "DNS Record Type"
emqx_conf_schema.cluster_etcd_node_ttl.desc = "Expiration time of the etcd key associated with the node.\nIt is refreshed automatically, as long as the node is alive."
emqx_conf_schema.cluster_etcd_node_ttl.label = "Cluster Etcd Node TTL"
emqx_conf_schema.cluster_etcd_prefix.desc = "Key prefix used for EMQX service discovery."
emqx_conf_schema.cluster_etcd_prefix.label = "Cluster Etcd Prefix"
emqx_conf_schema.cluster_etcd_server.desc = "List of endpoint URLs of the etcd cluster"
emqx_conf_schema.cluster_etcd_server.label = "Cluster Etcd Server"
emqx_conf_schema.cluster_etcd_ssl.desc = "Options for the TLS connection to the etcd cluster."
emqx_conf_schema.cluster_etcd_ssl.label = "Cluster Etcd SSL Option"
emqx_conf_schema.cluster_k8s_address_type.desc = "Address type used for connecting to the discovered nodes.\nSetting <code>cluster.k8s.address_type</code> to <code>ip</code> will\nmake EMQX to discover IP addresses of peer nodes from Kubernetes API."
emqx_conf_schema.cluster_k8s_address_type.label = "K8s Address Type"
emqx_conf_schema.cluster_k8s_apiserver.desc = "Kubernetes API endpoint URL."
emqx_conf_schema.cluster_k8s_apiserver.label = "Cluster k8s ApiServer"
emqx_conf_schema.cluster_k8s_namespace.desc = "Kubernetes namespace."
emqx_conf_schema.cluster_k8s_namespace.label = "K8s Namespace"
emqx_conf_schema.cluster_k8s_service_name.desc = "EMQX broker service name."
emqx_conf_schema.cluster_k8s_service_name.label = "K8s Service Name"
emqx_conf_schema.cluster_k8s_suffix.desc = "Node name suffix.<br/>\nNote: this parameter is only relevant when <code>address_type</code> is <code>dns</code>\nor <code>hostname</code>."
emqx_conf_schema.cluster_k8s_suffix.label = "K8s Suffix"
emqx_conf_schema.cluster_name.desc = "Human-friendly name of the EMQX cluster."
emqx_conf_schema.cluster_name.label = "Cluster Name"
emqx_conf_schema.cluster_proto_dist.desc = "The Erlang distribution protocol for the cluster.<br/>\n- inet_tcp: IPv4 TCP <br/>\n- inet_tls: IPv4 TLS, works together with <code>etc/ssl_dist.conf</code> <br/>\n- inet6_tcp: IPv6 TCP <br/>\n- inet6_tls: IPv6 TLS, works together with <code>etc/ssl_dist.conf</code>"
emqx_conf_schema.cluster_proto_dist.label = "Cluster Protocol Distribution"
emqx_conf_schema.cluster_quic_lb_mode.desc = "QUIC stack LB Mode\n- 0: disabled (Default)\n- 1: server_ip\n- 2: server_id_fixed\n- N: when N>2 server_id_fixed and server_id is N\n- IfName: when IfName is string, server_id will be set to the first ip on interface IfName, ipv4 only."
emqx_conf_schema.cluster_quic_lb_mode.label = " QUIC stack LB Mode "
emqx_conf_schema.cluster_static_seeds.desc = "List EMQX node names in the static cluster. See <code>node.name</code>."
emqx_conf_schema.cluster_static_seeds.label = "Cluster Static Seeds"
emqx_conf_schema.common_handler_chars_limit.desc = "Set the maximum length of a single log message. If this length is exceeded, the log message will be truncated.\nWhen formatter is <code>json</code> the truncation is done on the JSON values, but not on the log message itself."
emqx_conf_schema.common_handler_chars_limit.label = "Single Log Max Length"
emqx_conf_schema.common_handler_drop_mode_qlen.desc = "When the number of buffered log events is larger than this value, the new log events are dropped.\nWhen drop mode is activated or deactivated, a message is printed in the logs."
emqx_conf_schema.common_handler_drop_mode_qlen.label = "Queue Length before Entering Drop Mode"
emqx_conf_schema.common_handler_enable.desc = "Enable this log handler."
emqx_conf_schema.common_handler_enable.label = "Enable Log Handler"
emqx_conf_schema.common_handler_flush_qlen.desc = "If the number of buffered log events grows larger than this threshold, a flush (delete) operation takes place.\nTo flush events, the handler discards the buffered log messages without logging."
emqx_conf_schema.common_handler_flush_qlen.label = "Flush Threshold"
emqx_conf_schema.common_handler_formatter.desc = "Choose log formatter. <code>text</code> for free text, and <code>json</code> for structured logging."
emqx_conf_schema.common_handler_formatter.label = "Log Formatter"
emqx_conf_schema.common_handler_level.desc = "The log level for the current log handler.\nDefaults to warning."
emqx_conf_schema.common_handler_level.label = "Log Level"
emqx_conf_schema.common_handler_max_depth.desc = "Maximum depth for Erlang term log formatting and Erlang process message queue inspection."
emqx_conf_schema.common_handler_max_depth.label = "Max Depth"
emqx_conf_schema.common_handler_single_line.desc = "Print logs in a single line if set to true. Otherwise, log messages may span multiple lines."
emqx_conf_schema.common_handler_single_line.label = "Single Line Mode"
emqx_conf_schema.common_handler_supervisor_reports.desc = "Type of supervisor reports that are logged. Defaults to <code>error</code><br/>\n  - <code>error</code>: only log errors in the Erlang processes<br/>.\n  - <code>progress</code>: log process startup."
emqx_conf_schema.common_handler_supervisor_reports.label = "Report Type"
emqx_conf_schema.common_handler_sync_mode_qlen.desc = "As long as the number of buffered log events is lower than this value,\nall log events are handled asynchronously. This means that the client process sending the log event,\nby calling a log function in the Logger API, does not wait for a response from the handler\nbut continues executing immediately after the event is sent.\nIt is not affected by the time it takes the handler to print the event to the log device.\nIf the message queue grows larger than this value,\nthe handler starts handling log events synchronously instead,\nmeaning that the client process sending the event must wait for a response.\nWhen the handler reduces the message queue to a level below the sync_mode_qlen threshold,\nasynchronous operation is resumed."
emqx_conf_schema.common_handler_sync_mode_qlen.label = "Queue Length before Entering Sync Mode"
emqx_conf_schema.common_handler_time_offset.desc = "The time offset to be used when formatting the timestamp.\nCan be one of:\n  - <code>system</code>: the time offset used by the local system\n  - <code>utc</code>: the UTC time offset\n  - <code>+-[hh]:[mm]</code>: user specified time offset, such as \"-02:00\" or \"+00:00\"\nDefaults to: <code>system</code>.\nThis config has no effect for when formatter is <code>json</code> as the timestamp in JSON is milliseconds since epoch."
emqx_conf_schema.common_handler_time_offset.label = "Time Offset"
emqx_conf_schema.common_handler_timestamp_format.desc = "Pick a timestamp format:\n- `auto`: automatically choose the best format based on log formatter. `epoch` for JSON and `rfc3339` for text.\n- `epoch`: Unix epoch time in microseconds.\n- `rfc3339`: RFC3339 format."
emqx_conf_schema.common_handler_timestamp_format.label = "Timestamp Format"
emqx_conf_schema.db_backend.desc = "Select the backend for the embedded database.<br/>\n<code>rlog</code> is the default backend,\nthat is suitable for very large clusters.<br/>\n<code>mnesia</code> is a backend that offers decent performance in small clusters."
emqx_conf_schema.db_backend.label = "DB Backend"
emqx_conf_schema.db_default_bootstrap_batch_size.desc = "The number of built-in database table records to be pushed in one chunk from a core node to a replicant node during bootstrap.\nThe bootstrapping occurs when a new replicant node is added to the cluster or an existing replicant node reconnects to a core one.\nIncreasing this value may greatly reduce a replicant node startup time, especially when EMQX cluster interconnect network latency is high\nand EMQX built-in database holds large amount of data, e.g. when the number of subscriptions is high.\nDefaults to 500."
emqx_conf_schema.db_default_bootstrap_batch_size.label = "Default Bootstrap Batch Size"
emqx_conf_schema.db_default_shard_transport.desc = "Defines the default transport for pushing transaction logs.<br/>\nThis may be overridden on a per-shard basis in <code>db.shard_transports</code>.\n<code>gen_rpc</code> uses the <code>gen_rpc</code> library,\n<code>distr</code> uses the Erlang distribution."
emqx_conf_schema.db_default_shard_transport.label = "Default Shard Transport"
emqx_conf_schema.db_role.desc = "Select a node role.<br/>\n<code>core</code> nodes provide durability of the data, and take care of writes.\nIt is recommended to place core nodes in different racks or different availability zones.<br/>\n<code>replicant</code> nodes are ephemeral worker nodes. Removing them from the cluster\ndoesn't affect database redundancy<br/>\nIt is recommended to have more replicant nodes than core nodes.<br/>\nNote: this parameter only takes effect when the <code>backend</code> is set\nto <code>rlog</code>."
emqx_conf_schema.db_role.label = "DB Role"
emqx_conf_schema.db_rpc_module.desc = "Protocol used for pushing transaction logs to the replicant nodes."
emqx_conf_schema.db_rpc_module.label = "RPC Module"
emqx_conf_schema.db_shard_transports.desc = "Allows to tune the transport method used for transaction log replication, on a per-shard basis.<br/>\n<code>gen_rpc</code> uses the <code>gen_rpc</code> library,\n<code>distr</code> uses the Erlang distribution.<br/>If not specified,\nthe default is to use the value set in <code>db.default_shard_transport</code>."
emqx_conf_schema.db_shard_transports.label = "Shard Transports"
emqx_conf_schema.db_tlog_push_mode.desc = "In sync mode the core node waits for an ack from the replicant nodes before sending the next\ntransaction log entry."
emqx_conf_schema.db_tlog_push_mode.label = "Tlog Push Mode"
emqx_conf_schema.desc_audit_log_handler.desc = "Audit log handler that prints log events to files."
emqx_conf_schema.desc_audit_log_handler.label = "Audit Log Handler"
emqx_conf_schema.desc_authorization.desc = "Settings that control client authorization."
emqx_conf_schema.desc_authorization.label = "Authorization"
emqx_conf_schema.desc_cluster.desc = "EMQX nodes can form a cluster to scale up the total capacity.<br/>\n      Here holds the configs to instruct how individual nodes can discover each other."
emqx_conf_schema.desc_cluster.label = "Cluster"
emqx_conf_schema.desc_cluster_call.desc = "Options for the 'cluster call' feature that allows to execute a callback on all nodes in the cluster."
emqx_conf_schema.desc_cluster_call.label = "Cluster Call"
emqx_conf_schema.desc_cluster_dns.desc = "Service discovery via DNS SRV records."
emqx_conf_schema.desc_cluster_dns.label = "Cluster DNS"
emqx_conf_schema.desc_cluster_etcd.desc = "Service discovery using 'etcd' service."
emqx_conf_schema.desc_cluster_etcd.label = "Cluster Etcd"
emqx_conf_schema.desc_cluster_k8s.desc = "Service discovery via Kubernetes API server."
emqx_conf_schema.desc_cluster_k8s.label = "Cluster Kubernetes"
emqx_conf_schema.desc_cluster_static.desc = "Service discovery via static nodes.\nThe new node joins the cluster by connecting to one of the bootstrap nodes."
emqx_conf_schema.desc_cluster_static.label = "Cluster Static"
emqx_conf_schema.desc_console_handler.desc = "Log handler that prints log events to the EMQX console."
emqx_conf_schema.desc_console_handler.label = "Console Handler"
emqx_conf_schema.desc_db.desc = "Settings for the embedded database."
emqx_conf_schema.desc_db.label = "Database"
emqx_conf_schema.desc_log.desc = "EMQX supports multiple log handlers, one console handler and multiple file handlers.\nEMQX by default logs to console when running in docker or in console/foreground mode,\notherwise it logs to file `${EMQX_LOG_DIR}/emqx.log.N`.\nFor advanced configuration, you can find more parameters in this section."
emqx_conf_schema.desc_log.label = "Log"
emqx_conf_schema.desc_log_burst_limit.desc = "Large bursts of log events produced in a short time can potentially cause problems, such as:\n - Log files grow very large\n - Log files are rotated too quickly, and useful information gets overwritten\n - Overall performance impact on the system\n\nLog burst limit feature can temporarily disable logging to avoid these issues."
emqx_conf_schema.desc_log_burst_limit.label = "Log Burst Limit"
emqx_conf_schema.desc_log_file_handler.desc = "Log handler that prints log events to files."
emqx_conf_schema.desc_log_file_handler.label = "Files Log Handler"
emqx_conf_schema.desc_log_overload_kill.desc = "Log overload kill features an overload protection that activates when the log handlers use too much memory or have too many buffered log messages.<br/>\nWhen the overload is detected, the log handler is terminated and restarted after a cooldown period."
emqx_conf_schema.desc_log_overload_kill.label = "Log Overload Kill"
emqx_conf_schema.desc_log_rotation.desc = "By default, the logs are stored in `./log` directory (for installation from zip file) or in `/var/log/emqx` (for binary installation).<br/>\nThis section of the configuration controls the number of files kept for each log handler."
emqx_conf_schema.desc_log_rotation.label = "Log Rotation"
emqx_conf_schema.desc_log_throttling.desc = "Log throttling feature reduces the number of potentially flooding logged events by\ndropping all but the first event within a configured time window.\nThe throttling is automatically disabled if `console` or `file` log level is set to debug."
emqx_conf_schema.desc_log_throttling.label = "Log Throttling"
emqx_conf_schema.desc_node.desc = "Node name, cookie, config & data directories and the Erlang virtual machine (BEAM) boot parameters."
emqx_conf_schema.desc_node.label = "Node"
emqx_conf_schema.desc_rpc.desc = "EMQX uses a library called <code>gen_rpc</code> for inter-broker communication.<br/>\nMost of the time the default config should work,\nbut in case you need to do performance fine-tuning or experiment a bit,\nthis is where to look."
emqx_conf_schema.desc_rpc.label = "RPC"
emqx_conf_schema.dist_buffer_size.desc = "Erlang's distribution buffer busy limit in kilobytes."
emqx_conf_schema.dist_buffer_size.label = "Erlang's dist buffer size(KB)"
emqx_conf_schema.log_audit_handler.desc = "Audit file-based log handler."
emqx_conf_schema.log_audit_handler.label = "Audit log Handler"
emqx_conf_schema.log_burst_limit_enable.desc = "Enable log burst control feature."
emqx_conf_schema.log_burst_limit_enable.label = "Enable Burst"
emqx_conf_schema.log_burst_limit_max_count.desc = "Maximum number of log events to handle within a `window_time` interval. After the limit is reached, successive events are dropped until the end of the `window_time`."
emqx_conf_schema.log_burst_limit_max_count.label = "Events Number"
emqx_conf_schema.log_burst_limit_window_time.desc = "See <code>max_count</code>."
emqx_conf_schema.log_burst_limit_window_time.label = "Window Time"
emqx_conf_schema.log_file_handler_file.desc = "Name the log file."
emqx_conf_schema.log_file_handler_file.label = "Log File Name"
emqx_conf_schema.log_file_handler_max_size.desc = "This parameter controls log file rotation. The value `infinity` means the log file will grow indefinitely, otherwise the log file will be rotated once it reaches `rotation_size` in bytes."
emqx_conf_schema.log_file_handler_max_size.label = "Rotation Size"
emqx_conf_schema.log_file_handlers.desc = "File-based log handlers."
emqx_conf_schema.log_file_handlers.label = "File Handler"
emqx_conf_schema.log_overload_kill_enable.desc = "Enable log handler overload kill feature."
emqx_conf_schema.log_overload_kill_enable.label = "Log Handler Overload Kill"
emqx_conf_schema.log_overload_kill_mem_size.desc = "Maximum memory size that the log handler process is allowed to use."
emqx_conf_schema.log_overload_kill_mem_size.label = "Log Handler Max Memory Size"
emqx_conf_schema.log_overload_kill_qlen.desc = "Maximum allowed queue length."
emqx_conf_schema.log_overload_kill_qlen.label = "Max Queue Length"
emqx_conf_schema.log_overload_kill_restart_after.desc = "The handler restarts automatically after a delay in the event of termination, unless the value `infinity` is set, which blocks any subsequent restarts."
emqx_conf_schema.log_overload_kill_restart_after.label = "Handler Restart Timer"
emqx_conf_schema.log_root.desc = "EMQX provides support for two primary log handlers: `file` and `console`, with an additional `audit` handler specifically designed to always direct logs to files.\nThe system's default log handling behavior can be configured via the environment variable `EMQX_DEFAULT_LOG_HANDLER`, which accepts the following settings:\n\n- `file`: Directs log output exclusively to files.\n- `console`: Channels log output solely to the console.\n\nIt's noteworthy that `EMQX_DEFAULT_LOG_HANDLER` is set to `file` when EMQX is initiated via systemd's `emqx.service` file.\nIn scenarios outside systemd initiation, `console` serves as the default log handler."
emqx_conf_schema.log_root.label = "log"
emqx_conf_schema.log_rotation_count.desc = "Maximum number of log files."
emqx_conf_schema.log_rotation_count.label = "Max Log Files Number"
emqx_conf_schema.log_rotation_enable.desc = "Enable log rotation feature."
emqx_conf_schema.log_rotation_enable.label = "Rotation Enable"
emqx_conf_schema.log_throttling_time_window.desc = "This configuration setting controls the logging behavior for throttled messages,\nincluding, but not limited to messages like 'authorization_permission_denied'.\nWithin each defined time window, only one instance of a throttled message will be logged to prevent log flooding.\nAt the conclusion of each time window, a summary log will be generated, detailing the occurrence of any throttled messages during that period.\nIt's important to note that the shortest effective time window for this setting is 1 second (`1s`).\nShould a value lower than `1s` be specified, it will automatically be adjusted to `1s`."
emqx_conf_schema.log_throttling_time_window.label = "Log Throttling Time Window"
emqx_conf_schema.max_ets_tables.desc = "Max number of ETS tables"
emqx_conf_schema.max_ets_tables.label = "Max number of ETS tables"
emqx_conf_schema.max_ports.desc = "Maximum number of simultaneously open files and sockets for this Erlang system.\nFor more information, see: https://www.erlang.org/doc/man/erl.html"
emqx_conf_schema.max_ports.label = "Erlang Port Limit"
emqx_conf_schema.node_applications.desc = "List of Erlang applications that shall be rebooted when the EMQX broker joins the cluster."
emqx_conf_schema.node_applications.label = "Application"
emqx_conf_schema.node_backtrace_depth.desc = "Maximum depth of the call stack printed in error messages and\n<code>process_info</code>."
emqx_conf_schema.node_backtrace_depth.label = "BackTrace Depth"
emqx_conf_schema.node_broker_pool_size.desc = "The number of workers in emqx_broker pool. Increasing this value may improve performance\nby enhancing parallelism, especially when EMQX cluster interconnect network latency is high.\nDefaults to the number of Erlang schedulers (CPU cores) * 2."
emqx_conf_schema.node_broker_pool_size.label = "Node Broker Pool Size"
emqx_conf_schema.node_channel_cleanup_batch_size.desc = "The size of the channel cleanup batch. if EMQX cluster interconnect network latency is high,\nreducing this value together with increasing node.generic_pool_size may improve performance\nduring an abrupt disconnect of a large numbers of clients.\nDefaults to 100000."
emqx_conf_schema.node_channel_cleanup_batch_size.label = "Node Channel Cleanup Batch Size"
emqx_conf_schema.node_cookie.desc = "Secret cookie is a random string that should be the same on all nodes in\nthe given EMQX cluster, but unique per EMQX cluster. It is used to prevent EMQX nodes that\nbelong to different clusters from accidentally connecting to each other."
emqx_conf_schema.node_cookie.label = "Node Cookie"
emqx_conf_schema.node_crash_dump_bytes.desc = "This variable sets the maximum size of a crash dump file in bytes.\nThe crash dump will be truncated if this limit is exceeded.\nIf setting it to 0, the runtime system does not even attempt to write a crash dump file."
emqx_conf_schema.node_crash_dump_bytes.label = "Crash Dump Bytes"
emqx_conf_schema.node_crash_dump_file.desc = "Location of the crash dump file. Defaults to <code>log/erl_crash.YYYY.MM.DD.HH.MM.SS.dump</code>.\nThe timestamp is generated when emqx starts."
emqx_conf_schema.node_crash_dump_file.label = "Crash Dump File"
emqx_conf_schema.node_crash_dump_seconds.desc = "This variable gives the number of seconds that the emulator is allowed to spend writing a crash dump. When the given number of seconds have elapsed, the emulator is terminated.<br/>\n- If setting to 0 seconds, the runtime system does not even attempt to write the crash dump file. It only terminates.<br/>\n- If setting to a positive value S, wait for S seconds to complete the crash dump file and then terminates the runtime system with a SIGALRM signal.<br/>\n- A negative value causes the termination of the runtime system to wait indefinitely until the crash dump file has been completely written."
emqx_conf_schema.node_crash_dump_seconds.label = "Crash Dump Seconds"
emqx_conf_schema.node_data_dir.desc = "Path to the persistent data directory.<br/>\nPossible auto-created subdirectories are:<br/>\n- `mnesia/<node_name>`: EMQX's built-in database directory.<br/>\nFor example, `mnesia/emqx@127.0.0.1`.<br/>\nThere should be only one such subdirectory.<br/>\nMeaning, in case the node is to be renamed (to e.g. `emqx@10.0.1.1`),<br/>\nthe old dir should be deleted first.<br/>\n- `configs`: Generated configs at boot time, and cluster/local override configs.<br/>\n- `patches`: Hot-patch beam files are to be placed here.<br/>\n- `trace`: Trace log files.<br/>\n\n**NOTE**: One data dir cannot be shared by two or more EMQX nodes."
emqx_conf_schema.node_data_dir.label = "Node Data Dir"
emqx_conf_schema.node_dist_net_ticktime.desc = "This is the approximate time an EMQX node may be unresponsive until it is considered down and thereby disconnected."
emqx_conf_schema.node_dist_net_ticktime.label = "Dist Net TickTime"
emqx_conf_schema.node_etc_dir.desc = "<code>etc</code> dir for the node"
emqx_conf_schema.node_etc_dir.label = "Etc Dir"
emqx_conf_schema.node_generic_pool_size.desc = "The number of workers in emqx_pool. Increasing this value may improve performance\nby enhancing parallelism, especially when EMQX cluster interconnect network latency is high.\nDefaults to the number of Erlang schedulers (CPU cores)."
emqx_conf_schema.node_generic_pool_size.label = "Node Generic Pool Size"
emqx_conf_schema.node_global_gc_interval.desc = "Periodic garbage collection interval. Set to <code>disabled</code> to have it disabled."
emqx_conf_schema.node_global_gc_interval.label = "Global GC Interval"
emqx_conf_schema.node_name.desc = "Unique name of the EMQX node. It must follow <code>%name%@FQDN</code> or\n<code>%name%@IPv4</code> format."
emqx_conf_schema.node_name.label = "Node Name"
emqx_conf_schema.process_limit.desc = "Maximum number of simultaneously existing processes for this Erlang system.\nFor more information, see: https://www.erlang.org/doc/man/erl.html"
emqx_conf_schema.process_limit.label = "Erlang Process Limit"
emqx_conf_schema.rpc_async_batch_size.desc = "The maximum number of batch messages sent in asynchronous mode.\n      Note that this configuration does not work in synchronous mode."
emqx_conf_schema.rpc_async_batch_size.label = "Async Batch Size"
emqx_conf_schema.rpc_authentication_timeout.desc = "Timeout for the remote node authentication."
emqx_conf_schema.rpc_authentication_timeout.label = "RPC Authentication Timeout"
emqx_conf_schema.rpc_cacertfile.desc = "Path to certification authority TLS certificate file used to validate <code>rpc.certfile</code>.<br/>\nNote: certificates of all nodes in the cluster must be signed by the same CA."
emqx_conf_schema.rpc_cacertfile.label = "RPC Cacertfile"
emqx_conf_schema.rpc_call_receive_timeout.desc = "Timeout for the reply to a synchronous RPC."
emqx_conf_schema.rpc_call_receive_timeout.label = "RPC Call Receive Timeout"
emqx_conf_schema.rpc_certfile.desc = "Path to TLS certificate file used to validate identity of the cluster nodes.\nNote that this config only takes effect when <code>rpc.driver</code> is set to <code>ssl</code>."
emqx_conf_schema.rpc_certfile.label = "RPC Certfile"
emqx_conf_schema.rpc_client_num.desc = "Set the maximum number of RPC communication channels initiated by this node to each remote node."
emqx_conf_schema.rpc_client_num.label = "RPC TCP Client Num"
emqx_conf_schema.rpc_connect_timeout.desc = "Timeout for establishing an RPC connection."
emqx_conf_schema.rpc_connect_timeout.label = "RPC Connect Timeout"
emqx_conf_schema.rpc_driver.desc = "Transport protocol used for inter-broker communication"
emqx_conf_schema.rpc_driver.label = "RPC dirver"
emqx_conf_schema.rpc_insecure_fallback.desc = "Enable compatibility with old RPC authentication."
emqx_conf_schema.rpc_insecure_fallback.label = "RPC insecure fallback"
emqx_conf_schema.rpc_ipv6_only.desc = "This setting is effective only when <code>rpc.listen_address</code> is assigned an IPv6 address.\nIf set to <code>true</code>, the RPC client will exclusively use IPv6 for connections.\nOtherwise, the client might opt for IPv4, even if the server is on IPv6."
emqx_conf_schema.rpc_ipv6_only.label = "Use IPv6 Only"
emqx_conf_schema.rpc_keyfile.desc = "Path to the private key file for the <code>rpc.certfile</code>.<br/>\nNote: contents of this file are secret, so it's necessary to set permissions to 600."
emqx_conf_schema.rpc_keyfile.label = "RPC Keyfile"
emqx_conf_schema.rpc_listen_address.desc = "Indicates the IP address for the RPC server to listen on. For example, use <code>\"0.0.0.0\"</code> for IPv4 or <code>\"::\"</code> for IPv6."
emqx_conf_schema.rpc_listen_address.label = "RPC Listen IP Address"
emqx_conf_schema.rpc_mode.desc = "In <code>sync</code> mode the sending side waits for the ack from the receiving side."
emqx_conf_schema.rpc_mode.label = "RPC Mode"
emqx_conf_schema.rpc_port_discovery.desc = "<code>manual</code>: discover ports by <code>server_port</code>.<br/>\n<code>stateless</code>: discover ports in a stateless manner, using the following algorithm.\nIf node name is <code>emqxN@127.0.0.1</code>, where the N is an integer,\nthen the listening port will be 5370 + N.\nNOTE: when `port_discovery` is `manual`, `server_port` configuration has no effect."
emqx_conf_schema.rpc_port_discovery.label = "RRC Port Discovery"
emqx_conf_schema.rpc_send_timeout.desc = "Timeout for sending the RPC request."
emqx_conf_schema.rpc_send_timeout.label = "RPC Send Timeout"
emqx_conf_schema.rpc_server_port.desc = "Listening port used by RPC local service.<br/>\nNote that this config only takes effect when rpc.port_discovery is set to manual."
emqx_conf_schema.rpc_server_port.label = "RPC Server Port"
emqx_conf_schema.rpc_socket_buffer.desc = "TCP tuning parameters. Socket buffer size in user mode."
emqx_conf_schema.rpc_socket_buffer.label = "RPC Socket Buffer"
emqx_conf_schema.rpc_socket_keepalive_count.desc = "Corresponds to the `TCP_KEEPCNT` socket option. The maximum number of TCP keep-alive probes to send before giving up and killing the connection if no response is obtained from the other end."
emqx_conf_schema.rpc_socket_keepalive_count.label = "RPC Socket Keepalive Count"
emqx_conf_schema.rpc_socket_keepalive_idle.desc = "Corresponds to the `TCP_KEEPIDLE` socket option. The time (in seconds) the connection needs to remain idle before TCP starts sending keepalive probes."
emqx_conf_schema.rpc_socket_keepalive_idle.label = "RPC Socket Keepalive Idle"
emqx_conf_schema.rpc_socket_keepalive_interval.desc = "Corresponds to the `TCP_KEEPINTVL` socket option. The time (in seconds) between individual keepalive probes."
emqx_conf_schema.rpc_socket_keepalive_interval.label = "RPC Socket Keepalive Interval"
emqx_conf_schema.rpc_socket_recbuf.desc = "TCP tuning parameters. TCP receiving buffer size."
emqx_conf_schema.rpc_socket_recbuf.label = "RPC Socket Recbuf"
emqx_conf_schema.rpc_socket_sndbuf.desc = "TCP tuning parameters. TCP sending buffer size."
emqx_conf_schema.rpc_socket_sndbuf.label = "RPC Socket Sndbuf"
emqx_conf_schema_types.bytesize.desc = "A string that represents a number of bytes, for example: <code>10B</code>, <code>640kb</code>, <code>4MB</code>, <code>1GB</code>. Units are binary standardized, i.e., 1MB equals 1024KB. units are not case sensitive, i.e., 1kb equals 1KB."
emqx_conf_schema_types.duration.desc = "A string that represents a time duration, for example: <code>10s</code>, <code>2.5m</code>, <code>1h30m</code>, <code>1W2D</code>, or <code>2345ms</code>, which is the smallest unit. Each configuration item has its own minimum precision. The part of the setting value that exceeds the precision will be ignored.\n\nFor example, if a configuration item of type <code>Duration(s)</code> is set to <code>1200ms</code>, the final effective value will be <code>1s</code> instead of <code>1.2s</code>.\n\n`Duration` is equivalent to `Duration(ms)`. The unit part is case-insensitive."
emqx_conf_schema_types.secret.desc = "A string holding some sensitive information, such as a password. When secret starts with <code>file://</code>, the rest of the string is interpreted as a path to a file containing the secret itself: whole content of the file except any trailing whitespace characters is considered a secret value. Note: when clustered, all EMQX nodes should have the same file present before using <code>file://</code> secrets."
emqx_conf_schema_types.template.desc = "A string for `${.path.to.var}` style value interpolation,\nwhere the leading dot is optional, and `${.}` represents all values as an object."
emqx_connector_aggregator_schema.container.desc = "Settings governing the file format of an upload containing aggregated events."
emqx_connector_aggregator_schema.container.label = "Container for aggregated events"
emqx_connector_aggregator_schema.container_csv.desc = "Records (events) will be aggregated and uploaded as a CSV file."
emqx_connector_aggregator_schema.container_csv.label = "CSV container"
emqx_connector_aggregator_schema.container_csv_column_order.desc = "Event fields that will be ordered first as columns in the resulting CSV file.<br/>\nRegardless of this setting, resulting CSV will contain all the fields of aggregated events, but all the columns not explicitly mentioned here will be ordered after the ones listed here in the lexicographical order."
emqx_connector_aggregator_schema.container_csv_column_order.label = "CSV column order"
emqx_connector_aggregator_schema.container_json_lines.desc = "Records (events) will be aggregated and uploaded as a [JSON Lines](https://jsonlines.org/) file."
emqx_connector_aggregator_schema.container_json_lines.label = "JSON Lines container"
emqx_connector_api.desc_api1.desc = "List all created connectors."
emqx_connector_api.desc_api1.label = "List All Connectors"
emqx_connector_api.desc_api2.desc = "Create a new connector by type and name."
emqx_connector_api.desc_api2.label = "Create Connector"
emqx_connector_api.desc_api3.desc = "Get a connector by id."
emqx_connector_api.desc_api3.label = "Get Connector"
emqx_connector_api.desc_api4.desc = "Update a connector by id."
emqx_connector_api.desc_api4.label = "Update Connector"
emqx_connector_api.desc_api5.desc = "Delete a connector by id."
