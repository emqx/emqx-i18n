emqx_mt_api.update_managed_ns_config.label = "Update managed namespace configuration"
emqx_mt_schema.allow_only_managed_namespaces.desc = "If enabled, clients that belong to a non-managed namespace will be\ndenied connection.  Clients that can't have their namespace resolved\nwill also be denied connection."
emqx_mt_schema.allow_only_managed_namespaces.label = "Allow only managed namespaces"
