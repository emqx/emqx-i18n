emqx_bridge_hstreamdb_connector.partition_key.desc = "HStreamDB Partition Key. Placeholders supported."
emqx_bridge_hstreamdb_connector.partition_key.label = "HStreamDB Partition Key"
emqx_bridge_hstreamdb_connector.pool_size.desc = "The size of the aggregation pool and the writer pool (see the description of the HStreamDB action for more information about these pools). Larger pool sizes can enhance parallelization but may also reduce efficiency due to smaller batch sizes."
emqx_bridge_hstreamdb_connector.pool_size.label = "HStreamDB Pool Size"
emqx_bridge_hstreamdb_connector.stream_name.desc = "HStreamDB Stream Name."
emqx_bridge_hstreamdb_connector.stream_name.label = "HStreamDB Stream Name"
emqx_bridge_hstreamdb_connector.type.desc = "The Connector Type."
emqx_bridge_hstreamdb_connector.type.label = "Connector Type"
emqx_bridge_hstreamdb_connector.url.desc = "HStreamDB Server URL. This URL will be used as the gRPC HTTP server address."
emqx_bridge_hstreamdb_connector.url.label = "HStreamDB Server URL"
emqx_bridge_http_connector.body.desc = "HTTP request body."
emqx_bridge_http_connector.body.label = "HTTP Body"
emqx_bridge_http_connector.connect_timeout.desc = "The timeout when connecting to the HTTP server."
emqx_bridge_http_connector.connect_timeout.label = "Connect Timeout"
emqx_bridge_http_connector.enable_pipelining.desc = "The maximum number of HTTP requests that can be sent before an HTTP response is received.\n\nSetting this to 1 is equivalent to turning off HTTP pipelining, and the EMQX must receive a response to the previous HTTP request before sending the next HTTP request."
emqx_bridge_http_connector.enable_pipelining.label = "HTTP Pipelining"
emqx_bridge_http_connector.headers.desc = "List of HTTP headers."
emqx_bridge_http_connector.headers.label = "HTTP Headers"
emqx_bridge_http_connector.max_retries.desc = "Max retry times if error on sending request."
emqx_bridge_http_connector.max_retries.label = "Max Retries"
emqx_bridge_http_connector.method.desc = "HTTP method."
emqx_bridge_http_connector.method.label = "HTTP Method"
emqx_bridge_http_connector.path.desc = "URL path."
emqx_bridge_http_connector.path.label = "URL Path"
emqx_bridge_http_connector.pool_size.desc = "The pool size."
emqx_bridge_http_connector.pool_size.label = "Pool Size"
emqx_bridge_http_connector.pool_type.desc = "The type of the pool. Can be one of `random`, `hash`."
emqx_bridge_http_connector.pool_type.label = "Pool Type"
emqx_bridge_http_connector.request.desc = "Configure HTTP request parameters."
emqx_bridge_http_connector.request.label = "Request"
emqx_bridge_http_connector.request_timeout.desc = "HTTP request timeout."
emqx_bridge_http_connector.request_timeout.label = "Request Timeout"
emqx_bridge_http_schema.config_body.desc = "The body of the HTTP request.<br/>\nIf not provided, the body will be a JSON object of all the available fields.<br/>\nThere, 'all the available fields' means the context of a MQTT message when\nthis webhook is triggered by receiving a MQTT message (the `local_topic` is set),\nor the context of the event when this webhook is triggered by a rule (i.e. this\nwebhook is used as an action of a rule).<br/>\nTemplate with variables is allowed."
emqx_bridge_http_schema.config_body.label = "HTTP Body"
emqx_bridge_http_schema.config_enable_bridge.desc = "Enable or disable this action."
emqx_bridge_http_schema.config_enable_bridge.label = "Enable Or Disable Bridge"
emqx_bridge_http_schema.config_headers.desc = "The headers of the HTTP request.<br/>\nTemplate with variables is allowed."
emqx_bridge_http_schema.config_headers.label = "HTTP Header"
emqx_bridge_http_schema.config_local_topic.desc = "The MQTT topic filter to be forwarded to the HTTP server. All MQTT 'PUBLISH' messages with the topic\nmatching the local_topic will be forwarded.<br/>\nNOTE: If this action is used as the action of a rule (EMQX rule engine), and also local_topic is\nconfigured, then both the data got from the rule and the MQTT messages that match local_topic\nwill be forwarded."
emqx_bridge_http_schema.config_local_topic.label = "Local Topic"
emqx_bridge_http_schema.config_max_retries.desc = "HTTP request max retry times if failed."
emqx_bridge_http_schema.config_max_retries.label = "HTTP Request Max Retries"
emqx_bridge_http_schema.config_method.desc = "The method of the HTTP request. All the available methods are: post, put, get, delete.<br/>\nTemplate with variables is allowed."
emqx_bridge_http_schema.config_method.label = "HTTP Method"
emqx_bridge_http_schema.config_parameters_opts.desc = "The parameters for HTTP action."
emqx_bridge_http_schema.config_parameters_opts.label = "Parameters"
emqx_bridge_http_schema.config_path.desc = "The URL path for this Action.<br/>\nThis path will be appended to the Connector's <code>url</code> configuration to form the full\nURL address.\nTemplate with variables is allowed in this option. For example, <code>/room/${room_no}</code>"
emqx_bridge_http_schema.config_path.label = "URL Path"
emqx_bridge_http_schema.config_request_timeout.desc = "HTTP request timeout."
emqx_bridge_http_schema.config_request_timeout.label = "HTTP Request Timeout"
emqx_bridge_http_schema.config_url.desc = "The URL of the HTTP action.<br/>\nTemplate with variables is allowed in the path, but variables cannot be used in the scheme, host,\nor port part.<br/>\nFor example, <code> http://localhost:9901/${topic} </code> is allowed, but\n<code> http://${host}:9901/message </code> or <code> http://localhost:${port}/message </code>\nis not allowed."
emqx_bridge_http_schema.config_url.label = "URL"
emqx_bridge_http_schema.desc_config.desc = "Configuration for an HTTP action."
emqx_bridge_http_schema.desc_config.label = "HTTP Action Configuration"
emqx_bridge_http_schema.desc_name.desc = "Action name, used as a human-readable identifier."
emqx_bridge_http_schema.desc_name.label = "Action Name"
emqx_bridge_http_schema.desc_type.desc = "The action type."
emqx_bridge_http_schema.desc_type.label = "Action Type"
emqx_bridge_influxdb.action_parameters.desc = "Additional parameters specific to this action type"
emqx_bridge_influxdb.action_parameters.label = "Action Parameters"
emqx_bridge_influxdb.config_enable.desc = "Enable or disable this bridge."
emqx_bridge_influxdb.config_enable.label = "Enable Or Disable Bridge"
emqx_bridge_influxdb.connector.desc = "InfluxDB Connector Configs"
emqx_bridge_influxdb.connector.label = "InfluxDB Connector"
emqx_bridge_influxdb.desc_config.desc = "Configuration for an InfluxDB bridge."
emqx_bridge_influxdb.desc_config.label = "InfluxDB Bridge Configuration"
emqx_bridge_influxdb.desc_name.desc = "Bridge name."
emqx_bridge_influxdb.desc_name.label = "Bridge Name"
emqx_bridge_influxdb.desc_type.desc = "The Bridge Type."
emqx_bridge_influxdb.desc_type.label = "Bridge Type"
emqx_bridge_influxdb.influxdb_action.desc = "Action to interact with a InfluxDB connector"
emqx_bridge_influxdb.influxdb_action.label = "InfluxDB Action"
emqx_bridge_influxdb.local_topic.desc = "The MQTT topic filter to be forwarded to the InfluxDB. All MQTT 'PUBLISH' messages with the topic\nmatching the local_topic will be forwarded.<br/>\nNOTE: if this bridge is used as the action of a rule (EMQX rule engine), and also local_topic is\nconfigured, then both the data got from the rule and the MQTT messages that match local_topic\nwill be forwarded."
emqx_bridge_influxdb.local_topic.label = "Local Topic"
emqx_bridge_influxdb.write_syntax.desc = "Conf of InfluxDB line protocol to write data points. It is a text-based format that provides the measurement, tag set, field set, and timestamp of a data point, and placeholder supported.\nSee also [InfluxDB 2.3 Line Protocol](https://docs.influxdata.com/influxdb/v2.3/reference/syntax/line-protocol/) and\n[InfluxDB 1.8 Line Protocol](https://docs.influxdata.com/influxdb/v1.8/write_protocols/line_protocol_tutorial/) <br/>\nTLDR:<br/>\n```\n<measurement>[,<tag_key>=<tag_value>[,<tag_key>=<tag_value>]] <field_key>=<field_value>[,<field_key>=<field_value>] [<timestamp>]\n```\nPlease note that a placeholder for an integer value must be annotated with a suffix `i`. For example `${payload.int_value}i`."
emqx_bridge_influxdb.write_syntax.label = "Write Syntax"
emqx_bridge_influxdb_connector.bucket.desc = "InfluxDB bucket name."
emqx_bridge_influxdb_connector.bucket.label = "Bucket"
emqx_bridge_influxdb_connector.database.desc = "InfluxDB database."
emqx_bridge_influxdb_connector.database.label = "Database"
emqx_bridge_influxdb_connector.influxdb_api_v1.desc = "InfluxDB's protocol. Support InfluxDB v1.8 and before."
emqx_bridge_influxdb_connector.influxdb_api_v1.label = "HTTP API Protocol"
emqx_bridge_influxdb_connector.influxdb_api_v2.desc = "InfluxDB's protocol. Support InfluxDB v2.0 and after."
emqx_bridge_influxdb_connector.influxdb_api_v2.label = "HTTP API V2 Protocol"
emqx_bridge_influxdb_connector.influxdb_parameters.desc = "Set of parameters specific for the given type of this InfluxDB connector, `influxdb_type` can be one of `influxdb_api_v1`, `influxdb_api_v1`."
emqx_bridge_influxdb_connector.influxdb_parameters.label = "InfluxDB Type Specific Parameters"
emqx_bridge_influxdb_connector.org.desc = "Organization name of InfluxDB."
emqx_bridge_influxdb_connector.org.label = "Organization"
emqx_bridge_influxdb_connector.password.desc = "InfluxDB password."
emqx_bridge_influxdb_connector.password.label = "Password"
emqx_bridge_influxdb_connector.pool_size.desc = "Size of the connection pool towards the bridge target service."
emqx_bridge_influxdb_connector.pool_size.label = "Connection Pool Size"
emqx_bridge_influxdb_connector.precision.desc = "InfluxDB time precision."
emqx_bridge_influxdb_connector.precision.label = "Time Precision"
emqx_bridge_influxdb_connector.protocol.desc = "InfluxDB's protocol. HTTP API or HTTP API V2."
emqx_bridge_influxdb_connector.protocol.label = "Protocol"
emqx_bridge_influxdb_connector.server.desc = "The IPv4 or IPv6 address or the hostname to connect to.<br/>\nA host entry has the following form: `Host[:Port]`.<br/>\nThe InfluxDB default port 8086 is used if `[:Port]` is not specified."
emqx_bridge_influxdb_connector.server.label = "Server Host"
