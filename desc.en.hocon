emqx_authz_schema.rate_last5m.label = "Rate in Last 5min"
emqx_authz_schema.rate_max.desc = "The max rate of matched, times/second."
emqx_authz_schema.rate_max.label = "Max Rate"
emqx_authz_schema.sources.desc = "Authorization data sources.<br/>\nAn array of authorization (ACL) data providers.\nIt is designed as an array, not a hash-map, so the sources can be\nordered to form a chain of access controls.<br/>\n\nWhen authorizing a 'publish' or 'subscribe' action, the configured\nsources are checked in order. When checking an ACL source,\nin case the client (identified by username or client ID) is not found,\nit moves on to the next source. And it stops immediately\nonce an 'allow' or 'deny' decision is returned.<br/>\n\nIf the client is not found in any of the sources,\nthe default action configured in 'authorization.no_match' is applied.<br/>\n\nNOTE:\nThe source elements are identified by their 'type'.\nIt is NOT allowed to configure two or more sources of the same type."
emqx_authz_schema.sources.label = "sources"
emqx_authz_schema.status.desc = "The status of the resource."
emqx_authz_schema.status.label = "Status"
emqx_authz_schema.success.desc = "Count of query success."
emqx_authz_schema.success.label = "Success"
emqx_authz_schema.type.desc = "Backend type."
emqx_authz_schema.type.label = "type"
emqx_auto_subscribe_api.list_auto_subscribe_api.desc = "Get auto subscribe topic list"
emqx_auto_subscribe_api.list_auto_subscribe_api.label = "Get auto subscribe topics"
emqx_auto_subscribe_api.update_auto_subscribe_api.desc = "Update auto subscribe topic list"
emqx_auto_subscribe_api.update_auto_subscribe_api.label = "Update auto subscribe topics"
emqx_auto_subscribe_api.update_auto_subscribe_api_response409.desc = "Auto Subscribe topics max limit"
emqx_auto_subscribe_api.update_auto_subscribe_api_response409.label = "Auto Subscribe topics max limit"
emqx_auto_subscribe_schema.auto_subscribe.desc = "After the device logs in successfully, the subscription is automatically completed for the device through the pre-defined subscription representation. Supports the use of placeholders."
emqx_auto_subscribe_schema.auto_subscribe.label = "Auto Subscribe"
emqx_auto_subscribe_schema.nl.desc = "Default value 0.\nMQTT v3.1.1: if you subscribe to the topic published by yourself, you will receive all messages that you published.\nMQTT v5: if you set this option as 1 when subscribing, the server will not forward the message you published to you."
emqx_auto_subscribe_schema.nl.label = "No Local"
emqx_auto_subscribe_schema.qos.desc = "Default value 0. Quality of service.\nAt most once (0)\nAt least once (1)\nExactly once (2)"
emqx_auto_subscribe_schema.qos.label = "Quality of Service"
emqx_auto_subscribe_schema.rap.desc = "Default value 0. This option is used to specify whether the server retains the RETAIN mark when forwarding messages to the client, and this option does not affect the RETAIN mark in the retained message. Therefore, when the option Retain As Publish is set to 0, the client will directly distinguish whether this is a normal forwarded message or a retained message according to the RETAIN mark in the message, instead of judging whether this message is the first received after subscribing(the forwarded message may be sent before the retained message, which depends on the specific implementation of different brokers)."
emqx_auto_subscribe_schema.rap.label = "Retain As Publish"
emqx_auto_subscribe_schema.rh.desc = "Default value 0. This option is used to specify whether the server forwards the retained message to the client when establishing a subscription.\nRetain Handling is equal to 0, as long as the client successfully subscribes, the server will send the retained message.\nRetain Handling is equal to 1, if the client successfully subscribes and this subscription does not exist previously, the server sends the retained message. After all, sometimes the client re-initiate the subscription just to change the QoS, but it does not mean that it wants to receive the reserved messages again.\nRetain Handling is equal to 2, even if the client successfully subscribes, the server does not send the retained message."
emqx_auto_subscribe_schema.rh.label = "Retain Handling"
emqx_auto_subscribe_schema.topic.desc = "Topic name, placeholders are supported. For example: client/${clientid}/username/${username}/host/${host}/port/${port}\nRequired field, and cannot be empty string"
emqx_auto_subscribe_schema.topic.label = "Topic"
emqx_bridge_api.desc_api1.desc = "List all created bridges"
emqx_bridge_api.desc_api1.label = "List All Bridges"
emqx_bridge_api.desc_api2.desc = "Create a new bridge by type and name"
emqx_bridge_api.desc_api2.label = "Create Bridge"
emqx_bridge_api.desc_api3.desc = "Get a bridge by Id"
emqx_bridge_api.desc_api3.label = "Get Bridge"
emqx_bridge_api.desc_api4.desc = "Update a bridge by Id"
emqx_bridge_api.desc_api4.label = "Update Bridge"
emqx_bridge_api.desc_api5.desc = "Delete a bridge by Id"
emqx_bridge_api.desc_api5.label = "Delete Bridge"
emqx_bridge_api.desc_api6.desc = "Reset a bridge metrics by Id"
emqx_bridge_api.desc_api6.label = "Reset Bridge Metrics"
emqx_bridge_api.desc_api7.desc = "Stop/Restart bridges on all nodes in the cluster."
emqx_bridge_api.desc_api7.label = "Cluster Bridge Operate"
emqx_bridge_api.desc_api8.desc = "Stop/Restart bridges on a specific node."
emqx_bridge_api.desc_api8.label = "Node Bridge Operate"
emqx_bridge_api.desc_api9.desc = "Test creating a new bridge by given ID <br/>\nThe ID must be of format '{type}:{name}'"
emqx_bridge_api.desc_api9.label = "Test Bridge Creation"
emqx_bridge_api.desc_bridge_metrics.desc = "Get bridge metrics by Id"
emqx_bridge_api.desc_bridge_metrics.label = "Get Bridge Metrics"
emqx_bridge_api.desc_enable_bridge.desc = "Enable or Disable bridges on all nodes in the cluster."
emqx_bridge_api.desc_enable_bridge.label = "Cluster Bridge Enable"
emqx_bridge_api.desc_param_path_enable.desc = "Whether to enable this bridge"
emqx_bridge_api.desc_param_path_enable.label = "Enable bridge"
emqx_bridge_api.desc_param_path_id.desc = "The bridge Id. Must be of format {type}:{name}"
emqx_bridge_api.desc_param_path_id.label = "Bridge ID"
emqx_bridge_api.desc_param_path_node.desc = "The node name, e.g. emqx@127.0.0.1"
emqx_bridge_api.desc_param_path_node.label = "The node name"
emqx_bridge_api.desc_param_path_operation_cluster.desc = "Operations can be one of: stop, restart"
emqx_bridge_api.desc_param_path_operation_cluster.label = "Cluster Operation"
emqx_bridge_api.desc_param_path_operation_on_node.desc = "Operations can be one of: stop, restart"
emqx_bridge_api.desc_param_path_operation_on_node.label = "Node Operation"
emqx_bridge_azure_blob_storage_action_schema.aggreg_parameters.desc = "Set of parameters for the action in aggregated mode."
emqx_bridge_azure_blob_storage_action_schema.aggreg_parameters.label = "Azure Blob Storage Aggregated Mode action parameters"
emqx_bridge_azure_blob_storage_action_schema.aggregated_blob_template.desc = "Template for the Azure Blob Storage blob name of an aggregated upload.<br/>\n  Template may contain placeholders for the following variables:\n  <ul>\n  <li><code>${action}</code>: name of the action (required).</li>\n  <li><code>${node}</code>: name of the EMQX node conducting the upload (required).</li>\n  <li><code>${datetime.{format}}</code>: date and time when aggregation started, formatted according to the <code>{format}</code> string (required):\n      <ul>\n      <li><code>${datetime.rfc3339utc}</code>: RFC3339-formatted date and time in UTC,</li>\n      <li><code>${datetime.rfc3339}</code>: RFC3339-formatted date and time in local timezone,</li>\n      <li><code>${datetime.unix}</code>: Unix timestamp.</li>\n      </ul>\n  </li>\n  <li><code>${datetime_until.{format}}</code>: date and time when aggregation ended, with the same formatting options.</li>\n  <li><code>${sequence}</code>: sequence number of the aggregated upload within the same time interval (required).</li>\n  </ul>\n  All other placeholders are considered invalid. Note that placeholders marked as required will be added as a path suffix to the Azure Blob Storage blob name if they are missing from the template."
emqx_bridge_azure_blob_storage_action_schema.aggregated_blob_template.label = "Azure Blob Storage blob name template"
emqx_bridge_azure_blob_storage_action_schema.aggregated_container_name.desc = "The Azure Blob Storage container name. Does not support templates."
emqx_bridge_azure_blob_storage_action_schema.aggregated_container_name.label = "Azure Blob Storage Container name"
emqx_bridge_azure_blob_storage_action_schema.aggregated_mode.desc = "Enables time-based aggregation of incoming events and uploading them to the Azure Blob Storage service as a single object."
emqx_bridge_azure_blob_storage_action_schema.aggregated_mode.label = "Aggregated Azure Blob Storage Upload"
emqx_bridge_azure_blob_storage_action_schema.aggregation.desc = "Set of parameters governing the aggregation process."
emqx_bridge_azure_blob_storage_action_schema.aggregation.label = "Aggregation parameters"
emqx_bridge_azure_blob_storage_action_schema.aggregation_interval.desc = "Amount of time events will be aggregated in a single object before uploading."
emqx_bridge_azure_blob_storage_action_schema.aggregation_interval.label = "Time interval"
emqx_bridge_azure_blob_storage_action_schema.aggregation_max_records.desc = "Number of records (events) allowed per each aggregated object. Each aggregated upload will contain no more than that number of events, but may contain less.<br/>\n  If event rate is high enough, there obviously may be more than one aggregated upload during the same time interval. These uploads will have different, but consecutive sequence numbers, which will be a part of Azure Blob Storage blob name."
emqx_bridge_azure_blob_storage_action_schema.aggregation_max_records.label = "Maximum number of records"
emqx_bridge_azure_blob_storage_action_schema.azure_blob_storage.desc = "Action that takes incoming events and uploads them to the Azure Blob Storage service."
emqx_bridge_azure_blob_storage_action_schema.azure_blob_storage.label = "Upload to Azure Blob Storage"
emqx_bridge_azure_blob_storage_action_schema.direct_blob_template.desc = "The name of the Azure Blob Storage blob name."
emqx_bridge_azure_blob_storage_action_schema.direct_blob_template.label = "Blob Name"
emqx_bridge_azure_blob_storage_action_schema.direct_container_template.desc = "The name of the Azure Blob Storage container name."
emqx_bridge_azure_blob_storage_action_schema.direct_container_template.label = "Container Name"
emqx_bridge_azure_blob_storage_action_schema.direct_content_template.desc = "Content of the Azure Blob Storage blob being uploaded. Supports templates."
emqx_bridge_azure_blob_storage_action_schema.direct_content_template.label = "Azure Blob Storage Blob Content"
emqx_bridge_azure_blob_storage_action_schema.direct_mode.desc = "Enables uploading of events to the Azure Blob Storage service as separate objects."
emqx_bridge_azure_blob_storage_action_schema.direct_mode.label = "Direct Azure Blob Storage Upload"
emqx_bridge_azure_blob_storage_action_schema.direct_parameters.desc = "Set of parameters for the upload action. Action supports templates in Azure Blob Storage container name, blob name and blob content."
emqx_bridge_azure_blob_storage_action_schema.direct_parameters.label = "Direct Azure Blob Storage Upload action parameters"
emqx_bridge_azure_blob_storage_action_schema.parameters.desc = "Set of parameters for the action."
emqx_bridge_azure_blob_storage_action_schema.parameters.label = "Azure Blob Storage action parameters"
emqx_bridge_azure_blob_storage_connector_schema.account_key.desc = "Account key for Azure Blob Storage service."
emqx_bridge_azure_blob_storage_connector_schema.account_key.label = "Account Key"
emqx_bridge_azure_blob_storage_connector_schema.account_name.desc = "Account name for Azure Blob Storage service."
emqx_bridge_azure_blob_storage_connector_schema.account_name.label = "Account Name"
emqx_bridge_azure_blob_storage_connector_schema.config_connector.desc = "Configuration for a connector to Azure Blob Storage service."
emqx_bridge_azure_blob_storage_connector_schema.config_connector.label = "Azure Blob Storage Connector Configuration"
emqx_bridge_azure_event_hub.actions.desc = "The configuration for an action."
emqx_bridge_azure_event_hub.actions.label = "Action Config"
emqx_bridge_azure_event_hub.auth_sasl_mechanism.desc = "SASL authentication mechanism."
emqx_bridge_azure_event_hub.auth_sasl_mechanism.label = "Mechanism"
emqx_bridge_azure_event_hub.auth_sasl_password.desc = "The Connection String for connecting to Azure Event Hubs.  Should be the \"connection string-primary key\" of a Namespace shared access policy."
emqx_bridge_azure_event_hub.auth_sasl_password.label = "Connection String"
emqx_bridge_azure_event_hub.auth_username_password.desc = "Username/password based authentication."
emqx_bridge_azure_event_hub.auth_username_password.label = "Username/password Auth"
emqx_bridge_azure_event_hub.authentication.desc = "Authentication configs."
emqx_bridge_azure_event_hub.authentication.label = "Authentication"
emqx_bridge_azure_event_hub.bootstrap_hosts.desc = "A comma separated list of Azure Event Hubs Kafka <code>host[:port]</code> namespace endpoints to bootstrap the client.  Default port number is 9093."
emqx_bridge_azure_event_hub.bootstrap_hosts.label = "Bootstrap Hosts"
emqx_bridge_azure_event_hub.bridge_v2_type.desc = "The type of the bridge."
emqx_bridge_azure_event_hub.bridge_v2_type.label = "Bridge Type"
emqx_bridge_azure_event_hub.buffer_memory_overload_protection.desc = "Applicable when buffer mode is set to <code>memory</code>\nEMQX will drop old buffered messages under high memory pressure. The high memory threshold is defined in config <code>sysmon.os.sysmem_high_watermark</code>. NOTE: This config only works on Linux."
emqx_bridge_azure_event_hub.buffer_memory_overload_protection.label = "Memory Overload Protection"
emqx_bridge_azure_event_hub.buffer_mode.desc = "Message buffer mode.\n\n<code>memory</code>: Buffer all messages in memory. The messages will be lost in case of EMQX node restart\n<code>disk</code>: Buffer all messages on disk. The messages on disk are able to survive EMQX node restart.\n<code>hybrid</code>: Buffer message in memory first, when up to certain limit (see <code>segment_bytes</code> config for more information), then start offloading messages to disk, Like <code>memory</code> mode, the messages will be lost in case of EMQX node restart."
emqx_bridge_azure_event_hub.buffer_mode.label = "Buffer Mode"
emqx_bridge_azure_event_hub.buffer_per_partition_limit.desc = "Number of bytes allowed to buffer for each partition. When this limit is exceeded, older messages will be discarded to make room for new messages to be buffered."
emqx_bridge_azure_event_hub.buffer_per_partition_limit.label = "Per-partition Buffer Limit"
emqx_bridge_azure_event_hub.buffer_segment_bytes.desc = "Applicable when buffer mode is set to <code>disk</code> or <code>hybrid</code>.\nThis setting specifies the size of each buffer segment file stored on disk."
emqx_bridge_azure_event_hub.buffer_segment_bytes.label = "Segment File Bytes"
emqx_bridge_azure_event_hub.compression.desc = "Specify the method of compression."
emqx_bridge_azure_event_hub.compression.label = "Compression"
emqx_bridge_azure_event_hub.config_enable.desc = "Enable (true) or disable (false) this config."
emqx_bridge_azure_event_hub.config_enable.label = "Enable or Disable"
emqx_bridge_azure_event_hub.connect_timeout.desc = "Maximum wait time for TCP connection establishment (including authentication time if enabled)."
emqx_bridge_azure_event_hub.connect_timeout.label = "Connect Timeout"
emqx_bridge_azure_event_hub.connector_type.desc = "The type of the connector."
emqx_bridge_azure_event_hub.connector_type.label = "Connector Type"
emqx_bridge_azure_event_hub.desc_config.desc = "Configuration for an Azure Event Hubs bridge."
emqx_bridge_azure_event_hub.desc_config.label = "Azure Event Hubs Bridge Configuration"
emqx_bridge_azure_event_hub.desc_name.desc = "Bridge name, used as a human-readable description of the bridge."
emqx_bridge_azure_event_hub.desc_name.label = "Bridge Name"
emqx_bridge_azure_event_hub.desc_type.desc = "The action type."
emqx_bridge_azure_event_hub.desc_type.label = "Action Type"
emqx_bridge_azure_event_hub.kafka_header_value_encode_mode.desc = "The encoding mode for headers.\n\n - `none`: Add only strings are added as header values\n - `json`: Encode header values as JSON string"
emqx_bridge_azure_event_hub.kafka_header_value_encode_mode.label = "Headers value encode mode"
emqx_bridge_azure_event_hub.kafka_headers.desc = "Provide a placeholder for message headers<br/>\ne.g. <code>${pub_props}</code><br/>\nNote that the value of the placeholder must be either an object:\n<code>{\"foo\": \"bar\"}</code>\nor an array of key-value pairs:\n<code>[{\"key\": \"foo\", \"value\": \"bar\"}]</code>"
emqx_bridge_azure_event_hub.kafka_headers.label = "Message Headers"
emqx_bridge_azure_event_hub.kafka_message.desc = "Template for rendering a message."
emqx_bridge_azure_event_hub.kafka_message.label = "Azure Event Hubs Message Template"
emqx_bridge_azure_event_hub.kafka_message_key.desc = "Template for rendering message key. If the template is rendered into a NULL value (i.e. there is no such data field in Rule Engine context) then <code>NULL</code> (but not empty string) is used."
emqx_bridge_azure_event_hub.kafka_message_key.label = "Message Key"
emqx_bridge_azure_event_hub.kafka_message_timestamp.desc = "Which timestamp to use. The timestamp is expected to be a millisecond precision Unix epoch which can be in string format, e.g. <code>1661326462115</code> or <code>'1661326462115'</code>. When the desired data field for this template is not found, or if the found data is not a valid integer, the current system timestamp will be used."
emqx_bridge_azure_event_hub.kafka_message_timestamp.label = "Message Timestamp"
emqx_bridge_azure_event_hub.kafka_message_value.desc = "Template to render Azure Event Hubs message value. If the template is rendered into a NULL value (i.e. there is no such data field in Rule Engine context) then Azure Event Hubs' <code>NULL</code> (but not empty string) is used."
emqx_bridge_azure_event_hub.kafka_message_value.label = "Message Value"
emqx_bridge_azure_event_hub.kafka_producer.desc = "Azure Event Hubs Producer configuration."
emqx_bridge_azure_event_hub.kafka_producer.label = "Azure Event Hubs Producer"
emqx_bridge_azure_event_hub.kafka_topic.desc = "Event Hubs name.  Supports templates (e.g.: `t-${payload.t}`)."
emqx_bridge_azure_event_hub.kafka_topic.label = "Event Hubs Name"
emqx_bridge_azure_event_hub.max_batch_bytes.desc = "Maximum bytes to collect in an Azure Event Hubs message batch."
emqx_bridge_azure_event_hub.max_batch_bytes.label = "Max Batch Bytes"
emqx_bridge_azure_event_hub.max_inflight.desc = "The maximum number of message batches that the producer can send to each partition before it must wait for an acknowledgement.\nSetting a higher number can enhance throughput. However, value above 1 may lead to potential message reordering risks."
emqx_bridge_azure_event_hub.max_inflight.label = "Max Inflight"
emqx_bridge_azure_event_hub.max_linger_bytes.desc = "Maximum number of bytes for a per-partition producer to wait for messages in order to collect a batch to buffer."
emqx_bridge_azure_event_hub.max_linger_bytes.label = "Max Linger Bytes"
emqx_bridge_azure_event_hub.max_linger_time.desc = "Maximum duration for a per-partition producer to wait for messages in order to collect a batch to buffer.\nThe default value `0` means no wait. For non-memory buffer mode, it's advised to configure at least `5ms` for less IOPS."
emqx_bridge_azure_event_hub.max_linger_time.label = "Max Linger Time"
emqx_bridge_azure_event_hub.metadata_request_timeout.desc = "Maximum wait time when fetching metadata from Azure Event Hubs."
emqx_bridge_azure_event_hub.metadata_request_timeout.label = "Metadata Request Timeout"
emqx_bridge_azure_event_hub.min_metadata_refresh_interval.desc = "Minimum time interval the client has to wait before refreshing Azure Event Hubs Kafka broker and topic metadata. Setting too small value may add extra load on Azure Event Hubs."
emqx_bridge_azure_event_hub.min_metadata_refresh_interval.label = "Min Metadata Refresh Interval"
emqx_bridge_azure_event_hub.mqtt_topic.desc = "MQTT topic or topic filter as data source (action input).  If rule action is used as data source, this config should be left empty, otherwise messages will be duplicated in Azure Event Hubs."
emqx_bridge_azure_event_hub.mqtt_topic.label = "Source MQTT Topic"
emqx_bridge_azure_event_hub.partition_count_refresh_interval.desc = "The time interval for Azure Event Hubs producer to discover increased number of partitions.\nAfter the number of partitions is increased in Azure Event Hubs, EMQX will start taking the\ndiscovered partitions into account when dispatching messages per <code>partition_strategy</code>."
emqx_bridge_azure_event_hub.partition_count_refresh_interval.label = "Partition Count Refresh Interval"
emqx_bridge_azure_event_hub.partition_strategy.desc = "Partition strategy is to tell the producer how to dispatch messages to partitions.\n\n<code>random</code>: Randomly pick a partition for each message.\n<code>key_dispatch</code>: Assigns messages to partitions based on a hash of the message key,\nensuring consistent partition for messages with the same key."
emqx_bridge_azure_event_hub.partition_strategy.label = "Partition Strategy"
emqx_bridge_azure_event_hub.partitions_limit.desc = "Limit the number of partitions to produce data for the given topic.\nThe special value `all_partitions` is to utilize all partitions for the topic.\nSetting this to a value which is greater than the total number of partitions in has no effect."
emqx_bridge_azure_event_hub.partitions_limit.label = "Max Partitions"
emqx_bridge_azure_event_hub.producer_buffer.desc = "Configure producer message buffer.\n\nTell Azure Event Hubs producer how to buffer messages when EMQX has more messages to send than Azure Event Hubs can keep up, or when Azure Event Hubs is down."
emqx_bridge_azure_event_hub.producer_buffer.label = "Message Buffer"
emqx_bridge_azure_event_hub.producer_health_check_topic.desc = "Topic name used exclusively for more accurate connector health checks."
emqx_bridge_azure_event_hub.producer_health_check_topic.label = "Connector health check topic"
emqx_bridge_azure_event_hub.producer_kafka_ext_header_key.desc = "Key of the Azure Event Hubs header. Placeholders in format of ${var} are supported."
emqx_bridge_azure_event_hub.producer_kafka_ext_header_key.label = "Azure Event Hubs extra header key."
emqx_bridge_azure_event_hub.producer_kafka_ext_header_value.desc = "Value of the header. Placeholders in format of ${var} are supported."
emqx_bridge_azure_event_hub.producer_kafka_ext_header_value.label = "Extra Headers Value"
emqx_bridge_azure_event_hub.producer_kafka_ext_headers.desc = "Please provide more key-value pairs for Azure Event Hubs headers<br/>\nThe key-value pairs here will be combined with the\nvalue of <code>kafka_headers</code> field before sending to Azure Event Hubs."
emqx_bridge_azure_event_hub.producer_kafka_ext_headers.label = "Extra Azure Event Hubs headers"
emqx_bridge_azure_event_hub.producer_kafka_opts.desc = "Azure Event Hubs producer configs."
emqx_bridge_azure_event_hub.producer_kafka_opts.label = "Azure Event Hubs Producer"
emqx_bridge_azure_event_hub.producer_opts.desc = "Local MQTT data source and Azure Event Hubs bridge configs."
emqx_bridge_azure_event_hub.producer_opts.label = "MQTT to Azure Event Hubs"
emqx_bridge_azure_event_hub.query_mode.desc = "Query mode. Optional 'sync/async', default 'async'."
emqx_bridge_azure_event_hub.query_mode.label = "Query mode"
emqx_bridge_azure_event_hub.required_acks.desc = "The acknowledgement criteria for the partition leader. It determines the level of confirmation required from partition replicas before sending an acknowledgement back to the producer.\n\n<code>all_isr</code>: Require all in-sync replicas to acknowledge.\n<code>leader_only</code>: Require only the partition-leader's acknowledgement.\n<code>none</code>: No need for Kafka to acknowledge at all."
emqx_bridge_azure_event_hub.required_acks.label = "Required Acks"
emqx_bridge_azure_event_hub.server_name_indication.desc = "Server Name Indication (SNI) setting for TLS handshake.<br/>\n- <code>auto</code>: The client will use <code>\"servicebus.windows.net\"</code> as SNI.<br/>\n- <code>disable</code>: If you wish to prevent the client from sending the SNI.<br/>\n- Other string values it will be sent as-is."
emqx_bridge_azure_event_hub.server_name_indication.label = "SNI"
emqx_bridge_azure_event_hub.socket_nodelay.desc = "When set to 'true', TCP buffer is sent as soon as possible. Otherwise, the OS kernel may buffer small TCP packets for a while (40 ms by default)."
emqx_bridge_azure_event_hub.socket_nodelay.label = "No Delay"
emqx_bridge_azure_event_hub.socket_opts.desc = "Extra socket options."
emqx_bridge_azure_event_hub.socket_opts.label = "Socket Options"
emqx_bridge_azure_event_hub.socket_receive_buffer.desc = "Fine tune the socket receive buffer. The default value is tuned for high throughput."
emqx_bridge_azure_event_hub.socket_receive_buffer.label = "Socket Receive Buffer Size"
emqx_bridge_azure_event_hub.socket_send_buffer.desc = "Fine tune the socket send buffer. The default value is tuned for high throughput."
emqx_bridge_azure_event_hub.socket_send_buffer.label = "Socket Send Buffer Size"
emqx_bridge_azure_event_hub.socket_tcp_keepalive.desc = "Enable TCP keepalive.\nThe value is three comma separated numbers in the format of 'Idle,Interval,Probes'\n - Idle: The number of seconds a connection needs to be idle before the server begins to send out keep-alive probes (Linux default 7200).\n - Interval: The number of seconds between TCP keep-alive probes (Linux default 75).\n - Probes: The maximum number of TCP keep-alive probes to send before giving up and killing the connection if no response is obtained from the other end (Linux default 9).\nFor example \"240,30,5\" means: TCP keepalive probes are sent after the connection is idle for 240 seconds, and the probes are sent every 30 seconds until a response is received, if it misses 5 consecutive responses, the connection should be closed.\nDefault: 'none'"
emqx_bridge_azure_event_hub.socket_tcp_keepalive.label = "TCP keepalive options"
emqx_bridge_azure_event_hub.ssl_client_opts.desc = "TLS/SSL options for Azure Event Hubs client."
emqx_bridge_azure_event_hub.ssl_client_opts.label = "TLS/SSL options"
