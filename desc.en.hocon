emqx_bridge_rocketmq.config_enable.label = "Enable Or Disable Bridge"
emqx_bridge_rocketmq.desc_config.desc = "Configuration for a RocketMQ bridge."
emqx_bridge_rocketmq.desc_config.label = "RocketMQ Bridge Configuration"
emqx_bridge_rocketmq.desc_name.desc = "Bridge name."
emqx_bridge_rocketmq.desc_name.label = "Bridge Name"
emqx_bridge_rocketmq.desc_type.desc = "The Bridge Type"
emqx_bridge_rocketmq.desc_type.label = "Bridge Type"
emqx_bridge_rocketmq.local_topic.desc = "The MQTT topic filter to be forwarded to RocketMQ. All MQTT `PUBLISH` messages with the topic\nmatching the `local_topic` will be forwarded.<br/>\nNOTE: if the bridge is used as a rule action, `local_topic` should be left empty otherwise the messages will be duplicated."
emqx_bridge_rocketmq.local_topic.label = "Local Topic"
emqx_bridge_rocketmq.rocketmq_action.desc = "Configuration for RocketMQ Action"
emqx_bridge_rocketmq.rocketmq_action.label = "RocketMQ Action Configuration"
emqx_bridge_rocketmq.strategy.desc = "Producer key dispatch strategy, the default is `roundrobin`, also supports placeholders, such as: `clientid`, `messageid`, `username`."
emqx_bridge_rocketmq.template.desc = "Template, the default value is empty. When this value is empty the whole message will be stored in the RocketMQ.<br>\n            The template can be any valid string with placeholders, example:<br>\n            - ${id}, ${username}, ${clientid}, ${timestamp}<br>\n            - {\"id\" : ${id}, \"username\" : ${username}}"
emqx_bridge_rocketmq.template.label = "Template"
emqx_bridge_rocketmq_connector.access_key.desc = "RocketMQ server `accessKey`."
emqx_bridge_rocketmq_connector.access_key.label = "AccessKey"
emqx_bridge_rocketmq_connector.namespace.desc = "The namespace field MUST be set if you are using the RocketMQ service in\naliyun cloud and also the namespace is enabled,\nor if you have configured a namespace in your RocketMQ server.\nFor RocketMQ in aliyun cloud, the namespace is the instance ID."
emqx_bridge_rocketmq_connector.namespace.label = "Namespace / Instance ID"
emqx_bridge_rocketmq_connector.refresh_interval.desc = "RocketMQ Topic Route Refresh Interval."
emqx_bridge_rocketmq_connector.refresh_interval.label = "Topic Route Refresh Interval"
emqx_bridge_rocketmq_connector.secret_key.desc = "RocketMQ server `secretKey`."
emqx_bridge_rocketmq_connector.secret_key.label = "SecretKey"
emqx_bridge_rocketmq_connector.security_token.desc = "RocketMQ Server Security Token"
emqx_bridge_rocketmq_connector.security_token.label = "Security Token"
emqx_bridge_rocketmq_connector.send_buffer.desc = "The socket send buffer size of the RocketMQ driver client."
emqx_bridge_rocketmq_connector.send_buffer.label = "Send Buffer Size"
emqx_bridge_rocketmq_connector.servers.desc = "The IPv4 or IPv6 address or the hostname to connect to.<br/>\nA host entry has the following form: `Host[:Port]`.<br/>\nThe RocketMQ default port 9876 is used if `[:Port]` is not specified."
emqx_bridge_rocketmq_connector.servers.label = "Server Host"
emqx_bridge_rocketmq_connector.sync_timeout.desc = "Timeout of RocketMQ driver synchronous call."
emqx_bridge_rocketmq_connector.sync_timeout.label = "Sync Timeout"
emqx_bridge_rocketmq_connector.topic.desc = "RocketMQ Topic"
emqx_bridge_rocketmq_connector.topic.label = "RocketMQ Topic"
emqx_bridge_s3.config_connector.desc = "Configuration for a connector to S3 API compatible storage service."
emqx_bridge_s3.config_connector.label = "S3 Connector Configuration"
emqx_bridge_s3_upload.s3_aggregated_container.desc = "Settings governing the file format of an upload containing aggregated events."
emqx_bridge_s3_upload.s3_aggregated_container.label = "Container for aggregated events"
emqx_bridge_s3_upload.s3_aggregated_container_csv.desc = "Records (events) will be aggregated and uploaded as a CSV file."
emqx_bridge_s3_upload.s3_aggregated_container_csv.label = "CSV container"
emqx_bridge_s3_upload.s3_aggregated_container_csv_column_order.desc = "Event fields that will be ordered first as columns in the resulting CSV file.<br/>\nRegardless of this setting, resulting CSV will contain all the fields of aggregated events, but all the columns not explicitly mentioned here will be ordered after the ones listed here in the lexicographical order."
emqx_bridge_s3_upload.s3_aggregated_container_csv_column_order.label = "CSV column order"
emqx_bridge_s3_upload.s3_aggregated_upload_key.desc = "Template for the S3 object key of an aggregated upload.<br/>\nTemplate may contain placeholders for the following variables:\n<ul>\n<li><code>${action}</code>: name of the action (required).</li>\n<li><code>${node}</code>: name of the EMQX node conducting the upload (required).</li>\n<li><code>${datetime.{format}}</code>: date and time when aggregation started, formatted according to the <code>{format}</code> string (required):\n    <ul>\n    <li><code>${datetime.rfc3339utc}</code>: RFC3339-formatted date and time in UTC,</li>\n    <li><code>${datetime.rfc3339}</code>: RFC3339-formatted date and time in local timezone,</li>\n    <li><code>${datetime.unix}</code>: Unix timestamp.</li>\n    </ul>\n</li>\n<li><code>${datetime_until.{format}}</code>: date and time when aggregation ended, with the same formatting options.</li>\n<li><code>${sequence}</code>: sequence number of the aggregated upload within the same time interval (required).</li>\n</ul>\nAll other placeholders are considered invalid. Note that placeholders marked as required will be added as a path suffix to the S3 object key if they are missing from the template."
emqx_bridge_s3_upload.s3_aggregated_upload_key.label = "S3 object key template"
emqx_bridge_s3_upload.s3_aggregated_upload_mode.desc = "Enables time-based aggregation of incoming events and uploading them to the S3 service as a single object."
emqx_bridge_s3_upload.s3_aggregated_upload_mode.label = "Aggregated S3 Upload"
emqx_bridge_s3_upload.s3_aggregated_upload_parameters.desc = "Set of parameters for the aggregated upload action."
emqx_bridge_s3_upload.s3_aggregated_upload_parameters.label = "Aggregated S3 Upload action parameters"
emqx_bridge_s3_upload.s3_aggregation.desc = "Set of parameters governing the aggregation process."
emqx_bridge_s3_upload.s3_aggregation.label = "Aggregation parameters"
emqx_bridge_s3_upload.s3_aggregation_interval.desc = "Amount of time events will be aggregated in a single object before uploading."
emqx_bridge_s3_upload.s3_aggregation_interval.label = "Time interval"
emqx_bridge_s3_upload.s3_aggregation_max_records.desc = "Number of records (events) allowed per each aggregated object. Each aggregated upload will contain no more than that number of events, but may contain less.<br/>\nIf event rate is high enough, there obviously may be more than one aggregated upload during the same time interval. These uploads will have different, but consecutive sequence numbers, which will be a part of S3 object key."
emqx_bridge_s3_upload.s3_aggregation_max_records.label = "Maximum number of records"
emqx_bridge_s3_upload.s3_direct_upload_mode.desc = "Enables uploading of events to the S3 service as separate objects."
emqx_bridge_s3_upload.s3_direct_upload_mode.label = "Direct S3 Upload"
emqx_bridge_s3_upload.s3_direct_upload_parameters.desc = "Set of parameters for the upload action. Action supports templates in S3 bucket name, object key and object content."
emqx_bridge_s3_upload.s3_direct_upload_parameters.label = "Direct S3 Upload action parameters"
emqx_bridge_s3_upload.s3_object_content.desc = "Content of the S3 object being uploaded. Supports templates."
emqx_bridge_s3_upload.s3_object_content.label = "S3 Object Content"
emqx_bridge_s3_upload.s3_parameters.desc = "Set of parameters for the upload action."
emqx_bridge_s3_upload.s3_parameters.label = "S3 Upload parameters"
emqx_bridge_s3_upload.s3_upload.desc = "Action that takes incoming events and uploads them to the S3 API compatible service."
emqx_bridge_s3_upload.s3_upload.label = "Upload to S3"
