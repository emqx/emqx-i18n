emqx_mongodb.desc_topology.desc = "Topology of MongoDB."
emqx_mongodb.desc_topology.label = "Setting Topology"
emqx_mongodb.heartbeat_period.desc = "Controls when the driver checks the state of the MongoDB deployment. Specify the interval between checks, counted from the end of the previous check until the beginning of the next one. If the number of connections is increased (which will happen, for example, if you increase the pool size), you may need to increase this period as well to avoid creating too many log entries in the MongoDB log file."
emqx_mongodb.heartbeat_period.label = "Heartbeat period"
emqx_mongodb.local_threshold.desc = "The size of the latency window for selecting among multiple suitable MongoDB instances."
emqx_mongodb.local_threshold.label = "Local Threshold"
emqx_mongodb.max_overflow.desc = "The maximum number of additional workers that can be created when all workers in the pool are busy. This helps to manage temporary spikes in workload by allowing more concurrent connections to the MongoDB server."
emqx_mongodb.max_overflow.label = "Max Overflow Workers"
emqx_mongodb.min_heartbeat_period.desc = "Controls the minimum amount of time to wait between heartbeats."
emqx_mongodb.min_heartbeat_period.label = "Minimum Heartbeat Period"
emqx_mongodb.overflow_check_period.desc = "Period for checking if there are more workers than configured (\"overflow\")."
emqx_mongodb.overflow_check_period.label = "Overflow Check Period"
emqx_mongodb.overflow_ttl.desc = "Period of time before workers that exceed the configured pool size (\"overflow\") to be terminated."
emqx_mongodb.overflow_ttl.label = "Overflow TTL"
emqx_mongodb.r_mode.desc = "Read mode."
emqx_mongodb.r_mode.label = "Read Mode"
emqx_mongodb.replica_set_name.desc = "Name of the replica set."
emqx_mongodb.replica_set_name.label = "Replica Set Name"
emqx_mongodb.rs_mongo_type.desc = "Replica set. Must be set to 'rs' when MongoDB server is running in 'replica set' mode."
emqx_mongodb.rs_mongo_type.label = "Replica set"
emqx_mongodb.server.desc = "The IPv4 or IPv6 address or the hostname to connect to.<br/>\nA host entry has the following form: `Host[:Port]`.<br/>\nThe MongoDB default port 27017 is used if `[:Port]` is not specified."
emqx_mongodb.server.label = "Server Host"
emqx_mongodb.server_selection_timeout.desc = "Specifies how long to block for server selection before throwing an exception."
emqx_mongodb.server_selection_timeout.label = "Server Selection Timeout"
emqx_mongodb.servers.desc = "A Node list for Cluster to connect to. The nodes should be separated with commas, such as: `Node[,Node].`\nFor each Node should be: The IPv4 or IPv6 address or the hostname to connect to.\nA host entry has the following form: `Host[:Port]`.\nThe MongoDB default port 27017 is used if `[:Port]` is not specified."
emqx_mongodb.servers.label = "Servers"
emqx_mongodb.sharded_mongo_type.desc = "Sharded cluster. Must be set to 'sharded' when MongoDB server is running in 'sharded' mode."
emqx_mongodb.sharded_mongo_type.label = "Sharded cluster"
emqx_mongodb.single_mongo_type.desc = "Standalone instance. Must be set to 'single' when MongoDB server is running in standalone mode."
emqx_mongodb.single_mongo_type.label = "Standalone instance"
emqx_mongodb.socket_timeout.desc = "The duration to attempt to send or to receive on a socket before the attempt times out."
emqx_mongodb.socket_timeout.label = "Socket Timeout"
emqx_mongodb.srv_record.desc = "Use DNS SRV record."
emqx_mongodb.srv_record.label = "Srv Record"
emqx_mongodb.use_legacy_protocol.desc = "Whether to use MongoDB's legacy protocol for communicating with the database.  The default is to attempt to automatically determine if the newer protocol is supported."
emqx_mongodb.use_legacy_protocol.label = "Use legacy protocol"
emqx_mongodb.w_mode.desc = "Write mode."
emqx_mongodb.w_mode.label = "Write Mode"
emqx_mongodb.wait_queue_timeout.desc = "The maximum duration that a worker can wait for a connection to become available."
emqx_mongodb.wait_queue_timeout.label = "Wait Queue Timeout"
emqx_mqttsn_schema.mqttsn.desc = "The MQTT-SN Gateway configuration.\nThis gateway only supports the v1.2 protocol"
emqx_mqttsn_schema.mqttsn_broadcast.desc = "Whether to periodically broadcast ADVERTISE messages"
emqx_mqttsn_schema.mqttsn_enable_qos3.desc = "Allows connectionless clients to publish messages with a Qos of -1.\nThis feature is defined for very simple client implementations which do not support any other features except this one. There is no connection setup nor tear down, no registration nor subscription. The client just sends its 'PUBLISH' messages to a GW"
emqx_mqttsn_schema.mqttsn_gateway_id.desc = "MQTT-SN Gateway ID.\nWhen the <code>broadcast</code> option is enabled, the gateway will broadcast ADVERTISE message with this value"
emqx_mqttsn_schema.mqttsn_predefined.desc = "The pre-defined topic IDs and topic names.\nA 'pre-defined' topic ID is a topic ID whose mapping to a topic name is known in advance by both the client's application and the gateway"
emqx_mqttsn_schema.mqttsn_predefined_id.desc = "Topic ID. Range: 1-65535"
emqx_mqttsn_schema.mqttsn_predefined_topic.desc = "Topic Name"
emqx_mqttsn_schema.mqttsn_subs_resume.desc = "Whether to initiate all subscribed topic name registration messages to the client after the Session has been taken over by a new channel"
emqx_mt_api.bulk_import_configs.desc = "Upsert namespace configurations in bulk"
emqx_mt_api.bulk_import_configs.label = "Upsert namespace configurations in bulk"
