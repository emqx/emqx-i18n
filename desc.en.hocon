emqx_dashboard_schema.mfa_mechanism.label = "MFA Mechanism"
emqx_dashboard_schema.mfa_settings.desc = "Multifactor authentication settings."
emqx_dashboard_schema.mfa_settings.label = "MFA Settings"
emqx_dashboard_schema.num_acceptors.desc = "Socket acceptor pool size for TCP protocols. Default is the number of schedulers online"
emqx_dashboard_schema.num_acceptors.label = "Number of acceptors"
emqx_dashboard_schema.password_expired_time.desc = "The expiration time for the password of users. The default value `0` means the password will never expire."
emqx_dashboard_schema.proxy_header.desc = "Enable support for `HAProxy` header. Be aware once enabled regular HTTP requests can't be handled anymore."
emqx_dashboard_schema.proxy_header.label = "Enable support for HAProxy header"
emqx_dashboard_schema.sample_interval.desc = "How often to update metrics displayed in the dashboard.\nNote: `sample_interval` should be a divisor of 60, default is 10s."
emqx_dashboard_schema.send_timeout.desc = "Send timeout for the socket."
emqx_dashboard_schema.send_timeout.label = "Send timeout"
emqx_dashboard_schema.ssl_options.desc = "SSL/TLS options for the dashboard listener."
emqx_dashboard_schema.ssl_options.label = "SSL options"
emqx_dashboard_schema.swagger_support.desc = "Enable or disable support for swagger API documentation."
emqx_dashboard_schema.swagger_support.label = "Swagger Support"
emqx_dashboard_schema.token_expired_time.desc = "JWT token expiration time. Default is 60 minutes"
emqx_dashboard_schema.token_expired_time.label = "Token expired time"
emqx_dashboard_schema.unsuccessful_login_interval.desc = "The time interval for accumulating the number of unsuccessful login attempts."
emqx_dashboard_schema.unsuccessful_login_interval.label = "Unsuccessful login accumulation time interval"
emqx_dashboard_schema.unsuccessful_login_lock_duration.desc = "The duration of the lock period for a user after reaching the maximum number of unsuccessful login attempts."
