emqx_bridge_iotdb_connector.config_zoneId.desc = "Timezone for IoTDB Thrift session"
emqx_bridge_iotdb_connector.connect_timeout.desc = "Timeout for connecting to the IoTDB Thrift server"
emqx_bridge_iotdb_connector.desc_config.desc = "Configuration for Apache IoTDB bridge."
emqx_bridge_iotdb_connector.desc_config.label = "IoTDB Bridge Configuration"
emqx_bridge_iotdb_connector.pool_size.desc = "Size for the IoTDB Thrift connection pool"
emqx_bridge_iotdb_connector.recv_timeout.desc = "Timeout for IoTDB Thrift server response"
emqx_bridge_iotdb_connector.server.desc = "The address of the IoTDB Thrift server (host:port)"
emqx_bridge_kafka.auth_gssapi_kerberos.desc = "Use GSSAPI/Kerberos authentication."
emqx_bridge_kafka.auth_gssapi_kerberos.label = "GSSAPI/Kerberos"
emqx_bridge_kafka.auth_kerberos_keytab_file.desc = "SASL GSSAPI authentication Kerberos keytab file path. NOTE: This file has to be placed in EMQX nodes, and the EMQX service runner user requires read permission."
emqx_bridge_kafka.auth_kerberos_keytab_file.label = "Kerberos keytab file"
emqx_bridge_kafka.auth_kerberos_principal.desc = "SASL GSSAPI authentication Kerberos principal. For example <code>kafka/node1.example.com@EXAMPLE.COM</code>, NOTE: The realm in use has to be configured in /etc/krb5.conf in EMQX nodes."
emqx_bridge_kafka.auth_kerberos_principal.label = "Kerberos Principal"
emqx_bridge_kafka.auth_sasl_mechanism.desc = "SASL authentication mechanism."
emqx_bridge_kafka.auth_sasl_mechanism.label = "Mechanism"
emqx_bridge_kafka.auth_sasl_password.desc = "SASL authentication password."
emqx_bridge_kafka.auth_sasl_password.label = "Password"
emqx_bridge_kafka.auth_sasl_username.desc = "SASL authentication username."
emqx_bridge_kafka.auth_sasl_username.label = "Username"
emqx_bridge_kafka.auth_username_password.desc = "Username/password based authentication."
emqx_bridge_kafka.auth_username_password.label = "Username/password Auth"
emqx_bridge_kafka.authentication.desc = "Authentication configs."
emqx_bridge_kafka.authentication.label = "Authentication"
emqx_bridge_kafka.bootstrap_hosts.desc = "A comma separated list of Kafka <code>host:port</code> endpoints to bootstrap the client."
emqx_bridge_kafka.bootstrap_hosts.label = "Bootstrap Hosts"
emqx_bridge_kafka.buffer_memory_overload_protection.desc = "Applicable when buffer mode is set to <code>memory</code>\nEMQX will drop old buffered messages under high memory pressure. The high memory threshold is defined in config <code>sysmon.os.sysmem_high_watermark</code>. NOTE: This config only works on Linux."
emqx_bridge_kafka.buffer_memory_overload_protection.label = "Memory Overload Protection"
emqx_bridge_kafka.buffer_mode.desc = "Message buffer mode.\n\n<code>memory</code>: Buffer all messages in memory. The messages will be lost in case of EMQX node restart\n<code>disk</code>: Buffer all messages on disk. The messages on disk are able to survive EMQX node restart.\n<code>hybrid</code>: Buffer message in memory first, when up to certain limit (see <code>segment_bytes</code> config for more information), then start offloading messages to disk, Like <code>memory</code> mode, the messages will be lost in case of EMQX node restart."
emqx_bridge_kafka.buffer_mode.label = "Buffer Mode"
emqx_bridge_kafka.buffer_per_partition_limit.desc = "Number of bytes allowed to buffer for each partition. When this limit is exceeded, older messages will be discarded to make room for new messages to be buffered."
emqx_bridge_kafka.buffer_per_partition_limit.label = "Per-partition Buffer Limit"
emqx_bridge_kafka.buffer_segment_bytes.desc = "Applicable when buffer mode is set to <code>disk</code> or <code>hybrid</code>.\nThis setting specifies the size of each buffer file stored on disk."
emqx_bridge_kafka.buffer_segment_bytes.label = "Segment File Bytes"
emqx_bridge_kafka.compression.desc = "Specify the method of compression."
emqx_bridge_kafka.compression.label = "Compression"
emqx_bridge_kafka.config_enable.desc = "Enable (true) or disable (false) config."
emqx_bridge_kafka.config_enable.label = "Enable or Disable"
emqx_bridge_kafka.connect_timeout.desc = "Maximum wait time for TCP connection establishment (including authentication time if enabled)."
emqx_bridge_kafka.connect_timeout.label = "Connect Timeout"
emqx_bridge_kafka.consumer_kafka_opts.desc = "Kafka consumer configs."
emqx_bridge_kafka.consumer_kafka_opts.label = "Kafka Consumer"
emqx_bridge_kafka.consumer_kafka_topic.desc = "Kafka topic to consume from."
emqx_bridge_kafka.consumer_kafka_topic.label = "Kafka Topic"
emqx_bridge_kafka.consumer_key_encoding_mode.desc = "Defines how the key from the Kafka message is encoded before being forwarded via MQTT.\n<code>none</code> Uses the key from the Kafka message unchanged.  Note: in this case, the key must be a valid UTF-8 string.\n<code>base64</code> Uses base-64 encoding on the received key."
emqx_bridge_kafka.consumer_key_encoding_mode.label = "Key Encoding Mode"
emqx_bridge_kafka.consumer_max_batch_bytes.desc = "Set how many bytes to pull from Kafka in each fetch request.\nMessages are fetched in batches by the consumer, and if the first record batch in the first non-empty\npartition of the fetch is larger than this value, the record batch will still be returned to ensure\nthat the consumer can make progress. As such, this is not an absolute maximum. Set `1` for minimal latency."
emqx_bridge_kafka.consumer_max_batch_bytes.label = "Fetch Bytes"
emqx_bridge_kafka.consumer_max_rejoin_attempts.desc = "Maximum number of times allowed for a member to re-join the group. If the consumer group can not reach balance after this configured number of attempts, the consumer group member will restart after a delay."
emqx_bridge_kafka.consumer_max_rejoin_attempts.label = "Max Rejoin Attempts"
emqx_bridge_kafka.consumer_mqtt_opts.desc = "Local MQTT message publish."
emqx_bridge_kafka.consumer_mqtt_opts.label = "MQTT publish"
emqx_bridge_kafka.consumer_mqtt_payload.desc = "The template for transforming the incoming Kafka message.  By default, it will use JSON format to serialize inputs from the Kafka message.  Such fields are:\n<code>headers</code>: an object containing string key-value pairs.\n<code>key</code>: Kafka message key (uses the chosen key encoding).\n<code>offset</code>: offset for the message.\n<code>topic</code>: Kafka topic.\n<code>ts</code>: message timestamp.\n<code>ts_type</code>: message timestamp type, which is one of <code>create</code>, <code>append</code> or <code>undefined</code>.\n<code>value</code>: Kafka message value (uses the chosen value encoding)."
emqx_bridge_kafka.consumer_mqtt_payload.label = "MQTT Payload Template"
emqx_bridge_kafka.consumer_mqtt_qos.desc = "MQTT QoS used to publish messages consumed from Kafka."
emqx_bridge_kafka.consumer_mqtt_qos.label = "QoS"
emqx_bridge_kafka.consumer_mqtt_topic.desc = "Local topic to which consumed Kafka messages should be published to."
emqx_bridge_kafka.consumer_mqtt_topic.label = "MQTT Topic"
emqx_bridge_kafka.consumer_offset_commit_interval_seconds.desc = "Defines the time interval between two offset commit requests sent for each consumer group."
emqx_bridge_kafka.consumer_offset_commit_interval_seconds.label = "Offset Commit Interval"
emqx_bridge_kafka.consumer_offset_reset_policy.desc = "Defines from which offset a consumer should start fetching when there is no commit history or when the commit history becomes invalid."
emqx_bridge_kafka.consumer_offset_reset_policy.label = "Offset Reset Policy"
emqx_bridge_kafka.consumer_opts.desc = "Local MQTT publish and Kafka consumer configs."
emqx_bridge_kafka.consumer_opts.label = "MQTT to Kafka"
emqx_bridge_kafka.consumer_topic_mapping.desc = "Defines the mapping between Kafka topics and MQTT topics. Must contain at least one item."
emqx_bridge_kafka.consumer_topic_mapping.label = "Topic Mapping"
emqx_bridge_kafka.consumer_value_encoding_mode.desc = "Defines how the value from the Kafka message is encoded before being forwarded via MQTT.\n<code>none</code> Uses the value from the Kafka message unchanged.  Note: in this case, the value must be a valid UTF-8 string.\n<code>base64</code> Uses base-64 encoding on the received value."
emqx_bridge_kafka.consumer_value_encoding_mode.label = "Value Encoding Mode"
emqx_bridge_kafka.desc_config.desc = "Configuration for a Kafka Producer Client."
emqx_bridge_kafka.desc_config.label = "Kafka Producer Client Configuration"
emqx_bridge_kafka.desc_name.desc = "Action name, used as a human-readable identifier."
emqx_bridge_kafka.desc_name.label = "Action Name"
emqx_bridge_kafka.desc_type.desc = "The Action Type"
emqx_bridge_kafka.desc_type.label = "Action Type"
emqx_bridge_kafka.kafka_consumer.desc = "Kafka Consumer configuration."
emqx_bridge_kafka.kafka_consumer.label = "Kafka Consumer"
emqx_bridge_kafka.kafka_header_value_encode_mode.desc = "The encoding mode for headers.\n\n - `none`: Add only strings are added as header values\n - `json`: Encode header values as JSON string"
emqx_bridge_kafka.kafka_header_value_encode_mode.label = "Headers value encode mode"
emqx_bridge_kafka.kafka_headers.desc = "Provide a placeholder for message headers<br/>\ne.g. <code>${pub_props}</code><br/>\nNote that the value of the placeholder must be either an object:\n<code>{\"foo\": \"bar\"}</code>\nor an array of key-value pairs:\n<code>[{\"key\": \"foo\", \"value\": \"bar\"}]</code>"
emqx_bridge_kafka.kafka_headers.label = "Message Headers"
emqx_bridge_kafka.kafka_message.desc = "Template for rendering a message."
emqx_bridge_kafka.kafka_message.label = "Message Template"
emqx_bridge_kafka.kafka_message_key.desc = "Template for rendering message key. If the template is rendered into a NULL value (i.e. there is no such data field in Rule Engine context) then <code>NULL</code> (but not empty string) is used."
emqx_bridge_kafka.kafka_message_key.label = "Message Key"
emqx_bridge_kafka.kafka_message_timestamp.desc = "Which timestamp to use. The timestamp is expected to be a millisecond precision Unix epoch which can be in string format, e.g. <code>1661326462115</code> or <code>'1661326462115'</code>. When the desired data field for this template is not found, or if the found data is not a valid integer, the current system timestamp will be used."
emqx_bridge_kafka.kafka_message_timestamp.label = "Message Timestamp"
emqx_bridge_kafka.kafka_message_value.desc = "Template for rendering Kafka message value. If the template is rendered into a NULL value (i.e. there is no such data field in Rule Engine context) then Kafka's <code>NULL</code> (but not empty string) is used."
emqx_bridge_kafka.kafka_message_value.label = "Message Value"
emqx_bridge_kafka.kafka_producer.desc = "Kafka Producer configuration."
emqx_bridge_kafka.kafka_producer.label = "Kafka Producer"
emqx_bridge_kafka.kafka_producer_action.desc = "Producer Action"
emqx_bridge_kafka.kafka_producer_action.label = "Producer Action"
emqx_bridge_kafka.kafka_topic.desc = "Kafka topic name.  Supports templates (e.g.: `t-${payload.t}`)."
emqx_bridge_kafka.kafka_topic.label = "Kafka Topic Name"
emqx_bridge_kafka.max_batch_bytes.desc = "Maximum bytes to collect in a Kafka message batch. Most of the Kafka brokers default to a limit of 1 MB batch size. EMQX's default value is less than 1 MB in order to compensate Kafka message encoding overheads (especially when each individual message is very small). When a single message is over the limit, it is still sent (as a single element batch)."
emqx_bridge_kafka.max_batch_bytes.label = "Max Batch Bytes"
emqx_bridge_kafka.max_inflight.desc = "The maximum number of message batches that the producer can send to each partition before it must wait for an acknowledgement.\nSetting a higher number can enhance throughput. However, value above 1 may lead to potential message reordering risks."
emqx_bridge_kafka.max_inflight.label = "Max Inflight"
emqx_bridge_kafka.max_linger_bytes.desc = "Maximum number of bytes for a per-partition producer to wait for messages in order to collect a batch to buffer."
emqx_bridge_kafka.max_linger_bytes.label = "Max Linger Bytes"
emqx_bridge_kafka.max_linger_time.desc = "Maximum duration for a per-partition producer to wait for messages in order to collect a batch to buffer.\nThe default value `0` means no wait. For non-memory buffer mode, it's advised to configure at least `5ms` for less IOPS."
emqx_bridge_kafka.max_linger_time.label = "Max Linger Time"
emqx_bridge_kafka.metadata_request_timeout.desc = "Maximum wait time when fetching topic metadata."
emqx_bridge_kafka.metadata_request_timeout.label = "Metadata Request Timeout"
emqx_bridge_kafka.min_metadata_refresh_interval.desc = "Minimum time interval the client has to wait before refreshing Kafka broker and topic metadata. Setting too small value may add extra load on Kafka."
emqx_bridge_kafka.min_metadata_refresh_interval.label = "Min Metadata Refresh Interval"
emqx_bridge_kafka.mqtt_topic.desc = "MQTT topic or topic filter as data source (action input).  If rule action is used as data source, this config should be left empty, otherwise messages will be duplicated in Kafka."
emqx_bridge_kafka.mqtt_topic.label = "Source MQTT Topic"
emqx_bridge_kafka.partition_count_refresh_interval.desc = "The time interval for Kafka producer to discover increased number of partitions.\nAfter the number of partitions is increased in Kafka, EMQX will start taking the\ndiscovered partitions into account when dispatching messages per <code>partition_strategy</code>."
emqx_bridge_kafka.partition_count_refresh_interval.label = "Partition Count Refresh Interval"
emqx_bridge_kafka.partition_strategy.desc = "Partition strategy is to tell the producer how to dispatch messages to partitions.\n\n<code>random</code>: Randomly pick a partition for each message.\n<code>key_dispatch</code>: Assigns messages to partitions based on a hash of the message key,\nensuring consistent partition for messages with the same key."
emqx_bridge_kafka.partition_strategy.label = "Partition Strategy"
emqx_bridge_kafka.partitions_limit.desc = "Limit the number of partitions to produce data for the given topic.\nThe special value `all_partitions` is to utilize all partitions for the topic.\nSetting this to a value which is greater than the total number of partitions in has no effect."
emqx_bridge_kafka.partitions_limit.label = "Max Partitions"
emqx_bridge_kafka.producer_buffer.desc = "Configure producer message buffer.\n\nTell Kafka producer how to buffer messages when EMQX has more messages to send than Kafka can keep up, or when Kafka is down."
emqx_bridge_kafka.producer_buffer.label = "Message Buffer"
emqx_bridge_kafka.producer_health_check_topic.desc = "Topic name used exclusively for more accurate connector health checks."
emqx_bridge_kafka.producer_health_check_topic.label = "Connector health check topic"
emqx_bridge_kafka.producer_kafka_ext_header_key.desc = "Key of the header. Placeholders in format of ${var} are supported."
emqx_bridge_kafka.producer_kafka_ext_header_key.label = "Extra Headers Key"
emqx_bridge_kafka.producer_kafka_ext_header_value.desc = "Value of the header. Placeholders in format of ${var} are supported."
emqx_bridge_kafka.producer_kafka_ext_header_value.label = "Extra Headers Value"
emqx_bridge_kafka.producer_kafka_ext_headers.desc = "Provide more key-value pairs for message headers<br/>\nThe key-value pairs here will be combined with the\nvalue of <code>kafka_headers</code> field before sending producing."
emqx_bridge_kafka.producer_kafka_ext_headers.label = "Extra Headers"
emqx_bridge_kafka.producer_kafka_opts.desc = "Kafka producer configs."
emqx_bridge_kafka.producer_kafka_opts.label = "Kafka Producer"
emqx_bridge_kafka.query_mode.desc = "Query mode. Optional 'sync/async', default 'async'."
emqx_bridge_kafka.query_mode.label = "Query mode"
emqx_bridge_kafka.required_acks.desc = "The acknowledgement criteria for the partition leader. It determines the level of confirmation required from partition replicas before sending an acknowledgement back to the producer.\n\n<code>all_isr</code>: Require all in-sync replicas to acknowledge.\n<code>leader_only</code>: Require only the partition-leader's acknowledgement.\n<code>none</code>: No need for Kafka to acknowledge at all."
emqx_bridge_kafka.required_acks.label = "Required Acks"
emqx_bridge_kafka.server_name_indication.desc = "Server Name Indication (SNI) setting for TLS handshake.<br/>\n- <code>auto</code>: Allow the client to automatically determine the appropriate SNI.<br/>\n- <code>disable</code>: If you wish to prevent the client from sending the SNI.<br/>\n- Other string values will be sent as-is."
emqx_bridge_kafka.server_name_indication.label = "SNI"
emqx_bridge_kafka.socket_nodelay.desc = "When set to 'true', TCP buffer is sent as soon as possible. Otherwise, the OS kernel may buffer small TCP packets for a while (40 ms by default)."
emqx_bridge_kafka.socket_nodelay.label = "No Delay"
emqx_bridge_kafka.socket_opts.desc = "Extra socket options."
emqx_bridge_kafka.socket_opts.label = "Socket Options"
emqx_bridge_kafka.socket_receive_buffer.desc = "Fine tune the socket receive buffer. The default value is tuned for high throughput."
emqx_bridge_kafka.socket_receive_buffer.label = "Socket Receive Buffer Size"
emqx_bridge_kafka.socket_send_buffer.desc = "Fine tune the socket send buffer. The default value is tuned for high throughput."
emqx_bridge_kafka.socket_send_buffer.label = "Socket Send Buffer Size"
emqx_bridge_kafka.ssl_client_opts.desc = "TLS/SSL options for client."
emqx_bridge_kafka.ssl_client_opts.label = "TLS/SSL options"
emqx_bridge_kafka.sync_query_timeout.desc = "This parameter defines the timeout limit for synchronous queries. It applies only when the query mode is configured to 'sync'."
emqx_bridge_kafka.sync_query_timeout.label = "Synchronous Query Timeout"
emqx_bridge_kafka_consumer_schema.config_connector.desc = "Configuration for a Kafka Consumer Client."
emqx_bridge_kafka_consumer_schema.config_connector.label = "Kafka Consumer Client Configuration"
emqx_bridge_kafka_consumer_schema.consumer_source.desc = "Source configs."
emqx_bridge_kafka_consumer_schema.consumer_source.label = "Source"
emqx_bridge_kafka_consumer_schema.group_id.desc = "Consumer group identifier to be used for this source.  If omitted, one based off the source name will be automatically generated."
emqx_bridge_kafka_consumer_schema.group_id.label = "Custom Consumer Group Id"
emqx_bridge_kafka_consumer_schema.max_wait_time.desc = "Maximum amount of time that is waited for the Kafka broker to send a fetch response."
emqx_bridge_kafka_consumer_schema.max_wait_time.label = "Max Wait Time"
emqx_bridge_kafka_consumer_schema.source_parameters.desc = "Source specific configs."
emqx_bridge_kafka_consumer_schema.source_parameters.label = "Source Specific Configs"
emqx_bridge_kinesis.action_parameters.desc = "Action specific configuration."
emqx_bridge_kinesis.action_parameters.label = "Action"
emqx_bridge_kinesis.aws_access_key_id.desc = "Access Key ID for connecting to Amazon Kinesis."
emqx_bridge_kinesis.aws_access_key_id.label = "AWS Access Key ID"
emqx_bridge_kinesis.aws_secret_access_key.desc = "AWS Secret Access Key for connecting to Amazon Kinesis."
emqx_bridge_kinesis.aws_secret_access_key.label = "AWS Secret Access Key"
emqx_bridge_kinesis.config_connector.desc = "Configuration for a Kinesis Client."
emqx_bridge_kinesis.config_connector.label = "Kinesis Client Configuration"
emqx_bridge_kinesis.config_enable.desc = "Enable or disable this action"
emqx_bridge_kinesis.config_enable.label = "Enable Or Disable Action"
emqx_bridge_kinesis.desc_config.desc = "Configuration for an Amazon Kinesis action."
emqx_bridge_kinesis.desc_config.label = "Amazon Kinesis Action Configuration"
emqx_bridge_kinesis.desc_name.desc = "Action name."
emqx_bridge_kinesis.desc_name.label = "Action Name"
emqx_bridge_kinesis.desc_type.desc = "The action type."
emqx_bridge_kinesis.desc_type.label = "Action Type"
emqx_bridge_kinesis.endpoint.desc = "The url of Amazon Kinesis endpoint."
emqx_bridge_kinesis.endpoint.label = "Amazon Kinesis Endpoint"
emqx_bridge_kinesis.kinesis_action.desc = "Configuration for Kinesis Action"
emqx_bridge_kinesis.kinesis_action.label = "Kinesis Action Configuration"
emqx_bridge_kinesis.local_topic.desc = "The MQTT topic filter to be forwarded to Amazon Kinesis. All MQTT `PUBLISH` messages with the topic\nmatching the `local_topic` will be forwarded.<br/>\nNOTE: If this action is used as the action of a rule (EMQX rule engine), and also `local_topic` is\nconfigured, then both the data got from the rule and the MQTT messages that match `local_topic`\nwill be forwarded."
emqx_bridge_kinesis.local_topic.label = "Local Topic"
emqx_bridge_kinesis.max_retries.desc = "Max retry times if an error occurs when sending a request."
emqx_bridge_kinesis.max_retries.label = "Max Retries"
emqx_bridge_kinesis.partition_key.desc = "The Amazon Kinesis Partition Key associated to published message. Placeholders in format of ${var} are supported."
emqx_bridge_kinesis.partition_key.label = "Partition key"
emqx_bridge_kinesis.payload_template.desc = "The template for formatting the outgoing messages.  If undefined, will send all the available context in JSON format."
emqx_bridge_kinesis.payload_template.label = "Payload template"
emqx_bridge_kinesis.pool_size.desc = "The pool size."
emqx_bridge_kinesis.pool_size.label = "Pool Size"
emqx_bridge_kinesis.stream_name.desc = "The Amazon Kinesis Stream to publish messages to."
emqx_bridge_kinesis.stream_name.label = "Amazon Kinesis Stream"
emqx_bridge_mongodb.action_parameters.desc = "Additional parameters specific to this action type"
emqx_bridge_mongodb.action_parameters.label = "Action Parameters"
emqx_bridge_mongodb.batch_size.desc = "There is no batching support for MongoDB at the moment, so this config field has no effect. Internally the value is overridden to 1."
emqx_bridge_mongodb.batch_size.label = "Batch Size"
emqx_bridge_mongodb.collection.desc = "The collection where data will be stored into"
emqx_bridge_mongodb.collection.label = "Collection to be used"
emqx_bridge_mongodb.desc_config.desc = "Configuration for MongoDB action"
emqx_bridge_mongodb.desc_config.label = "MongoDB Action Configuration"
emqx_bridge_mongodb.desc_name.desc = "Action name."
emqx_bridge_mongodb.desc_name.label = "Action Name"
emqx_bridge_mongodb.desc_type.desc = "The action type."
emqx_bridge_mongodb.desc_type.label = "Action Type"
emqx_bridge_mongodb.enable.desc = "Enable or disable this MongoDB Action"
emqx_bridge_mongodb.enable.label = "Enable or disable"
emqx_bridge_mongodb.mongodb_action.desc = "Action to interact with a MongoDB connector"
emqx_bridge_mongodb.mongodb_action.label = "MongoDB Action"
emqx_bridge_mongodb.mongodb_parameters.desc = "Set of parameters specific for the given type of this MongoDB connector, `mongo_type` can be one of `single` (Standalone), `sharded` (Sharded) or `rs` (Replica Set)."
emqx_bridge_mongodb.mongodb_parameters.label = "MongoDB Type Specific Parameters"
emqx_bridge_mongodb.mongodb_rs_conf.desc = "MongoDB (Replica Set) configuration"
emqx_bridge_mongodb.mongodb_rs_conf.label = "MongoDB (Replica Set) Configuration"
emqx_bridge_mongodb.mongodb_sharded_conf.desc = "MongoDB (Sharded) configuration"
emqx_bridge_mongodb.mongodb_sharded_conf.label = "MongoDB (Sharded) Configuration"
emqx_bridge_mongodb.mongodb_single_conf.desc = "MongoDB (Standalone) configuration"
emqx_bridge_mongodb.mongodb_single_conf.label = "MongoDB (Standalone) Configuration"
emqx_bridge_mongodb.mqtt_topic.desc = "MQTT topic or topic filter as data source (action input).  If rule action is used as data source, this config should be left empty, otherwise messages will be duplicated in MongoDB."
emqx_bridge_mongodb.mqtt_topic.label = "Source MQTT Topic"
emqx_bridge_mongodb.payload_template.desc = "The template for formatting the outgoing messages.  If undefined, rule engine will use JSON format to serialize all visible inputs, such as clientid, topic, payload etc."
emqx_bridge_mongodb.payload_template.label = "Payload template"
emqx_bridge_mqtt_connector_schema.bridge_mode.desc = "If enable bridge mode.\nNOTE: This setting is only for MQTT protocol version older than 5.0, and the remote MQTT\nbroker MUST support this feature.\nIf bridge_mode is set to true, the bridge will indicate to the remote broker that it is a bridge not an ordinary client.\nThis means that loop detection will be more effective and that retained messages will be propagated correctly."
emqx_bridge_mqtt_connector_schema.bridge_mode.label = "Bridge Mode"
emqx_bridge_mqtt_connector_schema.clean_start.desc = "Whether to start a clean session when reconnecting a remote broker for ingress bridge"
emqx_bridge_mqtt_connector_schema.clean_start.label = "Clean Session"
emqx_bridge_mqtt_connector_schema.clientid_prefix.desc = "Optional prefix to prepend to the clientid used by egress bridges.\nDoes not apply if `static_clientids` is used."
emqx_bridge_mqtt_connector_schema.clientid_prefix.label = "Clientid Prefix"
emqx_bridge_mqtt_connector_schema.config_connector.desc = "Configurations for an MQTT connector."
emqx_bridge_mqtt_connector_schema.config_connector.label = "MQTT connector"
emqx_bridge_mqtt_connector_schema.connect_timeout.desc = "Timeout for connecting to the remote broker.  The connection worker process is blocked up to this amount of time when attempting the initial connection."
emqx_bridge_mqtt_connector_schema.connect_timeout.label = "Connect Timeout"
emqx_bridge_mqtt_connector_schema.egress_desc.desc = "The egress config defines how this bridge forwards messages from the local broker to the remote broker.<br/>\nTemplate with variables is allowed in 'remote.topic', 'local.qos', 'local.retain', 'local.payload'.<br/>\nNOTE: if this bridge is used as the action of a rule, and also 'local.topic'\nis configured, then both the data got from the rule and the MQTT messages that matches\n'local.topic' will be forwarded."
emqx_bridge_mqtt_connector_schema.egress_desc.label = "Egress Configs"
emqx_bridge_mqtt_connector_schema.egress_local.desc = "The configs about receiving messages from local broker."
emqx_bridge_mqtt_connector_schema.egress_local.label = "Local Configs"
emqx_bridge_mqtt_connector_schema.egress_local_topic.desc = "The local topic to be forwarded to the remote broker"
emqx_bridge_mqtt_connector_schema.egress_local_topic.label = "Local Topic"
emqx_bridge_mqtt_connector_schema.egress_pool_size.desc = "Size of the pool of MQTT clients that will publish messages to the remote broker.<br/>\nEach MQTT client will be assigned 'clientid' of the form '${clientid_prefix}:${bridge_name}:egress:${node}:${n}'\nwhere 'n' is the number of a client inside the pool.\n\nThis option does not take effect if `static_clientids` is not empty. When static client IDs is in use, pool size is always derived from the number of assigned IDs for each node."
emqx_bridge_mqtt_connector_schema.egress_pool_size.label = "Pool Size"
emqx_bridge_mqtt_connector_schema.egress_remote.desc = "The configs about sending message to the remote broker."
emqx_bridge_mqtt_connector_schema.egress_remote.label = "Remote Configs"
emqx_bridge_mqtt_connector_schema.egress_remote_qos.desc = "The QoS of the MQTT message to be sent.<br/>\nTemplate with variables is allowed."
emqx_bridge_mqtt_connector_schema.egress_remote_qos.label = "Remote QoS"
emqx_bridge_mqtt_connector_schema.egress_remote_topic.desc = "Forward to which topic of the remote broker.<br/>\nTemplate with variables is allowed."
emqx_bridge_mqtt_connector_schema.egress_remote_topic.label = "Remote Topic"
emqx_bridge_mqtt_connector_schema.ingress_desc.desc = "The ingress config defines how this bridge receive messages from the remote MQTT broker, and then\n        send them to the local broker.<br/>\n        Template with variables is allowed in 'remote.qos', 'local.topic', 'local.qos', 'local.retain', 'local.payload'.<br/>\n        NOTE: if this bridge is used as the input of a rule, and also 'local.topic' is\n        configured, then messages got from the remote broker will be sent to both the 'local.topic' and\n        the rule."
emqx_bridge_mqtt_connector_schema.ingress_desc.label = "Ingress Configs"
emqx_bridge_mqtt_connector_schema.ingress_local.desc = "The configs about sending message to the local broker."
emqx_bridge_mqtt_connector_schema.ingress_local.label = "Local Configs"
emqx_bridge_mqtt_connector_schema.ingress_local_qos.desc = "The QoS of the MQTT message to be sent.<br/>\nTemplate with variables is allowed."
emqx_bridge_mqtt_connector_schema.ingress_local_qos.label = "Local QoS"
emqx_bridge_mqtt_connector_schema.ingress_local_topic.desc = "Send messages to which topic of the local broker.<br/>\nTemplate with variables is allowed."
emqx_bridge_mqtt_connector_schema.ingress_local_topic.label = "Local Topic"
emqx_bridge_mqtt_connector_schema.ingress_pool_size.desc = "Size of the pool of MQTT clients that will ingest messages from the remote broker.<br/>\nThis value will be respected only if 'remote.topic' is a shared subscription topic or topic-filter\n(for example `$share/name1/topic1` or `$share/name2/topic2/#`), otherwise only a single MQTT client will be used.\nEach MQTT client will be assigned 'clientid' of the form '${clientid_prefix}:${bridge_name}:ingress:${node}:${n}'\nwhere 'n' is the number of a client inside the pool.\nNOTE: Non-shared subscription will not work well when EMQX is clustered.\n\nThis option does not take effect if `static_clientids` is not empty. When static client IDs is in use, pool size is always derived from the number of assigned IDs for each node."
emqx_bridge_mqtt_connector_schema.ingress_pool_size.label = "Pool Size"
emqx_bridge_mqtt_connector_schema.ingress_remote.desc = "The configs about subscribing to the remote broker."
emqx_bridge_mqtt_connector_schema.ingress_remote.label = "Remote Configs"
emqx_bridge_mqtt_connector_schema.ingress_remote_qos.desc = "The QoS level to be used when subscribing to the remote broker"
emqx_bridge_mqtt_connector_schema.ingress_remote_qos.label = "Remote QoS"
emqx_bridge_mqtt_connector_schema.ingress_remote_topic.desc = "Receive messages from which topic of the remote broker"
emqx_bridge_mqtt_connector_schema.ingress_remote_topic.label = "Remote Topic"
emqx_bridge_mqtt_connector_schema.max_inflight.desc = "Max inflight (sent, but un-acked) messages of the MQTT protocol"
emqx_bridge_mqtt_connector_schema.max_inflight.label = "Max Inflight Message"
emqx_bridge_mqtt_connector_schema.mode.desc = "The mode of the MQTT Bridge.<br/>\n- cluster_shareload: create an MQTT connection on each node in the emqx cluster.<br/>\nIn 'cluster_shareload' mode, the incoming load from the remote broker is shared by\nusing shared subscription.<br/>\nNote that the 'clientid' is suffixed by the node name, this is to avoid\nclientid conflicts between different nodes. And we can only use shared subscription\ntopic filters for <code>remote.topic</code> of ingress connections."
emqx_bridge_mqtt_connector_schema.mode.label = "MQTT Bridge Mode"
emqx_bridge_mqtt_connector_schema.password.desc = "The password of the MQTT protocol"
emqx_bridge_mqtt_connector_schema.password.label = "Password"
emqx_bridge_mqtt_connector_schema.payload.desc = "The payload of the MQTT message to be sent.<br/>\nTemplate with variables is allowed."
emqx_bridge_mqtt_connector_schema.payload.label = "Payload"
emqx_bridge_mqtt_connector_schema.proto_ver.desc = "The MQTT protocol version"
emqx_bridge_mqtt_connector_schema.proto_ver.label = "Protocol Version"
emqx_bridge_mqtt_connector_schema.retain.desc = "The 'retain' flag of the MQTT message to be sent.<br/>\nTemplate with variables is allowed."
emqx_bridge_mqtt_connector_schema.retain.label = "Retain Flag"
emqx_bridge_mqtt_connector_schema.server.desc = "The host and port of the remote MQTT broker"
emqx_bridge_mqtt_connector_schema.server.label = "Broker IP And Port"
emqx_bridge_mqtt_connector_schema.server_configs.desc = "Configs related to the server."
emqx_bridge_mqtt_connector_schema.server_configs.label = "Server Configs"
emqx_bridge_mqtt_connector_schema.static_clientid_entry.desc = "Entries mapping EMQX node names to static client IDs.\n\nIf any entries are defined, then only EMQX nodes matching those entries will start MQTT clients with the corresponding clientids."
emqx_bridge_mqtt_connector_schema.static_clientid_entry.label = "Static ClientId Entries"
emqx_bridge_mqtt_connector_schema.static_clientid_entry_ids.desc = "Array of static client IDs assigned to this node."
emqx_bridge_mqtt_connector_schema.static_clientid_entry_ids.label = "Static clientids"
emqx_bridge_mqtt_connector_schema.static_clientid_entry_node.desc = "Node name (e.g.: `emqx@10.0.0.1`)."
emqx_bridge_mqtt_connector_schema.static_clientid_entry_node.label = "Node name"
emqx_bridge_mqtt_connector_schema.username.desc = "The username of the MQTT protocol"
emqx_bridge_mqtt_connector_schema.username.label = "Username"
emqx_bridge_mqtt_pubsub_schema.action_parameters.desc = "Action specific configs."
emqx_bridge_mqtt_pubsub_schema.action_parameters.label = "Action"
emqx_bridge_mqtt_pubsub_schema.ingress_parameters.desc = "Source specific configs."
emqx_bridge_mqtt_pubsub_schema.ingress_parameters.label = "Source"
emqx_bridge_mqtt_pubsub_schema.mqtt_publisher_action.desc = "Action configs."
emqx_bridge_mqtt_pubsub_schema.mqtt_publisher_action.label = "Action"
emqx_bridge_mqtt_pubsub_schema.mqtt_subscriber_source.desc = "Source configs."
emqx_bridge_mqtt_pubsub_schema.mqtt_subscriber_source.label = "Source"
emqx_bridge_mqtt_pubsub_schema.source_no_local.desc = "Whether to set the no-local flag when subscribing to the remote topic.  If set to true, and you use the same connector to publish messages to a topic you also subscribe to, this prevents the server from forwarding your own published messages back to you.  Only takes effect when using MQTT protocol version 5.  Note that if you use a pool of workers larger than 1 you will still receive duplicated messages back."
emqx_bridge_mqtt_pubsub_schema.source_no_local.label = "No Local"
emqx_bridge_mqtt_schema.config.desc = "The config for MQTT Bridges."
emqx_bridge_mqtt_schema.config.label = "Config"
emqx_bridge_mqtt_schema.desc_name.desc = "Bridge name, used as a human-readable identifier."
emqx_bridge_mqtt_schema.desc_name.label = "Bridge Name"
emqx_bridge_mqtt_schema.desc_type.desc = "The bridge type."
emqx_bridge_mqtt_schema.desc_type.label = "Bridge Type"
emqx_bridge_mysql.action_parameters.desc = "Additional parameters specific to this action type"
emqx_bridge_mysql.action_parameters.label = "Action Parameters"
emqx_bridge_mysql.config_enable.desc = "Enable or disable this action"
