emqx_gateway_api_listeners.delete_user.desc = "Delete the user for the gateway authenticator (only supports built_in_database)"
emqx_gateway_api_listeners.get_listener.desc = "Get the gateway listener configs"
emqx_gateway_api_listeners.get_listener_authn.desc = "Get the listener's authenticator configs."
emqx_gateway_api_listeners.get_user.desc = "Get user info from the gateway authenticator (only supports built_in_database)"
emqx_gateway_api_listeners.import_users.desc = "Import users into the gateway authenticator (only supports built_in_database)"
emqx_gateway_api_listeners.list_listeners.desc = "Gets a list of gateway listeners. This interface returns all the configs of the listener (including the authenticator on that listener), as well as the status of that listener running in the cluster."
emqx_gateway_api_listeners.list_users.desc = "Get the users for the authenticator (only supported by <code>built_in_database</code>)"
emqx_gateway_api_listeners.listener_id.desc = "Listener ID"
emqx_gateway_api_listeners.listener_node_status.desc = "listener status of each node in the cluster"
emqx_gateway_api_listeners.listener_status.desc = "listener status"
emqx_gateway_api_listeners.node.desc = "Node Name"
emqx_gateway_api_listeners.update_listener.desc = "Update the gateway listener. The listener being updated performs a restart and all clients connected to that listener will be disconnected."
emqx_gateway_api_listeners.update_listener_authn.desc = "Update authenticator configs for the listener, or disable/enable it."
emqx_gateway_api_listeners.update_user.desc = "Update the user info for the gateway authenticator (only supports built_in_database)"
emqx_gateway_schema.dtls_listener_acceptors.desc = "Size of the acceptor pool."
emqx_gateway_schema.dtls_listener_dtls_opts.desc = "DTLS socket options"
emqx_gateway_schema.fields_ws_opts_allow_origin_absence.desc = "If <code>false</code> and <code>check_origin_enable</code> is\n <code>true</code>, the server will reject requests that don't have <code>origin</code>\n HTTP header."
emqx_gateway_schema.fields_ws_opts_allow_origin_absence.label = "Allow origin absence"
emqx_gateway_schema.fields_ws_opts_check_origin_enable.desc = "If <code>true</code>, <code>origin</code> HTTP header will be\n validated against the list of allowed origins configured in <code>check_origins</code>\n parameter."
emqx_gateway_schema.fields_ws_opts_check_origin_enable.label = "Check origin"
emqx_gateway_schema.fields_ws_opts_check_origins.desc = "List of allowed origins.<br/>See <code>check_origin_enable</code>."
emqx_gateway_schema.fields_ws_opts_check_origins.label = "Allowed origins"
emqx_gateway_schema.fields_ws_opts_compress.desc = "If <code>true</code>, compress WebSocket messages using <code>zlib</code>.<br/>\nThe configuration items under <code>deflate_opts</code> belong to the compression-related parameter configuration."
emqx_gateway_schema.fields_ws_opts_compress.label = "Ws compress"
emqx_gateway_schema.fields_ws_opts_fail_if_no_subprotocol.desc = "If <code>true</code>, the server will return an error when\n the client does not carry the <code>Sec-WebSocket-Protocol</code> field.\n <br/>Note: WeChat applet needs to disable this verification."
emqx_gateway_schema.fields_ws_opts_fail_if_no_subprotocol.label = "Fail if no subprotocol"
emqx_gateway_schema.fields_ws_opts_idle_timeout.desc = "The timeout for waiting for the WebSocket upgrade request. After the timeout, the connection will be closed."
emqx_gateway_schema.fields_ws_opts_idle_timeout.label = "WebSocket Upgrade Timeout"
emqx_gateway_schema.fields_ws_opts_max_frame_size.desc = "The maximum length of a single MQTT packet."
emqx_gateway_schema.fields_ws_opts_max_frame_size.label = "Max frame size"
emqx_gateway_schema.fields_ws_opts_path.desc = "WebSocket's MQTT protocol path. So the address of EMQX Broker's WebSocket is:\n<code>ws://{ip}:{port}/mqtt</code>"
emqx_gateway_schema.fields_ws_opts_path.label = "WS MQTT Path"
emqx_gateway_schema.fields_ws_opts_piggyback.desc = "Whether a WebSocket message is allowed to contain multiple MQTT packets."
emqx_gateway_schema.fields_ws_opts_piggyback.label = "MQTT Piggyback"
emqx_gateway_schema.fields_ws_opts_proxy_address_header.desc = "HTTP header used to pass information about the client IP address.\nRelevant when the EMQX cluster is deployed behind a load-balancer."
emqx_gateway_schema.fields_ws_opts_proxy_address_header.label = "Proxy address header"
emqx_gateway_schema.fields_ws_opts_proxy_port_header.desc = "HTTP header used to pass information about the client port. Relevant when the EMQX cluster is deployed behind a load-balancer."
emqx_gateway_schema.fields_ws_opts_proxy_port_header.label = "Proxy port header"
emqx_gateway_schema.fields_ws_opts_supported_subprotocols.desc = "Comma-separated list of supported subprotocols."
emqx_gateway_schema.fields_ws_opts_supported_subprotocols.label = "Supported subprotocols"
emqx_gateway_schema.gateway_common_authentication.desc = "Default authentication configs for all the gateway listeners. For per-listener overrides see <code>authentication</code>\n in listener configs"
emqx_gateway_schema.gateway_common_clientinfo_override.desc = "ClientInfo override."
emqx_gateway_schema.gateway_common_clientinfo_override_clientid.desc = "Template for overriding clientid."
emqx_gateway_schema.gateway_common_clientinfo_override_password.desc = "Template for overriding password."
emqx_gateway_schema.gateway_common_clientinfo_override_username.desc = "Template for overriding username."
emqx_gateway_schema.gateway_common_enable.desc = "Whether to enable this gateway"
emqx_gateway_schema.gateway_common_enable_stats.desc = "Whether to enable client process statistic"
emqx_gateway_schema.gateway_common_idle_timeout.desc = "The idle time of the client connection process. It has two purposes:\n  1. A newly created client process that does not receive any client requests after that time will be closed directly.\n  2. A running client process that does not receive any client requests after this time will go into hibernation to save resources."
emqx_gateway_schema.gateway_common_listener_access_rules.desc = "An access rule list consisting of string rules to restrict or allow access from some addresses.\nThe rules that appear earlier in the list are matched first.\nThe format is `allow | deny <address> | <CIDR> | all`.\n\nFor example:\n\n`[\"deny 192.168.1.1\", \"allow 192.168.1.0/24\", \"deny all\"]`"
emqx_gateway_schema.gateway_common_listener_bind.desc = "The IP address and port that the listener will bind."
emqx_gateway_schema.gateway_common_listener_enable.desc = "Enable the listener."
emqx_gateway_schema.gateway_common_listener_enable_authn.desc = "Set <code>true</code> (default) to enable client authentication on this listener.\nWhen set to <code>false</code> clients will be allowed to connect without authentication."
emqx_gateway_schema.gateway_common_listener_max_conn_rate.desc = "Maximum connections per second."
emqx_gateway_schema.gateway_common_listener_max_connections.desc = "The maximum number of concurrent connections allowed by the listener."
emqx_gateway_schema.gateway_mountpoint.desc = "When publishing or subscribing, prefix all topics with a mountpoint string.\nThe prefixed string will be removed from the topic name when the message is delivered to the subscriber.\nThe mountpoint is a way that users can use to implement isolation of message routing between different listeners.\nFor example if a client A subscribes to `t` with `listeners.tcp.\\<name>.mountpoint` set to `some_tenant`,\nthen the client actually subscribes to the topic `some_tenant/t`.\nSimilarly, if another client B (connected to the same listener as the client A) sends a message to topic `t`,\nthe message is routed to all the clients subscribed `some_tenant/t`,\nso client A will receive the message, with topic name `t`. Set to `\"\"` to disable the feature.\nSupported placeholders in mountpoint string:<br/>\n  - <code>${clientid}</code>: clientid<br/>\n  - <code>${username}</code>: username<br/>\n  - <code>${endpoint_name}</code>: endpoint name"
emqx_gateway_schema.listener_name_to_settings_map.desc = "A map from listener names to listener settings."
emqx_gateway_schema.ssl_listener_options.desc = "SSL Socket options."
emqx_gateway_schema.tcp_listener_acceptors.desc = "Size of the acceptor pool."
emqx_gateway_schema.tcp_listener_proxy_protocol.desc = "If a reverse proxy is deployed for EMQX, and the PROXY protocol is enabled at the proxy to pass the client's real IP,\nthis option needs to be turned on so that EMQX can extract the client's real IP from the PROXY protocol header.\nEMQX will automatically detect the version of the PROXY protocol and support V1 and V2.\n\nFor a detailed description of the PROXY protocol, please refer to: https://www.haproxy.com/blog/haproxy/proxy-protocol/"
emqx_gateway_schema.tcp_listener_proxy_protocol_timeout.desc = "Timeout for proxy protocol.\nEMQX will close the TCP connection if proxy protocol packet is not received within the timeout."
emqx_gateway_schema.tcp_listener_tcp_opts.desc = "Setting the TCP socket options."
emqx_gateway_schema.tcp_listeners.desc = "Settings for the TCP listeners."
emqx_gateway_schema.tcp_udp_listeners.desc = "Settings for the listeners."
emqx_gateway_schema.udp_health_check.desc = "Some Cloud platform use a `request-reply` mechanism to check whether a UDP port is healthy, here can configure this pair."
emqx_gateway_schema.udp_health_check_reply.desc = "The content to reply."
emqx_gateway_schema.udp_health_check_request.desc = "The content of the request."
emqx_gateway_schema.udp_listener_active_n.desc = "Specify the {active, N} option for the socket.\nSee: https://erlang.org/doc/man/inet.html#setopts-2"
emqx_gateway_schema.udp_listener_buffer.desc = "Size of the user-space buffer for the socket."
emqx_gateway_schema.udp_listener_recbuf.desc = "Size of the kernel-space receive buffer for the socket."
emqx_gateway_schema.udp_listener_reuseaddr.desc = "Allow local reuse of port numbers."
emqx_gateway_schema.udp_listener_sndbuf.desc = "Size of the kernel-space send buffer for the socket."
emqx_gateway_schema.udp_listener_udp_opts.desc = "Settings for the UDP sockets."
emqx_gateway_schema.udp_listeners.desc = "Settings for the UDP listeners."
