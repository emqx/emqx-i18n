emqx_bridge_schema.desc_node_status.label = "Node Status"
emqx_bridge_schema.desc_status.desc = "The status of the bridge<br/>\n- <code>connecting</code>: the initial state before any health probes were made.<br/>\n- <code>connected</code>: when the bridge passes the health probes.<br/>\n- <code>disconnected</code>: when the bridge can not pass health probes.<br/>\n- <code>stopped</code>: when the bridge resource is requested to be stopped.<br/>\n- <code>inconsistent</code>: When not all the nodes are at the same status."
emqx_bridge_schema.desc_status.label = "Bridge Status"
emqx_bridge_schema.desc_status_reason.desc = "This is the reason given in case a bridge is failing to connect."
emqx_bridge_schema.desc_status_reason.label = "Failure reason"
emqx_bridge_schema.metric_dropped.desc = "Count of messages dropped."
emqx_bridge_schema.metric_dropped.label = "Dropped"
emqx_bridge_schema.metric_dropped_other.desc = "Count of messages dropped due to other reasons."
emqx_bridge_schema.metric_dropped_other.label = "Dropped Other"
emqx_bridge_schema.metric_dropped_queue_full.desc = "Count of messages dropped due to the queue is full."
emqx_bridge_schema.metric_dropped_queue_full.label = "Dropped Queue Full"
emqx_bridge_schema.metric_dropped_resource_not_found.desc = "Count of messages dropped due to the resource is not found."
emqx_bridge_schema.metric_dropped_resource_not_found.label = "Dropped Resource NotFound"
emqx_bridge_schema.metric_dropped_resource_stopped.desc = "Count of messages dropped due to the resource is stopped."
emqx_bridge_schema.metric_dropped_resource_stopped.label = "Dropped Resource Stopped"
emqx_bridge_schema.metric_inflight.desc = "Count of messages that were sent asynchronously but ACKs are not yet received."
emqx_bridge_schema.metric_inflight.label = "Sent Inflight"
emqx_bridge_schema.metric_matched.desc = "Count of this bridge is matched and queried."
emqx_bridge_schema.metric_matched.label = "Matched"
emqx_bridge_schema.metric_queuing.desc = "Count of messages that are currently queuing."
emqx_bridge_schema.metric_queuing.label = "Queued"
emqx_bridge_schema.metric_rate.desc = "The rate of matched, times/second"
emqx_bridge_schema.metric_rate.label = "Rate"
emqx_bridge_schema.metric_rate_last5m.desc = "The average rate of matched in the last 5 minutes, times/second"
emqx_bridge_schema.metric_rate_last5m.label = "Last 5 Minutes Rate"
emqx_bridge_schema.metric_rate_max.desc = "The max rate of matched, times/second"
emqx_bridge_schema.metric_rate_max.label = "Max Rate Of Matched"
emqx_bridge_schema.metric_received.desc = "Count of messages that is received from the remote system."
emqx_bridge_schema.metric_received.label = "Received"
emqx_bridge_schema.metric_retried.desc = "Times of retried."
emqx_bridge_schema.metric_retried.label = "Retried"
emqx_bridge_schema.metric_sent_failed.desc = "Count of messages that sent failed."
emqx_bridge_schema.metric_sent_failed.label = "Sent Failed"
emqx_bridge_schema.metric_sent_success.desc = "Count of messages that sent successfully."
emqx_bridge_schema.metric_sent_success.label = "Sent Success"
emqx_bridge_snowflake_action_schema.aggreg_parameters.desc = "Set of parameters for the action in aggregated mode."
emqx_bridge_snowflake_action_schema.aggreg_parameters.label = "Snowflake Aggregated Mode action parameters"
emqx_bridge_snowflake_action_schema.aggregated_mode.desc = "Enables time-based aggregation of incoming events and uploading them to the Snowflake as a single object.  This aggregation is done independently by each node in the cluster."
emqx_bridge_snowflake_action_schema.aggregated_mode.label = "Aggregated Snowflake Upload"
emqx_bridge_snowflake_action_schema.aggregation.desc = "Set of parameters governing the aggregation process."
emqx_bridge_snowflake_action_schema.aggregation.label = "Aggregation parameters"
emqx_bridge_snowflake_action_schema.aggregation_interval.desc = "Amount of time events will be aggregated in a single file on each node before uploading."
emqx_bridge_snowflake_action_schema.aggregation_interval.label = "Time interval"
emqx_bridge_snowflake_action_schema.aggregation_max_records.desc = "Number of records (events) allowed per each aggregated file. Each aggregated upload will contain no more than that number of events, but may contain less.<br/>\n  If event rate is high enough, there obviously may be more than one aggregated upload during the same time interval. These uploads will have different, but consecutive sequence numbers, which will be a part of Snowflake staged file name."
emqx_bridge_snowflake_action_schema.aggregation_max_records.label = "Maximum number of records"
emqx_bridge_snowflake_action_schema.connect_timeout.desc = "The timeout when connecting to the HTTP server."
emqx_bridge_snowflake_action_schema.connect_timeout.label = "Connect Timeout"
emqx_bridge_snowflake_action_schema.database.desc = "Name of the Database that contains the Snowflake resources."
emqx_bridge_snowflake_action_schema.database.label = "Database"
emqx_bridge_snowflake_action_schema.max_retries.desc = "Max retry attempts if there's an error when sending an HTTP request."
emqx_bridge_snowflake_action_schema.max_retries.label = "Max Retries"
emqx_bridge_snowflake_action_schema.parameters.desc = "Set of parameters for the action."
emqx_bridge_snowflake_action_schema.parameters.label = "Snowflake action parameters"
emqx_bridge_snowflake_action_schema.pipe.desc = "Name of the Pipe that'll be used to ingest data into the table."
emqx_bridge_snowflake_action_schema.pipe.label = "Pipe"
emqx_bridge_snowflake_action_schema.pipe_user.desc = "A username which has a role with permissions over the Pipe to be used.  The minimum permissions are `operate` and `monitor`."
emqx_bridge_snowflake_action_schema.pipe_user.label = "Pipe User"
emqx_bridge_snowflake_action_schema.pipelining.desc = "A positive integer. Whether to send HTTP requests continuously, when set to 1, it means that after each HTTP request is sent, you need to wait for the server to return and then continue to send the next request."
emqx_bridge_snowflake_action_schema.pipelining.label = "HTTP Pipelining"
emqx_bridge_snowflake_action_schema.pool_size.desc = "The pool size."
emqx_bridge_snowflake_action_schema.pool_size.label = "Pool Size"
emqx_bridge_snowflake_action_schema.private_key.desc = "The private key configured for the Pipe User.  This supports the input formats below:\n- Plain key: Enter the private key contents in PEM format directly as a string value.\n- File Path: Specify the path to a file that contains the private key. Ensure the path starts with <code>file://</code>.  The file path must be the same on all nodes in the cluster."
emqx_bridge_snowflake_action_schema.private_key.label = "Private Key"
emqx_bridge_snowflake_action_schema.proxy_config.desc = "Proxy configuration.  Only plain HTTP proxies are currently supported (no HTTPS)."
