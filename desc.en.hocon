emqx_otel_schema.client_connect_disconnect.label = "Trace Client Connect/Disconnect"
emqx_otel_schema.client_messaging.desc = "Enable/Disable background messaging events for all clients at the configured sample ratio and trace-level."
emqx_otel_schema.client_messaging.label = "Trace Messaging Events"
emqx_otel_schema.client_subscribe_unsubscribe.desc = "Enable/Disable background tracing for all clients' subscribe/unsubscribe at the configured sample ratio."
emqx_otel_schema.client_subscribe_unsubscribe.label = "Trace Client Subscribe/Unsubscribe"
emqx_otel_schema.clientid_match_rules_max.desc = "Maximum length of the whitelist for clientid matching."
emqx_otel_schema.clientid_match_rules_max.label = "Maximum Number of Client ID Match Whitelist"
emqx_otel_schema.cluster_identifier.desc = "An attribute value added into Span's Attributes. The attribute key will be `cluster.id`\nTypically, set a simple and easily recognizable name or use the cluster name to identify different EMQX clusters."
emqx_otel_schema.cluster_identifier.label = "Cluster Identifier"
emqx_otel_schema.e2e_tracing_options.desc = "End-to-end tracing options"
emqx_otel_schema.e2e_tracing_options.label = "End-to-End Tracing Options"
emqx_otel_schema.enable.desc = "Enable or disable Open Telemetry signal."
emqx_otel_schema.enable.label = "Enable."
emqx_otel_schema.exporter_endpoint.desc = "The target URL to which the exporter is going to send Open Telemetry signal data."
emqx_otel_schema.exporter_endpoint.label = "Exporter Endpoint"
emqx_otel_schema.exporter_protocol.desc = "The transport protocol of Open Telemetry Exporter"
emqx_otel_schema.exporter_protocol.label = "Exporter Protocol"
emqx_otel_schema.exporter_ssl.desc = "SSL configuration for the Open Telemetry exporter"
emqx_otel_schema.exporter_ssl.label = "SSL Options"
emqx_otel_schema.exporting_timeout.desc = "The time Open Telemetry signal export can run before it is cancelled."
emqx_otel_schema.exporting_timeout.label = "Exporting Timeout"
emqx_otel_schema.follow_traceparent.desc = "Enable/Disable, Whether to follow the traceparent passed in by the client through User-Property."
emqx_otel_schema.follow_traceparent.label = "Follow Traceparent"
emqx_otel_schema.max_queue_size.desc = "The maximum queue size. After the size is reached Open Telemetry signals are dropped."
emqx_otel_schema.max_queue_size.label = "Max Queue Size"
emqx_otel_schema.msg_trace_level.desc = "Trace level for all message exchanges during the message publishing process.\n- `0`: Basic events during message publish will be recorded as Spans.\n  Including 'client.publish', 'client.authz', 'message.route', 'message.forward', 'message.handle_forward', 'broker.publish'.\n- `1`: In addition to basic events.\n  The events 'broker.puback', 'client.puback', 'broker.pubrec', 'client.pubrec' will be recorded as Spans.\n  That is, the first response packet in the QoS1 or QoS2 message interaction.\n- `2`: In addition to level 1.\n  The events 'broker.pubrel', 'client.pubrel', 'broker.pubcomp', 'client.pubcomp' will be recorded as Spans."
emqx_otel_schema.msg_trace_level.label = "Message Trace Level"
emqx_otel_schema.opentelemetry.desc = "Open Telemetry Toolkit configuration"
emqx_otel_schema.opentelemetry.label = "Open Telemetry"
emqx_otel_schema.otel_exporter.desc = "Open Telemetry Exporter"
emqx_otel_schema.otel_exporter.label = "Exporter"
emqx_otel_schema.otel_log_handler_level.desc = "The log level of the Open Telemetry log handler."
emqx_otel_schema.otel_log_handler_level.label = "Log Level"
emqx_otel_schema.otel_logs.desc = "Open Telemetry Logs configuration. If enabled, EMQX installs a log handler that formats events according to Open Telemetry log data model and\nexports them to the configured Open Telemetry collector or backend."
emqx_otel_schema.otel_logs.label = "Open Telemetry Logs"
emqx_otel_schema.otel_metrics.desc = "Open Telemetry Metrics configuration."
emqx_otel_schema.otel_metrics.label = "Open Telemetry Metrics"
emqx_otel_schema.otel_traces.desc = "Open Telemetry Traces configuration."
emqx_otel_schema.otel_traces.label = "Open Telemetry Traces"
emqx_otel_schema.sample_ratio.desc = "Background tracing sample ratio for the listed event types."
emqx_otel_schema.sample_ratio.label = "Sampling Ratio"
emqx_otel_schema.scheduled_delay.desc = "The delay interval between two consecutive exports of Open Telemetry signals."
emqx_otel_schema.scheduled_delay.label = "Scheduled Delay Interval"
emqx_otel_schema.topic_match_rules_max.desc = "Maximum length of the whitelist based for topic matching."
emqx_otel_schema.topic_match_rules_max.label = "Maximum Number of Topic Match Whitelist"
emqx_otel_schema.trace_all.desc = "If enabled, all published messages are traced, a new trace ID is generated if it can't be extracted from the message.\nOtherwise, only messages published with trace context are traced.\nDisabled by default.\nNote: this config only takes effect when `trace_mode` is set to `legacy`."
emqx_otel_schema.trace_all.label = "Trace All"
emqx_otel_schema.trace_filter.desc = "Open Telemetry Trace Filter configuration"
emqx_otel_schema.trace_filter.label = "Trace Filter"
emqx_otel_schema.trace_mode.desc = "OpenTelemetry tracing mode.\n- `legacy`: follow the old tracing method, only trace message publishing and delivery.\n  Span names will be compatible to versions before 5.9.\n- `e2e`: end-to-end tracing mode. All client behaviors will be traced:\n  - connect and disconnect\n  - subscribe and unsubscribe\n  - messaging events such as `PUBLISH`, `PUBACK`, `PUBREL` etc.\n  When enabled (for each type of events), there will be a background tracing for all clients at the configured sample ratio.\n  From the dashboard, one can also add additional trace whitelist on top of the background tracing at full volume for a list of clients or topics.\n  See dashboard or API documents for more details.\n  More control and sampling options can be provided in `e2e_tracing_options`"
emqx_otel_schema.trace_mode.label = "Trace Mode"
emqx_otel_schema.trace_rule_engine.desc = "Enable/Disable background tracing of rule engine execution for all clients at the configured sample ratio."
emqx_otel_schema.trace_rule_engine.label = "Trace Rule Engine"
emqx_plugins_schema.check_interval.desc = "Check interval: check if the status of the plugins in the cluster is consistent, <br/>\nif the results of 3 consecutive checks are not consistent, then alarm."
emqx_plugins_schema.enable.desc = "Set to 'true' to enable this plugin"
emqx_plugins_schema.enable.label = "Enable"
emqx_plugins_schema.install_dir.desc = "The installation directory for the external plugins.\nThe plugin beam files and configuration files should reside in\nthe subdirectory named as <code>emqx_foo_bar-0.1.0</code>.\n<br/>\nNOTE: For security reasons, this directory should **NOT** be writable\nby anyone except <code>emqx</code> (or any user which runs EMQX)."
emqx_plugins_schema.install_dir.label = "Install Directory"
emqx_plugins_schema.name_vsn.desc = "The `{name}-{version}` of the plugin.<br/>\nIt should match the plugin application name-version as plugin release package name<br/>\nFor example: `my_plugin-0.1.0`."
emqx_plugins_schema.name_vsn.label = "Name-Version"
emqx_plugins_schema.plugins.desc = "Manage EMQX plugins.<br/>\nPlugins can be pre-built as a part of EMQX package,\nor installed as a standalone package in a location specified by\n<code>install_dir</code> config key<br/>\nThe standalone-installed plugins are referred to as 'external' plugins."
emqx_plugins_schema.plugins.label = "Plugins"
emqx_plugins_schema.state.desc = "A per-plugin config to describe the desired state of the plugin."
emqx_plugins_schema.state.label = "State"
emqx_plugins_schema.states.desc = "An array of plugins in the desired states.<br/>\nThe plugins are started in the defined order"
emqx_plugins_schema.states.label = "States"
emqx_postgresql.config_connector.desc = "The configuration for the PostgreSQL connector."
emqx_postgresql.config_connector.label = "PostgreSQL Connector Config"
emqx_postgresql.disable_prepared_statements.desc = "Disables the usage of prepared statements in the connections.\nSome endpoints, like PGBouncer or Supabase in Transaction mode, do not\nsupport session features such as prepared statements.  For such connections,\nthis option should be enabled."
emqx_postgresql.disable_prepared_statements.label = "Disable Prepared Statements"
emqx_postgresql.server.desc = "The IPv4 or IPv6 address or the hostname to connect to.<br/>\nA host entry has the following form: `Host[:Port]`.<br/>\nThe PostgreSQL default port 5432 is used if `[:Port]` is not specified."
emqx_postgresql.server.label = "Server Host"
emqx_postgresql_connector_schema.config_connector.desc = "The configuration for the PostgreSQL connector."
emqx_postgresql_connector_schema.config_connector.label = "PostgreSQL Connector Config"
emqx_postgresql_connector_schema.server.desc = "The IPv4 or IPv6 address or the hostname to connect to.<br/>\nA host entry has the following form: `Host[:Port]`.<br/>\nThe PostgreSQL default port 5432 is used if `[:Port]` is not specified."
emqx_postgresql_connector_schema.server.label = "Server Host"
emqx_prometheus_api.get_prom_auth_data.desc = "Get Prometheus Metrics for AuthN, AuthZ and Banned"
emqx_prometheus_api.get_prom_auth_data.label = "Prometheus Metrics for Auth"
emqx_prometheus_api.get_prom_conf_info.desc = "Get Prometheus config info"
emqx_prometheus_api.get_prom_conf_info.label = "Get Prometheus config info"
emqx_prometheus_api.get_prom_data.desc = "Get Prometheus Metrics"
emqx_prometheus_api.get_prom_data.label = "Prometheus Metrics"
emqx_prometheus_api.get_prom_data_integration_data.desc = "Get Prometheus Metrics for Data Integration"
emqx_prometheus_api.get_prom_data_integration_data.label = "Prometheus Metrics for Data Integration"
emqx_prometheus_api.get_prom_message_transformation.desc = "Get Prometheus Metrics for Message Validation"
emqx_prometheus_api.get_prom_message_transformation.label = "Prometheus Metrics for Message Validation"
emqx_prometheus_api.get_prom_schema_validation.desc = "Get Prometheus Metrics for Schema Validation"
emqx_prometheus_api.get_prom_schema_validation.label = "Prometheus Metrics for Schema Validation"
emqx_prometheus_api.update_prom_conf_info.desc = "Update Prometheus config"
emqx_prometheus_api.update_prom_conf_info.label = "Update Prometheus config"
emqx_prometheus_schema.collectors.desc = "The internal advanced metrics of the virtual machine are initially disabled\nand are usually only enabled during performance testing.\nEnabling them will increase the CPU load."
emqx_prometheus_schema.enable_basic_auth.desc = "Enable or disable basic authentication for prometheus scrape api, not for Push Gateway"
emqx_prometheus_schema.headers.desc = "An HTTP Headers when pushing to Push Gateway.<br/>\nFor example, <code> { Authorization = \"some-authz-tokens\"}</code>"
emqx_prometheus_schema.interval.desc = "Data reporting interval"
emqx_prometheus_schema.job_name.desc = "Job Name that is pushed to the Push Gateway. Available variables:<br/>\n- ${cluster_name}: Name of EMQX cluster.<br/>\n- ${name}: Name of EMQX node.<br/>\n- ${host}: Host name of EMQX node.<br/>\nFor example, when the EMQX node name is <code>emqx@127.0.0.1</code> then the <code>name</code>\nvariable takes value <code>emqx</code> and the <code>host</code> variable takes value <code>127.0.0.1</code>.\nDefault value is: <code>${name}/instance/${name}~${host}</code>"
emqx_prometheus_schema.latency_buckets.desc = "Comma separated duration values for latency histogram buckets."
emqx_prometheus_schema.latency_buckets.label = "Latency Histogram Buckets"
emqx_prometheus_schema.legacy_deprecated_setting.desc = "Deprecated since 5.4.0"
emqx_prometheus_schema.legacy_enable.desc = "Deprecated since 5.4.0, use `prometheus.push_gateway.url` instead"
emqx_prometheus_schema.legacy_headers.desc = "Deprecated since 5.4.0, use `prometheus.push_gateway.headers` instead"
emqx_prometheus_schema.legacy_interval.desc = "Deprecated since 5.4.0, use `prometheus.push_gateway.interval` instead"
emqx_prometheus_schema.legacy_job_name.desc = "Deprecated since 5.4.0, use `prometheus.push_gateway.job_name` instead"
emqx_prometheus_schema.legacy_mnesia_collector.desc = "Deprecated since 5.4.0, use `prometheus.collectors.mnesia` instead"
emqx_prometheus_schema.legacy_push_gateway_server.desc = "Deprecated since 5.4.0, use `prometheus.push_gateway.url` instead"
emqx_prometheus_schema.legacy_vm_dist_collector.desc = "Deprecated since 5.4.0, use `prometheus.collectors.vm_dist` instead"
emqx_prometheus_schema.legacy_vm_memory_collector.desc = "Deprecated since 5.4.0, use `prometheus.collectors.vm_memory` instead"
emqx_prometheus_schema.legacy_vm_msacc_collector.desc = "Deprecated since 5.4.0, use `prometheus.collectors.vm_msacc` instead"
emqx_prometheus_schema.legacy_vm_statistics_collector.desc = "Deprecated since 5.4.0, use `prometheus.collectors.vm_statistics` instead"
emqx_prometheus_schema.legacy_vm_system_info_collector.desc = "Deprecated, use `prometheus.collectors.vm_system_info` instead"
emqx_prometheus_schema.mnesia_collector.desc = "Collects Mnesia metrics mainly using <code> mnesia:system_info/1 </code>"
emqx_prometheus_schema.prometheus.desc = "EMQX's Prometheus scraping endpoint is enabled by default without authentication.\nYou can inspect it with a `curl` command like this: `curl -f \"127.0.0.1:18083/api/v5/prometheus/stats\"`"
emqx_prometheus_schema.prometheus.label = "Prometheus"
emqx_prometheus_schema.push_gateway.desc = "Push Gateway is optional, should not be configured if prometheus is to scrape EMQX."
emqx_prometheus_schema.push_gateway_enable.desc = "Enable or disable Pushgateway"
emqx_prometheus_schema.push_gateway_method.desc = "The HTTP Method of pushing metrics to Pushgateway. Available options:<br/>\n - <code>put</code>: All metrics with the grouping key specified in the URL are replaced by the metrics pushed with PUT.<br/>\n - <code>post</code>: POST works exactly like the PUT method but only metrics with the same name as the newly pushed metrics are replaced.<br/>\nThe default value is <code>put</code>."
emqx_prometheus_schema.push_gateway_url.desc = "URL of Pushgateway server. Pushgateway is optional, should not be configured if prometheus is to scrape EMQX."
emqx_prometheus_schema.recommend_setting.desc = "Recommended setting"
emqx_prometheus_schema.vm_dist_collector.desc = "Enable or disable VM distribution collector,\ncollects information about the sockets and processes involved in the Erlang distribution mechanism."
emqx_prometheus_schema.vm_memory_collector.desc = "Collects information about memory dynamically allocated by the Erlang emulator using\n<code> erlang:memory/0 </code>."
emqx_prometheus_schema.vm_msacc_collector.desc = "Enable or disable VM microstate accounting metrics collector."
emqx_prometheus_schema.vm_statistics_collector.desc = "Enable or disable VM statistics collector."
emqx_prometheus_schema.vm_system_info_collector.desc = "Enable or disable VM system info collector."
emqx_psk_schema.chunk_size.desc = "The size of each chunk used to import to the built-in database from PSK file"
emqx_psk_schema.enable.desc = "Whether to enable TLS PSK support"
emqx_psk_schema.init_file.desc = "If init_file is specified, EMQX will import PSKs from the file into the built-in database at startup for use by the runtime.\nThe file has to be structured line-by-line, each line must be in the format of <code>PSKIdentity:SharedSecret</code>.\nFor example: <code>mydevice1:c2VjcmV0</code>"
emqx_psk_schema.psk_authentication.desc = "PSK stands for 'Pre-Shared Keys'.\nThis config to enable TLS-PSK authentication.\n\nImportant! Make sure the SSL listener with only <code>tlsv1.2</code> enabled, and also PSK cipher suites\nconfigured, such as <code>RSA-PSK-AES256-GCM-SHA384</code>.\n\nSee listener SSL options config for more details.\n\nThe IDs and secrets can be provided from a file which is configurable by the <code>init_file</code> field."
emqx_psk_schema.separator.desc = "The separator between <code>PSKIdentity</code> and <code>SharedSecret</code> in the PSK file"
emqx_redis.cluster.desc = "Cluster mode. Must be set to 'cluster' when Redis server is running in clustered mode."
emqx_redis.cluster.label = "Cluster Mode"
emqx_redis.database.desc = "Redis database ID."
emqx_redis.database.label = "Database ID"
emqx_redis.redis_cluster_connector.desc = "Redis connector in cluster mode"
emqx_redis.redis_cluster_connector.label = "Redis Cluster Connector"
emqx_redis.redis_sentinel_connector.desc = "Redis connector in sentinel mode"
emqx_redis.redis_sentinel_connector.label = "Redis Sentinel Connector"
emqx_redis.redis_single_connector.desc = "Redis connector in sentinel mode"
emqx_redis.redis_single_connector.label = "Redis Single Connector"
emqx_redis.sentinel.desc = "Sentinel mode. Must be set to 'sentinel' when Redis server is running in sentinel mode."
emqx_redis.sentinel.label = "Sentinel Mode"
emqx_redis.sentinel_desc.desc = "The cluster name in Redis sentinel mode."
emqx_redis.sentinel_desc.label = "Cluster Name"
emqx_redis.server.desc = "The IPv4 or IPv6 address or the hostname to connect to.<br/>\nA host entry has the following form: `Host[:Port]`.<br/>\nThe Redis default port 6379 is used if `[:Port]` is not specified."
emqx_redis.server.label = "Server Host"
emqx_redis.servers.desc = "A Node list for Cluster to connect to. The nodes should be separated with commas, such as: `Node[,Node].`\nFor each Node should be: The IPv4 or IPv6 address or the hostname to connect to.\nA host entry has the following form: `Host[:Port]`.\nThe Redis default port 6379 is used if `[:Port]` is not specified."
emqx_redis.servers.label = "Servers"
emqx_redis.single.desc = "Single mode. Must be set to 'single' when Redis server is running in single mode."
emqx_redis.single.label = "Single Mode"
emqx_resource_schema.batch_size.desc = "Maximum batch count. If equal to 1, there's effectively no batching."
emqx_resource_schema.batch_size.label = "Max batch size"
emqx_resource_schema.batch_time.desc = "Maximum waiting interval when accumulating a batch at a low message rates for more efficient resource usage."
emqx_resource_schema.batch_time.label = "Max batch wait time"
emqx_resource_schema.buffer_seg_bytes.desc = "Applicable when buffer mode is set to <code>volatile_offload</code>.\nThis value is to specify the size of each on-disk buffer file."
emqx_resource_schema.buffer_seg_bytes.label = "Segment File Bytes"
emqx_resource_schema.creation_opts.desc = "Creation options."
emqx_resource_schema.creation_opts.label = "Creation Options"
emqx_resource_schema.enable_batch.desc = "Batch mode enabled."
emqx_resource_schema.enable_batch.label = "Enable batch"
emqx_resource_schema.enable_queue.desc = "Enable disk buffer queue (only applicable for egress bridges).\nWhen Enabled, messages will be buffered on disk when the bridge connection is down.\nWhen disabled the messages are buffered in RAM only."
emqx_resource_schema.enable_queue.label = "Enable disk buffer queue"
emqx_resource_schema.health_check_interval.desc = "Health check interval."
emqx_resource_schema.health_check_interval.label = "Health Check Interval"
emqx_resource_schema.inflight_window.desc = "Query inflight window. When query_mode is set to async, this config has to be set to 1 if messages from the same MQTT client have to be strictly ordered."
emqx_resource_schema.inflight_window.label = "Inflight window"
emqx_resource_schema.max_buffer_bytes.desc = "Maximum number of bytes to buffer for each buffer worker."
emqx_resource_schema.max_buffer_bytes.label = "Max buffer queue size"
emqx_resource_schema.query_mode.desc = "Query mode. Optional 'sync/async', default 'async'."
emqx_resource_schema.query_mode.label = "Query mode"
emqx_resource_schema.request_ttl.desc = "Starting from the moment when the request enters the buffer, if the request remains in the buffer for the specified time or is sent but does not receive a response or acknowledgement in time, the request is considered expired."
emqx_resource_schema.request_ttl.label = "Request TTL"
emqx_resource_schema.resource_opts.desc = "Resource options."
emqx_resource_schema.resource_opts.label = "Resource Options"
emqx_resource_schema.resume_interval.desc = "The interval at which the buffer worker attempts to resend failed requests in the inflight window."
emqx_resource_schema.resume_interval.label = "Resume Interval"
emqx_resource_schema.start_after_created.desc = "Whether start the resource right after created."
emqx_resource_schema.start_after_created.label = "Start After Created"
emqx_resource_schema.start_timeout.desc = "Time interval to wait for an auto-started resource to become healthy before responding resource creation requests."
emqx_resource_schema.start_timeout.label = "Start Timeout"
emqx_resource_schema.worker_pool_size.desc = "The number of buffer workers. Only applicable for egress type bridges.\nFor bridges only have ingress direction data flow, it can be set to 0 otherwise must be greater than 0."
emqx_resource_schema.worker_pool_size.label = "Buffer Pool Size"
emqx_retainer_api.config_content.desc = "The config content"
emqx_retainer_api.config_not_found.desc = "Config not found."
emqx_retainer_api.delete_matching_api.desc = "Delete matching messages."
emqx_retainer_api.delete_matching_api.label = "Delete matching messages"
emqx_retainer_api.delete_messages.desc = "Delete all retained messages"
emqx_retainer_api.delete_messages.label = "Delete Retained Messages"
emqx_retainer_api.from_clientid.desc = "The clientid of publisher."
emqx_retainer_api.from_username.desc = "The username of publisher."
emqx_retainer_api.get_config_api.desc = "View config"
emqx_retainer_api.get_config_api.label = "View config"
emqx_retainer_api.list_retained_api.desc = "List retained messages."
emqx_retainer_api.list_retained_api.label = "List retained messages."
emqx_retainer_api.lookup_api.desc = "Lookup a message by a topic without wildcards."
emqx_retainer_api.lookup_api.label = "Lookup a message"
emqx_retainer_api.message_detail.desc = "Details of the message."
emqx_retainer_api.message_not_exist.desc = "Viewed message doesn't exist."
emqx_retainer_api.msgid.desc = "Message ID."
emqx_retainer_api.payload.desc = "Payload."
emqx_retainer_api.publish_at.desc = "Message publish time, RFC 3339 format."
emqx_retainer_api.qos.desc = "QoS."
emqx_retainer_api.query_match_topic.desc = "Topic filter, supports wildcards, omit this to match all messages."
emqx_retainer_api.retained_list.desc = "Retained messages list."
emqx_retainer_api.topic.desc = "Topic."
emqx_retainer_api.unsupported_backend.desc = "Unsupported backend."
emqx_retainer_api.update_config_failed.desc = "Update config failed"
emqx_retainer_api.update_config_success.desc = "Update configs successfully."
emqx_retainer_api.update_retainer_api.desc = "Update retainer config."
emqx_retainer_api.update_retainer_api.label = "Update retainer config"
emqx_retainer_schema.allow_never_expire.desc = "If true, retained messages set to never expire (i.e., whose `Message-Expiry-Interval = 0`) are not affected by the expiry time override.  This configuration only takes effect when `msg_expiry_interval_override` is set."
emqx_retainer_schema.backend.desc = "Settings for the database storing the retained messages."
emqx_retainer_schema.batch_deliver_limiter.desc = "The rate limiter name for retained messages' delivery.\nLimiter helps to avoid delivering too many messages to the client at once, which may cause the client to block or crash, or drop messages due to exceeding the size of the message queue.\nThe names of the available rate limiters are taken from the existing rate limiters under `limiter.batch`.\nIf this field is empty, limiter is not used."
emqx_retainer_schema.batch_deliver_number.desc = "The number of retained messages can be delivered per batch."
emqx_retainer_schema.batch_read_number.desc = "Size of the batch when reading messages from storage. 0 means no limit."
emqx_retainer_schema.delivery_rate.desc = "The maximum rate of delivering retained messages"
emqx_retainer_schema.enable.desc = "Enable retainer feature"
emqx_retainer_schema.flow_control.desc = "Flow control."
emqx_retainer_schema.max_payload_size.desc = "The maximum size of retained messages allowed to be stored. EMQX will refuse to store retained messages larger than this size and output an Error log with the keyword 'retain_failed_for_payload_size_exceeded_limit'.\n\n0 means unlimited retained message size."
emqx_retainer_schema.max_publish_rate.desc = "The maximum rate of publishing retained messages. Messages that are published over the limit are delivered but not stored as retained."
emqx_retainer_schema.max_retained_messages.desc = "Maximum number of retained messages. 0 means no limit."
emqx_retainer_schema.mnesia_config_storage_type.desc = "Specifies whether the messages are stored in RAM or persisted on disc."
emqx_retainer_schema.mnesia_config_type.desc = "Backend type."
emqx_retainer_schema.mnesia_enable.desc = "Enable built-in Mnesia backend."
emqx_retainer_schema.msg_clear_interval.desc = "The time interval for checking and clearing expired retained messages. This can prevent expired retained messages from being stored for a long time.\n\nIf `msg_clear_interval` is set to 0, that is, expired retained messages are not actively checked regularly, EMQX will only check and delete expired retained messages when preparing for delivery."
emqx_retainer_schema.msg_clear_limit.desc = "The maximum number of expired messages cleared at once each `msg_clear_interval`. Settings reasonable limit can prevent the clearing process from running for too long and consume too much resources."
emqx_retainer_schema.msg_expiry_interval.desc = "Expired retained messages will not be delivered again, and a setting of 0 means that retained messages will never expire.\n\nHowever, if the `Message-Expiry-Interval` property is specified in the MQTT message, the value of that property prevails."
emqx_retainer_schema.msg_expiry_interval_override.desc = "If set, this value will take precedence over any `Message-Expiry-Interval` property specified in retained MQTT messages, allowing messages to expire earlier if necessary.  This override only applies to the garbage collection process: it does not affect the expiry time of messages being written nor that of already written messages while iterating over them.  Therefore, messages that are candidate for garbage collection when overridden may still be visible when subscribing to retained topics."
emqx_retainer_schema.stop_publish_clear_msg.desc = "When the retained flag of the `PUBLISH` message is set and Payload is empty,\nwhether to continue to publish the message.\nSee:\nhttp://docs.oasis-open.org/mqtt/mqtt/v3.1.1/os/mqtt-v3.1.1-os.html#_Toc398718038"
emqx_rewrite_api.list_topic_rewrite_api.desc = "List all rewrite rules"
emqx_rewrite_api.list_topic_rewrite_api.label = "List all rewrite rules"
emqx_rewrite_api.update_topic_rewrite_api.desc = "Update all rewrite rules"
emqx_rewrite_api.update_topic_rewrite_api.label = "Update all rewrite rules"
emqx_rewrite_api.update_topic_rewrite_api_response400.desc = "Bad request"
emqx_rewrite_api.update_topic_rewrite_api_response400.label = "Bad request"
emqx_rewrite_api.update_topic_rewrite_api_response413.desc = "Rules count exceed max limit"
emqx_rewrite_api.update_topic_rewrite_api_response413.label = "Rules count exceed limit"
emqx_rule_api_schema.event_action.desc = "Publish or Subscribe"
emqx_rule_api_schema.event_action.label = "Publish or Subscribe"
emqx_rule_api_schema.event_authz_source.desc = "Cache, Plugs or Default"
emqx_rule_api_schema.event_authz_source.label = "Auth Source"
emqx_rule_api_schema.event_clean_start.desc = "Clean Start"
emqx_rule_api_schema.event_clean_start.label = "Clean Start"
emqx_rule_api_schema.event_clientid.desc = "The Client ID"
emqx_rule_api_schema.event_clientid.label = "Client ID"
emqx_rule_api_schema.event_connected_at.desc = "The Time that this Client is Connected"
emqx_rule_api_schema.event_connected_at.label = "Connected Time"
emqx_rule_api_schema.event_ctx_authn_reason_code.desc = "The reason code"
emqx_rule_api_schema.event_ctx_connack_reason_code.desc = "The reason code"
emqx_rule_api_schema.event_ctx_connack_reason_code.label = "Reason Code"
emqx_rule_api_schema.event_ctx_disconnected_da.desc = "The Time that this Client is Disconnected"
emqx_rule_api_schema.event_ctx_disconnected_da.label = "Disconnected Time"
emqx_rule_api_schema.event_ctx_disconnected_reason.desc = "The Reason for Disconnect"
emqx_rule_api_schema.event_ctx_disconnected_reason.label = "Disconnect Reason"
emqx_rule_api_schema.event_ctx_dropped.desc = "The Reason for Dropping"
emqx_rule_api_schema.event_ctx_dropped.label = "Dropped Reason"
emqx_rule_api_schema.event_dup.desc = "The DUP flag of the MQTT message"
emqx_rule_api_schema.event_dup.label = "DUP Flag"
