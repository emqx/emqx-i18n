emqx_bridge_cassandra_connector.keyspace.label = "Keyspace"
emqx_bridge_cassandra_connector.servers.desc = "The IPv4 or IPv6 address or the hostname to connect to.<br/>\nA host entry has the following form: `Host[:Port][,Host2:Port]`.<br/>\nThe Cassandra default port 9042 is used if `[:Port]` is not specified."
emqx_bridge_cassandra_connector.servers.label = "Servers"
emqx_bridge_clickhouse.action_parameters.desc = "Action specific configs."
emqx_bridge_clickhouse.action_parameters.label = "Action"
emqx_bridge_clickhouse.batch_value_separator.desc = "The default value ',' works for the VALUES format. You can also use other separator if other format is specified. See [INSERT INTO Statement](https://clickhouse.com/docs/en/sql-reference/statements/insert-into)."
emqx_bridge_clickhouse.batch_value_separator.label = "Batch Value Separator"
emqx_bridge_clickhouse.clickhouse_action.desc = "Action configs."
emqx_bridge_clickhouse.clickhouse_action.label = "Action"
emqx_bridge_clickhouse.config_enable.desc = "Enable or disable this bridge"
emqx_bridge_clickhouse.config_enable.label = "Enable Or Disable Bridge"
emqx_bridge_clickhouse.desc_config.desc = "Configuration for a Clickhouse bridge."
emqx_bridge_clickhouse.desc_config.label = "Clickhouse Bridge Configuration"
emqx_bridge_clickhouse.desc_name.desc = "Bridge name."
emqx_bridge_clickhouse.desc_name.label = "Bridge Name"
emqx_bridge_clickhouse.desc_type.desc = "The Bridge Type"
emqx_bridge_clickhouse.desc_type.label = "Bridge Type"
emqx_bridge_clickhouse.local_topic.desc = "The MQTT topic filter to be forwarded to Clickhouse. All MQTT 'PUBLISH' messages with the topic\nmatching the local_topic will be forwarded.<br/>\nNOTE: if this bridge is used as the action of a rule (EMQX rule engine), and also local_topic is\nconfigured, then both the data got from the rule and the MQTT messages that match local_topic\nwill be forwarded."
emqx_bridge_clickhouse.local_topic.label = "Local Topic"
emqx_bridge_clickhouse.sql_template.desc = "The template string can contain ${field} placeholders for message metadata and payload field. Make sure that the inserted values are formatted and escaped correctly. [Prepared Statement](https://docs.emqx.com/en/enterprise/v5.0/data-integration/data-bridges.html#Prepared-Statement) is not supported."
emqx_bridge_clickhouse.sql_template.label = "SQL Template"
emqx_bridge_clickhouse_connector.base_url.desc = "The HTTP URL to the Clickhouse server that you want to connect to (for example http://myhostname:8123)"
emqx_bridge_clickhouse_connector.base_url.label = "Server URL"
emqx_bridge_clickhouse_connector.connect_timeout.desc = "The timeout when connecting to the Clickhouse server."
emqx_bridge_clickhouse_connector.connect_timeout.label = "Clickhouse Timeout"
emqx_bridge_confluent_producer.actions.desc = "The configuration for an action."
emqx_bridge_confluent_producer.actions.label = "Action Config"
emqx_bridge_confluent_producer.auth_sasl_mechanism.desc = "SASL authentication mechanism."
emqx_bridge_confluent_producer.auth_sasl_mechanism.label = "Mechanism"
emqx_bridge_confluent_producer.auth_sasl_password.desc = "Confluent Secret."
emqx_bridge_confluent_producer.auth_sasl_password.label = "Secret"
emqx_bridge_confluent_producer.auth_sasl_username.desc = "Confluent Key."
emqx_bridge_confluent_producer.auth_sasl_username.label = "Key"
emqx_bridge_confluent_producer.auth_username_password.desc = "Username/password based authentication."
emqx_bridge_confluent_producer.auth_username_password.label = "Username/password Auth"
emqx_bridge_confluent_producer.authentication.desc = "Authentication configs."
emqx_bridge_confluent_producer.authentication.label = "Authentication"
emqx_bridge_confluent_producer.bootstrap_hosts.desc = "A comma separated list of Confluent Kafka <code>host[:port]</code> namespace endpoints to bootstrap the client.  Default port number is 9092."
emqx_bridge_confluent_producer.bootstrap_hosts.label = "Bootstrap Server"
emqx_bridge_confluent_producer.bridge_v2_type.desc = "The type of the action."
emqx_bridge_confluent_producer.bridge_v2_type.label = "Action Type"
emqx_bridge_confluent_producer.buffer_memory_overload_protection.desc = "Applicable when buffer mode is set to <code>memory</code>\nEMQX will drop old buffered messages under high memory pressure. The high memory threshold is defined in config <code>sysmon.os.sysmem_high_watermark</code>. NOTE: This config only works on Linux."
emqx_bridge_confluent_producer.buffer_memory_overload_protection.label = "Memory Overload Protection"
emqx_bridge_confluent_producer.buffer_mode.desc = "Message buffer mode.\n\n<code>memory</code>: Buffer all messages in memory. The messages will be lost in case of EMQX node restart\n<code>disk</code>: Buffer all messages on disk. The messages on disk are able to survive EMQX node restart.\n<code>hybrid</code>: Buffer message in memory first, when up to certain limit (see <code>segment_bytes</code> config for more information), then start offloading messages to disk, Like <code>memory</code> mode, the messages will be lost in case of EMQX node restart."
emqx_bridge_confluent_producer.buffer_mode.label = "Buffer Mode"
emqx_bridge_confluent_producer.buffer_per_partition_limit.desc = "Number of bytes allowed to buffer for each partition. When this limit is exceeded, older messages will be discarded to make room for new messages to be buffered."
emqx_bridge_confluent_producer.buffer_per_partition_limit.label = "Per-partition Buffer Limit"
emqx_bridge_confluent_producer.buffer_segment_bytes.desc = "Applicable when buffer mode is set to <code>disk</code> or <code>hybrid</code>.\nThis setting specifies the size of each buffer file stored on disk."
emqx_bridge_confluent_producer.buffer_segment_bytes.label = "Segment File Bytes"
emqx_bridge_confluent_producer.compression.desc = "Specify the method of compression."
emqx_bridge_confluent_producer.compression.label = "Compression"
emqx_bridge_confluent_producer.config_enable.desc = "Enable (true) or disable (false) this config."
emqx_bridge_confluent_producer.config_enable.label = "Enable or Disable"
emqx_bridge_confluent_producer.connect_timeout.desc = "Maximum wait time for TCP connection establishment (including authentication time if enabled)."
emqx_bridge_confluent_producer.connect_timeout.label = "Connect Timeout"
emqx_bridge_confluent_producer.connector_type.desc = "The type of the connector."
emqx_bridge_confluent_producer.connector_type.label = "Connector Type"
emqx_bridge_confluent_producer.desc_config.desc = "Configuration for a Confluent action."
emqx_bridge_confluent_producer.desc_config.label = "Confluent Action Configuration"
emqx_bridge_confluent_producer.desc_name.desc = "Action name, used as a human-readable description of the action."
emqx_bridge_confluent_producer.desc_name.label = "Action Name"
emqx_bridge_confluent_producer.desc_type.desc = "The action type."
emqx_bridge_confluent_producer.desc_type.label = "Action Type"
emqx_bridge_confluent_producer.kafka_header_value_encode_mode.desc = "The encoding mode for headers.\n\n - `none`: Add only strings are added as header values\n - `json`: Encode header values as JSON string"
emqx_bridge_confluent_producer.kafka_header_value_encode_mode.label = "Headers value encode mode"
emqx_bridge_confluent_producer.kafka_headers.desc = "Provide a placeholder for message headers<br/>\ne.g. <code>${pub_props}</code><br/>\nNote that the value of the placeholder must be either an object:\n<code>{\"foo\": \"bar\"}</code>\nor an array of key-value pairs:\n<code>[{\"key\": \"foo\", \"value\": \"bar\"}]</code>"
emqx_bridge_confluent_producer.kafka_headers.label = "Message Headers"
emqx_bridge_confluent_producer.kafka_message.desc = "Template for rendering a message."
emqx_bridge_confluent_producer.kafka_message.label = "Confluent Message Template"
emqx_bridge_confluent_producer.kafka_message_key.desc = "Template for rendering message key. If the template is rendered into a NULL value (i.e. there is no such data field in Rule Engine context) then <code>NULL</code> (but not empty string) is used."
emqx_bridge_confluent_producer.kafka_message_key.label = "Message Key"
emqx_bridge_confluent_producer.kafka_message_timestamp.desc = "Which timestamp to use. The timestamp is expected to be a millisecond precision Unix epoch which can be in string format, e.g. <code>1661326462115</code> or <code>'1661326462115'</code>. When the desired data field for this template is not found, or if the found data is not a valid integer, the current system timestamp will be used."
emqx_bridge_confluent_producer.kafka_message_timestamp.label = "Message Timestamp"
emqx_bridge_confluent_producer.kafka_message_value.desc = "Template to render Confluent message value. If the template is rendered into a NULL value (i.e. there is no such data field in Rule Engine context) then Confluent's <code>NULL</code> (but not empty string) is used."
emqx_bridge_confluent_producer.kafka_message_value.label = "Message Value"
emqx_bridge_confluent_producer.kafka_producer.desc = "Confluent Producer configuration."
emqx_bridge_confluent_producer.kafka_producer.label = "Confluent Producer"
emqx_bridge_confluent_producer.kafka_topic.desc = "Kafka topic name.  Supports templates (e.g.: `t-${payload.t}`)."
emqx_bridge_confluent_producer.kafka_topic.label = "Kafka Topic Name"
emqx_bridge_confluent_producer.max_batch_bytes.desc = "Maximum bytes to collect in a Confluent message batch. Most of the Kafka brokers default to a limit of 1 MB batch size. EMQX's default value is less than 1 MB in order to compensate Kafka message encoding overheads (especially when each individual message is very small). When a single message is over the limit, it is still sent (as a single element batch)."
emqx_bridge_confluent_producer.max_batch_bytes.label = "Max Batch Bytes"
emqx_bridge_confluent_producer.max_inflight.desc = "The maximum number of message batches that the producer can send to each partition before it must wait for an acknowledgement.\nSetting a higher number can enhance throughput. However, value above 1 may lead to potential message reordering risks."
emqx_bridge_confluent_producer.max_inflight.label = "Max Inflight"
emqx_bridge_confluent_producer.max_linger_bytes.desc = "Maximum number of bytes for a per-partition producer to wait for messages in order to collect a batch to buffer."
emqx_bridge_confluent_producer.max_linger_bytes.label = "Max Linger Bytes"
emqx_bridge_confluent_producer.max_linger_time.desc = "Maximum duration for a per-partition producer to wait for messages in order to collect a batch to buffer.\nThe default value `0` means no wait. For non-memory buffer mode, it's advised to configure at least `5ms` for less IOPS."
emqx_bridge_confluent_producer.max_linger_time.label = "Max Linger Time"
emqx_bridge_confluent_producer.metadata_request_timeout.desc = "Maximum wait time when fetching metadata from Confluent."
emqx_bridge_confluent_producer.metadata_request_timeout.label = "Metadata Request Timeout"
emqx_bridge_confluent_producer.min_metadata_refresh_interval.desc = "Minimum time interval the client has to wait before refreshing Confluent Kafka broker and topic metadata. Setting too small value may add extra load on Confluent."
emqx_bridge_confluent_producer.min_metadata_refresh_interval.label = "Min Metadata Refresh Interval"
emqx_bridge_confluent_producer.mqtt_topic.desc = "MQTT topic or topic filter as data source (action input).  If rule action is used as data source, this config should be left empty, otherwise messages will be duplicated in Confluent."
emqx_bridge_confluent_producer.mqtt_topic.label = "Source MQTT Topic"
emqx_bridge_confluent_producer.partition_count_refresh_interval.desc = "The time interval for Confluent producer to discover increased number of partitions.\nAfter the number of partitions is increased in Confluent, EMQX will start taking the\ndiscovered partitions into account when dispatching messages per <code>partition_strategy</code>."
emqx_bridge_confluent_producer.partition_count_refresh_interval.label = "Partition Count Refresh Interval"
emqx_bridge_confluent_producer.partition_strategy.desc = "Partition strategy is to tell the producer how to dispatch messages to partitions.\n\n<code>random</code>: Randomly pick a partition for each message.\n<code>key_dispatch</code>: Assigns messages to partitions based on a hash of the message key,\nensuring consistent partition for messages with the same key."
emqx_bridge_confluent_producer.partition_strategy.label = "Partition Strategy"
emqx_bridge_confluent_producer.partitions_limit.desc = "Limit the number of partitions to produce data for the given topic.\nThe special value `all_partitions` is to utilize all partitions for the topic.\nSetting this to a value which is greater than the total number of partitions in has no effect."
emqx_bridge_confluent_producer.partitions_limit.label = "Max Partitions"
emqx_bridge_confluent_producer.producer_buffer.desc = "Configure producer message buffer.\n\nTell Confluent producer how to buffer messages when EMQX has more messages to send than Confluent can keep up, or when Confluent is down."
emqx_bridge_confluent_producer.producer_buffer.label = "Message Buffer"
emqx_bridge_confluent_producer.producer_health_check_topic.desc = "Topic name used exclusively for more accurate connector health checks."
emqx_bridge_confluent_producer.producer_health_check_topic.label = "Connector health check topic"
emqx_bridge_confluent_producer.producer_kafka_ext_header_key.desc = "Key of the Confluent header. Placeholders in format of ${var} are supported."
emqx_bridge_confluent_producer.producer_kafka_ext_header_key.label = "Confluent extra header key."
emqx_bridge_confluent_producer.producer_kafka_ext_header_value.desc = "Value of the header. Placeholders in format of ${var} are supported."
emqx_bridge_confluent_producer.producer_kafka_ext_header_value.label = "Extra Headers Value"
emqx_bridge_confluent_producer.producer_kafka_ext_headers.desc = "Please provide more key-value pairs for Confluent headers<br/>\nThe key-value pairs here will be combined with the\nvalue of <code>kafka_headers</code> field before sending to Confluent."
emqx_bridge_confluent_producer.producer_kafka_ext_headers.label = "Extra Confluent headers"
emqx_bridge_confluent_producer.producer_kafka_opts.desc = "Confluent producer configs."
emqx_bridge_confluent_producer.producer_kafka_opts.label = "Confluent Producer"
emqx_bridge_confluent_producer.producer_opts.desc = "Local MQTT data source and Confluent bridge configs."
emqx_bridge_confluent_producer.producer_opts.label = "MQTT to Confluent"
emqx_bridge_confluent_producer.query_mode.desc = "Query mode. Optional 'sync/async', default 'async'."
emqx_bridge_confluent_producer.query_mode.label = "Query mode"
emqx_bridge_confluent_producer.required_acks.desc = "The acknowledgement criteria for the partition leader. It determines the level of confirmation required from partition replicas before sending an acknowledgement back to the producer.\n\n<code>all_isr</code>: Require all in-sync replicas to acknowledge.\n<code>leader_only</code>: Require only the partition-leader's acknowledgement.\n<code>none</code>: No need for Kafka to acknowledge at all."
emqx_bridge_confluent_producer.required_acks.label = "Required Acks"
emqx_bridge_confluent_producer.server_name_indication.desc = "Server Name Indication (SNI) setting for TLS handshake.<br/>\n- <code>auto</code>: The client will use <code>\"servicebus.windows.net\"</code> as SNI.<br/>\n- <code>disable</code>: If you wish to prevent the client from sending the SNI.<br/>\n- Other string values it will be sent as-is."
emqx_bridge_confluent_producer.server_name_indication.label = "SNI"
emqx_bridge_confluent_producer.socket_nodelay.desc = "When set to 'true', TCP buffer is sent as soon as possible. Otherwise, the OS kernel may buffer small TCP packets for a while (40 ms by default)."
emqx_bridge_confluent_producer.socket_nodelay.label = "No Delay"
emqx_bridge_confluent_producer.socket_opts.desc = "Extra socket options."
emqx_bridge_confluent_producer.socket_opts.label = "Socket Options"
emqx_bridge_confluent_producer.socket_receive_buffer.desc = "Fine tune the socket receive buffer. The default value is tuned for high throughput."
emqx_bridge_confluent_producer.socket_receive_buffer.label = "Socket Receive Buffer Size"
emqx_bridge_confluent_producer.socket_send_buffer.desc = "Fine tune the socket send buffer. The default value is tuned for high throughput."
emqx_bridge_confluent_producer.socket_send_buffer.label = "Socket Send Buffer Size"
emqx_bridge_confluent_producer.socket_tcp_keepalive.desc = "Enable TCP keepalive.\nThe value is three comma separated numbers in the format of 'Idle,Interval,Probes'\n - Idle: The number of seconds a connection needs to be idle before the server begins to send out keep-alive probes (Linux default 7200).\n - Interval: The number of seconds between TCP keep-alive probes (Linux default 75).\n - Probes: The maximum number of TCP keep-alive probes to send before giving up and killing the connection if no response is obtained from the other end (Linux default 9).\nFor example \"240,30,5\" means: TCP keepalive probes are sent after the connection is idle for 240 seconds, and the probes are sent every 30 seconds until a response is received, if it misses 5 consecutive responses, the connection should be closed.\nDefault: 'none'"
emqx_bridge_confluent_producer.socket_tcp_keepalive.label = "TCP keepalive options"
emqx_bridge_confluent_producer.ssl_client_opts.desc = "TLS/SSL options for Confluent client."
emqx_bridge_confluent_producer.ssl_client_opts.label = "TLS/SSL options"
emqx_bridge_confluent_producer.sync_query_timeout.desc = "This parameter defines the timeout limit for synchronous queries. It applies only when the action query mode is configured to 'sync'."
emqx_bridge_confluent_producer.sync_query_timeout.label = "Synchronous Query Timeout"
emqx_bridge_couchbase_action_schema.couchbase.desc = "Action that takes incoming events and uploads them to the Couchbase service."
emqx_bridge_couchbase_action_schema.couchbase.label = "Upload to Couchbase"
emqx_bridge_couchbase_action_schema.max_retries.desc = "Max retry times if error on sending request."
emqx_bridge_couchbase_action_schema.max_retries.label = "Max Retries"
emqx_bridge_couchbase_action_schema.parameters.desc = "Set of parameters for the action."
emqx_bridge_couchbase_action_schema.parameters.label = "Couchbase action parameters"
emqx_bridge_couchbase_action_schema.sql.desc = "SQL Template"
emqx_bridge_couchbase_action_schema.sql.label = "SQL Template"
emqx_bridge_couchbase_connector_schema.config_connector.desc = "Configuration for a connector to Couchbase service."
emqx_bridge_couchbase_connector_schema.config_connector.label = "Couchbase Connector Configuration"
emqx_bridge_couchbase_connector_schema.connect_timeout.desc = "The timeout when connecting to the HTTP server."
emqx_bridge_couchbase_connector_schema.connect_timeout.label = "Connect Timeout"
emqx_bridge_couchbase_connector_schema.password.desc = "Password for Couchbase service."
emqx_bridge_couchbase_connector_schema.password.label = "Password"
emqx_bridge_couchbase_connector_schema.pipelining.desc = "A positive integer. Whether to send HTTP requests continuously, when set to 1, it means that after each HTTP request is sent, you need to wait for the server to return and then continue to send the next request."
emqx_bridge_couchbase_connector_schema.pipelining.label = "HTTP Pipelining"
emqx_bridge_couchbase_connector_schema.pool_size.desc = "The pool size."
emqx_bridge_couchbase_connector_schema.pool_size.label = "Pool Size"
emqx_bridge_couchbase_connector_schema.server.desc = "The IPv4 or IPv6 address or the hostname to connect to.<br/>\n  A host entry has the following form: `Host[:Port]`.<br/>\n  The Couchbase default query service port 8093 is used if `[:Port]` is not specified."
emqx_bridge_couchbase_connector_schema.server.label = "Server Host"
emqx_bridge_couchbase_connector_schema.username.desc = "Username for Couchbase service."
emqx_bridge_couchbase_connector_schema.username.label = "Username"
emqx_bridge_datalayers.action_parameters.desc = "Additional parameters specific to this action type"
emqx_bridge_datalayers.action_parameters.label = "Action Parameters"
emqx_bridge_datalayers.connector.desc = "Datalayers Connector Configs"
emqx_bridge_datalayers.connector.label = "Datalayers Connector"
emqx_bridge_datalayers.datalayers_action.desc = "Action to interact with a Datalayers connector"
emqx_bridge_datalayers.datalayers_action.label = "Datalayers Action"
emqx_bridge_datalayers.desc_config.desc = "Configuration for a Datalayers bridge."
emqx_bridge_datalayers.desc_config.label = "Datalayers Bridge Configuration"
emqx_bridge_datalayers.desc_name.desc = "Bridge name."
emqx_bridge_datalayers.desc_name.label = "Bridge Name"
emqx_bridge_datalayers.desc_type.desc = "The Bridge Type."
emqx_bridge_datalayers.desc_type.label = "Bridge Type"
emqx_bridge_datalayers.write_syntax.desc = "Conf of InfluxDB line protocol to write data points. It is a text-based format that provides the measurement, tag set, field set, and timestamp of a data point, and placeholder supported.\nSee also [InfluxDB 1.8 Line Protocol](https://docs.influxdata.com/influxdb/v1.8/write_protocols/line_protocol_tutorial/) <br/>\nTLDR:<br/>\n```\n<measurement>[,<tag_key>=<tag_value>[,<tag_key>=<tag_value>]] <field_key>=<field_value>[,<field_key>=<field_value>] [<timestamp>]\n```\nPlease note that a placeholder for an integer value must be annotated with a suffix `i`. For example `${payload.int_value}i`."
emqx_bridge_datalayers.write_syntax.label = "Write Syntax"
emqx_bridge_datalayers_connector.database.desc = "Datalayers database."
emqx_bridge_datalayers_connector.database.label = "Database"
emqx_bridge_datalayers_connector.datalayers_api.desc = "Datalayers protocol."
emqx_bridge_datalayers_connector.datalayers_api.label = "HTTP API Protocol"
emqx_bridge_datalayers_connector.datalayers_parameters.desc = "Set of parameters specific for the given type of this Datalayers connector."
emqx_bridge_datalayers_connector.datalayers_parameters.label = "Datalayers Specific Parameters"
emqx_bridge_datalayers_connector.driver_type.desc = "The Driver used to communicate with Datalayers service."
emqx_bridge_datalayers_connector.driver_type.label = "Driver Type"
emqx_bridge_datalayers_connector.password.desc = "Datalayers password."
emqx_bridge_datalayers_connector.password.label = "Password"
emqx_bridge_datalayers_connector.pool_size.desc = "Size of the connection pool towards the bridge target service."
emqx_bridge_datalayers_connector.pool_size.label = "Connection Pool Size"
emqx_bridge_datalayers_connector.precision.desc = "Datalayers time precision."
emqx_bridge_datalayers_connector.precision.label = "Time Precision"
emqx_bridge_datalayers_connector.server.desc = "The IPv4 or IPv6 address or the hostname to connect to.<br/>\nA host entry has the following form: `Host[:Port]`.<br/>\nThe Datalayers default port 8361 is used if `[:Port]` is not specified."
emqx_bridge_datalayers_connector.server.label = "Server Host"
emqx_bridge_datalayers_connector.username.desc = "Datalayers username."
emqx_bridge_datalayers_connector.username.label = "Username"
emqx_bridge_disk_log_action_schema.action_parameters.desc = "Set of parameters for the action."
emqx_bridge_disk_log_action_schema.action_parameters.label = "Disk Log action parameters"
emqx_bridge_disk_log_action_schema.disk_log.desc = "Action that takes incoming events and appends them to local rotating log files in JSON lines format."
emqx_bridge_disk_log_action_schema.disk_log.label = "Append to Log File"
emqx_bridge_disk_log_action_schema.template.desc = "Content of the JSON object to be written. Supports templates."
emqx_bridge_disk_log_action_schema.template.label = "Content"
emqx_bridge_disk_log_action_schema.write_mode.desc = "Whether to write logs synchronously or asynchronously to disk."
emqx_bridge_disk_log_action_schema.write_mode.label = "Write Mode"
emqx_bridge_disk_log_connector_schema.config_connector.desc = "Configuration for a Disk Logging connector."
emqx_bridge_disk_log_connector_schema.config_connector.label = "Disk Log Connector Configuration"
emqx_bridge_disk_log_connector_schema.filepath.desc = "Base file path to the log file to be written to.  Actual log files will have the format `filepath.N`, where `N` is `1..max_file_number`.  The currently used file can be found by taking the file with the most recent modification date.  Note that the directory containing it must also be writable by the EMQX application user, as it'll also contain extra files for internal use (ending in `.siz` and `.idx`)."
emqx_bridge_disk_log_connector_schema.filepath.label = "Log filepath"
emqx_bridge_disk_log_connector_schema.max_file_number.desc = "Maximum number of log files to be used.  Once the maximum number of files is reached and a new rotation is required, the oldest such file is truncated and used as the new current file."
emqx_bridge_disk_log_connector_schema.max_file_number.label = "Maximum Number of Files"
emqx_bridge_disk_log_connector_schema.max_file_size.desc = "Maximum size for the currently active log file.  At least one entry is written to each log, so the final file size may exceed this maximum if a single log entry exceeds this value."
emqx_bridge_disk_log_connector_schema.max_file_size.label = "Maximum File Size"
